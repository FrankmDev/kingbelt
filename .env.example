# Selección obligatoria y explícita: solo acepta demo o shopify.
# demo usa exclusivamente adapters demo y no requiere credenciales Shopify.
# shopify usa exclusivamente Storefront/BFF y exige su configuración válida.
# Las credenciales Shopify nunca seleccionan el proveedor automáticamente.
# Nunca uses PUBLIC_* ni el token Storefront público.
COMMERCE_SOURCE=demo

# Hostname myshopify.com, sin protocolo, ruta, puerto ni credenciales.
SHOPIFY_STORE_DOMAIN=

# Versión fijada. No uses latest ni otra fecha.
SHOPIFY_API_VERSION=2026-07

# Token privado del storefront Headless (cabecera Shopify-Storefront-Private-Token).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Secreto aleatorio de al menos 32 caracteres para firmar la cookie HttpOnly del carrito.
SHOPIFY_CART_COOKIE_SECRET=

# Firma de webhooks de Shopify (Settings → Notifications). Solo servidor.
SHOPIFY_WEBHOOK_SECRET=

# Deploy Hook de Vercel (https://api.vercel.com/v1/integrations/deploy/...).
VERCEL_DEPLOY_HOOK_URL=
