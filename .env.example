# Proveedor activo por defecto. El proyecto no necesita este archivo para usar la demo local.
COMMERCE_SOURCE=local

# Configuración futura e inactiva de Shopify. Fijar siempre una versión; no usar `latest`.
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STORE_DOMAIN=

# El token público de Storefront podrá usarse en cliente si se elige ese flujo de carrito.
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Exclusivo de servidor: nunca usar PUBLIC_, HTML, data-*, JSON, localStorage ni logs.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
