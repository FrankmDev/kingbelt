# Obligatorio por entorno de despliegue. Solo admite demo o shopify.
# No se configura en vercel.json ni se infiere de VERCEL_ENV, rama o tokens.
COMMERCE_SOURCE=demo

# Requeridas únicamente con COMMERCE_SOURCE=shopify.
# SHOPIFY_STORE_DOMAIN: hostname de la tienda en Shopify Admin → Settings → Domains
# (Primary domain de myshopify). Sin https://, sin barra final, sin comillas, sin puerto.
# Correcto: tu-tienda.myshopify.com
# Incorrecto: tu-tienda.shopify.com (falta "my"), el dominio público del sitio,
# admin.shopify.com/store/..., URLs o rutas.
# No uses SHOPIFY_STOREFRONT_ACCESS_TOKEN; el runtime solo lee el token privado.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# URL base alojada de Shopify Customer Accounts (Settings → Customer accounts).
# HTTPS absoluto, sin credenciales. No concatenar SHOPIFY_STORE_DOMAIN + "/account".
# Login, registro y cuenta se delegan a esa superficie. No es una URL de checkout.
SHOPIFY_CUSTOMER_ACCOUNT_URL=

# Redis persistente (Upstash REST) para el store de sesiones de Astro.
# Se leen en runtime desde process.env en el session driver; no van a astro:env ni al bundle.
# Obligatorias las DOS en Vercel (Production y Preview). Una sola, espacios o saltos de línea fallan.
# URL: HTTPS absoluto, sin usuario, contraseña, query ni fragment. Se admite una barra final.
# Preferible una base Upstash distinta para Preview y Production.
# Tras crear o cambiar una variable: nuevo deployment. Un deployment Ready previo no relee runtime.
# En local, sin ninguna de las dos, Astro usa disco (.astro/session). Con ambas válidas, local usa Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcionales: webhook de catálogo. Solo servidor.
SHOPIFY_WEBHOOK_SECRET=
VERCEL_DEPLOY_HOOK_URL=

# Solo se usan durante shopify:preflight.
# Deben contener el conjunto exacto que se espera ver en Storefront.
# CSV de handles (minúsculas con guiones, sin URLs ni IDs Shopify).
SHOPIFY_PREFLIGHT_EXPECTED_PRODUCT_HANDLES=
SHOPIFY_PREFLIGHT_EXPECTED_COLLECTION_HANDLES=

# CLI de smoke y release gate contra un deployment real. No son secretos.
# No entran en astro.config ni en el runtime del frontend.
SHOPIFY_SMOKE_BASE_URL=
SHOPIFY_SMOKE_PRODUCT_HANDLE=
