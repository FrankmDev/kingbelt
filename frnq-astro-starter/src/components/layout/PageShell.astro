---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  mainId?: string;
}

const { mainId = 'main-content', class: className, ...rest } = Astro.props;
---

<div class:list={['flex min-h-svh flex-col', className]} {...rest}>
  <slot name="header" />
  <main id={mainId} class="min-w-0 flex-1" tabindex="-1">
    <slot />
  </main>
  <slot name="footer" />
</div>
