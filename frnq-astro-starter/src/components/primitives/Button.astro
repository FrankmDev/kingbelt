---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'text';
  disabled?: boolean;
  loading?: boolean;
  class?: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
  name?: string;
  value?: string;
  form?: string;
  id?: string;
  title?: string;
  'aria-label'?: string;
  'aria-describedby'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  disabled = false,
  loading = false,
  class: className,
  target,
  rel,
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

const inactive = disabled || loading;
const safeRel = target === '_blank' ? rel ?? 'noopener noreferrer' : rel;
const baseClasses =
  'inline-flex min-h-11 items-center justify-center gap-2 rounded-sm border border-transparent px-6 py-3 font-bold leading-none no-underline transition-[color,background-color,border-color,transform] duration-150 ease-out hover:-translate-y-px';
const variantClasses = {
  primary: 'bg-accent text-accent-contrast',
  secondary: 'border-border bg-surface text-ink',
  text: 'min-h-auto bg-transparent px-0 py-2 text-ink',
};
---

{href ? (
  <a
    class:list={[
      baseClasses,
      variantClasses[variant],
      inactive && 'pointer-events-none opacity-55',
      className,
    ]}
    href={inactive ? undefined : href}
    target={target}
    rel={safeRel}
    aria-label={ariaLabel}
    aria-disabled={inactive || undefined}
    aria-busy={loading || undefined}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    class:list={[
      baseClasses,
      variantClasses[variant],
      inactive && 'pointer-events-none opacity-55',
      className,
    ]}
    type={type}
    disabled={inactive}
    aria-label={ariaLabel}
    aria-busy={loading || undefined}
    {...rest}
  >
    <slot />
  </button>
)}
