---
interface Props {
  id: string;
  label: string;
  help?: string;
  error?: string;
  required?: boolean;
  class?: string;
}

const { id, label, help, error, required = false, class: className } = Astro.props;

const helpId = help ? `${id}-help` : undefined;
const errorId = error ? `${id}-error` : undefined;
---

<div class:list={['grid min-w-0 gap-2', className]} data-invalid={Boolean(error) || undefined}>
  <label class="font-bold" for={id}>
    {label}
    {required && <span class="ms-1 text-danger" aria-hidden="true">*</span>}
  </label>
  <slot />
  {help && !error && <p id={helpId} class="text-sm text-muted">{help}</p>}
  {error && <p id={errorId} class="text-sm text-danger" role="alert">{error}</p>}
</div>
