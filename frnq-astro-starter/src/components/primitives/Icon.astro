---
interface Props {
  name: 'arrow-right' | 'check' | 'chevron-down' | 'close' | 'external' | 'menu';
  size?: number;
  strokeWidth?: number;
  title?: string;
  class?: string;
}

const { name, size = 24, strokeWidth = 1.75, title, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  check: '<path d="m5 12 4 4L19 6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  external: '<path d="M14 5h5v5M10 14 19 5"/><path d="M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  set:html={paths[name]}
>
  {title && <title>{title}</title>}
</svg>
