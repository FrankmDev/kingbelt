---
import JsonLd from '@/components/core/JsonLd.astro';
import SEO from '@/components/core/SEO.astro';
import SkipLink from '@/components/core/SkipLink.astro';
import PageShell from '@/components/layout/PageShell.astro';
import { siteConfig } from '@/config/site';
import type { JsonLdValue } from '@/lib/seo/jsonLd';
import { projectConfig } from '../../project.config';
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: JsonLdValue;
}

const {
  schema,
  noindex = !projectConfig.meta.initialized,
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <SEO {...seoProps} noindex={noindex} />
    {schema && <JsonLd data={schema} />}
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <PageShell>
      <slot name="header" slot="header" />
      <slot />
      <slot name="footer" slot="footer" />
    </PageShell>
  </body>
</html>
