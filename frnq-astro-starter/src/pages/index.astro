---
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projectConfig } from '../../project.config';

const status = projectConfig.meta.initialized ? 'initialized' : 'foundation ready';
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.name,
    url: siteConfig.domain,
  }}
>
  <Section class="grid min-h-svh items-center" aria-labelledby="foundation-title">
    <Container size="narrow">
      <div class="space-y-6">
        <p class="text-sm font-bold tracking-[0.08em] text-muted uppercase">{status}</p>
        <h1 id="foundation-title">{siteConfig.name}</h1>
        <p>
          The technical foundation is working. Project-specific pages and sections are intentionally
          not implemented yet.
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>
