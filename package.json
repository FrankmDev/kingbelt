{
  "name": "kingbelt",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "bun test",
    "build": "astro build",
    "shopify:smoke": "bun scripts/shopify-storefront-smoke.mjs",
