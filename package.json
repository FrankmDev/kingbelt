    "check:links": "node scripts/check-internal-links.mjs",
    "check:perf": "node scripts/check-performance-budgets.mjs",
    "check:scale": "node scripts/check-scale-product.mjs",
    "security:scan": "node scripts/security-audit.mjs",
    "security:scan:history": "node scripts/security-audit.mjs --history",
    "audit:dependencies": "bun audit",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.6",
    "@upstash/redis": "^1.38.2",
    "astro": "^7.2.0",
    "gsap": "^3.15.0",
    "unstorage": "1.17.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "path-to-regexp": "6.3.0"
  }
}
