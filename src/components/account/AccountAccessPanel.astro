---
import Button from '../ui/Button.astro';
import FormField from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';
import { accountAccessPage } from '@content/account';

const { intents, note, helpLabel, helpHref } = accountAccessPage;
const initial = intents.login;
---

<section
  class="account-access"
  aria-labelledby="account-access-title"
  data-account-access
  data-login-heading={intents.login.heading}
  data-login-lede={intents.login.lede}
  data-login-submit={intents.login.submit}
  data-register-heading={intents.register.heading}
  data-register-lede={intents.register.lede}
  data-register-submit={intents.register.submit}
>
  <header class="account-access__head">
    <p class="account-access__eyebrow kb-eyebrow text-king-accent">Cuenta KingBelt</p>
    <h1 id="account-access-title" class="account-access__title font-display" data-account-heading>
      {initial.heading}
    </h1>
    <p class="account-access__lede text-king-muted" data-account-lede>
      {initial.lede}
    </p>
  </header>

  <div class="account-access__intents" role="tablist" aria-label="Tipo de acceso">
    <button
      type="button"
      class="account-access__intent"
      role="tab"
      id="account-intent-login"
      aria-selected="true"
      aria-controls="account-access-form"
      data-account-intent="login"
    >
      {intents.login.label}
    </button>
    <button
      type="button"
      class="account-access__intent"
      role="tab"
      id="account-intent-register"
      aria-selected="false"
      aria-controls="account-access-form"
      data-account-intent="register"
    >
      {intents.register.label}
    </button>
  </div>

  <form id="account-access-form" class="account-access__form" data-account-form>
    <input type="hidden" name="intent" value="login" data-account-intent-value />

    <FormField label="Email" for="account-email" required>
      <input
        id="account-email"
        class="kb-input"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        spellcheck="false"
        maxlength="254"
        required
      />
    </FormField>

    <div class="account-access__actions">
      <Button type="submit" variant="primary" size="lg" data-account-start>
        <span data-account-submit>{initial.submit}</span>
        <Icon name="arrow-right" />
      </Button>
    </div>
  </form>

  <p class="account-access__note text-king-muted">{note}</p>

  <a href={helpHref} class="account-access__help kb-link">{helpLabel}</a>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-account-access]');
  if (root) {
    const heading = root.querySelector<HTMLElement>('[data-account-heading]');
    const lede = root.querySelector<HTMLElement>('[data-account-lede]');
    const submit = root.querySelector<HTMLElement>('[data-account-submit]');
    const intentValue = root.querySelector<HTMLInputElement>('[data-account-intent-value]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-account-intent]')];

    const copy = {
      login: {
        heading: root.dataset.loginHeading ?? '',
        lede: root.dataset.loginLede ?? '',
        submit: root.dataset.loginSubmit ?? '',
      },
      register: {
        heading: root.dataset.registerHeading ?? '',
        lede: root.dataset.registerLede ?? '',
        submit: root.dataset.registerSubmit ?? '',
      },
    } as const;

    const setIntent = (intent: 'login' | 'register') => {
      const next = copy[intent];
      if (heading) heading.textContent = next.heading;
      if (lede) lede.textContent = next.lede;
      if (submit) submit.textContent = next.submit;
      if (intentValue) intentValue.value = intent;

      for (const tab of tabs) {
        tab.setAttribute('aria-selected', String(tab.dataset.accountIntent === intent));
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const intent = tab.dataset.accountIntent;
        if (intent === 'login' || intent === 'register') setIntent(intent);
      });
    }

    root.querySelector<HTMLFormElement>('[data-account-form]')?.addEventListener('submit', (event) => {
      event.preventDefault();
    });
  }
</script>

<style>
  .account-access {
    display: grid;
    gap: var(--kb-space-5);
    min-width: 0;
    padding: var(--kb-space-6);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-sm);
    background: var(--color-king-bone);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.45) inset;
  }

  .account-access__head {
    display: grid;
    gap: var(--kb-space-3);
    min-width: 0;
  }

  .account-access__eyebrow,
  .account-access__title,
  .account-access__lede,
  .account-access__note {
    margin: 0;
  }

  .account-access__title {
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-king-text);
  }

  .account-access__lede,
  .account-access__note {
    font-size: var(--kb-text-sm);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .account-access__intents {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--kb-stroke-dark);
  }

  .account-access__intent {
    margin: 0 0 -1px;
    padding: 0.85rem 0.25rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-king-muted);
    font-family: var(--font-sans);
    font-size: var(--kb-text-meta);
    font-weight: var(--kb-label-weight);
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color var(--kb-dur-fast) var(--kb-ease-out),
      border-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .account-access__intent:hover {
    color: var(--color-king-text);
  }

  .account-access__intent[aria-selected='true'] {
    color: var(--color-king-text);
    border-bottom-color: var(--color-king-accent);
  }

  .account-access__intent:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  .account-access__form {
    display: grid;
    gap: var(--kb-space-4);
    min-width: 0;
  }

  .account-access__actions :global(.kb-btn) {
    width: 100%;
    justify-content: center;
    gap: var(--kb-space-2);
  }

  .account-access__help {
    justify-self: start;
    font-size: var(--kb-text-sm);
  }
</style>
