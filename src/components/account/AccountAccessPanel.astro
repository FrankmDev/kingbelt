---
import Button from '../ui/Button.astro';
import FormField from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';
import { accountAccessPage } from '@content/account';

const { heading, lede, submit, note, helpLabel, helpHref } = accountAccessPage;
---

<section
  class="account-access"
  aria-labelledby="account-access-title"
  data-account-access
  data-demo-account-access
>
  <header class="account-access__head">
    <p class="account-access__eyebrow kb-eyebrow text-king-accent">Cuenta KingBelt</p>
    <h1 id="account-access-title" class="account-access__title font-display">
      {heading}
    </h1>
    <p class="account-access__lede text-king-muted">
      {lede}
    </p>
  </header>

  <form id="account-access-form" class="account-access__form" data-account-form>
    <FormField label="Email" for="account-email" required>
      <input
        id="account-email"
        class="kb-input"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        spellcheck="false"
        maxlength="254"
        required
      />
    </FormField>

    <div class="account-access__actions">
      <Button type="submit" variant="primary" size="lg" data-account-start>
        <span>{submit}</span>
        <Icon name="arrow-right" />
      </Button>
    </div>
  </form>

  <p class="account-access__note text-king-muted">{note}</p>

  <a href={helpHref} class="account-access__help kb-link">{helpLabel}</a>
</section>

<script>
  document.querySelector<HTMLFormElement>('[data-demo-account-access] [data-account-form]')
    ?.addEventListener('submit', (event) => {
      event.preventDefault();
    });
</script>

<style>
  .account-access {
    display: grid;
    gap: var(--kb-space-5);
    min-width: 0;
    padding: var(--kb-space-6);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-sm);
    background: var(--color-king-bone);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.45) inset;
  }

  .account-access__head {
    display: grid;
    gap: var(--kb-space-3);
    min-width: 0;
  }

  .account-access__eyebrow,
  .account-access__title,
  .account-access__lede,
  .account-access__note {
    margin: 0;
  }

  .account-access__title {
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-king-text);
  }

  .account-access__lede,
  .account-access__note {
    font-size: var(--kb-text-sm);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .account-access__form {
    display: grid;
    gap: var(--kb-space-4);
    min-width: 0;
  }

  .account-access__actions :global(.kb-btn) {
    width: 100%;
    justify-content: center;
    gap: var(--kb-space-2);
  }

  .account-access__help {
    justify-self: start;
    font-size: var(--kb-text-sm);
  }
</style>
