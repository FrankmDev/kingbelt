---
import Button from '../ui/Button.astro';
import { headerAccountCta } from '@config/navigation';

interface Props {
  href: string | null;
}

const { href } = Astro.props;
const className = 'header-account-btn hidden lg:inline-flex';
---

{href ? (
  <Button
    href={href}
    id="header-cta"
    variant="outline"
    size="sm"
    class={className}
    aria-label={headerAccountCta.ariaLabel}
  >
    {headerAccountCta.label}
  </Button>
) : (
  <Button
    disabled
    id="header-cta"
    variant="outline"
    size="sm"
    class={className}
    aria-label={headerAccountCta.unavailableAriaLabel}
  >
    {headerAccountCta.label}
  </Button>
)}

<style>
  .header-account-btn:global(.kb-btn) {
    flex-shrink: 0;
  }

  :global(#site-header[data-theme='dark']) .header-account-btn:global(.kb-btn-outline) {
    color: rgba(255, 255, 255, 0.82);
    border-color: rgba(255, 255, 255, 0.22);
  }

  :global(#site-header[data-theme='dark']) .header-account-btn:global(.kb-btn-outline)::after {
    border-color: rgba(255, 255, 255, 0.08);
  }
</style>
