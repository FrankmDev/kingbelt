---
import SectionHeader from '@components/ui/SectionHeader.astro';
import ArticleBody from './ArticleBody.astro';
import ArticleIndex from './ArticleIndex.astro';
import type { BlogPost } from '@content/blog';

interface SectionContent {
  index?: string;
  eyebrow?: string;
  title: string;
}

interface Props {
  post: BlogPost;
  section: SectionContent;
}

const { post, section } = Astro.props;
const idPrefix = `article-${post.slug}`;
const titleId = `${idPrefix}-title`;
---

<section
  class="article-main section-spacing article-main--chapter-start"
  aria-labelledby={titleId}
  data-article-main={idPrefix}
>
  <div class="kb-shell-wide article-main__inner">
    <SectionHeader
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      meta={`${post.dateLabel} · ${post.readingTime}`}
      body={post.introduction}
      titleId={titleId}
      class="article-main__header"
    />

    <div class="article-spread">
      <ArticleBody sections={post.sections} />
      <ArticleIndex sections={post.sections} idPrefix={idPrefix} />
    </div>
  </div>
</section>

<style>
  .article-main {
    background: var(--color-king-surface);
  }

  .article-main--chapter-start {
    padding-top: clamp(2.5rem, 4.5vw, 3.75rem);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .article-main__inner {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-gap);
  }

  .article-main__header:global(.section-header) {
    margin-bottom: 0;
  }

  .article-spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap-lg);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .article-spread {
      grid-template-columns: minmax(0, 1.12fr) minmax(22rem, 0.88fr);
      align-items: stretch;
    }
  }
</style>

<script>
  import { initArticleIndex } from '../../scripts/article-index';

  const cleanups = Array.from(document.querySelectorAll<HTMLElement>('[data-article-main]'))
    .map((root) => initArticleIndex(root));

  document.addEventListener(
    'astro:before-swap',
    () => cleanups.forEach((cleanup) => cleanup()),
    { once: true }
  );
</script>
