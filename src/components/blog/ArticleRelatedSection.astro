---
import SectionHeader from '@components/ui/SectionHeader.astro';
import LatestPostsSection from './LatestPostsSection.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { BlogPost } from '@content/blog';

interface SectionContent {
  index?: string;
  eyebrow?: string;
  title: string;
  body?: string;
  meta?: string;
  cta?: { label: string; href: string };
}

interface Props {
  posts: BlogPost[];
  section: SectionContent;
}

const { posts, section } = Astro.props;
const meta = section.meta?.includes('Artículos')
  ? `${posts.length} artículos relacionados`
  : section.meta;
---

<section
  class="article-related section-spacing"
  aria-labelledby="article-related-title"
>
  <div class="kb-shell-wide article-related__inner">
    <SectionHeader
      index={section.index}
      eyebrow={section.eyebrow}
      body={section.body}
      meta={meta}
      titleId="article-related-title"
    >
      <Fragment slot="title">
        <span set:html={section.title} />
      </Fragment>

      {section.cta && (
        <Fragment slot="aside">
          <Button href={section.cta.href} variant="outline" size="md">
            {section.cta.label}
            <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </Button>
        </Fragment>
      )}
    </SectionHeader>

    <LatestPostsSection posts={posts} showHeader={false} embedded class="article-related__grid" />
  </div>
</section>

<style>
  .article-related {
    background: var(--color-king-bg);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .article-related__inner {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-gap);
  }

  .article-related__inner :global(.home-section-head) {
    margin-bottom: 0;
  }

  .article-related__grid:global(.blog-latest.blog-latest--embedded) {
    padding: 0;
  }

  .article-related__grid :global(.blog-latest-grid) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .article-related__grid :global(.blog-latest-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .article-related__grid :global(.blog-latest-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
