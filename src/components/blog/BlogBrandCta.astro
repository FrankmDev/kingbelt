---
import EditorialCtaSection from '../sections/EditorialCtaSection.astro';

interface SectionContent {
  index?: string;
  eyebrow: string;
  title: string;
  body: string;
  label: string;
  href: string;
}

interface Props {
  image: string;
  imagePosition?: string;
  section: SectionContent;
  article?: boolean;
}

const { image, imagePosition, section, article = false } = Astro.props;
---

<EditorialCtaSection
  index={section.index}
  titleId={article ? 'blog-article-brand-cta' : 'blog-brand-cta-title'}
  class:list={[article && 'blog-brand-cta--article', 'section-spacing-tight']}
  cta={{
    eyebrow: section.eyebrow,
    title: section.title,
    description: section.body,
    buttonLabel: section.label,
    buttonHref: section.href,
    image,
    imagePosition,
  }}
/>

<style>
  .blog-brand-cta--article {
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
  }
</style>
