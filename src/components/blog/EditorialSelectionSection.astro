---
import SectionHeader from '@components/ui/SectionHeader.astro';
import ArticleMeta from '../ui/ArticleMeta.astro';
import Icon from '../ui/Icon.astro';
import OptimizedImage from '../ui/OptimizedImage.astro';
import type { BlogPost } from '@content/blog';

interface SectionContent {
  index?: string;
  eyebrow?: string;
  title: string;
  body?: string;
  meta?: string;
}

interface Props {
  posts: BlogPost[];
  section: SectionContent;
  showHeader?: boolean;
  class?: string;
}

const { posts, section, showHeader = true, class: className = '' } = Astro.props;
const [lead, ...secondary] = posts;
---

<section
  class:list={['blog-selection section-spacing', className]}
  aria-labelledby={showHeader ? 'blog-selection-title' : undefined}
  {...(!showHeader && { 'aria-label': 'Selección editorial de la revista' })}
>
  <div class="kb-shell-wide blog-selection__inner">
    {showHeader && (
      <SectionHeader
        index={section.index}
        eyebrow={section.eyebrow}
        body={section.body}
        meta={section.meta}
        titleId="blog-selection-title"
      >
        <Fragment slot="title">
          <span set:html={section.title} />
        </Fragment>
      </SectionHeader>
    )}

    {lead && (
      <div class="blog-selection-spread">
        <article class="blog-selection-lead" aria-labelledby="blog-selection-lead-title">
          <OptimizedImage
            src={lead.image}
            alt={lead.imageAlt}
            preset="feature"
            width={1672}
            height={941}
            loading="lazy"
            style={`object-position: ${lead.imagePosition ?? 'center'}`}
          />
          <span class="blog-selection-lead__shade" aria-hidden="true"></span>

          <div class="blog-selection-lead__topline">
            <span class="kb-meta-label">Selección / 01</span>
            <span class="kb-meta-label">Referencia principal</span>
          </div>

          <div class="blog-selection-lead__content">
            <ArticleMeta
              category={lead.category}
              date={lead.dateLabel}
              readingTime={lead.readingTime}
              class="blog-selection-lead__meta"
            />

            <h3 id="blog-selection-lead-title">
              <a href={`/blog/${lead.slug}`}>{lead.title}</a>
            </h3>

            <p>{lead.excerpt}</p>

            <a href={`/blog/${lead.slug}`} class="blog-selection-lead__link">
              Leer artículo
              <Icon name="arrow-right" />
            </a>
          </div>

          <span class="blog-selection-lead__side-note kb-meta-label" aria-hidden="true">
            KingBelt Journal · Cuaderno 01
          </span>
        </article>

        <aside class="blog-selection-index" aria-labelledby="blog-selection-index-title">
          <header class="blog-selection-index__header">
            <p class="kb-eyebrow">Archivo breve</p>
            <div class="blog-selection-index__title-row">
              <h3 id="blog-selection-index-title">También en la selección.</h3>
              <span aria-hidden="true">02—03</span>
            </div>
          </header>

          <ol class="blog-selection-index__list" start="2">
            {secondary.map((post, index) => {
              const number = String(index + 2).padStart(2, '0');
              const href = `/blog/${post.slug}`;

              return (
                <li class="blog-selection-index__item">
                  <article aria-labelledby={`blog-selection-index-title-${index}`}>
                    <a
                      href={href}
                      class="blog-selection-index__thumb"
                      aria-label={`Leer artículo: ${post.title}`}
                    >
                      <OptimizedImage
                        src={post.image}
                        alt={post.imageAlt}
                        preset="thumb"
                        width={360}
                        height={203}
                        loading="lazy"
                        style={`object-position: ${post.imagePosition ?? 'center'}`}
                      />
                      <span aria-hidden="true">{number}</span>
                    </a>

                    <div class="blog-selection-index__copy">
                      <div class="blog-selection-index__meta-row">
                        <p class="kb-eyebrow">{post.category}</p>
                        <span class="kb-meta-label">{post.readingTime}</span>
                      </div>

                      <h4 id={`blog-selection-index-title-${index}`}>
                        <a href={href}>{post.title}</a>
                      </h4>

                      <p>{post.excerpt}</p>

                      <a href={href} class="blog-selection-index__link">
                        Leer artículo
                        <Icon name="arrow-up-right" />
                      </a>
                    </div>
                  </article>
                </li>
              );
            })}
          </ol>

          <footer class="blog-selection-index__footer">
            <span class="kb-meta-label">KingBelt / Revista</span>
            <span class="blog-selection-index__line" aria-hidden="true"></span>
            <span class="kb-meta-label">01</span>
          </footer>
        </aside>
      </div>
    )}
  </div>
</section>

<style>
  .blog-selection {
    background: var(--color-king-bg);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .blog-selection__inner {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-gap);
  }

  .blog-selection__inner :global(.home-section-head) {
    margin-bottom: 0;
  }

  .blog-selection-spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-panel-radius);
    background: var(--color-king-surface);
    box-shadow: var(--kb-shadow-sm);
  }

  .blog-selection-lead {
    position: relative;
    display: flex;
    min-width: 0;
    aspect-ratio: 16 / 9;
    min-height: clamp(18rem, 52vw, 28rem);
    overflow: hidden;
    color: var(--color-king-bone);
  }

  .blog-selection-lead :global(picture),
  .blog-selection-lead img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);
    transform-origin: center center;
    transition: transform 760ms var(--kb-ease-soft);
  }

  .blog-selection-lead__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to bottom,
        rgba(11, 10, 8, 0.68) 0%,
        rgba(11, 10, 8, 0.28) 22%,
        transparent 40%
      ),
      linear-gradient(
        to top,
        rgba(11, 10, 8, 0.94) 0%,
        rgba(11, 10, 8, 0.72) 28%,
        rgba(11, 10, 8, 0.28) 58%,
        rgba(11, 10, 8, 0.06) 78%,
        transparent 92%
      ),
      linear-gradient(to right, rgba(11, 10, 8, 0.42) 0%, transparent 68%);
    pointer-events: none;
  }

  .blog-selection-lead__topline {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    padding: var(--kb-space-4) clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(11, 10, 8, 0.52);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .blog-selection-lead__topline :global(.kb-meta-label) {
    color: var(--color-king-bone);
  }

  .blog-selection-lead__content {
    position: relative;
    z-index: 2;
    align-self: flex-end;
    width: 100%;
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }

  .blog-selection-lead__meta :global(.text-king-muted),
  .blog-selection-lead__meta :global(.kb-meta-label) {
    color: rgba(248, 246, 241, 0.92);
  }

  .blog-selection-lead__meta :global(.kb-divider-dot) {
    opacity: 0.85;
  }

  .blog-selection-lead h3 {
    max-width: 18ch;
    margin: var(--kb-space-5) 0 var(--kb-space-4);
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgba(11, 10, 8, 0.35);
  }

  .blog-selection-lead h3 a {
    color: inherit;
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-selection-lead__content > p {
    max-width: 43ch;
    margin: 0 0 var(--kb-space-6);
    color: rgba(248, 246, 241, 0.8);
    font-size: var(--kb-text-body-lg);
    line-height: 1.65;
  }

  .blog-selection-lead__link {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-2);
    color: var(--color-king-on-dark-soft);
    font-size: var(--kb-action-size);
    font-weight: var(--kb-label-weight);
    letter-spacing: var(--kb-action-tracking);
    text-transform: uppercase;
    text-decoration: none;
    transition:
      gap var(--kb-dur-fast) var(--kb-ease-out),
      color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-selection-lead__link :global(svg),
  .blog-selection-index__link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .blog-selection-lead__side-note {
    display: none;
  }

  .blog-selection-index {
    display: flex;
    min-width: 0;
    flex-direction: column;
    color: var(--color-king-text);
    background: var(--color-king-surface);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .blog-selection-index__header {
    padding: var(--kb-space-5) var(--kb-space-6);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .blog-selection-index__header > p,
  .blog-selection-index__meta-row :global(.kb-eyebrow) {
    margin: 0;
    color: var(--color-king-accent);
  }

  .blog-selection-index__title-row > span {
    font-family: var(--font-display);
    font-size: var(--kb-text-h3);
    font-weight: var(--kb-w-heading-light);
    line-height: 1;
    color: color-mix(in srgb, var(--color-king-accent) 78%, var(--color-king-text));
  }

  .blog-selection-index__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-selection-index__item {
    min-width: 0;
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .blog-selection-index__item article {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: var(--kb-space-4);
    align-items: start;
    padding: var(--kb-space-5);
  }

  .blog-selection-index__thumb {
    position: relative;
    display: block;
    width: 4.25rem;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
    align-self: start;
    overflow: hidden;
    border-radius: var(--kb-radius-sm);
    background: var(--color-king-graphite);
  }

  .blog-selection-index__thumb :global(picture),
  .blog-selection-index__thumb img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform var(--kb-dur-slow) var(--kb-ease-soft);
  }

  .blog-selection-index__thumb > span {
    position: absolute;
    right: 0.2rem;
    bottom: 0.2rem;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.72);
    text-shadow: 0 1px 3px rgba(11, 10, 8, 0.45);
  }

  .blog-selection-index__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .blog-selection-index__meta-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--kb-space-3);
  }

  .blog-selection-index__title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--kb-space-5);
    margin-top: var(--kb-space-4);
  }

  .blog-selection-index__title-row h3 {
    max-width: 14ch;
    margin: 0;
    font-size: var(--kb-text-h3);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.08;
  }

  .blog-selection-index__meta-row > :global(.kb-meta-label) {
    flex-shrink: 0;
    color: color-mix(in srgb, var(--color-king-text) 68%, transparent);
  }

  .blog-selection-index h4 {
    max-width: none;
    margin: var(--kb-space-3) 0 var(--kb-space-2);
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: var(--kb-w-medium);
    line-height: 1.2;
    text-wrap: balance;
  }

  .blog-selection-index h4 a {
    color: var(--color-king-text);
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-selection-index__copy > p {
    display: -webkit-box;
    overflow: hidden;
    max-width: 34ch;
    margin: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--color-king-muted);
    font-size: var(--kb-text-sm);
    line-height: 1.55;
  }

  .blog-selection-index__link {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-2);
    margin-top: var(--kb-space-3);
    padding-top: var(--kb-space-3);
    border-top: 1px solid var(--kb-stroke-hairline);
    color: var(--color-king-muted);
    font-size: var(--kb-action-size);
    font-weight: var(--kb-label-weight);
    letter-spacing: var(--kb-action-tracking);
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-selection-index__footer {
    display: flex;
    align-items: center;
    gap: var(--kb-space-4);
    margin-top: auto;
    padding: var(--kb-space-4) var(--kb-space-6);
  }

  .blog-selection-index__footer :global(.kb-meta-label) {
    color: color-mix(in srgb, var(--color-king-text) 62%, transparent);
  }

  .blog-selection-index__line {
    flex: 1;
    height: 1px;
    background: var(--kb-stroke-hairline);
  }

  .blog-selection-lead h3 a:focus-visible,
  .blog-selection-lead__link:focus-visible,
  .blog-selection-index__thumb:focus-visible,
  .blog-selection-index h4 a:focus-visible,
  .blog-selection-index__link:focus-visible {
    border-radius: var(--kb-radius-sm);
    outline: 2px solid var(--color-king-on-dark-soft);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .blog-selection-lead:hover :global(picture),
    .blog-selection-lead:hover img {
      transform: scale(1.22);
    }

    .blog-selection-lead h3 a:hover,
    .blog-selection-lead__link:hover {
      color: var(--color-king-bone);
    }

    .blog-selection-lead__link:hover {
      gap: var(--kb-space-3);
    }

    .blog-selection-index__thumb:hover img {
      transform: scale(1.045);
    }

    .blog-selection-index h4 a:hover,
    .blog-selection-index__link:hover {
      color: var(--color-king-accent);
    }
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .blog-selection-spread {
      grid-template-columns: minmax(0, 1.05fr) minmax(16rem, 0.95fr);
      align-items: stretch;
    }

    .blog-selection-lead {
      aspect-ratio: auto;
      min-height: 100%;
      height: 100%;
    }

    .blog-selection-index {
      border-top: 0;
      border-inline-start: 1px solid var(--kb-stroke-hairline);
    }

    .blog-selection-index__item article {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      padding: var(--kb-space-5);
    }

    .blog-selection-index__thumb {
      width: 4.5rem;
    }

    .blog-selection-index__copy > p {
      max-width: none;
    }

    .blog-selection-index__link {
      margin-top: var(--kb-space-3);
    }
  }

  @media (min-width: 64rem) {
    .blog-selection-spread {
      grid-template-columns: minmax(0, 1.12fr) minmax(20rem, 0.88fr);
      align-items: stretch;
    }

    .blog-selection-lead {
      aspect-ratio: auto;
      min-height: 100%;
      height: 100%;
    }

    .blog-selection-lead__side-note {
      position: absolute;
      top: 50%;
      right: var(--kb-space-4);
      z-index: 1;
      display: block;
      color: rgba(248, 246, 241, 0.5);
      writing-mode: vertical-rl;
      transform: translateY(-50%);
    }

    .blog-selection-index {
      border-top: 0;
      border-inline-start: 1px solid var(--kb-stroke-hairline);
    }

    .blog-selection-index__item article {
      grid-template-columns: 5rem minmax(0, 1fr);
      padding: var(--kb-space-5) var(--kb-space-6);
    }

    .blog-selection-index__thumb {
      width: 5rem;
    }

    .blog-selection-index__link {
      margin-top: var(--kb-space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-selection-lead :global(picture),
    .blog-selection-lead img,
    .blog-selection-index__thumb :global(picture),
    .blog-selection-index__thumb img,
    .blog-selection-index__link {
      transition: none;
    }
  }
</style>
