---
import SectionHeader from '../common/SectionHeader.astro';
import ArticleMeta from '../ui/ArticleMeta.astro';
import Icon from '../ui/Icon.astro';
import type { BlogPost } from '../../data/blog';

interface Props {
  posts: BlogPost[];
  showHeader?: boolean;
  class?: string;
}

const { posts, showHeader = true, class: className = '' } = Astro.props;
const [lead, ...secondary] = posts;
---

<section
  class:list={[
    'blog-selection section-spacing section-spacing-chapter section-steel blog-selection--chapter-end',
    className,
  ]}
  aria-labelledby={showHeader ? 'blog-selection-title' : undefined}
  {...(!showHeader && { 'aria-label': 'Selección editorial de la revista' })}
>
  <div class="kb-shell-wide section-stack-lg">
    {showHeader && (
      <SectionHeader
        eyebrow="Selección editorial"
        body="Una lectura principal y dos referencias concretas sobre medida, herrajes y proporción."
        meta={`${posts.length} lecturas de referencia`}
        titleId="blog-selection-title"
        tone="dark"
        align="left"
        class="blog-selection-header"
      >
        <Fragment slot="title">
          Lecturas para <em>volver</em>.
        </Fragment>
      </SectionHeader>
    )}

    {lead && (
      <div class="blog-selection-spread">
        <article class="blog-selection-lead" aria-labelledby="blog-selection-lead-title">
          <img
            src={lead.image}
            alt={lead.imageAlt}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
            style={`object-position: ${lead.imagePosition ?? 'center'}`}
          />
          <span class="blog-selection-lead__shade" aria-hidden="true"></span>

          <div class="blog-selection-lead__topline">
            <span class="kb-meta-label">Selección / 01</span>
            <span class="kb-meta-label">Referencia principal</span>
          </div>

          <div class="blog-selection-lead__content">
            <ArticleMeta
              category={lead.category}
              date={lead.dateLabel}
              readingTime={lead.readingTime}
              class="blog-selection-lead__meta"
            />

            <h3 id="blog-selection-lead-title">
              <a href={`/blog/${lead.slug}`}>{lead.title}</a>
            </h3>

            <p>{lead.excerpt}</p>

            <a href={`/blog/${lead.slug}`} class="blog-selection-lead__link">
              Leer artículo
              <Icon name="arrow-right" />
            </a>
          </div>

          <span class="blog-selection-lead__side-note kb-meta-label" aria-hidden="true">
            KingBelt Journal · Cuaderno 01
          </span>
        </article>

        <aside class="blog-selection-index" aria-labelledby="blog-selection-index-title">
          <header class="blog-selection-index__header">
            <p class="kb-eyebrow">Archivo breve</p>
            <div class="blog-selection-index__title-row">
              <h3 id="blog-selection-index-title">También en la selección.</h3>
              <span aria-hidden="true">02—03</span>
            </div>
          </header>

          <ol class="blog-selection-index__list" start="2">
            {secondary.map((post, index) => {
              const number = String(index + 2).padStart(2, '0');
              const href = `/blog/${post.slug}`;

              return (
                <li class="blog-selection-index__item">
                  <article aria-labelledby={`blog-selection-index-title-${index}`}>
                    <a
                      href={href}
                      class="blog-selection-index__thumb"
                      aria-label={`Leer artículo: ${post.title}`}
                    >
                      <img
                        src={post.image}
                        alt={post.imageAlt}
                        width="360"
                        height="420"
                        loading="lazy"
                        decoding="async"
                        style={`object-position: ${post.imagePosition ?? 'center'}`}
                      />
                      <span aria-hidden="true">{number}</span>
                    </a>

                    <div class="blog-selection-index__copy">
                      <div class="blog-selection-index__meta-row">
                        <p class="kb-eyebrow">{post.category}</p>
                        <span class="kb-meta-label">{post.readingTime}</span>
                      </div>

                      <h4 id={`blog-selection-index-title-${index}`}>
                        <a href={href}>{post.title}</a>
                      </h4>

                      <p>{post.excerpt}</p>

                      <a href={href} class="blog-selection-index__link">
                        <span>{post.dateLabel}</span>
                        <Icon name="arrow-up-right" />
                      </a>
                    </div>
                  </article>
                </li>
              );
            })}
          </ol>

          <footer class="blog-selection-index__footer">
            <span class="kb-meta-label">KingBelt / Revista</span>
            <span class="blog-selection-index__line" aria-hidden="true"></span>
            <span class="kb-meta-label">01</span>
          </footer>
        </aside>
      </div>
    )}
  </div>
</section>

<style>
  .blog-selection--chapter-end {
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .blog-selection-header:global(.section-header) {
    --sh-max-copy: 40ch;
  }

  .blog-selection-spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: var(--kb-panel-radius);
    background: var(--color-king-bg);
    box-shadow: 0 1rem 2.75rem rgba(11, 10, 8, 0.14);
  }

  .blog-selection-lead {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: clamp(34rem, 118vw, 44rem);
    overflow: hidden;
    color: var(--color-king-bone);
  }

  .blog-selection-lead > img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 760ms var(--kb-ease-soft);
  }

  .blog-selection-lead__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(11, 10, 8, 0.9) 0%, rgba(11, 10, 8, 0.14) 64%, transparent 84%),
      linear-gradient(to right, rgba(11, 10, 8, 0.38), transparent 62%);
    pointer-events: none;
  }

  .blog-selection-lead__topline {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    padding: var(--kb-space-5) clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(248, 246, 241, 0.78);
  }

  .blog-selection-lead__content {
    position: relative;
    z-index: 1;
    align-self: flex-end;
    width: 100%;
    padding: clamp(1.5rem, 5vw, 3.5rem);
  }

  .blog-selection-lead__meta :global(.text-king-muted) {
    color: rgba(248, 246, 241, 0.76);
  }

  .blog-selection-lead h3 {
    max-width: 16ch;
    margin: var(--kb-space-5) 0 var(--kb-space-4);
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .blog-selection-lead h3 a {
    color: inherit;
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-selection-lead__content > p {
    max-width: 43ch;
    margin: 0 0 var(--kb-space-6);
    color: rgba(248, 246, 241, 0.8);
    font-size: var(--kb-text-body-lg);
    line-height: 1.65;
  }

  .blog-selection-lead__link {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-2);
    color: var(--color-king-accent-light);
    font-size: var(--kb-action-size);
    font-weight: var(--kb-label-weight);
    letter-spacing: var(--kb-action-tracking);
    text-transform: uppercase;
    text-decoration: none;
    transition:
      gap var(--kb-dur-fast) var(--kb-ease-out),
      color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-selection-lead__link :global(svg),
  .blog-selection-index__link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .blog-selection-lead__side-note {
    display: none;
  }

  .blog-selection-index {
    display: flex;
    min-width: 0;
    flex-direction: column;
    color: var(--color-king-text);
    background: var(--color-king-bg);
    border-top: 1px solid var(--kb-stroke-dark);
  }

  .blog-selection-index__header {
    padding: var(--kb-space-7);
    border-bottom: 1px solid var(--kb-stroke-dark);
  }

  .blog-selection-index__header > p,
  .blog-selection-index__meta-row p {
    margin: 0;
    color: var(--color-king-accent);
  }

  .blog-selection-index__title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--kb-space-5);
    margin-top: var(--kb-space-4);
  }

  .blog-selection-index__title-row h3 {
    max-width: 14ch;
    margin: 0;
    font-size: var(--kb-text-h3);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.08;
  }

  .blog-selection-index__title-row > span {
    font-family: var(--font-display);
    font-size: var(--kb-text-h3);
    font-weight: var(--kb-w-heading-light);
    line-height: 1;
    color: rgba(138, 90, 43, 0.35);
  }

  .blog-selection-index__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-selection-index__item {
    min-width: 0;
    border-bottom: 1px solid var(--kb-stroke-dark);
  }

  .blog-selection-index__item article {
    display: grid;
    grid-template-columns: 5.75rem minmax(0, 1fr);
    gap: var(--kb-space-5);
    min-height: 100%;
    padding: var(--kb-space-6);
  }

  .blog-selection-index__thumb {
    position: relative;
    display: block;
    min-height: 8.25rem;
    overflow: hidden;
    border-radius: var(--kb-radius-sm);
    background: var(--color-king-graphite);
  }

  .blog-selection-index__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform var(--kb-dur-slow) var(--kb-ease-soft);
  }

  .blog-selection-index__thumb > span {
    position: absolute;
    right: var(--kb-space-2);
    bottom: var(--kb-space-2);
    font-family: var(--font-display);
    font-size: var(--kb-text-h4);
    line-height: 1;
    color: rgba(255, 255, 255, 0.68);
    text-shadow: 0 1px 4px rgba(11, 10, 8, 0.45);
  }

  .blog-selection-index__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .blog-selection-index__meta-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--kb-space-3);
  }

  .blog-selection-index__meta-row > span {
    flex-shrink: 0;
    color: var(--color-king-muted);
  }

  .blog-selection-index h4 {
    max-width: 19ch;
    margin: var(--kb-space-4) 0 var(--kb-space-3);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.7vw, 1.65rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.1;
    text-wrap: balance;
  }

  .blog-selection-index h4 a {
    color: var(--color-king-text);
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-selection-index__copy > p {
    display: -webkit-box;
    overflow: hidden;
    max-width: 34ch;
    margin: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--color-king-muted);
    font-size: var(--kb-text-sm);
    line-height: 1.55;
  }

  .blog-selection-index__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-3);
    margin-top: var(--kb-space-4);
    padding-top: var(--kb-space-3);
    border-top: 1px solid var(--kb-stroke-dark);
    color: var(--color-king-muted);
    font-size: var(--kb-action-size);
    font-weight: var(--kb-label-weight);
    letter-spacing: var(--kb-action-tracking);
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-selection-index__footer {
    display: flex;
    align-items: center;
    gap: var(--kb-space-4);
    margin-top: auto;
    padding: var(--kb-space-5) var(--kb-space-7);
    color: var(--color-king-muted);
  }

  .blog-selection-index__line {
    flex: 1;
    height: 1px;
    background: var(--kb-stroke-dark);
  }

  .blog-selection-lead h3 a:focus-visible,
  .blog-selection-lead__link:focus-visible,
  .blog-selection-index__thumb:focus-visible,
  .blog-selection-index h4 a:focus-visible,
  .blog-selection-index__link:focus-visible {
    border-radius: var(--kb-radius-sm);
    outline: 2px solid var(--color-king-accent-light);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .blog-selection-lead:hover > img {
      transform: scale(1.025);
    }

    .blog-selection-lead h3 a:hover,
    .blog-selection-lead__link:hover {
      color: var(--color-king-bone);
    }

    .blog-selection-lead__link:hover {
      gap: var(--kb-space-3);
    }

    .blog-selection-index__thumb:hover img {
      transform: scale(1.045);
    }

    .blog-selection-index h4 a:hover,
    .blog-selection-index__link:hover {
      color: var(--color-king-accent);
    }
  }

  @media (min-width: 48rem) and (max-width: 63.999rem) {
    .blog-selection-spread {
      grid-template-columns: minmax(0, 1.02fr) minmax(18.5rem, 0.98fr);
      min-height: clamp(34rem, 52vw, 40rem);
    }

    .blog-selection-lead {
      min-height: 0;
    }

    .blog-selection-index {
      border-top: 0;
      border-inline-start: 1px solid var(--kb-stroke-dark);
    }

    .blog-selection-index__list {
      grid-template-rows: repeat(2, minmax(0, 1fr));
      flex: 1;
    }

    .blog-selection-index__item article {
      grid-template-columns: 6.75rem minmax(0, 1fr);
      padding: var(--kb-space-6);
    }

    .blog-selection-index__thumb {
      min-height: 100%;
    }

    .blog-selection-index h4 {
      max-width: none;
      font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    }

    .blog-selection-index__copy > p {
      max-width: none;
    }

    .blog-selection-index__link {
      margin-top: auto;
    }
  }

  @media (min-width: 64rem) {
    .blog-selection-spread {
      grid-template-columns: minmax(0, 1.18fr) minmax(24rem, 0.82fr);
      min-height: clamp(40rem, 48vw, 46rem);
    }

    .blog-selection-lead {
      min-height: 0;
    }

    .blog-selection-lead__side-note {
      position: absolute;
      top: 50%;
      right: var(--kb-space-4);
      z-index: 1;
      display: block;
      color: rgba(248, 246, 241, 0.5);
      writing-mode: vertical-rl;
      transform: translateY(-50%);
    }

    .blog-selection-index {
      border-top: 0;
      border-inline-start: 1px solid var(--kb-stroke-dark);
    }

    .blog-selection-index__list {
      grid-template-rows: repeat(2, minmax(0, 1fr));
      flex: 1;
    }

    .blog-selection-index__item article {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      padding: var(--kb-space-6);
    }

    .blog-selection-index__thumb {
      min-height: 100%;
    }

    .blog-selection-index__link {
      margin-top: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-selection-lead > img,
    .blog-selection-lead__link,
    .blog-selection-index__thumb img,
    .blog-selection-index__link {
      transition: none;
    }
  }
</style>
