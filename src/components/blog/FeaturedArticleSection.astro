---
import SectionHeader from '@components/ui/SectionHeader.astro';
import ArticleMeta from '../ui/ArticleMeta.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Panel from '../ui/Panel.astro';
import OptimizedImage from '../ui/OptimizedImage.astro';
import type { BlogPost } from '@content/blog';

interface Props {
  post: BlogPost;
  showHeader?: boolean;
  afterNav?: boolean;
  embedded?: boolean;
  class?: string;
}

const {
  post,
  showHeader = true,
  afterNav = true,
  embedded = false,
  class: className = '',
} = Astro.props;
const href = `/blog/${post.slug}`;
const topics = post.sections.slice(0, 3).map((section) => section.title);
const sectionCount = post.sections.length;
---

<section
  id={showHeader ? 'articulo-destacado' : undefined}
  class:list={[
    'blog-featured',
    !embedded && 'section-spacing',
    !embedded && afterNav && 'blog-featured--after-nav',
    !embedded && 'blog-featured--chapter-end',
    embedded && 'blog-featured--embedded',
    className,
  ]}
  aria-labelledby={showHeader ? 'blog-featured-title' : undefined}
  {...(!showHeader && { 'aria-label': 'Artículo destacado de la revista' })}
>
  <div class:list={[embedded ? 'blog-featured__inner' : 'kb-shell-wide section-stack-lg']}>
    {showHeader && (
      <SectionHeader
        eyebrow="El cuaderno KingBelt"
        title="Una lectura para empezar <em>por lo esencial</em>."
        body="Guías sobre proporción, materiales, cuidado y estilo masculino. Información directa para entender cada pieza antes y después de usarla."
        meta="Cuaderno 01 / Verano 2026"
        titleId="blog-featured-title"
        align="center"
        class="blog-featured-header"
      />
    )}

    <Panel variant="steel" padding="none" class="blog-featured-cover">
      <article class="blog-featured-cover__layout" aria-labelledby="blog-featured-article-title">
        <a
          href={href}
          class="blog-featured-cover__media"
          aria-label={`Leer artículo: ${post.title}`}
        >
          <OptimizedImage
            src={post.image}
            alt={post.imageAlt}
            preset="feature"
            width={1672}
            height={941}
            loading="lazy"
            style={`object-position: ${post.imagePosition ?? 'center'}`}
          />
          <span class="blog-featured-cover__image-shade" aria-hidden="true"></span>
          <span class="blog-featured-cover__image-frame" aria-hidden="true"></span>
          <span class="blog-featured-cover__image-label kb-meta-label">
            Artículo destacado
          </span>
          <span class="blog-featured-cover__image-caption kb-meta-label">
            {post.category} · {post.readingTime}
          </span>
          <span class="blog-featured-cover__image-folio" aria-hidden="true">01</span>
        </a>

        <div class="blog-featured-cover__content">
          <header class="blog-featured-cover__head">
            <div class="blog-featured-cover__head-bar">
              <p class="kb-eyebrow kb-eyebrow-lined blog-featured-cover__eyebrow">En portada</p>
              <span class="blog-featured-cover__folio kb-meta-label" aria-hidden="true">01</span>
            </div>
            <ArticleMeta
              category={post.category}
              date={post.dateLabel}
              readingTime={post.readingTime}
              class="blog-featured-cover__meta"
            />
          </header>

          <div class="blog-featured-cover__reading-track" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="blog-featured-cover__body">
            <h3 id="blog-featured-article-title" class="blog-featured-cover__title">
              <a href={href}>{post.title}</a>
            </h3>

            <p class="blog-featured-cover__dek">{post.introduction}</p>

            <p class="blog-featured-cover__excerpt">{post.excerpt}</p>

            {topics.length > 0 && (
              <ul class="blog-featured-cover__topics" aria-label="Apartados del artículo">
                {topics.map((topic) => (
                  <li>{topic}</li>
                ))}
              </ul>
            )}
          </div>

          <footer class="blog-featured-cover__foot">
            <div class="blog-featured-cover__foot-meta">
              <span class="blog-featured-cover__edition kb-meta-label">Revista / 01</span>
              <span class="blog-featured-cover__scope kb-meta-label">
                {sectionCount} apartados
              </span>
            </div>
            <Button href={href} variant="surface" size="md" class="blog-featured-cover__button">
              Leer artículo
              <Icon name="arrow-right" />
            </Button>
          </footer>
        </div>
      </article>
    </Panel>
  </div>
</section>

<style>
  .blog-featured {
    background: var(--color-king-bg);
  }

  .blog-featured--embedded {
    background: transparent;
  }

  .blog-featured--embedded .blog-featured__inner {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-gap);
  }

  .blog-featured--embedded :global(.blog-featured-cover.kb-panel-steel) {
    border-color: color-mix(in srgb, var(--color-king-text) 10%, transparent);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.55) inset,
      0 16px 40px rgba(17, 16, 14, 0.06);
  }

  .blog-featured--after-nav {
    padding-top: clamp(2.5rem, 4.5vw, 3.75rem);
  }

  .blog-featured--chapter-end {
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .blog-featured-header:global(.section-header) {
    --sh-max-copy: 42ch;
  }

  .blog-featured-cover__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .blog-featured-cover__media,
  .blog-featured-cover__content {
    min-width: 0;
  }

  .blog-featured-cover__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    color: var(--color-king-bone);
  }

  .blog-featured-cover__media :global(picture),
  .blog-featured-cover__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .blog-featured-cover__media img {
    transform: scale(1.001);
    transition: transform 720ms var(--kb-ease-soft);
  }

  .blog-featured-cover__image-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 10, 8, 0.62) 0%,
      rgba(11, 10, 8, 0.08) 48%,
      transparent 72%
    );
    pointer-events: none;
  }

  .blog-featured-cover__image-frame {
    position: absolute;
    inset: var(--kb-space-4);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: calc(var(--kb-radius-lg) - var(--kb-space-1));
    box-shadow: inset 0 0 0 1px rgba(11, 10, 8, 0.12);
    pointer-events: none;
  }

  .blog-featured-cover__image-label {
    position: absolute;
    top: var(--kb-space-5);
    left: var(--kb-space-5);
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--kb-radius-xs);
    background: rgba(17, 16, 14, 0.72);
    color: var(--color-king-bone);
  }

  .blog-featured-cover__image-folio {
    position: absolute;
    right: var(--kb-space-5);
    bottom: var(--kb-space-4);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 7rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.22);
  }

  .blog-featured-cover__image-caption {
    position: absolute;
    left: var(--kb-space-5);
    bottom: var(--kb-space-5);
    max-width: calc(100% - 8rem);
    color: rgba(248, 246, 241, 0.72);
  }

  .blog-featured-cover__media:focus-visible {
    outline: 2px solid var(--color-king-on-dark-soft);
    outline-offset: -4px;
  }

  .blog-featured-cover__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-5);
    padding: var(--kb-space-6);
    border-top: 1px solid var(--kb-stroke-soft);
  }

  .blog-featured--embedded .blog-featured-cover__content {
    padding: var(--kb-space-5);
    gap: var(--kb-space-4);
  }

  .blog-featured--embedded .blog-featured-cover__title {
    max-width: none;
    font-size: clamp(1.375rem, 3.2vw, 1.875rem);
    line-height: 1.12;
    letter-spacing: -0.018em;
  }

  .blog-featured--embedded .blog-featured-cover__dek {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .blog-featured--embedded .blog-featured-cover__excerpt {
    max-width: none;
    font-size: var(--kb-text-sm);
    line-height: 1.62;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .blog-featured--embedded .blog-featured-cover__foot {
    padding-top: var(--kb-space-4);
  }

  .blog-featured--embedded .blog-featured-cover__image-folio,
  .blog-featured--embedded .blog-featured-cover__image-caption {
    display: none;
  }

  .blog-featured--embedded .blog-featured-cover__image-label {
    top: var(--kb-space-4);
    left: var(--kb-space-4);
    padding: 0.35rem 0.6rem;
    font-size: 0.6875rem;
  }

  .blog-featured-cover__content::before {
    content: "";
    position: absolute;
    top: -3px;
    left: var(--kb-space-7);
    width: 5px;
    height: 5px;
    border-radius: var(--kb-radius-pill);
    background: var(--color-king-on-dark-line);
    box-shadow:
      1rem 0 0 rgba(255, 250, 241, 0.42),
      2rem 0 0 rgba(255, 250, 241, 0.2);
  }

  .blog-featured-cover__head {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--kb-space-3);
  }

  .blog-featured-cover__head-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    width: 100%;
  }

  .blog-featured-cover__folio {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.38);
    letter-spacing: 0.16em;
  }

  .blog-featured-cover__eyebrow {
    margin: 0;
    color: var(--color-king-on-dark-muted);
  }

  .blog-featured-cover__meta {
    justify-content: flex-start;
  }

  .blog-featured-cover__meta :global(.text-king-muted) {
    color: var(--color-king-secondary);
  }

  .blog-featured-cover__reading-track {
    display: grid;
    grid-template-columns: 1fr 0.62fr 0.28fr;
    gap: var(--kb-space-2);
  }

  .blog-featured-cover__reading-track span {
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
  }

  .blog-featured-cover__reading-track span:first-child {
    background: var(--color-king-on-dark-line);
  }

  .blog-featured-cover__body {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    min-width: 0;
  }

  .blog-featured-cover__title {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.06;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .blog-featured-cover__title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .blog-featured-cover__title a:focus-visible {
    border-radius: var(--kb-radius-sm);
    outline: 2px solid var(--color-king-on-dark-soft);
    outline-offset: 0.2em;
  }

  .blog-featured-cover__dek {
    max-width: 48ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.42;
    color: rgba(255, 255, 255, 0.82);
    text-wrap: pretty;
  }

  .blog-featured-cover__excerpt {
    max-width: 46ch;
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.65;
    color: var(--color-king-secondary);
  }

  .blog-featured-cover__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kb-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-featured-cover__topics li {
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--kb-radius-xs);
    font-size: var(--kb-text-2xs);
    font-weight: var(--kb-w-medium);
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: var(--color-king-secondary);
  }

  .blog-featured-cover__foot {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: var(--kb-space-4);
    margin-top: var(--kb-space-2);
    padding-top: var(--kb-space-5);
    border-top: 1px solid var(--kb-stroke-soft);
  }

  .blog-featured-cover__foot-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-2) var(--kb-space-4);
  }

  .blog-featured-cover__edition,
  .blog-featured-cover__scope {
    color: var(--color-king-secondary);
  }

  :global(.blog-featured-cover__button.kb-btn) {
    overflow: hidden;
  }

  :global(.blog-featured-cover__button.kb-btn)::before {
    content: none;
  }

  :global(.blog-featured-cover__button.kb-btn-surface),
  :global(.blog-featured-cover__button.kb-btn-surface:active) {
    background-image: none;
    box-shadow: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .blog-featured-cover__media:hover img {
      transform: scale(1.035);
    }

    .blog-featured-cover__title a:hover {
      color: var(--color-king-on-dark-soft);
    }

    :global(.blog-featured-cover__button.kb-btn-surface:hover) {
      background-image: none;
      border-color: var(--color-king-on-dark-line);
      box-shadow: none;
    }
  }

  @media (min-width: 48rem) {
    .blog-featured-cover__head-bar,
    .blog-featured-cover__foot {
      align-items: center;
      flex-direction: row;
      justify-content: space-between;
    }

    .blog-featured-cover__meta {
      justify-content: flex-end;
    }
  }

  @media (min-width: 64rem) {
    .blog-featured-cover__layout {
      grid-template-columns: minmax(0, 1.12fr) minmax(24rem, 0.88fr);
      align-items: stretch;
    }

    .blog-featured-cover__media {
      align-self: stretch;
      width: 100%;
      min-height: 100%;
      aspect-ratio: auto;
    }

    .blog-featured-cover__content {
      justify-content: flex-start;
      gap: var(--kb-space-5);
      padding: clamp(1.75rem, 3vw, 2.75rem);
      border-top: 0;
      border-inline-start: 1px solid var(--kb-stroke-soft);
    }

    .blog-featured--embedded .blog-featured-cover__content {
      padding: var(--kb-space-5);
    }

    .blog-featured-cover__content::before {
      top: var(--kb-space-7);
      left: -3px;
      width: 5px;
      height: 5px;
      box-shadow:
        0 1rem 0 rgba(255, 250, 241, 0.42),
        0 2rem 0 rgba(255, 250, 241, 0.2);
    }

    .blog-featured-cover__title {
      max-width: 20ch;
      font-size: clamp(1.875rem, 2.8vw, 2.75rem);
    }

    .blog-featured--embedded .blog-featured-cover__title {
      font-size: clamp(1.5rem, 2.4vw, 2rem);
    }

    .blog-featured-cover__dek {
      max-width: 42ch;
    }

    .blog-featured-cover__excerpt {
      max-width: 44ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-featured-cover__media img {
      transition: none;
    }
  }
</style>
