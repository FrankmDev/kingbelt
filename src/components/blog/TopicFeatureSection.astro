---
import SectionHeader from '../common/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import MediaFrame from '../ui/MediaFrame.astro';
import type { BlogPost } from '../../data/blog';

interface Props {
  lead: BlogPost;
  related: BlogPost[];
}

const { lead, related } = Astro.props;
const layerCount = related.length;
---

<section
  id="cuidados"
  class="blog-topic section-spacing blog-topic--chapter-start"
  aria-labelledby="blog-topic-title"
>
  <div class="kb-shell-wide section-stack-lg">
    <SectionHeader
      eyebrow="Dossier"
      body="Una lectura principal y referencias relacionadas para cuidar el material con criterio y sin exceso de rutina."
      meta={`${lead.category} · ${lead.readingTime}`}
      align="left"
    >
      <Fragment slot="title">
        <span id="blog-topic-title">Usar, cuidar, <em>conservar</em>.</span>
      </Fragment>
    </SectionHeader>

    <div class="blog-topic-layout">
      <div
        class="blog-topic-media-wrap"
        style={`--blog-topic-image-position: ${lead.imagePosition ?? 'center'}`}
      >
        <MediaFrame
          src={lead.image}
          alt={lead.imageAlt}
          ratio="4/3"
          label={lead.category}
          caption={lead.title}
          captionNumber="01"
          width={1600}
          height={1200}
          loading="lazy"
          class="blog-topic-media"
        />
      </div>

      <aside class="kb-reading-panel" aria-labelledby="blog-topic-panel-title">
        <header class="kb-reading-panel__head">
          <div class="kb-reading-panel__head-bar">
            <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">
              Guía principal
            </p>
            <span class="kb-reading-panel__folio kb-meta-label" aria-hidden="true">
              {String(layerCount).padStart(2, '0')}
            </span>
          </div>

          <p id="blog-topic-panel-title" class="kb-reading-panel__statement">
            {lead.title}
          </p>
        </header>

        <ol class="kb-reading-panel__layers">
          {related.map((post, index) => (
            <li class="kb-reading-panel__layer">
              <div class="kb-reading-panel__rail" aria-hidden="true">
                <span class="kb-reading-panel__num">{String(index + 1).padStart(2, '0')}</span>
                {index < related.length - 1 && <span class="kb-reading-panel__rail-line"></span>}
              </div>

              <div class="kb-reading-panel__body">
                <div class="kb-reading-panel__layer-head">
                  <h3 class="kb-reading-panel__label">{post.category}</h3>
                  <span class="kb-reading-panel__tag">{post.readingTime}</span>
                </div>
                <p class="kb-reading-panel__text">
                  <a href={`/blog/${post.slug}`} class="blog-topic-related-link">
                    {post.title}
                  </a>
                </p>
              </div>
            </li>
          ))}
        </ol>

        <div class="blog-topic-panel-actions">
          <Button href={`/blog/${lead.slug}`} variant="primary" size="md">
            Leer la guía
            <Icon name="arrow-right" />
          </Button>
        </div>

        <div class="kb-reading-panel__foot" aria-hidden="true">
          <span class="kb-reading-panel__track"></span>
          <span class="kb-reading-panel__track"></span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .blog-topic {
    background: var(--color-king-surface);
  }

  .blog-topic--chapter-start {
    padding-top: clamp(4.25rem, 7.5vw, 6.5rem);
  }

  .blog-topic-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap-lg);
    align-items: start;
  }

  .blog-topic-panel-actions {
    padding: 0 var(--kb-space-6) var(--kb-space-6);
  }

  .blog-topic-related-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .blog-topic-related-link:hover {
      color: var(--color-king-accent);
    }
  }

  .blog-topic-related-link:focus-visible {
    outline: 2px solid rgba(138, 90, 43, 0.45);
    outline-offset: 2px;
    border-radius: var(--kb-radius-sm);
  }

  @media (min-width: 64rem) {
    .blog-topic-layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: stretch;
    }

    .kb-reading-panel {
      height: 100%;
    }

    :global(.blog-topic-media.media-frame) {
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }

    :global(.blog-topic-media .media-frame__image) {
      object-position: var(--blog-topic-image-position, center);
    }
  }
</style>
