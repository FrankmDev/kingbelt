---
import Icon from '../ui/Icon.astro';

interface Props {
  icon: string;
  value: string;
  unit?: string;
  label: string;
  desc: string;
}

const { icon, value, unit, label, desc } = Astro.props;
---

<div class="stat-item group relative p-8 border border-king-border/50 bg-king-surface/50 hover:bg-king-surface transition-all duration-500">
  <Icon
    name={icon}
    class="w-8 h-8 text-king-accent/60 mb-6 group-hover:text-king-accent transition-colors duration-500"
  />
  <div class="flex items-baseline gap-1 mb-3">
    <span class="font-display text-5xl md:text-6xl text-king-text tracking-tight">
      {value}
    </span>
    {unit && (
      <span class="text-sm font-medium text-king-muted uppercase tracking-wider">
        {unit}
      </span>
    )}
  </div>
  <h3 class="text-sm font-medium text-king-text uppercase tracking-wider mb-2">
    {label}
  </h3>
  <p class="text-xs text-king-muted leading-relaxed">{desc}</p>
  <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-king-accent/0 group-hover:border-king-accent/40 transition-colors duration-500"></div>
  <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-king-accent/0 group-hover:border-king-accent/40 transition-colors duration-500"></div>
</div>
