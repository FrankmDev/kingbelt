---
import '../../styles/cart.css';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import CartEmpty from './CartEmpty.astro';
---

<div
  id="cart-drawer"
  class="cart-drawer"
  data-cart-drawer
  aria-hidden="true"
  inert
>
  <button
    type="button"
    class="cart-drawer__overlay"
    data-cart-drawer-overlay
    aria-label="Cerrar carrito"
    tabindex="-1"
  ></button>

  <aside
    class="cart-drawer__panel"
    data-cart-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-drawer-title"
    tabindex="-1"
  >
    <header class="cart-drawer__header">
      <div class="cart-drawer__heading">
        <h2 id="cart-drawer-title" class="cart-drawer__title font-display">Tu carrito</h2>
        <p class="cart-drawer__count kb-meta-label text-king-muted" data-cart-drawer-count>
          0 artículos
        </p>
      </div>

      <button
        type="button"
        class="cart-drawer__close"
        data-cart-drawer-close
        aria-label="Cerrar carrito"
      >
        <Icon name="x" class="h-4 w-4" />
      </button>
    </header>

    <p
      class="cart-drawer__status kb-meta-label"
      data-cart-drawer-status
      id="cart-drawer-status"
      role="status"
      aria-live="polite"
      tabindex="-1"
      hidden
    ></p>

    <div class="cart-drawer__body">
      <div class="cart-drawer__lines" data-cart-drawer-lines hidden></div>
      <div data-cart-drawer-empty>
        <CartEmpty variant="drawer" />
      </div>
    </div>

    <footer class="cart-drawer__footer" data-cart-drawer-footer hidden>
      <div class="cart-drawer__subtotal-row">
        <span class="kb-meta-label text-king-muted">Subtotal</span>
        <span class="cart-drawer__subtotal font-display" data-cart-drawer-subtotal>0 €</span>
      </div>

      <p class="cart-drawer__note kb-meta-label text-king-muted">
        Envío e impuestos se calcularán en el checkout.
      </p>

      <div class="cart-drawer__actions">
        <Button
          type="button"
          variant="primary"
          size="md"
          class="cart-drawer__checkout"
          data-cart-checkout
          aria-describedby="cart-drawer-status"
        >
          Finalizar compra
        </Button>
        <Button href="/carrito" variant="outline" size="md">
          Ver carrito
        </Button>
      </div>
    </footer>
  </aside>
</div>

<style>
  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--kb-z-modal);
    pointer-events: none;
  }

  .cart-drawer__overlay {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(13, 12, 11, 0.42);
    opacity: 0;
    transition: opacity var(--kb-dur-med) var(--kb-ease-out);
    cursor: pointer;
  }

  .cart-drawer__panel {
    position: absolute;
    inset-block: 0;
    right: 0;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    grid-template-areas:
      'header'
      'status'
      'body'
      'footer';
    width: min(100%, 26rem);
    height: 100dvh;
    max-width: 100%;
    border-left: 1px solid var(--kb-stroke-hairline);
    background: var(--color-king-bg);
    box-shadow: -12px 0 40px rgba(13, 12, 11, 0.08);
    transform: translateX(100%);
    transition: transform var(--kb-dur-med) var(--kb-ease-out);
    pointer-events: auto;
    padding-bottom: env(safe-area-inset-bottom, 0);
  }

  .cart-drawer[data-open='true'] {
    pointer-events: auto;
  }

  .cart-drawer[data-open='true'] .cart-drawer__overlay {
    opacity: 1;
  }

  .cart-drawer[data-open='true'] .cart-drawer__panel {
    transform: translateX(0);
  }

  .cart-drawer__header {
    grid-area: header;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--kb-space-4);
    padding: var(--kb-space-5) var(--kb-space-5) var(--kb-space-4);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .cart-drawer__heading {
    display: grid;
    gap: var(--kb-space-1);
    min-width: 0;
  }

  .cart-drawer__title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: var(--kb-w-heading-light);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .cart-drawer__count {
    margin: 0;
  }

  .cart-drawer__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    color: var(--color-king-text);
    background: transparent;
    transition:
      border-color var(--kb-dur-fast) var(--kb-ease-out),
      color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .cart-drawer__close:hover {
    border-color: var(--kb-stroke-accent);
    color: var(--color-king-accent);
  }

  .cart-drawer__close:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  .cart-drawer__status {
    grid-area: status;
    margin: 0;
    padding: var(--kb-space-3) var(--kb-space-5) 0;
    color: var(--color-king-muted);
  }

  .cart-drawer__status[data-status-error] {
    color: var(--color-king-error);
  }

  .cart-drawer__status:focus {
    outline: none;
  }

  .cart-drawer__body {
    grid-area: body;
    overflow: auto;
    overscroll-behavior: contain;
    padding: var(--kb-space-4) var(--kb-space-5);
    min-height: 0;
    -webkit-overflow-scrolling: touch;
  }

  .cart-drawer__lines {
    display: grid;
    gap: var(--kb-space-4);
  }

  .cart-drawer__footer {
    grid-area: footer;
    display: grid;
    gap: var(--kb-space-3);
    padding: var(--kb-space-5);
    border-top: 1px solid var(--kb-stroke-hairline);
    background: var(--color-king-bone);
  }

  .cart-drawer__subtotal-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--kb-space-4);
  }

  .cart-drawer__subtotal {
    font-size: 1.25rem;
    font-weight: var(--kb-w-heading-light);
    font-variant-numeric: tabular-nums;
  }

  .cart-drawer__note {
    margin: 0;
    line-height: 1.5;
  }

  .cart-drawer__actions {
    display: grid;
    gap: var(--kb-space-3);
    padding-top: var(--kb-space-1);
  }

  .cart-drawer__actions :global(.kb-btn) {
    width: 100%;
    justify-content: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer__overlay,
    .cart-drawer__panel {
      transition: none;
    }
  }
</style>
