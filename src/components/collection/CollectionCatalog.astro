---
import CollectionFilters from './CollectionFilters.astro';
import ProductCard from './ProductCard.astro';
import type {
  CollectionFacets,
  Collection,
  ProductSummary,
} from '@commerce/domain/catalog';

interface Props {
  category: Collection;
  products: ProductSummary[];
  facets: CollectionFacets;
  /** Referencias visibles antes de «Mostrar más». */
  pageSize?: number;
  class?: string;
}

const { category, products, facets, pageSize = 24, class: className } = Astro.props;

const countLabel = `${products.length} ${products.length === 1 ? 'referencia' : 'referencias'}`;
---

<section
  id="productos"
  class:list={['collection-catalog', className]}
  aria-label={`Productos de la categoría ${category.title}`}
  data-collection-catalog
  data-page-size={pageSize}
>
  <div class="collection-catalog__layout kb-shell-wide">
    <aside class="collection-catalog__aside" aria-label="Filtros de catálogo">
      <CollectionFilters facets={facets} idPrefix={`filters-${category.handle}`} />
    </aside>

    <div class="collection-catalog__results">
      <header class="collection-catalog__toolbar">
        <div class="collection-catalog__toolbar-main">
          <p class="collection-catalog__folio kb-code-label text-king-muted">Catálogo</p>
          <p class="collection-catalog__heading font-display" data-results-count role="status" aria-live="polite">{countLabel}</p>
        </div>
        <p class="collection-catalog__scope text-king-muted">
          Selección de {category.title.toLowerCase()} con material, color y precio visibles en cada referencia.
        </p>
      </header>

      <ul class="collection-catalog__grid">
        {products.map((product, index) => (
          <li
            class="collection-catalog__item"
            data-collection-product
            data-filter-type={product.productType}
            data-filter-colors={JSON.stringify(product.colors.map((color) => color.label))}
            data-filter-price-min={product.priceRange.min.amountMinor}
            data-filter-purchasable={product.purchasable}
          >
            <ProductCard
              product={product}
              index={index}
              meta={`${product.productType} · ${product.colors.length === 1 ? product.colors[0].label : `${product.colors.length} colores`}`}
            />
          </li>
        ))}
      </ul>

      <div class="collection-catalog__more">
        <button type="button" class="kb-btn kb-btn-outline kb-btn-md" data-load-more hidden>
          Mostrar más
        </button>
      </div>

      <div class="collection-catalog__empty" data-results-empty hidden>
        <p class="font-display">No hay referencias con estos filtros.</p>
        <p class="text-king-muted">Restablece los filtros para volver a ver la colección completa.</p>
        <button type="button" class="kb-btn kb-btn-ghost kb-btn-sm" data-empty-reset>
          Restablecer filtros
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initCollectionCatalogs } from '@scripts/commerce/collection-filters';
  initCollectionCatalogs();
</script>

<style>
  .collection-catalog {
    padding-top: var(--kb-space-8);
    padding-bottom: var(--kb-space-section);
    border-top: 1px solid var(--kb-stroke-hairline);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-king-bone) 28%, transparent),
      transparent 12rem
    );
  }

  .collection-catalog__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-7);
    align-items: start;
  }

  .collection-catalog__aside,
  .collection-catalog__results {
    min-width: 0;
  }

  /* ---------- Toolbar ---------- */

  .collection-catalog__toolbar {
    display: grid;
    gap: var(--kb-space-3);
    margin-bottom: var(--kb-space-8);
    padding-bottom: var(--kb-space-6);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .collection-catalog__toolbar-main {
    display: grid;
    gap: var(--kb-space-2);
  }

  .collection-catalog__folio {
    margin: 0;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .collection-catalog__heading {
    margin: 0;
    font-size: clamp(1.75rem, 1.35rem + 1.4vw, 2.5rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-king-text);
    text-wrap: balance;
  }

  .collection-catalog__scope {
    margin: 0;
    max-width: 52ch;
    font-size: var(--kb-text-sm);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* ---------- Grid de productos ---------- */

  .collection-catalog__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--kb-space-8) var(--kb-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-catalog__item {
    min-width: 0;
    content-visibility: auto;
    contain-intrinsic-block-size: auto 32rem;
  }

  .collection-catalog__item[hidden] {
    display: none;
  }

  .collection-catalog__more {
    display: flex;
    justify-content: center;
    padding-top: var(--kb-space-7);
  }

  .collection-catalog__empty {
    padding: var(--kb-space-8) 0;
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .collection-catalog__empty p {
    margin: 0;
  }

  .collection-catalog__empty p + p {
    margin-top: var(--kb-space-2);
  }

  .collection-catalog__empty [data-empty-reset] {
    margin-top: var(--kb-space-4);
  }

  @media (min-width: 40rem) {
    .collection-catalog__grid {
      gap: var(--kb-space-8) var(--kb-space-5);
    }
  }

  @media (min-width: 48rem) {
    .collection-catalog__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- Escritorio ---------- */

  @media (min-width: 64rem) {
    .collection-catalog__layout {
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      gap: clamp(2.5rem, 4vw, 4.5rem);
    }

    .collection-catalog__aside {
      position: sticky;
      top: 7rem;
      align-self: start;
      z-index: calc(var(--kb-z-sticky) - 2);
      padding-right: clamp(1.25rem, 2vw, 2rem);
      border-right: 1px solid var(--kb-stroke-hairline);
    }

    .collection-catalog__grid {
      gap: var(--kb-space-8) var(--kb-space-6);
    }

    .collection-catalog__toolbar {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      align-items: end;
      gap: var(--kb-space-6);
    }

    .collection-catalog__scope {
      justify-self: end;
      text-align: right;
    }
  }

  @media (min-width: 80rem) {
    .collection-catalog__layout {
      grid-template-columns: minmax(0, 20.5rem) minmax(0, 1fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }
</style>
