---
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import type { ProductSummary } from '@commerce/domain/catalog';
import { formatProductColorLabel, formatProductPriceLabel } from '@commerce/domain/product-mappers';
import { resolveColorSwatch } from '@commerce/domain/color-swatch';
import { buildCardSource } from '@shared/image-source';
import { PRODUCT_CARD_SUMMARY_MAX, truncateText } from '@shared/text';

interface Props {
  product: ProductSummary;
  /** Posición en el grid; alimenta el folio numérico. */
  index: number;
  /** `sizes` de la imagen; por defecto, grid de catálogo. */
  sizes?: string;
  /** Prioriza la imagen (LCP en destacados). */
  priority?: boolean;
  class?: string;
}

const MAX_VISIBLE_SWATCHES = 4;

const {
  product,
  index,
  sizes = '(min-width: 64rem) 25vw, (min-width: 48rem) 33vw, 50vw',
  priority = false,
  class: className,
} = Astro.props;

const priceLabel = formatProductPriceLabel(product.priceRange);
const folio = String(index + 1).padStart(2, '0');
const primarySource = product.primaryImage
  ? buildCardSource(product.primaryImage.url, sizes)
  : null;
const summaryLabel = truncateText(product.summary, PRODUCT_CARD_SUMMARY_MAX);
const visibleColors = product.colors.slice(0, MAX_VISIBLE_SWATCHES);
const extraColorCount = Math.max(product.colors.length - visibleColors.length, 0);
const colorNames = formatProductColorLabel(product.colors);
const badgeLabel = product.purchasable ? product.badge : 'Agotado';
---

<a
  href={`/productos/${product.handle}`}
  class:list={['product-card kb-rise-sm', !product.purchasable && 'is-unavailable', className]}
  aria-label={`Ver ${product.title} — ${priceLabel}`}
>
  <div class="product-card__media">
    {product.primaryImage && primarySource ? (
      <img
        src={primarySource.src}
        srcset={primarySource.srcset}
        sizes={primarySource.sizes}
        alt={product.primaryImage.altText}
        width={product.primaryImage.width}
        height={product.primaryImage.height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        style={`object-position: ${product.primaryImage.position ?? 'center'}`}
      />
    ) : (
      <span class="product-card__placeholder" aria-hidden="true" />
    )}

    <div class="product-card__tags">
      {badgeLabel ? (
        <Badge variant="steel">{badgeLabel}</Badge>
      ) : (
        <span aria-hidden="true" />
      )}
      <span class="product-card__folio kb-meta-label" aria-hidden="true">{folio}</span>
    </div>

    <span class="product-card__media-line" aria-hidden="true" />
  </div>

  <div class="product-card__info">
    <p class="product-card__category kb-meta-label">{product.primaryCollection.title}</p>

    <div class="product-card__head">
      <h3 class="product-card__name font-display">{product.title}</h3>
      <p class="product-card__price">{priceLabel}</p>
    </div>

    {visibleColors.length > 0 && (
      <ul class="product-card__swatches" aria-label={`Colores: ${colorNames}`}>
        {visibleColors.map((color) => (
          <li>
            <span
              class="product-card__swatch"
              style={`background: ${resolveColorSwatch(color.label, color.swatch)}`}
            >
              <span class="sr-only">{color.label}</span>
            </span>
          </li>
        ))}
        {extraColorCount > 0 && (
          <li class="product-card__swatch-more kb-code-label" aria-hidden="true">
            +{extraColorCount}
          </li>
        )}
      </ul>
    )}

    <p class="product-card__excerpt text-king-muted">{summaryLabel}</p>

    <span class="product-card__action kb-meta-label">
      Ver
      <Icon name="arrow-right" class="product-card__action-icon h-3 w-3" />
    </span>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* ---------- Media ---------- */

  .product-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-card-radius);
    background: var(--color-king-bone);
    box-shadow:
      var(--kb-shadow-xs),
      inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    isolation: isolate;
    transition:
      border-color var(--kb-dur-med) var(--kb-ease-out),
      box-shadow var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__media::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 34%;
    background: linear-gradient(
      to bottom,
      rgba(13, 13, 12, 0.3),
      rgba(13, 13, 12, 0.08) 58%,
      transparent
    );
    pointer-events: none;
  }

  .product-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.91) contrast(1.03);
    transform: translateZ(0);
    transition:
      transform var(--kb-dur-slow) var(--kb-ease-soft),
      filter var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-king-bone);
  }

  .product-card.is-unavailable .product-card__media img {
    opacity: 0.78;
    filter: saturate(0.62) contrast(1.02);
  }

  .product-card__tags {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-2);
    padding: var(--kb-space-3);
    pointer-events: none;
  }

  .product-card__folio {
    color: var(--color-king-bone);
    text-shadow: 0 1px 10px rgba(13, 13, 12, 0.5);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.14em;
    opacity: 0.92;
  }

  .product-card__media-line {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-brass) 68%, transparent) 55%,
      transparent
    );
    transform: scaleX(0.16);
    transform-origin: left center;
    pointer-events: none;
    transition: transform var(--kb-dur-med) var(--kb-ease-out);
  }

  /* ---------- Información ---------- */

  .product-card__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--kb-space-3);
    min-width: 0;
    padding-top: var(--kb-space-5);
  }

  .product-card__category {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    margin: 0;
    padding: 0.28rem 0.5rem;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    background: color-mix(in srgb, var(--color-king-bone) 70%, transparent);
    color: var(--color-king-muted);
    letter-spacing: 0.16em;
    line-height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition:
      border-color var(--kb-dur-med) var(--kb-ease-out),
      color var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__head {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }

  .product-card__name {
    margin: 0;
    min-width: 0;
    font-size: clamp(1.1875rem, 1.05rem + 0.7vw, 1.625rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--color-king-text);
    transition: color var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__price {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--kb-text-body-lg);
    font-weight: var(--kb-w-semibold);
    line-height: 1.2;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-king-text) 86%, var(--color-king-muted));
  }

  .product-card__swatches {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-card__swatch {
    display: block;
    width: 0.8125rem;
    height: 0.8125rem;
    border: 1px solid color-mix(in srgb, var(--color-king-text) 16%, transparent);
    border-radius: var(--kb-radius-pill);
    box-shadow:
      0 0 0 1px var(--color-king-bg),
      inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }

  .product-card__swatch-more {
    margin-left: 0.125rem;
    color: var(--color-king-muted);
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .product-card__excerpt {
    margin: 0;
    max-width: 34ch;
    font-size: var(--kb-text-sm);
    line-height: 1.52;
    text-wrap: pretty;
    color: color-mix(in srgb, var(--color-king-muted) 92%, var(--color-king-text));
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .product-card__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--kb-space-2);
    width: 100%;
    min-height: 2.25rem;
    margin-top: auto;
    padding: 0.5rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-king-text) 20%, transparent);
    border-radius: var(--kb-btn-radius);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-king-text);
    background: transparent;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      color var(--kb-dur-med) var(--kb-ease-out),
      background-color var(--kb-dur-med) var(--kb-ease-out),
      border-color var(--kb-dur-med) var(--kb-ease-out),
      box-shadow var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__action-icon {
    transition: transform var(--kb-dur-fast) var(--kb-ease-out);
  }

  /* ---------- Responsive ---------- */

  @media (min-width: 40rem) {
    .product-card__info {
      padding-top: var(--kb-space-6);
    }

    .product-card__action {
      min-height: 2.375rem;
    }
  }

  @media (max-width: 39.99rem) {
    .product-card__excerpt {
      display: none;
    }
  }

  /* ---------- Hover / focus ---------- */

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .product-card__media {
      border-color: var(--kb-stroke-accent);
      box-shadow:
        var(--kb-shadow-md),
        inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    }

    .product-card:hover .product-card__media img {
      transform: scale(1.04);
      filter: saturate(0.95) contrast(1.04);
    }

    .product-card:hover .product-card__media-line {
      transform: scaleX(1);
    }

    .product-card:hover .product-card__name {
      color: var(--color-king-accent);
    }

    .product-card:hover .product-card__category {
      border-color: color-mix(in srgb, var(--color-king-accent) 28%, var(--kb-stroke-hairline));
      color: var(--color-king-text);
    }

    .product-card:hover .product-card__action {
      color: var(--color-king-bone);
      background: var(--color-king-text);
      border-color: var(--color-king-text);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    }

    .product-card:hover .product-card__action-icon {
      transform: translateX(2px);
    }
  }

  .product-card:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 4px;
    border-radius: var(--kb-card-radius);
  }

  .product-card:focus-visible .product-card__media {
    border-color: var(--kb-stroke-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__media,
    .product-card__media img,
    .product-card__media-line,
    .product-card__name,
    .product-card__category,
    .product-card__action,
    .product-card__action-icon {
      transition: none;
    }

    .product-card__media img {
      transform: none;
    }

    .product-card__media-line {
      transform: scaleX(1);
    }
  }
</style>
