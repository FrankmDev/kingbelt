---
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { formatPrice, type ProductPreview } from '../../data/catalog';

interface Props {
  product: ProductPreview;
  /** Posición en el grid; alimenta el folio numérico. */
  index: number;
  /** Metadata bajo la imagen; por defecto `categoría · color`. */
  meta?: string;
  class?: string;
}

const { product, index, meta, class: className } = Astro.props;

const priceLabel = formatPrice(product.price, product.currency);
const ref = product.id.toUpperCase();
const metaLabel = meta ?? `${product.category} · ${product.color}`;
const folio = String(index + 1).padStart(2, '0');
---

<a
  href={product.href}
  class:list={['product-card kb-rise-sm', className]}
  aria-label={`Ver ${product.name} — ${priceLabel}`}
>
  <div class="product-card__media">
    <img
      src={product.image}
      alt={product.imageAlt}
      width="480"
      height="600"
      loading="lazy"
      decoding="async"
      style={`object-position: ${product.imagePosition ?? 'center'}`}
    />

    <div class="product-card__tags">
      {product.badge ? (
        <Badge variant="steel">{product.badge}</Badge>
      ) : (
        <span aria-hidden="true" />
      )}
      <span class="product-card__folio kb-meta-label" aria-hidden="true">{folio}</span>
    </div>

    <div class="product-card__overlay" aria-hidden="true">
      <span class="product-card__cta">
        Ver referencia
        <Icon name="arrow-right" class="product-card__cta-icon h-3 w-3" />
      </span>
    </div>

    <span class="product-card__media-line" aria-hidden="true" />
  </div>

  <div class="product-card__info">
    <p class="product-card__meta kb-meta-label text-king-muted">{metaLabel}</p>
    <h3 class="product-card__name font-display">{product.name}</h3>
    <p class="product-card__excerpt text-king-muted">{product.excerpt}</p>

    <div class="product-card__stitch kb-stitch-line" aria-hidden="true" />

    <div class="product-card__foot">
      <span class="product-card__price">{priceLabel}</span>
      <span class="product-card__ref kb-code-label text-king-muted">{ref}</span>
    </div>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* ---------- Media ---------- */

  .product-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    background: var(--color-king-bone);
    transition: border-color var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__media::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 34%;
    background: linear-gradient(
      to bottom,
      rgba(13, 13, 12, 0.34),
      rgba(13, 13, 12, 0.08) 58%,
      transparent
    );
    pointer-events: none;
  }

  .product-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.03);
    transform: translateZ(0);
    transition: transform var(--kb-dur-slow) var(--kb-ease-soft);
    will-change: transform;
  }

  .product-card__tags {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-2);
    padding: var(--kb-space-3);
    pointer-events: none;
  }

  .product-card__folio {
    color: var(--color-king-bone);
    text-shadow: 0 1px 8px rgba(13, 13, 12, 0.55);
    font-variant-numeric: tabular-nums;
  }

  .product-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--kb-space-4);
    background: linear-gradient(
      to top,
      rgba(13, 13, 12, 0.52),
      rgba(13, 13, 12, 0.12) 48%,
      transparent
    );
    opacity: 0;
    transition: opacity var(--kb-dur-med) var(--kb-ease-out);
    pointer-events: none;
  }

  .product-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-2);
    padding: var(--kb-space-2) var(--kb-space-4);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--kb-radius-pill);
    background: rgba(13, 13, 12, 0.42);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: var(--kb-text-xs);
    font-weight: var(--kb-w-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-king-bone);
    transform: translateY(0.35rem);
    transition: transform var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__cta-icon {
    transition: transform var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-card__media-line {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-brass) 70%, transparent) 60%,
      transparent
    );
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
    transition: transform var(--kb-dur-med) var(--kb-ease-out);
  }

  /* ---------- Información ---------- */

  .product-card__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding-top: var(--kb-space-4);
  }

  .product-card__meta {
    margin: 0 0 var(--kb-space-2);
  }

  .product-card__name {
    margin: 0 0 var(--kb-space-2);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.06;
    letter-spacing: -0.018em;
    text-wrap: balance;
    color: var(--color-king-text);
    transition: color var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__excerpt {
    margin: 0 0 var(--kb-space-4);
    font-size: var(--kb-text-sm);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .product-card__stitch {
    width: 100%;
    height: 1px;
    margin: auto 0 var(--kb-space-3);
  }

  .product-card__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--kb-space-3);
  }

  .product-card__price {
    font-family: var(--font-sans);
    font-size: var(--kb-text-body-lg);
    font-weight: var(--kb-w-semibold);
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--color-king-text);
  }

  /* ---------- Responsive ---------- */

  @media (min-width: 40rem) {
    .product-card__info {
      padding-top: var(--kb-space-5);
    }
  }

  @media (max-width: 47.99rem) {
    .product-card__excerpt {
      display: none;
    }
  }

  /* ---------- Hover / focus ---------- */

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .product-card__media {
      border-color: var(--kb-stroke-accent);
    }

    .product-card:hover .product-card__media img {
      transform: scale(1.05);
    }

    .product-card:hover .product-card__overlay {
      opacity: 1;
    }

    .product-card:hover .product-card__cta {
      transform: translateY(0);
    }

    .product-card:hover .product-card__cta-icon {
      transform: translateX(2px);
    }

    .product-card:hover .product-card__media-line {
      transform: scaleX(1);
    }

    .product-card:hover .product-card__name {
      color: var(--color-king-accent);
    }
  }

  .product-card:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 4px;
    border-radius: var(--kb-radius-xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__media,
    .product-card__media img,
    .product-card__overlay,
    .product-card__cta,
    .product-card__cta-icon,
    .product-card__media-line,
    .product-card__name {
      transition: none;
    }

    .product-card__overlay {
      opacity: 1;
    }

    .product-card__cta {
      transform: none;
    }
  }
</style>
