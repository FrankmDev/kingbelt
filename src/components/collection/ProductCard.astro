---
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { formatMoney } from '@commerce/domain/money';
import type { ProductSummary } from '@commerce/domain/catalog';
import { buildCardSource } from '@shared/image-source';

interface Props {
  product: ProductSummary;
  /** Posición en el grid; alimenta el folio numérico. */
  index: number;
  /** Metadata bajo la imagen; por defecto `categoría · color`. */
  meta?: string;
  class?: string;
}

const { product, index, meta, class: className } = Astro.props;

const hasPriceRange = product.priceRange.min.amountMinor !== product.priceRange.max.amountMinor;
const priceLabel = hasPriceRange
  ? `Desde ${formatMoney(product.priceRange.min)}`
  : formatMoney(product.priceRange.min);
const colorLabel = product.colors.length === 1
  ? product.colors[0].label
  : `${product.colors.length} colores`;
const metaLabel = meta ?? `${product.primaryCollection.title} · ${colorLabel}`;
const folio = String(index + 1).padStart(2, '0');
const cardSizes = '(min-width: 64rem) 25vw, (min-width: 40rem) 33vw, 50vw';
const primarySource = product.primaryImage
  ? buildCardSource(product.primaryImage.url, cardSizes)
  : null;
---

<a
  href={`/productos/${product.handle}`}
  class:list={['product-card kb-rise-sm', !product.purchasable && 'is-unavailable', className]}
  aria-label={`Ver ${product.title} — ${priceLabel}`}
>
  <div class="product-card__media">
    {product.primaryImage && primarySource ? (
      <img
        src={primarySource.src}
        srcset={primarySource.srcset}
        sizes={primarySource.sizes}
        alt={product.primaryImage.altText}
        width={product.primaryImage.width}
        height={product.primaryImage.height}
        loading="lazy"
        decoding="async"
        style={`object-position: ${product.primaryImage.position ?? 'center'}`}
      />
    ) : (
      <span class="product-card__placeholder" aria-hidden="true" />
    )}

    <div class="product-card__tags">
      {product.badge || !product.purchasable ? (
        <Badge variant="steel">{product.purchasable ? product.badge : 'Agotado'}</Badge>
      ) : (
        <span aria-hidden="true" />
      )}
      <span class="product-card__folio kb-meta-label" aria-hidden="true">{folio}</span>
    </div>

    <div class="product-card__overlay" aria-hidden="true">
      <span class="product-card__cta">
        Ver referencia
        <Icon name="arrow-right" class="product-card__cta-icon h-3 w-3" />
      </span>
    </div>

    <span class="product-card__media-line" aria-hidden="true" />
  </div>

  <div class="product-card__info">
    <p class="product-card__meta kb-meta-label text-king-muted">{metaLabel}</p>
    <h3 class="product-card__name font-display">{product.title}</h3>

    <p class="product-card__excerpt text-king-muted">{product.summary}</p>

    <div class="product-card__stitch kb-stitch-line" aria-hidden="true" />

    <div class="product-card__foot">
      <span class="product-card__price font-display">{priceLabel}</span>
      <span class="product-card__ref kb-code-label text-king-muted">{product.reference}</span>
    </div>
  </div>
</a>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* ---------- Media ---------- */

  .product-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-sm);
    background: var(--color-king-bone);
    transition: border-color var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__media::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 34%;
    background: linear-gradient(
      to bottom,
      rgba(13, 13, 12, 0.34),
      rgba(13, 13, 12, 0.08) 58%,
      transparent
    );
    pointer-events: none;
  }

  .product-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    filter: saturate(0.92) contrast(1.03);
    transform: translateZ(0);
    transition: transform var(--kb-dur-slow) var(--kb-ease-soft);
    will-change: transform;
  }

  .product-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-king-bone);
  }

  .product-card.is-unavailable .product-card__media img {
    opacity: 0.72;
  }

  .product-card__tags {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-2);
    padding: var(--kb-space-3);
    pointer-events: none;
  }

  .product-card__folio {
    color: var(--color-king-bone);
    text-shadow: 0 1px 8px rgba(13, 13, 12, 0.55);
    font-variant-numeric: tabular-nums;
  }

  .product-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: var(--kb-space-4);
    background: linear-gradient(
      to top,
      rgba(13, 13, 12, 0.52),
      rgba(13, 13, 12, 0.12) 48%,
      transparent
    );
    opacity: 0;
    transition: opacity var(--kb-dur-med) var(--kb-ease-out);
    pointer-events: none;
  }

  .product-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-2);
    padding: var(--kb-space-2) var(--kb-space-4);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--kb-radius-pill);
    background: rgba(13, 13, 12, 0.42);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: var(--kb-text-xs);
    font-weight: var(--kb-w-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-king-bone);
    transform: translateY(0.35rem);
    transition: transform var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__cta-icon {
    transition: transform var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-card__media-line {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-brass) 70%, transparent) 60%,
      transparent
    );
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
    transition: transform var(--kb-dur-med) var(--kb-ease-out);
  }

  /* ---------- Información ---------- */

  .product-card__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--kb-space-2);
    min-width: 0;
    padding-top: var(--kb-space-4);
  }

  .product-card__meta {
    margin: 0;
    letter-spacing: 0.17em;
  }

  .product-card__name {
    margin: 0;
    font-size: clamp(1.0625rem, 0.98rem + 0.45vw, 1.4375rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--color-king-text);
    transition: color var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__excerpt {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.52;
    color: color-mix(in srgb, var(--color-king-muted) 92%, var(--color-king-text));
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .product-card__stitch {
    width: 2.75rem;
    height: 1px;
    margin: var(--kb-space-2) 0 var(--kb-space-1);
  }

  .product-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-3);
    margin-top: auto;
    padding-top: var(--kb-space-1);
  }

  .product-card__price {
    font-size: clamp(1.1875rem, 1.05rem + 0.35vw, 1.375rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1;
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
    color: var(--color-king-text);
    transition: color var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-card__ref {
    font-size: var(--kb-text-xs);
    letter-spacing: 0.12em;
    opacity: 0.72;
    transition: opacity var(--kb-dur-fast) var(--kb-ease-out);
  }

  /* ---------- Responsive ---------- */

  @media (min-width: 40rem) {
    .product-card__info {
      padding-top: var(--kb-space-5);
      gap: var(--kb-space-3);
    }

    .product-card__stitch {
      margin: var(--kb-space-3) 0 var(--kb-space-2);
    }
  }

  @media (max-width: 47.99rem) {
    .product-card__excerpt {
      display: none;
    }

    .product-card__info {
      gap: var(--kb-space-1);
    }

    .product-card__stitch {
      margin-top: var(--kb-space-1);
    }
  }

  /* ---------- Hover / focus ---------- */

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .product-card__media {
      border-color: var(--kb-stroke-accent);
    }

    .product-card:hover .product-card__media img {
      transform: scale(1.05);
    }

    .product-card:hover .product-card__overlay {
      opacity: 1;
    }

    .product-card:hover .product-card__cta {
      transform: translateY(0);
    }

    .product-card:hover .product-card__cta-icon {
      transform: translateX(2px);
    }

    .product-card:hover .product-card__media-line {
      transform: scaleX(1);
    }

    .product-card:hover .product-card__name {
      color: var(--color-king-accent);
    }

    .product-card:hover .product-card__ref {
      opacity: 1;
    }
  }

  .product-card:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 4px;
    border-radius: var(--kb-radius-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__media,
    .product-card__media img,
    .product-card__overlay,
    .product-card__cta,
    .product-card__cta-icon,
    .product-card__media-line,
    .product-card__name,
    .product-card__price,
    .product-card__ref {
      transition: none;
    }

    .product-card__overlay {
      opacity: 1;
    }

    .product-card__cta {
      transform: none;
    }
  }
</style>
