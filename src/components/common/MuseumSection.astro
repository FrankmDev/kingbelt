---
import SectionHeader from './SectionHeader.astro';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  tone?: 'light' | 'alt';
}

const { id, title, subtitle, tone = 'light' } = Astro.props;
---

<section
  id={id}
  class:list={[
    'relative py-14 md:py-18 lg:py-22',
    tone === 'alt' ? 'section-garage' : 'bg-king-bg',
  ]}
>
  <div class="kb-shell-wide">
    <SectionHeader
      eyebrow={subtitle}
      align="left"
      tone="light"
      class="mb-8 md:mb-10"
    >
      <Fragment slot="title">
        {title}
      </Fragment>
    </SectionHeader>

    <slot />
  </div>
</section>
