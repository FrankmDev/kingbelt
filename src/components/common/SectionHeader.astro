---
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  meta?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  title,
  body,
  meta,
  align = 'left',
  tone = 'light',
  class: className = '',
} = Astro.props;

const hasTitle = Boolean(title || Astro.slots.has('title'));
const hasCopy = Boolean(body || meta);
---

<header
  class:list={['section-header', className]}
  data-align={align}
  data-tone={tone}
  aria-label={eyebrow}
>
  <div class="sh-rule" aria-hidden="true"></div>

  {(eyebrow || meta) && (
    <div class="sh-meta-row">
      {eyebrow && <p class="sh-eyebrow">{eyebrow}</p>}
      {meta && <p class="sh-meta">{meta}</p>}
    </div>
  )}

  <div class:list={['sh-content', hasCopy && 'has-copy']}>
    {hasTitle && (
      <h2 class="sh-title">
        {Astro.slots.has('title') ? <slot name="title" /> : title}
      </h2>
    )}

    {hasCopy && (
      <div class="sh-copy">
        {body && <p>{body}</p>}
        {meta && <p class="sh-meta-mobile">{meta}</p>}
      </div>
    )}
  </div>
</header>

<style>
  .section-header {
    --sh-ink: var(--color-king-text);
    --sh-muted: rgba(26, 26, 26, 0.62);
    --sh-line: rgba(26, 26, 26, 0.1);
    --sh-accent: var(--color-king-accent);

    width: 100%;
    color: var(--sh-ink);
  }

  .section-header[data-tone='dark'] {
    --sh-ink: rgba(255, 250, 241, 0.96);
    --sh-muted: rgba(255, 250, 241, 0.64);
    --sh-line: rgba(255, 255, 255, 0.12);
    --sh-accent: #d6b16e;
  }

  .section-header[data-align='center'] {
    margin-inline: auto;
    text-align: center;
  }

  .sh-rule {
    position: relative;
    height: 1px;
    margin-bottom: clamp(0.95rem, 1.8vw, 1.35rem);
    background: var(--sh-line);
  }

  .sh-rule::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: clamp(4.5rem, 12vw, 9rem);
    background: linear-gradient(90deg, var(--sh-accent), transparent);
  }

  .section-header[data-align='center'] .sh-rule::before {
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, var(--sh-accent), transparent);
  }

  .sh-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .section-header[data-align='center'] .sh-meta-row {
    justify-content: center;
  }

  .sh-eyebrow,
  .sh-meta,
  .sh-meta-mobile {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--kb-label-size);
    font-weight: 700;
    letter-spacing: var(--kb-label-tracking);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .sh-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--sh-accent);
  }

  .sh-eyebrow::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border: 1px solid currentColor;
    background: color-mix(in srgb, currentColor 16%, transparent);
    transform: rotate(45deg);
  }

  .sh-meta {
    color: color-mix(in srgb, var(--sh-ink) 38%, transparent);
    white-space: nowrap;
  }

  .sh-content {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(17rem, 0.72fr);
    align-items: end;
    gap: clamp(1.25rem, 3.2vw, 3.2rem);
  }

  .sh-content:not(.has-copy),
  .section-header[data-align='center'] .sh-content {
    display: block;
  }

  .sh-title {
    max-width: 12.5ch;
    margin: 0;
    color: var(--sh-ink);
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 6.4vw, 4.6rem);
    font-weight: 300;
    letter-spacing: var(--kb-title-tracking);
    line-height: 0.9;
    text-wrap: balance;
  }

  .section-header[data-align='center'] .sh-title {
    max-width: 14ch;
    margin-inline: auto;
  }

  .sh-title :global(em) {
    color: var(--sh-accent);
    font-style: italic;
  }

  .sh-copy {
    position: relative;
    max-width: 34rem;
    padding-top: 0.95rem;
    color: var(--sh-muted);
    font-size: clamp(0.94rem, 0.9rem + 0.22vw, 1.06rem);
    font-weight: 350;
    letter-spacing: 0.01em;
    line-height: 1.78;
  }

  .sh-copy::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 2.75rem;
    height: 1px;
    background: var(--sh-accent);
    opacity: 0.45;
  }

  .section-header[data-align='center'] .sh-copy {
    width: min(100%, 42rem);
    margin: clamp(1.2rem, 2.6vw, 1.8rem) auto 0;
  }

  .section-header[data-align='center'] .sh-copy::before {
    left: 50%;
    transform: translateX(-50%);
    width: 4.5rem;
  }

  .sh-copy p {
    margin: 0;
  }

  .sh-meta-mobile {
    display: none;
    margin-top: 0.85rem;
    color: color-mix(in srgb, var(--sh-ink) 38%, transparent);
  }

  @media (max-width: 900px) {
    .sh-content {
      display: block;
    }

    .sh-copy {
      width: min(100%, 40rem);
      margin-top: clamp(1.15rem, 3vw, 1.6rem);
    }
  }

  @media (max-width: 640px) {
    .sh-rule {
      margin-bottom: 0.9rem;
    }

    .sh-meta-row {
      align-items: flex-start;
      margin-bottom: 1rem;
    }

    .sh-meta {
      display: none;
    }

    .sh-meta-mobile {
      display: block;
    }

    .sh-eyebrow,
    .sh-meta-mobile {
      font-size: 0.5rem;
      letter-spacing: 0.3em;
    }

    .sh-title {
      max-width: 12.5ch;
      font-size: clamp(2.35rem, 12vw, 3.4rem);
      line-height: 0.92;
    }
  }
</style>
