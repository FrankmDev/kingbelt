---
/** Diagrama conceptual accesible de medición de cinturón. Sin dimensiones comerciales. */
---

<figure class="belt-diagram" role="img" aria-labelledby="belt-diagram-title belt-diagram-desc">
  <figcaption class="belt-diagram__caption">
    <span id="belt-diagram-title" class="belt-diagram__title">Diagrama de medición conceptual</span>
    <span id="belt-diagram-desc" class="belt-diagram__desc">
      Cinturón extendido mostrando hebilla, punto de inicio de medición, agujero de referencia y dirección de la cinta métrica.
      Las medidas definitivas dependen del modelo.
    </span>
  </figcaption>

  <svg
    class="belt-diagram__svg"
    viewBox="0 0 720 200"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <pattern id="belt-texture" patternUnits="userSpaceOnUse" width="8" height="8">
        <rect width="8" height="8" fill="#c4a882" />
        <path d="M0 4h8M4 0v8" stroke="#b89972" stroke-width="0.3" opacity="0.4" />
      </pattern>
      <marker id="arrowhead" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
        <polygon points="0 0, 8 3, 0 6" fill="#8a5a2b" />
      </marker>
    </defs>

    {/* Hebilla */}
    <rect x="40" y="70" width="48" height="60" rx="4" fill="#6b6b6b" stroke="#4a4a4a" stroke-width="1.5" />
    <rect x="52" y="82" width="24" height="36" rx="2" fill="#8a8a8a" stroke="#5a5a5a" stroke-width="1" />
    <text x="64" y="135" text-anchor="middle" font-size="11" fill="#5a4a3a" font-family="system-ui, sans-serif">Hebilla</text>

    {/* Correa */}
    <rect x="88" y="88" width="520" height="24" rx="2" fill="url(#belt-texture)" stroke="#a08060" stroke-width="1" />

    {/* Agujeros */}
    {[180, 240, 300, 360, 420, 480, 540].map((cx) => (
      <circle cx={cx} cy="100" r="5" fill="#9a7a5a" stroke="#7a6048" stroke-width="1" />
    ))}

    {/* Agujero activo */}
    <circle cx="300" cy="100" r="7" fill="none" stroke="#8a5a2b" stroke-width="2" />
    <text x="300" y="155" text-anchor="middle" font-size="10" fill="#8a5a2b" font-family="system-ui, sans-serif">Agujero de referencia</text>

    {/* Punto inicio */}
    <line x1="88" y1="100" x2="88" y2="60" stroke="#8a5a2b" stroke-width="1.5" stroke-dasharray="4 3" />
    <circle cx="88" cy="60" r="4" fill="#8a5a2b" />
    <text x="88" y="50" text-anchor="middle" font-size="10" fill="#5a4a3a" font-family="system-ui, sans-serif">Inicio</text>

    {/* Línea de medición */}
    <line x1="88" y1="170" x2="300" y2="170" stroke="#8a5a2b" stroke-width="2" marker-end="url(#arrowhead)" />
    <line x1="88" y1="165" x2="88" y2="175" stroke="#8a5a2b" stroke-width="1.5" />
    <line x1="300" y1="165" x2="300" y2="175" stroke="#8a5a2b" stroke-width="1.5" />
    <text x="194" y="190" text-anchor="middle" font-size="11" fill="#5a4a3a" font-family="system-ui, sans-serif">Medida de referencia (cm)</text>

    {/* Extremo */}
    <path d="M608 88 L628 100 L608 112 Z" fill="#a08060" stroke="#8a6048" stroke-width="1" />
    <text x="620" y="135" text-anchor="middle" font-size="10" fill="#5a4a3a" font-family="system-ui, sans-serif">Punta</text>
  </svg>

  <ul class="belt-diagram__legend">
    <li><span class="belt-diagram__swatch belt-diagram__swatch--buckle" aria-hidden="true"></span> Hebilla</li>
    <li><span class="belt-diagram__swatch belt-diagram__swatch--start" aria-hidden="true"></span> Punto de inicio de medición</li>
    <li><span class="belt-diagram__swatch belt-diagram__swatch--hole" aria-hidden="true"></span> Agujero de referencia</li>
    <li><span class="belt-diagram__swatch belt-diagram__swatch--measure" aria-hidden="true"></span> Dirección de la medida</li>
  </ul>
</figure>

<style>
  .belt-diagram {
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--color-king-surface);
    color: var(--color-king-text);
  }

  .belt-diagram__caption {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .belt-diagram__title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    font-weight: var(--kb-w-medium);
    color: var(--color-king-text);
  }

  .belt-diagram__desc {
    font-size: var(--kb-text-2xs);
    line-height: 1.55;
    color: var(--color-king-muted);
    max-width: 58ch;
  }

  .belt-diagram__svg {
    width: 100%;
    height: auto;
    max-height: 12rem;
    display: block;
  }

  .belt-diagram__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-size: var(--kb-text-2xs);
    color: var(--color-king-muted);
  }

  .belt-diagram__legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .belt-diagram__swatch {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 1px;
    flex-shrink: 0;
  }

  .belt-diagram__swatch--buckle {
    background: #6b6b6b;
  }

  .belt-diagram__swatch--start {
    background: #8a5a2b;
    border-radius: 50%;
  }

  .belt-diagram__swatch--hole {
    background: transparent;
    border: 2px solid #8a5a2b;
    border-radius: 50%;
  }

  .belt-diagram__swatch--measure {
    background: #8a5a2b;
    width: 1rem;
    height: 2px;
  }
</style>
