---
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icon-paths';

interface Props {
  title: string;
  description: string;
  href: string;
  priority: 'primary' | 'secondary';
  icon?: IconName;
  class?: string;
}

const { title, description, href, priority, icon, class: className } = Astro.props;
---

<a href={href} class:list={['help-card', `help-card--${priority}`, className]}>
  <div class="help-card__head">
    {icon && (
      <span class="help-card__icon" aria-hidden="true">
        <Icon name={icon} class="h-4 w-4" strokeWidth={1.5} />
      </span>
    )}
    <h2 class="help-card__title">{title}</h2>
  </div>
  <p class="help-card__desc">{description}</p>
  <span class="help-card__action kb-action-label">Consultar</span>
</a>

<style>
  .help-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    text-decoration: none;
    color: inherit;
    border-radius: var(--kb-panel-radius);
    border: 1px solid var(--kb-stroke-hairline);
    background: var(--color-king-surface);
    transition:
      border-color var(--kb-dur-med) var(--kb-ease-out),
      box-shadow var(--kb-dur-med) var(--kb-ease-out),
      transform var(--kb-dur-med) var(--kb-ease-out);
  }

  .help-card--primary {
    grid-column: span 1;
  }

  .help-card--secondary {
    background: transparent;
  }

  .help-card:hover {
    border-color: rgba(138, 90, 43, 0.35);
    box-shadow: var(--kb-shadow-sm);
    transform: translateY(-2px);
  }

  .help-card:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 2px;
  }

  .help-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .help-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: var(--kb-radius-xs);
    border: 1px solid var(--kb-stroke-hairline);
    color: var(--color-king-accent);
    background: rgba(138, 90, 43, 0.06);
  }

  .help-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: var(--kb-w-medium);
    line-height: 1.2;
    color: var(--color-king-text);
    margin: 0;
  }

  .help-card--primary .help-card__title {
    font-size: clamp(1.35rem, 2.5vw, 1.65rem);
  }

  .help-card__desc {
    font-size: var(--kb-text-xs);
    line-height: 1.65;
    color: var(--color-king-muted);
    margin: 0;
    flex: 1;
  }

  .help-card__action {
    color: var(--color-king-accent);
    margin-top: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .help-card:hover {
      transform: none;
    }
  }
</style>
