---
import Panel from '../ui/Panel.astro';

interface Method {
  id: string;
  title: string;
  steps: readonly string[];
}

interface Props {
  methods: readonly Method[];
}

const { methods } = Astro.props;
---

<div class="size-steps">
  {methods.map((method, index) => (
    <article class="size-steps__item" aria-labelledby={`method-${method.id}`}>
      <Panel padding="lg" class="size-steps__panel">
        <p class="size-steps__index kb-meta-label" aria-hidden="true">
          Método {String(index + 1).padStart(2, '0')}
        </p>
        <h3 id={`method-${method.id}`} class="size-steps__title">{method.title}</h3>
        <ol class="size-steps__list">
          {method.steps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </Panel>
    </article>
  ))}
</div>

<style>
  .size-steps {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 48rem) {
    .size-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .size-steps__index {
    margin: 0 0 0.5rem;
    color: var(--color-king-accent);
  }

  .size-steps__title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: var(--kb-w-medium);
    color: var(--color-king-text);
    margin: 0 0 1rem;
    line-height: 1.25;
  }

  .size-steps__list {
    margin: 0;
    padding-inline-start: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .size-steps__list li {
    font-size: var(--kb-text-xs);
    line-height: 1.65;
    color: var(--color-king-muted);
  }

  .size-steps__list li::marker {
    color: var(--color-king-accent);
    font-weight: 600;
  }
</style>
