---
interface Method {
  id: string;
  title: string;
  steps: readonly string[];
}

interface Props {
  methods: readonly Method[];
}

const { methods } = Astro.props;
---

<div class="size-steps">
  {methods.map((method, index) => (
    <article class="size-steps__item" aria-labelledby={`method-${method.id}`}>
      <p class="size-steps__index kb-folio" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </p>
      <h3 id={`method-${method.id}`} class="size-steps__title">{method.title}</h3>
      <ol class="size-steps__list">
        {method.steps.map((step, stepIndex) => (
          <li>
            <span class="size-steps__num" aria-hidden="true">
              {String(stepIndex + 1).padStart(2, '0')}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </article>
  ))}
</div>

<style>
  .size-steps {
    display: grid;
    gap: var(--kb-space-gap);
  }

  @media (min-width: 48rem) {
    .size-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .size-steps__item {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    min-width: 0;
    padding: var(--kb-space-6);
    background: var(--color-king-surface);
    border-top: 3px solid var(--color-king-accent);
  }

  .size-steps__item:first-child {
    background: var(--color-king-graphite);
    border-top-color: var(--color-king-accent-light);
  }

  .size-steps__index {
    margin: 0;
    color: var(--color-king-accent);
    opacity: 0.7;
  }

  .size-steps__item:first-child .size-steps__index {
    color: var(--color-king-accent-light);
  }

  .size-steps__title {
    font-family: var(--font-display);
    font-size: var(--kb-text-h4);
    font-weight: var(--kb-w-medium);
    color: var(--color-king-text);
    margin: 0;
    line-height: 1.2;
    text-wrap: balance;
  }

  .size-steps__item:first-child .size-steps__title {
    color: rgba(255, 255, 255, 0.94);
  }

  .size-steps__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .size-steps__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--kb-space-3);
    padding-block: var(--kb-space-3);
    border-top: 1px solid var(--kb-stroke-hairline);
    font-size: var(--kb-text-sm);
    line-height: 1.65;
    color: var(--color-king-muted);
  }

  .size-steps__item:first-child .size-steps__list li {
    border-top-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.62);
  }

  .size-steps__num {
    font-variant-numeric: tabular-nums;
    font-size: var(--kb-text-2xs);
    letter-spacing: 0.06em;
    color: var(--color-king-accent);
  }

  .size-steps__item:first-child .size-steps__num {
    color: var(--color-king-accent-light);
  }
</style>
