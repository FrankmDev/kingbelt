---
interface SizeRow {
  size: string;
  waistCm?: string;
  beltLengthCm?: string;
  notes?: string;
}

interface Props {
  rows?: readonly SizeRow[];
  caption?: string;
}

const { rows = [], caption = 'Equivalencias de tallaje KingBelt' } = Astro.props;
const hasData = rows.length > 0;
---

<div class="size-table">
  {hasData ? (
    <div class="size-table__wrap">
      <table class="size-table__table">
        <caption class="sr-only">{caption}</caption>
        <thead>
          <tr>
            <th scope="col">Talla</th>
            <th scope="col">Cintura (cm)</th>
            <th scope="col">Longitud (cm)</th>
            <th scope="col">Notas</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row">{row.size}</th>
              <td>{row.waistCm ?? '—'}</td>
              <td>{row.beltLengthCm ?? '—'}</td>
              <td>{row.notes ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <aside class="kb-reading-panel size-table__pending">
      <header class="kb-reading-panel__head">
        <div class="kb-reading-panel__head-bar">
          <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">Pendiente</p>
          <span class="kb-reading-panel__folio kb-meta-label" aria-hidden="true">—</span>
        </div>
        <p class="kb-reading-panel__statement">Equivalencias por modelo</p>
      </header>
      <p class="kb-reading-panel__text size-table__pending-text">
        Las tablas de tallaje se publicarán para cada referencia cuando las medidas estén confirmadas.
        Mientras tanto, utiliza los métodos de medición de esta guía y consulta la ficha del producto o escríbenos antes de comprar.
      </p>
    </aside>
  )}
</div>

<style>
  .size-table__wrap {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .size-table__table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: var(--kb-text-xs);
  }

  .size-table__table th,
  .size-table__table td {
    padding: 0.95rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .size-table__table thead th {
    font-size: var(--kb-text-2xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-king-muted);
    background: var(--color-king-bg);
  }

  .size-table__table tbody th {
    font-family: var(--font-display);
    font-weight: var(--kb-w-medium);
    color: var(--color-king-text);
  }

  .size-table__table tbody td {
    color: var(--color-king-muted);
  }

  .size-table__table tbody tr:last-child th,
  .size-table__table tbody tr:last-child td {
    border-bottom: none;
  }

  .size-table__pending-text {
    padding-top: var(--kb-space-4);
    max-width: 58ch;
  }
</style>
