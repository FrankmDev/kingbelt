---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../common/SectionHeader.astro';
import { contactChannels, footerNav, socialLinks } from '../../data/navigation';
import { site } from '../../data/site';

const finalCtas = [{ label: 'La marca', href: '/#marca', external: false }, ...contactChannels] as const;

const workshopSpecs = [
  { num: '01', label: 'Cuero seleccionado' },
  { num: '02', label: 'Herrajes sólidos' },
  { num: '03', label: 'Hecho en España' },
  { num: '04', label: 'Uso diario' },
];
---

<footer id="contacto" class="overflow-x-hidden w-full max-w-full" data-gsap-footer>

  {/* ====================== CTA BANNER ====================== */}
  <section class="cta-shell relative overflow-hidden bg-[#0a0908]" data-cta-section>
    {/* Atmospheric background */}
    <div class="cta-bg pointer-events-none absolute inset-0"></div>
    <div class="cta-glow pointer-events-none absolute left-1/2 top-1/2 h-[45rem] w-[45rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-king-accent/[0.04] blur-[160px]"></div>
    <div class="cta-vignette pointer-events-none absolute inset-0"></div>
    <div class="cta-noise pointer-events-none absolute inset-0"></div>

    {/* Subtle top steel line */}
    <div class="absolute inset-x-8 top-8 h-px bg-gradient-to-r from-transparent via-white/[0.04] to-transparent pointer-events-none md:inset-x-16 lg:inset-x-24"></div>

    {/* Main content */}
    <div class="kb-shell-wide relative z-10 py-28 text-center md:py-36 lg:py-44">

      <SectionHeader
        eyebrow="Hecho en España"
        number="03" numberTotal="03"
        body="Una base de marca sólida, lista para conectar catálogo y compra directa cuando entre Shopify."
        align="center"
        tone="dark"
        class="cta-section-header mx-auto mb-10 max-w-4xl md:mb-14"
      >
        <Fragment slot="title">
          <span class="cta-title-line-1 block">Construido para la ruta.</span>
          <span class="cta-title-line-2 block italic">Hecho <span class="not-italic text-king-accent">para quedarse</span>.</span>
        </Fragment>
      </SectionHeader>

      {/* CTA Buttons */}
      <div class="cta-btn-wrap flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap">
        {finalCtas.map((cta) => (
          <Button
            href={cta.href}
            target={cta.external ? '_blank' : undefined}
            rel={cta.external ? 'noopener noreferrer' : undefined}
            variant={cta.label === 'La marca' ? 'secondary' : 'surfaceOutline'}
            size="md"
          >
            {cta.label}
            {cta.label === 'La marca' && (
              <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" />
            )}
          </Button>
        ))}
      </div>

      {/* Specs strip */}
      <div class="cta-bottom-strip kb-texture-asphalt relative mx-auto mt-16 max-w-xl overflow-hidden border border-white/[0.06] bg-white/[0.03] px-8 py-5 backdrop-blur-sm md:mt-20 md:px-12 md:py-6">
        <div class="relative flex flex-wrap items-center justify-center gap-x-8 gap-y-3 md:gap-x-12">
          {workshopSpecs.map((spec) => (
            <div class="cta-spec-item flex items-center gap-2.5">
              <span class="font-mono text-[11px] tabular-nums text-king-accent/50">{spec.num}</span>
              <span class="text-[10px] font-medium uppercase tracking-[0.18em] text-white/25">{spec.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ====================== ASPHALT DIVIDER ====================== */}
  <div class="relative h-10 overflow-hidden bg-[#14120f] md:h-12">
    <div class="absolute inset-x-8 top-1/2 h-px -translate-y-1/2 bg-gradient-to-r from-transparent via-king-accent/20 to-transparent md:inset-x-16"></div>
  </div>

  {/* ====================== FOOTER BOTTOM ====================== */}
  <div class="footer-shell relative overflow-hidden bg-king-bg" data-footer-bottom>
    {/* Background */}
    <div class="footer-bg pointer-events-none absolute inset-0"></div>
    <div class="footer-vignette pointer-events-none absolute inset-0"></div>

    <div class="kb-shell-wide relative z-10 pb-12 pt-16 md:pb-16 md:pt-20">

      {/* Top rule line */}
      <div class="footer-top-rule mb-14 flex items-center md:mb-16">
        <span class="h-px flex-1 bg-gradient-to-r from-transparent to-king-border/30"></span>
        <span class="mx-6 flex items-center gap-3">
          <span class="h-px w-6 bg-king-accent/20"></span>
          <span class="h-2 w-2 rotate-45 bg-king-accent/20"></span>
          <span class="h-px w-6 bg-king-accent/20"></span>
        </span>
        <span class="h-px flex-1 bg-gradient-to-l from-transparent to-king-border/30"></span>
      </div>

      {/* Main grid */}
      <div class="footer-grid grid grid-cols-1 gap-14 md:grid-cols-12 md:gap-10 mb-14 md:mb-16">

        {/* Brand column */}
        <div class="footer-brand-col md:col-span-5">
          <a href="/" class="group inline-flex items-center gap-3 mb-6">
            <span class="font-display text-2xl tracking-[0.25em] uppercase text-king-text md:text-3xl">
              KingBelt
            </span>
            <span class="hidden md:block h-px w-10 bg-king-accent/20 transition-all duration-500 group-hover:w-16 group-hover:bg-king-accent/40"></span>
          </a>
          <p class="mb-8 max-w-sm text-[14px] font-light leading-[1.85] text-king-muted/50">
            Accesorios de cuero para el día a día, hechos en España. Para los que se mueven diferente.
          </p>

          {/* Social icons */}
          <div class="flex items-center gap-4">
            {socialLinks.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-social group relative flex h-10 w-10 items-center justify-center rounded-full border border-king-border/40 text-king-muted/40 transition-all duration-500 hover:border-king-accent/50 hover:text-king-accent"
                aria-label={s.label}
              >
                <span class="absolute inset-0 rounded-full bg-king-accent/[0.03] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
                <Icon name={s.icon} class="relative z-10 h-4 w-4" />
              </a>
            ))}
          </div>
        </div>

        {/* Navigation column */}
        <div class="footer-nav-col md:col-span-2 md:col-start-7">
          <h4 class="footer-col-title mb-6 text-[11px] font-medium uppercase tracking-[0.2em] text-king-text">
            Navegación
          </h4>
          <nav class="flex flex-col gap-3">
            {footerNav.map((item) => (
              <a
                href={item.href}
                class="footer-nav-link group relative inline-flex items-center gap-3 text-[14px] font-light text-king-muted/50 transition-all duration-500 hover:text-king-text"
              >
                <span class="h-px w-0 bg-king-accent/50 transition-all duration-500 group-hover:w-4"></span>
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        {/* Contact column */}
        <div class="footer-contact-col md:col-span-2">
          <h4 class="footer-col-title mb-6 text-[11px] font-medium uppercase tracking-[0.2em] text-king-text">
            Contacto
          </h4>
          <div class="flex flex-col gap-3">
            <a
              href={site.urls.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link group relative inline-flex items-center gap-3 text-[14px] font-light text-king-muted/50 transition-colors duration-500 hover:text-king-accent"
            >
              <span class="h-px w-0 bg-king-accent/50 transition-all duration-500 group-hover:w-4"></span>
              WhatsApp
            </a>
            <a
              href={site.urls.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link group relative inline-flex items-center gap-3 text-[14px] font-light text-king-muted/50 transition-colors duration-500 hover:text-king-accent"
            >
              <span class="h-px w-0 bg-king-accent/50 transition-all duration-500 group-hover:w-4"></span>
              Instagram
            </a>
            <a
              href={`mailto:hola@kingbelt.com`}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link group relative inline-flex items-center gap-3 text-[14px] font-light text-king-muted/50 transition-colors duration-500 hover:text-king-accent"
            >
              <span class="h-px w-0 bg-king-accent/50 transition-all duration-500 group-hover:w-4"></span>
              Email
            </a>
          </div>
        </div>
      </div>

      {/* Bottom bar */}
      <div class="footer-bottom-bar relative flex flex-col items-center gap-5 border-t border-king-border/20 pt-8 md:flex-row md:justify-between">
        <div class="flex items-center gap-4">
          <span class="footer-dot-marker h-2 w-2 rotate-45 bg-king-accent/15"></span>
          <p class="text-[11px] font-light tracking-[0.06em] text-king-muted/30">
            &copy; {new Date().getFullYear()} KingBelt. Todos los derechos reservados.
          </p>
        </div>

        <div class="footer-bar-separator hidden items-center gap-3 md:flex">
          <span class="h-px w-8 bg-gradient-to-r from-transparent to-king-border/30"></span>
          <span class="h-2.5 w-2.5 rotate-45 border border-king-accent/20"></span>
          <span class="h-px w-8 bg-gradient-to-l from-transparent to-king-border/30"></span>
        </div>

        <div class="flex items-center gap-7">
          <p class="text-[11px] font-light tracking-[0.06em] text-king-muted/30">
            Asfalto, cuero y carácter desde España.
          </p>
          <button
            id="scroll-to-top"
            class="group flex items-center gap-2 text-[11px] font-light tracking-[0.06em] text-king-muted/30 transition-all duration-300 hover:text-king-accent"
            aria-label="Volver arriba"
            style="opacity: 0; pointer-events: none;"
          >
            <span>Volver arriba</span>
            <span class="flex h-7 w-7 items-center justify-center rounded-full border border-king-border/30 transition-all duration-300 group-hover:border-king-accent/40 group-hover:-translate-y-0.5">
              <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" /></svg>
            </span>
          </button>
        </div>
      </div>
    </div>

    {/* GIANT TYPOGRAPHY */}
    <div
      class="footer-giant-wrap relative mt-6 overflow-hidden text-center md:mt-8"
      style="height: clamp(10rem, 20vw, 18rem); mask-image: linear-gradient(to bottom, black 0%, black 75%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 75%, transparent 100%);"
    >
      <span
        class="footer-giant font-display pointer-events-none inline-block select-none uppercase leading-[0.6] tracking-[0.06em] text-king-text"
        style="font-size: 20vw; opacity: 0.04; transform: translateY(1.5rem); font-weight: 300;"
      >
        KINGBELT
      </span>
      {/* Subtle ghosted wordmark layer for depth */}
      <span
        class="footer-giant-ghost font-display pointer-events-none absolute inset-0 flex select-none items-center justify-center overflow-hidden uppercase leading-[0.6] tracking-[0.06em] text-king-accent/[0.06]"
        style="font-size: 20vw; font-weight: 300;"
        aria-hidden="true"
      >
        <span class="footer-giant-drift inline-block">KINGBELT</span>
      </span>
    </div>
  </div>
</footer>

<style>
  /* ===== CTA SECTION ===== */
  .cta-shell {
    isolation: isolate;
  }

  .cta-bg {
    background:
      radial-gradient(circle at 30% 40%, rgba(138, 90, 43, 0.06), transparent 42%),
      radial-gradient(circle at 70% 60%, rgba(138, 90, 43, 0.03), transparent 38%),
      radial-gradient(ellipse 100% 60% at 50% 100%, rgba(138, 90, 43, 0.04), transparent 50%);
  }

  .cta-vignette {
    background: radial-gradient(ellipse 75% 65% at 50% 50%, transparent 0%, rgba(8, 7, 6, 0.55) 100%);
  }

  .cta-noise {
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    mix-blend-mode: overlay;
  }

  .cta-bottom-strip {
    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  /* ===== FOOTER BOTTOM ===== */
  .footer-shell {
    isolation: isolate;
  }

  .footer-bg {
    opacity: 0.3;
    background-image:
      linear-gradient(90deg, rgba(138, 90, 43, 0.04) 0, rgba(138, 90, 43, 0.04) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.01) 1px, transparent 1px);
    background-size: 10rem 100%, 100% 4rem;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), transparent 98%);
  }

  .footer-vignette {
    background: radial-gradient(ellipse 80% 65% at 50% 40%, transparent 0%, rgba(247, 243, 238, 0.4) 100%);
  }

  /* Social icons */
  .footer-social {
    position: relative;
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer-social:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(138, 90, 43, 0.08);
  }

  /* Navigation links */
  .footer-nav-link::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-king-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .footer-nav-link:hover::after {
    transform: scaleX(1);
  }

  .footer-nav-link:hover {
    transform: translateX(4px);
  }

  /* Contact links */
  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-king-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .footer-link:hover::after {
    transform: scaleX(1);
  }

  .footer-link:hover {
    transform: translateX(4px);
  }

  /* Giant ghosted drift */
  .footer-giant-drift {
    animation: footer-drift 22s linear infinite;
    will-change: transform;
  }

  @keyframes footer-drift {
    0% { transform: translateX(0); }
    100% { transform: translateX(-6%); }
  }

  .footer-giant-ghost {
    mix-blend-mode: multiply;
  }

  /* Footer bar refinements */
  .footer-dot-marker {
    transition: transform 600ms var(--kb-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
                background-color 400ms ease;
  }

  .footer-bottom-bar:hover .footer-dot-marker {
    transform: rotate(45deg) scale(1.1);
    background-color: rgba(138, 90, 43, 0.35);
  }

  .footer-bar-separator span:nth-child(2) {
    transition: transform 600ms var(--kb-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .footer-bar-separator:hover span:nth-child(2) {
    transform: rotate(45deg) scale(1.15);
  }

</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const footerScope = document.querySelector('[data-gsap-footer]');
  if (footerScope) {
    /* ── CTA Section Timeline ── */
    const ctaSection = footerScope.querySelector('[data-cta-section]');
    if (ctaSection) {
      const ctaTl = gsap.timeline({
        defaults: { ease: 'power3.out' },
        scrollTrigger: {
          trigger: ctaSection,
          start: 'top 85%',
          once: true,
        },
      });

      ctaTl
        .from(ctaSection.querySelector('.cta-bg'), { opacity: 0, duration: 1.4 })
        .from(ctaSection.querySelector('.cta-glow'), { opacity: 0, scale: 0.8, duration: 1.2 }, 0.1)
        .from(ctaSection.querySelector('.cta-section-header'), { y: 20, opacity: 0, duration: 0.8 }, 0.35)
        .from(ctaSection.querySelector('.cta-title-line-1'), { y: 40, opacity: 0, duration: 1.0 }, 0.45)
        .from(ctaSection.querySelector('.cta-title-line-2'), { y: 40, opacity: 0, duration: 1.0 }, 0.55)
        .from(ctaSection.querySelector('.cta-btn-wrap'), { y: 14, opacity: 0, duration: 0.8 }, 0.85)
        .from(ctaSection.querySelector('.cta-bottom-strip'), { y: 24, opacity: 0, duration: 0.9 }, 0.95)
        .from(ctaSection.querySelectorAll('.cta-spec-item'), { y: 10, opacity: 0, duration: 0.5, stagger: 0.08 }, 1.05);
    }

    /* ── Footer Bottom Timeline ── */
    const footerBottom = footerScope.querySelector('[data-footer-bottom]');
    if (footerBottom) {
      const footerTl = gsap.timeline({
        defaults: { ease: 'power3.out' },
        scrollTrigger: {
          trigger: footerBottom,
          start: 'top 90%',
          once: true,
        },
      });

      footerTl
        .from(footerBottom.querySelector('.footer-bg'), { opacity: 0, duration: 1.2 })
        .from(footerBottom.querySelector('.footer-top-rule'), { scaleX: 0, opacity: 0, duration: 0.8, transformOrigin: 'center' }, 0.2)
        .from(footerBottom.querySelector('.footer-brand-col'), { y: 24, opacity: 0, duration: 0.8 }, 0.3)
        .from(footerBottom.querySelector('.footer-nav-col'), { y: 24, opacity: 0, duration: 0.8 }, 0.4)
        .from(footerBottom.querySelector('.footer-contact-col'), { y: 24, opacity: 0, duration: 0.8 }, 0.5)
        .from(footerBottom.querySelector('.footer-giant'), { y: 50, opacity: 0, duration: 1.4 }, 0.5)
        .from(footerBottom.querySelector('.footer-bottom-bar'), { y: 12, opacity: 0, duration: 0.7 }, 0.8);
    }
  }

  /* ── Scroll to top ── */
  const scrollToTopBtn = document.getElementById('scroll-to-top');
  if (scrollToTopBtn) {
    const toggleVisibility = () => {
      if (window.scrollY > 400) {
        scrollToTopBtn.style.opacity = '1';
        scrollToTopBtn.style.pointerEvents = 'auto';
      } else {
        scrollToTopBtn.style.opacity = '0';
        scrollToTopBtn.style.pointerEvents = 'none';
      }
    };

    window.addEventListener('scroll', toggleVisibility, { passive: true });
    toggleVisibility();

    scrollToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
