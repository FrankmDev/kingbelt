---
import { mainNav } from '@config/navigation';
import HeaderAccountCta from '../account/HeaderAccountCta.astro';
import CartDrawer from '../cart/CartDrawer.astro';
import CartTrigger from '../cart/CartTrigger.astro';
import MobileNavigation from './MobileNavigation.astro';

interface Props {
  initialTheme?: 'dark' | 'light';
  scrolledTheme?: 'dark' | 'light';
  compactThreshold?: number;
  /** Carga el carrito en cuanto la página esté lista (p. ej. /carrito). */
  cartEager?: boolean;
}

const {
  initialTheme = 'dark',
  scrolledTheme = 'light',
  compactThreshold = 72,
  cartEager = false,
} = Astro.props;

const links = mainNav;
---

<header
  id="site-header"
  data-site-header
  data-theme={initialTheme}
  data-initial-theme={initialTheme}
  data-scrolled-theme={scrolledTheme}
  data-scrolled="false"
  data-menu-open="false"
  data-compact-threshold={compactThreshold}
  data-cart-eager={cartEager ? 'true' : undefined}
  class="fixed left-0 right-0 top-0 z-50 px-3 pt-3 md:px-5 md:pt-4"
>
  <div class="header-shell mx-auto overflow-hidden">
    <nav
      id="header-nav"
      class="header-tier-2 mx-auto flex items-center justify-between gap-3 px-5 md:px-8 lg:px-10"
      aria-label="Principal"
    >
      <a href="/" id="header-logo" class="group relative flex items-center gap-3 md:gap-4" aria-label="KingBelt — Inicio">
        <span class="header-wordmark font-display whitespace-nowrap uppercase">KingBelt</span>
        <span class="header-logo-rule hidden h-[1px] bg-current md:block" aria-hidden="true"></span>
      </a>

      <div class="hidden items-center gap-1 lg:flex">
        {links.map((l, i) => (
          <>
            {i > 0 && <span class="header-divider mx-2.5 h-3.5 w-px lg:mx-3.5" aria-hidden="true"></span>}
            <a href={l.href} class="header-link group relative flex items-center gap-2 py-1">
              <span>{l.label}</span>
              <span class="header-link-line absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-king-accent transition-transform duration-[var(--kb-dur-med)] group-hover:scale-x-100"></span>
            </a>
          </>
        ))}
        <span class="header-divider mx-2.5 h-3.5 w-px lg:mx-3.5" aria-hidden="true"></span>
        <HeaderAccountCta />
        <span class="header-divider mx-2.5 h-3.5 w-px lg:mx-3.5" aria-hidden="true"></span>
        <CartTrigger />
      </div>

      <div class="flex items-center gap-1 lg:hidden">
        <CartTrigger />
        <button
          id="menu-toggle"
          data-menu-toggle
          class="relative -mr-2 flex h-11 w-11 flex-col items-end justify-center gap-[6px] p-2"
          aria-label="Abrir menú"
          aria-controls="mobile-menu"
          aria-expanded="false"
          type="button"
        >
          <span class="menu-line menu-line-1 block h-[1.5px]"></span>
          <span class="menu-line menu-line-2 block h-[1.5px]"></span>
        </button>
      </div>
    </nav>

    <div class="header-stitch h-px"></div>
    <div class="header-progress" aria-hidden="true">
      <span class="header-progress-bar"></span>
    </div>
  </div>
</header>

<MobileNavigation links={links} />

<CartDrawer />

<style>
  #site-header {
    --scroll-progress: 0;
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      color 500ms ease,
      opacity 500ms ease;
  }

  .header-shell {
    max-width: var(--kb-shell-max);
    border: 1px solid transparent;
    border-radius: var(--kb-radius-lg);
    backdrop-filter: blur(calc(10px + (var(--scroll-progress) * 18px))) saturate(calc(1.05 + (var(--scroll-progress) * 0.55)));
    -webkit-backdrop-filter: blur(calc(10px + (var(--scroll-progress) * 18px))) saturate(calc(1.05 + (var(--scroll-progress) * 0.55)));
    box-shadow:
      0 20px 45px rgba(15, 12, 10, calc(var(--scroll-progress) * 0.08)),
      0 6px 18px rgba(15, 12, 10, calc(var(--scroll-progress) * 0.05));
    transition:
      background-color 500ms ease,
      border-color 500ms ease,
      box-shadow 500ms ease,
      border-radius 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header-tier-2 {
    padding-top: calc(1.25rem - (var(--scroll-progress) * 0.6rem));
    padding-bottom: calc(1.25rem - (var(--scroll-progress) * 0.6rem));
    transition:
      padding 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header-wordmark {
    font-size: calc(0.96rem - (var(--scroll-progress) * 0.12rem));
    letter-spacing: calc(0.34em - (var(--scroll-progress) * 0.05em));
    transition:
      font-size 600ms ease,
      letter-spacing 600ms ease,
      opacity 300ms ease;
  }

  @media (min-width: 768px) {
    .header-wordmark {
      font-size: calc(1.04rem - (var(--scroll-progress) * 0.14rem));
    }
  }

  .header-logo-rule {
    width: calc(3.3rem - (var(--scroll-progress) * 1.1rem));
    opacity: calc(0.18 + (var(--scroll-progress) * 0.06));
    transition: width 600ms ease, opacity 400ms ease;
  }

  @media (min-width: 1024px) {
    .header-logo-rule {
      width: calc(5.5rem - (var(--scroll-progress) * 1.7rem));
    }
  }

  #header-logo:hover .header-logo-rule {
    opacity: 0.34;
  }

  .header-divider {
    background: currentColor;
    opacity: 0.08;
    transition: opacity 400ms ease;
  }

  .header-link {
    font-size: calc(0.675rem - (var(--scroll-progress) * 0.03rem));
    font-weight: 500;
    letter-spacing: calc(0.16em - (var(--scroll-progress) * 0.02em));
    text-transform: uppercase;
    transition:
      color 400ms ease,
      opacity 400ms ease,
      letter-spacing 400ms ease,
      font-size 400ms ease;
  }

  .menu-line {
    background: currentColor;
    transition:
      transform 500ms ease,
      width 500ms ease,
      background-color 400ms ease;
  }

  .menu-line-1 {
    width: 1.5rem;
  }

  .menu-line-2 {
    width: 0.9rem;
  }

  #site-header[data-menu-open='true'] .menu-line-1 {
    transform: translateY(3.75px) rotate(45deg);
  }

  #site-header[data-menu-open='true'] .menu-line-2 {
    width: 1.5rem;
    transform: translateY(-2.25px) rotate(-45deg);
  }

  .header-stitch {
    background: rgba(138, 90, 43, calc(0.08 + (var(--scroll-progress) * 0.06)));
    opacity: calc(1 - (var(--scroll-progress) * 0.75));
    transition: opacity 400ms ease;
  }

  .header-progress {
    position: relative;
    height: 1px;
    background: transparent;
    overflow: hidden;
    opacity: calc(0.4 + (var(--scroll-progress) * 0.6));
    transition: opacity 400ms ease;
  }

  .header-progress-bar {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(var(--scroll-progress) * 100%);
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-king-accent) 28%,
      var(--color-king-accent-light) 72%,
      transparent 100%
    );
    box-shadow: 0 0 8px rgba(138, 90, 43, 0.35);
    transition: width 120ms linear;
  }

  #site-header[data-theme='dark'] .header-progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(214, 177, 110, 0.7) 28%,
      rgba(214, 177, 110, 0.95) 72%,
      transparent 100%
    );
    box-shadow: 0 0 8px rgba(214, 177, 110, 0.25);
  }

  #site-header[data-theme='dark'] {
    color: #ffffff;
  }

  #site-header[data-theme='dark'] .header-shell {
    background-color: rgba(14, 12, 11, calc(var(--scroll-progress) * 0.4));
    border-color: rgba(255, 255, 255, calc(0.06 + (var(--scroll-progress) * 0.08)));
  }

  #site-header[data-theme='dark'] .header-link {
    color: rgba(255, 255, 255, 0.72);
  }

  #site-header[data-theme='dark'] .header-link:hover,
  #site-header[data-theme='dark'] #header-logo:hover {
    color: #ffffff;
  }

  #site-header[data-theme='light'] {
    color: var(--color-king-text);
  }

  #site-header[data-theme='light'] .header-shell {
    background-color: rgba(247, 243, 238, calc(0.82 + (var(--scroll-progress) * 0.1)));
    border-color: rgba(24, 21, 18, calc(0.08 + (var(--scroll-progress) * 0.04)));
    box-shadow:
      0 24px 50px rgba(19, 16, 14, calc(0.07 + (var(--scroll-progress) * 0.06))),
      0 10px 24px rgba(19, 16, 14, calc(0.03 + (var(--scroll-progress) * 0.03)));
  }

  #site-header[data-theme='light'] .header-link {
    color: rgba(24, 21, 18, 0.72);
  }

  #site-header[data-theme='light'] .header-link:hover,
  #site-header[data-theme='light'] #header-logo:hover {
    color: var(--color-king-text);
  }

  #site-header[data-scrolled='true'] .header-shell {
    border-radius: var(--kb-radius-md);
  }

  #site-header[data-scrolled='true'] .header-tier-2 {
    transform: translateY(-0.02rem);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    .header-shell,
    .header-tier-2,
    .header-wordmark,
    .header-logo-rule,
    .header-link,
    .menu-line,
    .header-progress-bar {
      transition: none !important;
    }
  }
</style>

<script>
  import '@scripts/layout/header-client';
</script>
