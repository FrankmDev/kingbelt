---
import { mainNav } from '@config/navigation';
import { getCustomerAccountHref } from '@commerce/commerce-navigation';
import HeaderAccountCta from '../account/HeaderAccountCta.astro';
import CartDrawer from '../cart/CartDrawer.astro';
import CartTrigger from '../cart/CartTrigger.astro';
import MobileNavigation from './MobileNavigation.astro';
import BrandLogo from '../ui/BrandLogo.astro';

interface Props {
  initialTheme?: 'dark' | 'light';
  scrolledTheme?: 'dark' | 'light';
  compactThreshold?: number;
  /** Carga el carrito en cuanto la página esté lista (p. ej. /carrito). */
  cartEager?: boolean;
}

const {
  initialTheme = 'dark',
  scrolledTheme = 'light',
  compactThreshold = 72,
  cartEager = false,
} = Astro.props;

const links = mainNav;
const accountHref = getCustomerAccountHref();
---

<header
  id="site-header"
  data-site-header
  data-theme={initialTheme}
  data-initial-theme={initialTheme}
  data-scrolled-theme={scrolledTheme}
  data-scrolled="false"
  data-menu-open="false"
  data-compact-threshold={compactThreshold}
  data-cart-eager={cartEager ? 'true' : undefined}
  class="fixed left-0 right-0 top-0 z-50 px-3 md:px-5"
>
  <div class="header-shell mx-auto overflow-hidden">
    <nav
      id="header-nav"
      class="header-tier-2 mx-auto flex items-center justify-between gap-3 px-5 md:px-8 lg:px-10"
      aria-label="Principal"
    >
      <a href="/" id="header-logo" class="group relative flex items-center" aria-label="KingBelt — Inicio">
        <span class="header-logo">
          <BrandLogo
            tone="ink"
            class="header-logo__mark header-logo__mark--ink"
            sizes="(min-width: 768px) 180px, 148px"
            loading="eager"
            fetchpriority="high"
          />
          <BrandLogo
            tone="white"
            class="header-logo__mark header-logo__mark--white"
            sizes="(min-width: 768px) 180px, 148px"
            loading="eager"
          />
        </span>
      </a>

      <div class="hidden items-center gap-1 lg:flex">
        {links.map((l, i) => (
          <>
            {i > 0 && <span class="header-divider mx-2.5 h-3.5 w-px lg:mx-3.5" aria-hidden="true"></span>}
            <a href={l.href} class="header-link group relative flex items-center gap-2 py-1">
              <span>{l.label}</span>
              <span class="header-link-line absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-king-accent transition-transform duration-[var(--kb-dur-med)] group-hover:scale-x-100"></span>
            </a>
          </>
        ))}
        <span class="header-divider mx-2.5 h-3.5 w-px lg:mx-3.5" aria-hidden="true"></span>
        <HeaderAccountCta href={accountHref} />
        <span class="header-divider mx-2.5 h-3.5 w-px lg:mx-3.5" aria-hidden="true"></span>
        <CartTrigger />
      </div>

      <div class="header-mobile-actions">
        <CartTrigger />
        <span class="header-mobile-rule" aria-hidden="true"></span>
        <button
          id="menu-toggle"
          data-menu-toggle
          class="header-menu-toggle"
          aria-label="Abrir menú"
          aria-controls="mobile-menu"
          aria-expanded="false"
          type="button"
        >
          <span class="menu-line menu-line-1" aria-hidden="true"></span>
          <span class="menu-line menu-line-2" aria-hidden="true"></span>
        </button>
      </div>
    </nav>

    <div class="header-stitch h-px"></div>
    <div class="header-progress" aria-hidden="true">
      <span class="header-progress-bar"></span>
    </div>
  </div>
</header>

<MobileNavigation links={links} accountHref={accountHref} />

<CartDrawer />

<style>
  #site-header {
    --scroll-progress: 0;
    padding-top: calc(0.75rem + env(safe-area-inset-top, 0px));
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      color 500ms ease,
      opacity 500ms ease;
  }

  .header-shell {
    max-width: var(--kb-shell-max);
    border: 1px solid transparent;
    border-radius: var(--kb-radius-lg);
    backdrop-filter: blur(calc(10px + (var(--scroll-progress) * 18px))) saturate(calc(1.05 + (var(--scroll-progress) * 0.55)));
    -webkit-backdrop-filter: blur(calc(10px + (var(--scroll-progress) * 18px))) saturate(calc(1.05 + (var(--scroll-progress) * 0.55)));
    box-shadow:
      0 20px 45px rgba(15, 12, 10, calc(var(--scroll-progress) * 0.08)),
      0 6px 18px rgba(15, 12, 10, calc(var(--scroll-progress) * 0.05));
    transition:
      background-color 500ms ease,
      border-color 500ms ease,
      box-shadow 500ms ease,
      border-radius 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header-tier-2 {
    padding-top: calc(1.25rem - (var(--scroll-progress) * 0.6rem));
    padding-bottom: calc(1.25rem - (var(--scroll-progress) * 0.6rem));
    transition:
      padding 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header-logo {
    position: relative;
    display: block;
    height: calc(2.45rem - (var(--scroll-progress) * 0.28rem));
    aspect-ratio: 512 / 271;
    transition:
      height 600ms ease,
      opacity 300ms ease;
  }

  .header-logo :global(.header-logo__mark) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
    transition: opacity 400ms ease;
  }

  .header-logo :global(.header-logo__mark--white) {
    opacity: 0;
  }

  @media (min-width: 768px) {
    #site-header {
      padding-top: calc(1rem + env(safe-area-inset-top, 0px));
    }

    .header-logo {
      height: calc(2.85rem - (var(--scroll-progress) * 0.32rem));
    }
  }

  #header-logo:hover .header-logo {
    opacity: 0.88;
  }

  .header-divider {
    background: currentColor;
    opacity: 0.08;
    transition: opacity 400ms ease;
  }

  .header-link {
    font-size: calc(0.675rem - (var(--scroll-progress) * 0.03rem));
    font-weight: 500;
    letter-spacing: calc(0.16em - (var(--scroll-progress) * 0.02em));
    text-transform: uppercase;
    transition:
      color 400ms ease,
      opacity 400ms ease,
      letter-spacing 400ms ease,
      font-size 400ms ease;
  }

  .header-mobile-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0;
  }

  .header-mobile-rule {
    width: 1px;
    height: 0.75rem;
    margin: 0 0.45rem;
    background: currentColor;
    opacity: 0.22;
  }

  @media (min-width: 64rem) {
    .header-mobile-actions {
      display: none;
    }
  }

  .header-menu-toggle {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    color: inherit;
  }

  .header-menu-toggle:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
    border-radius: var(--kb-radius-xs);
  }

  .menu-line {
    display: block;
    width: 1.125rem;
    height: 1.5px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 420ms var(--kb-ease-out),
      opacity 220ms ease;
  }

  #site-header[data-menu-open='true'] .menu-line-1 {
    transform: translateY(3.25px) rotate(45deg);
  }

  #site-header[data-menu-open='true'] .menu-line-2 {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .header-stitch {
    background: rgba(138, 90, 43, calc(0.08 + (var(--scroll-progress) * 0.06)));
    opacity: calc(1 - (var(--scroll-progress) * 0.75));
    transition: opacity 400ms ease;
  }

  .header-progress {
    position: relative;
    height: 1px;
    background: transparent;
    overflow: hidden;
    opacity: calc(0.4 + (var(--scroll-progress) * 0.6));
    transition: opacity 400ms ease;
  }

  .header-progress-bar {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(var(--scroll-progress) * 100%);
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-king-accent) 28%,
      var(--color-king-accent-light) 72%,
      transparent 100%
    );
    box-shadow: 0 0 8px rgba(138, 90, 43, 0.35);
    transition: width 120ms linear;
  }

  #site-header[data-theme='dark'] .header-progress-bar {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(214, 177, 110, 0.7) 28%,
      rgba(214, 177, 110, 0.95) 72%,
      transparent 100%
    );
    box-shadow: 0 0 8px rgba(214, 177, 110, 0.25);
  }

  #site-header[data-theme='dark'] {
    color: #ffffff;
  }

  #site-header[data-theme='dark'] .header-shell {
    background-color: rgba(14, 12, 11, calc(var(--scroll-progress) * 0.4));
    border-color: rgba(255, 255, 255, calc(0.06 + (var(--scroll-progress) * 0.08)));
  }

  #site-header[data-theme='dark'] .header-link {
    color: rgba(255, 255, 255, 0.72);
  }

  #site-header[data-theme='dark'] .header-link:hover {
    color: #ffffff;
  }

  #site-header[data-theme='dark'] .header-logo :global(.header-logo__mark--ink),
  #site-header[data-menu-open='true'] .header-logo :global(.header-logo__mark--ink) {
    opacity: 0;
  }

  #site-header[data-theme='dark'] .header-logo :global(.header-logo__mark--white),
  #site-header[data-menu-open='true'] .header-logo :global(.header-logo__mark--white) {
    opacity: 1;
  }

  #site-header[data-theme='light'] {
    color: var(--color-king-text);
  }

  #site-header[data-theme='light'] .header-shell {
    background-color: rgba(247, 243, 238, calc(0.82 + (var(--scroll-progress) * 0.1)));
    border-color: rgba(24, 21, 18, calc(0.08 + (var(--scroll-progress) * 0.04)));
    box-shadow:
      0 24px 50px rgba(19, 16, 14, calc(0.07 + (var(--scroll-progress) * 0.06))),
      0 10px 24px rgba(19, 16, 14, calc(0.03 + (var(--scroll-progress) * 0.03)));
  }

  #site-header[data-theme='light'] .header-link {
    color: rgba(24, 21, 18, 0.72);
  }

  #site-header[data-theme='light'] .header-link:hover {
    color: var(--color-king-text);
  }

  @media (min-width: 64rem) {
    #site-header[data-scrolled='true'] .header-shell {
      border-radius: var(--kb-radius-md);
    }
  }

  #site-header[data-scrolled='true'] .header-tier-2 {
    transform: translateY(-0.02rem);
  }

  @media (max-width: 63.99rem) {
    #site-header {
      padding-top: calc(0.65rem + env(safe-area-inset-top, 0px));
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .header-shell {
      overflow: visible;
      border-radius: var(--kb-radius-md);
    }

    .header-tier-2 {
      padding-top: 0.8rem;
      padding-bottom: 0.8rem;
      padding-left: 1.1rem;
      padding-right: 0.65rem;
    }

    #header-logo {
      min-width: 0;
    }

    .header-logo {
      height: 2.35rem;
    }

    .header-progress {
      display: none;
    }

    .header-mobile-actions :global(.cart-trigger) {
      width: 2.5rem;
      height: 2.5rem;
      border: 0;
      background: transparent;
    }

    .header-mobile-actions :global(.cart-trigger svg) {
      width: 1.05rem;
      height: 1.05rem;
    }

    .header-mobile-actions :global(.cart-trigger:hover) {
      border-color: transparent;
      opacity: 1;
    }

    #site-header[data-menu-open='true'] {
      color: #ffffff;
    }

    #site-header[data-menu-open='true'] .header-shell {
      background-color: rgba(14, 12, 11, 0.82);
      border-color: rgba(255, 255, 255, 0.14);
      box-shadow: 0 18px 40px rgba(13, 12, 11, 0.28);
      backdrop-filter: blur(18px) saturate(1.2);
      -webkit-backdrop-filter: blur(18px) saturate(1.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    .header-shell,
    .header-tier-2,
    .header-logo,
    .header-logo :global(.header-logo__mark),
    .header-link,
    .menu-line,
    .header-progress-bar {
      transition: none !important;
    }
  }
</style>

<script>
  import '@scripts/layout/header-client';
</script>
