---
import LegalSection from './LegalSection.astro';
import LegalBlocks from './LegalBlocks.astro';
import Prose from '../ui/Prose.astro';
import { legalDocuments, type LegalDocument, type LegalDocumentKey } from '@content/legal';
import { legalBodies } from '@content/legal-bodies';
import { getLegalSectionReadiness, hasMeaningfulLegalContent } from '@config/legal-readiness';

interface Props {
  documentKey: keyof typeof legalBodies;
}

const { documentKey } = Astro.props;
const doc: LegalDocument = legalDocuments[documentKey as LegalDocumentKey];
const body = legalBodies[documentKey];
const readiness = getLegalSectionReadiness(documentKey);

const missing = doc.sections.filter((section) => !body.sections[section.id]);
if (missing.length > 0) {
  throw new Error(
    `Legal body for "${documentKey}" is missing sections: ${missing.map((section) => section.id).join(', ')}`
  );
}

if (doc.status === 'published') {
  const pending = doc.sections.filter((section) => readiness[section.id]?.status !== 'complete');
  if (pending.length > 0) {
    throw new Error(
      `Published legal document "${documentKey}" has pending sections: ${pending.map((section) => section.id).join(', ')}`
    );
  }
  const empty = doc.sections.filter((section) => !hasMeaningfulLegalContent(readiness[section.id]?.content));
  if (empty.length > 0) {
    throw new Error(
      `Published legal document "${documentKey}" has empty sections: ${empty.map((section) => section.id).join(', ')}`
    );
  }
}
---

<Prose variant="document">
  {doc.sections.map((section) => (
    <LegalSection
      id={section.id}
      title={section.title}
      pending={readiness[section.id]?.status !== 'complete'}
      documentStatus={doc.status}
    >
      {readiness[section.id]?.status === 'complete' && (
        <LegalBlocks blocks={body.sections[section.id]} />
      )}
    </LegalSection>
  ))}
</Prose>
