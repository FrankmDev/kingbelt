---
import type { HTMLAttributes } from 'astro/types';
import { visibleLegalNavItems } from '@content/legal';

interface Props extends Omit<HTMLAttributes<'nav'>, 'class'> {
  currentPath: string;
  class?: string;
}

const { currentPath, class: className, ...rest } = Astro.props;

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const current = normalize(currentPath);
---

<nav {...rest} class:list={['legal-nav', className]} aria-label="Documentos legales">
  <ul class="legal-nav__list">
    {visibleLegalNavItems.map((item) => {
      const isActive = normalize(item.href) === current;
      return (
        <li>
          <a
            href={item.href}
            class:list={['legal-nav__link', isActive && 'legal-nav__link--active']}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
            {item.status === 'draft' && (
              <span class="legal-nav__draft kb-meta-label">Borrador</span>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .legal-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .legal-nav__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0;
    font-size: var(--kb-text-2xs);
    color: var(--color-king-muted);
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .legal-nav__link:hover {
    color: var(--color-king-text);
  }

  .legal-nav__link--active {
    color: var(--color-king-accent);
    font-weight: 500;
  }

  .legal-nav__draft {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-king-muted);
    opacity: 0.75;
  }

  .legal-nav__link:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 2px;
  }
</style>
