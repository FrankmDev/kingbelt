---
import SectionHeaderHome from '../sections/home/SectionHeaderHome.astro';
import EditorialCtaSection from '../sections/EditorialCtaSection.astro';
import LegalNavigation from './LegalNavigation.astro';
import LegalStatusNotice from './LegalStatusNotice.astro';
import HelpNavigation from '../help/HelpNavigation.astro';
import { legalCta, type LegalDocument } from '@content/legal';

interface SectionCopy {
  index: string;
  eyebrow: string;
  title: string;
  body: string;
}

interface Props {
  document: LegalDocument;
  section: SectionCopy;
  relatedNav?: 'legal' | 'help' | 'none';
  showContactCta?: boolean;
  ctaIndex?: string;
}

const {
  document,
  section,
  relatedNav = 'legal',
  showContactCta = true,
  ctaIndex = '02',
} = Astro.props;

const { status, updatedAt, version, sections } = document;
const titleId = 'legal-document-title';
const statusMeta =
  status === 'published' ? 'Vigente' : status === 'inactive' ? 'No operativo' : 'Borrador';
const hasIntro = status === 'published' && Astro.slots.has('intro');
---

<div class="legal-page">
  {status !== 'published' && (
    <div class="legal-page__notice">
      <div class="legal-page__notice-inner kb-shell-wide">
        <LegalStatusNotice status={status} />
      </div>
    </div>
  )}

  <section class="legal-page__document" aria-labelledby={titleId}>
    <div class="legal-page__inner kb-shell-wide">
      <SectionHeaderHome
        index={section.index}
        eyebrow={section.eyebrow}
        meta={statusMeta}
        titleId={titleId}
        body={section.body}
        class="legal-page__header"
      >
        <Fragment slot="title">{section.title}</Fragment>
      </SectionHeaderHome>

      {(version || updatedAt) && (
        <p class="legal-page__version kb-meta-label">
          {version && <span>v{version}</span>}
          {version && updatedAt && <span aria-hidden="true"> · </span>}
          {updatedAt && <span>Actualizado: {updatedAt}</span>}
        </p>
      )}

      <div class="legal-page__layout">
        {sections.length > 0 && (
          <aside class="legal-page__aside" aria-label="Navegación del documento">
            <div class="kb-reading-panel legal-page__toc-panel">
              <header class="kb-reading-panel__head">
                <div class="kb-reading-panel__head-bar">
                  <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">Índice</p>
                  <span class="kb-reading-panel__folio kb-meta-label" aria-hidden="true">
                    {String(sections.length).padStart(2, '0')}
                  </span>
                </div>
                <p class="kb-reading-panel__statement">En este documento</p>
              </header>

              <details class="legal-page__toc-disclosure" open>
                <summary class="legal-page__toc-summary kb-action-label">
                  Ver apartados
                </summary>
                <nav class="legal-page__toc" aria-label="Índice del documento">
                  <ol class="kb-reading-panel__layers legal-page__toc-list">
                    {sections.map((item, index) => (
                      <li class="kb-reading-panel__layer">
                        <div class="kb-reading-panel__rail" aria-hidden="true">
                          <span class="kb-reading-panel__num">
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          {index < sections.length - 1 && (
                            <span class="kb-reading-panel__rail-line"></span>
                          )}
                        </div>
                        <div class="kb-reading-panel__body">
                          <a href={`#${item.id}`} class="legal-page__toc-link">
                            {item.title}
                          </a>
                        </div>
                      </li>
                    ))}
                  </ol>
                </nav>
              </details>

              {relatedNav === 'legal' && (
                <div class="legal-page__related">
                  <p class="legal-page__related-label kb-action-label">Documentos legales</p>
                  <LegalNavigation currentPath={Astro.url.pathname} />
                </div>
              )}

              {relatedNav === 'help' && (
                <div class="legal-page__related">
                  <p class="legal-page__related-label kb-action-label">Centro de ayuda</p>
                  <HelpNavigation currentPath={Astro.url.pathname} />
                </div>
              )}
            </div>
          </aside>
        )}

        <div class="legal-page__main">
          {hasIntro && (
            <div class="legal-page__intro">
              <slot name="intro" />
            </div>
          )}
          <article class="legal-page__content">
            <slot />
          </article>
        </div>
      </div>
    </div>
  </section>

  {showContactCta && (
    <EditorialCtaSection cta={legalCta} index={ctaIndex} meta="Contacto" titleId="legal-cta-title" />
  )}
</div>

<style>
  .legal-page {
    display: flex;
    flex-direction: column;
  }

  .legal-page__notice {
    padding-block: var(--kb-space-5);
    background: var(--color-king-surface);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .legal-page__document {
    padding-block: var(--kb-space-section);
    background: var(--color-king-bg);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  @media (max-width: 47.99rem) {
    .legal-page__document {
      padding-block: var(--kb-space-8);
    }

    .legal-page__version {
      margin-bottom: var(--kb-space-5);
    }

    .legal-page__layout {
      gap: var(--kb-space-5);
    }
  }

  .legal-page__header:global(.section-header-home) {
    width: 100%;
    margin-bottom: var(--kb-space-4);
  }

  .legal-page__version {
    margin: 0 0 var(--kb-space-gap);
    color: var(--color-king-muted);
  }

  .legal-page__layout {
    display: grid;
    gap: var(--kb-space-gap);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .legal-page__layout {
      grid-template-columns: minmax(16rem, 20rem) minmax(0, 1fr);
    }

    .legal-page__aside {
      position: sticky;
      top: 6rem;
    }
  }

  .legal-page__toc-panel:global(.kb-reading-panel) {
    padding-block: var(--kb-space-5);
  }

  .legal-page__toc-disclosure {
    border: 0;
  }

  .legal-page__toc-summary {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-3);
    color: var(--color-king-text);
    cursor: pointer;
    list-style: none;
  }

  .legal-page__toc-summary::-webkit-details-marker {
    display: none;
  }

  .legal-page__toc-summary::after {
    content: '+';
    color: var(--color-king-accent);
    font-size: var(--kb-text-body);
    font-weight: 400;
  }

  .legal-page__toc-disclosure[open] .legal-page__toc-summary::after {
    content: '−';
  }

  .legal-page__toc-summary:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 2px;
  }

  @media (min-width: 64rem) {
    .legal-page__toc-summary {
      display: none;
    }

    .legal-page__toc-disclosure:not([open]) > .legal-page__toc {
      display: block;
    }
  }

  .legal-page__toc-list:global(.kb-reading-panel__layers) {
    margin: 0;
  }

  .legal-page__toc-list :global(.kb-reading-panel__body) {
    padding-block: 0.35rem;
  }

  .legal-page__toc-link {
    display: block;
    font-size: var(--kb-text-xs);
    line-height: 1.45;
    color: var(--color-king-muted);
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .legal-page__toc-link:hover {
    color: var(--color-king-text);
  }

  .legal-page__toc-link:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 2px;
  }

  .legal-page__related {
    margin-top: var(--kb-space-5);
    padding-top: var(--kb-space-4);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .legal-page__related-label {
    margin: 0 0 0.75rem;
    color: var(--color-king-muted);
  }

  .legal-page__main {
    min-width: 0;
  }

  .legal-page__intro {
    margin-bottom: var(--kb-space-gap);
  }

  .legal-page__content {
    min-width: 0;
  }

  .legal-page__content :global(.kb-prose > .legal-section + .legal-section) {
    margin-top: 0;
  }

  .legal-page__content :global(.kb-prose--document > .legal-section + .legal-section) {
    margin-top: 0;
  }
</style>
