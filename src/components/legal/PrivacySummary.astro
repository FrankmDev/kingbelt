---
import type { HTMLAttributes } from 'astro/types';
import { privacyFirstLayer } from '@content/legal';
import { confirmed, businessFacts } from '@config/business';
import { site } from '@config/site';

interface Props extends Omit<HTMLAttributes<'aside'>, 'class'> {
  class?: string;
  compact?: boolean;
}

const { class: className, compact = false, ...rest } = Astro.props;
const layer = privacyFirstLayer();
const email = confirmed(businessFacts.email) ?? site.contact.email;
const pendingValue = 'Pendiente de confirmación antes de publicar esta política.';

const items = [
  { label: 'Responsable', value: layer.controller ?? pendingValue },
  { label: 'Finalidad', value: layer.purpose ?? pendingValue },
  { label: 'Legitimación', value: layer.legalBasis ?? pendingValue },
  ...(layer.recipients ? [{ label: 'Destinatarios', value: layer.recipients }] : []),
  { label: 'Derechos', value: layer.rights },
];
---

<aside
  {...rest}
  class:list={['privacy-summary', 'kb-reading-panel', compact && 'privacy-summary--compact', className]}
  aria-labelledby="privacy-summary-title"
>
  <header class="kb-reading-panel__head">
    <div class="kb-reading-panel__head-bar">
      <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">Primera capa</p>
      <span class="kb-reading-panel__folio kb-meta-label" aria-hidden="true">
        {String(items.length + 1).padStart(2, '0')}
      </span>
    </div>
    <h2 id="privacy-summary-title" class="kb-reading-panel__statement">
      Información básica sobre privacidad
    </h2>
  </header>

  <dl class="privacy-summary__list">
    {items.map((item, index) => (
      <div class="privacy-summary__item">
        <dt>
          <span class="privacy-summary__num" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          {item.label}
        </dt>
        <dd>{item.value}</dd>
      </div>
    ))}
    <div class="privacy-summary__item">
      <dt>
        <span class="privacy-summary__num" aria-hidden="true">
          {String(items.length + 1).padStart(2, '0')}
        </span>
        Información adicional
      </dt>
      <dd>
        <a href="/privacidad">Política de privacidad completa</a>
        {' · '}
        <a href={`mailto:${email}`}>Contacto</a>
      </dd>
    </div>
  </dl>
</aside>

<style>
  .privacy-summary__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .privacy-summary__item {
    margin: 0;
    padding: var(--kb-space-4) 0;
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .privacy-summary__item dt {
    display: flex;
    align-items: baseline;
    gap: var(--kb-space-3);
    margin-bottom: 0.35rem;
    font-size: var(--kb-text-2xs);
    font-weight: var(--kb-w-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-king-accent);
  }

  .privacy-summary__num {
    font-variant-numeric: tabular-nums;
    color: var(--color-king-muted);
  }

  .privacy-summary__item dd {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.65;
    color: var(--color-king-text);
  }

  .privacy-summary__item a {
    color: var(--color-king-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .privacy-summary__item a:hover {
    text-decoration: underline;
  }

  .privacy-summary--compact .privacy-summary__item {
    padding-block: var(--kb-space-3);
  }
</style>
