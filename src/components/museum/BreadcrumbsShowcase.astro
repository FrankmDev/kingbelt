---
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Panel from '../ui/Panel.astro';

const blogCrumbs = [{ label: 'Blog' }, { label: 'Cuidado del cuero' }];
const articleCrumbs = [
  { label: 'Blog', href: '/blog' },
  { label: 'Cuidado del cuero', href: '/blog/cuidado' },
  { label: 'Como limpiar tu cinturon' },
];
---

<div class="space-y-4">
  <Panel padding="md">
    <span class="kb-code-label block text-king-accent/50 mb-3">Uso en blog</span>
    <Breadcrumbs items={blogCrumbs} />
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label block text-king-accent/50 mb-3">Uso en artículo</span>
    <Breadcrumbs items={articleCrumbs} />
  </Panel>

  <Panel padding="sm">
    <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">items: Crumb[] (label, href?)</span>
  </Panel>
</div>
