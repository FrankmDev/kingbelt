---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<div class="bg-king-surface rounded-lg border border-king-border/30 shadow-sm overflow-hidden mb-4">
  <div class="overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-king-border/10">
          <th class="px-5 py-3 text-[8px] font-mono uppercase tracking-[0.15em] text-king-muted/40">Variant</th>
          <th class="px-3 py-3 text-[8px] font-mono uppercase tracking-[0.15em] text-king-muted/40">sm</th>
          <th class="px-3 py-3 text-[8px] font-mono uppercase tracking-[0.15em] text-king-muted/40">md</th>
          <th class="px-3 py-3 text-[8px] font-mono uppercase tracking-[0.15em] text-king-muted/40">lg</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-king-border/5">
        {(['primary', 'secondary', 'outline', 'ghost', 'surface', 'surfaceOutline'] as const).map((v) => (
          <tr class="hover:bg-king-bg/20 transition-colors">
            <td class="px-5 py-3">
              <span class="text-[9px] font-mono font-medium text-king-text">{v}</span>
            </td>
            <td class="px-3 py-3"><Button variant={v} size="sm">{v}</Button></td>
            <td class="px-3 py-3"><Button variant={v}>{v}</Button></td>
            <td class="px-3 py-3"><Button variant={v} size="lg">{v}</Button></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<div class="bg-king-surface rounded-lg border border-king-border/30 shadow-sm p-5">
  <span class="text-[8px] font-mono uppercase tracking-[0.15em] text-king-accent/60 block mb-4">Con iconos</span>
  <div class="flex flex-wrap gap-3">
    <Button variant="primary">WhatsApp<Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" /></Button>
    <Button variant="secondary">Conocer<Icon name="arrow-left" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:-translate-x-1" /></Button>
    <Button variant="outline"><Icon name="shield-check" class="h-3.5 w-3.5" />Garant&iacute;a</Button>
    <Button variant="ghost"><Icon name="clock" class="h-3.5 w-3.5" />Historia</Button>
    <Button variant="surface"><Icon name="motorcycle" class="h-3.5 w-3.5" />Estilo</Button>
    <Button variant="surfaceOutline"><Icon name="paper-plane" class="h-3.5 w-3.5" />Contacto</Button>
  </div>
  <div class="mt-5 border-t border-king-border/10 pt-4">
    <span class="text-[8px] font-mono text-king-muted/40">Props: href, variant, size (sm|md|lg), target, rel, type, class</span>
  </div>
</div>
