---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-5">
  <Panel padding="md">
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-king-border/15">
            <th class="kb-code-label px-4 py-3 text-king-muted/45">Variant</th>
            <th class="kb-code-label px-3 py-3 text-king-muted/45">sm</th>
            <th class="kb-code-label px-3 py-3 text-king-muted/45">md</th>
            <th class="kb-code-label px-3 py-3 text-king-muted/45">lg</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-king-border/5">
          {(['primary', 'secondary', 'outline', 'ghost', 'surface', 'surfaceOutline'] as const).map((v) => (
            <tr class="hover:bg-king-bg/25 transition-colors">
              <td class="px-4 py-3">
                <span class="font-mono text-[var(--kb-text-eyebrow)] font-medium text-king-text/85">{v}</span>
              </td>
              <td class="px-3 py-3"><Button variant={v} size="sm">{v}</Button></td>
              <td class="px-3 py-3"><Button variant={v}>{v}</Button></td>
              <td class="px-3 py-3"><Button variant={v} size="lg">{v}</Button></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label block mb-5 text-king-accent/60">Con iconos</span>
    <div class="flex flex-wrap gap-3">
      <Button variant="primary">WhatsApp<Icon name="arrow-right" /></Button>
      <Button variant="secondary">Conocer<Icon name="arrow-left" /></Button>
      <Button variant="outline"><Icon name="shield-check" />Garantía</Button>
      <Button variant="ghost"><Icon name="clock" />Historia</Button>
      <Button variant="surface"><Icon name="motorcycle" />Estilo</Button>
      <Button variant="surfaceOutline"><Icon name="paper-plane" />Contacto</Button>
    </div>
    <div class="mt-6 pt-4 border-t border-king-border/15">
      <span class="font-mono text-[var(--kb-text-eyebrow)] text-king-muted/70">Props: href, variant, size (sm|md|lg), target, rel, type, disabled, class</span>
    </div>
  </Panel>
</div>
