---
import CTABox from '../ui/CTABox.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-6">
  <CTABox
    eyebrow="Edición limitada"
    title="Piezas únicas, hechas a mano."
    description="Cada cinturón cuenta una historia. Cuero vegetal, herrajes de latón, producción limitada."
    buttonLabel="Explorar edición"
    buttonHref="/edicion-limitada"
    buttonVariant="secondary"
    backgroundImage="/image.jpg"
    backgroundAlt="Detalle de cuero y herraje"
    backgroundWidth={1600}
    backgroundHeight={900}
    backgroundPosition="center 30%"
  />

  <CTABox
    eyebrow="Colección"
    title="Descubre las piezas de la temporada."
    description="Cuero seleccionado, herrajes macizos, diseño español. Cada pieza pensada para la ruta."
    buttonLabel="Ver colección"
    buttonHref="/coleccion"
    buttonVariant="surfaceOutline"
    backgroundImage="/image.jpg"
    backgroundAlt="Cinturón de cuero sobre superficie oscura"
    backgroundWidth={1600}
    backgroundHeight={900}
    backgroundPosition="center 60%"
  />

  <Panel padding="sm">
    <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">title, description?, eyebrow?, buttonLabel, buttonHref, buttonVariant (primary|secondary|outline|surfaceOutline), backgroundImage, backgroundAlt?, backgroundWidth?, backgroundHeight?, backgroundPosition?, titleTag?</span>
  </Panel>
</div>
