---
import Card from '../ui/Card.astro';
import Panel from '../ui/Panel.astro';

type CompInfo = {
  path: string;
  file: string;
  desc: string;
  props: string;
};

interface Props {
  type: 'layout' | 'sections';
}

const { type } = Astro.props;

const layoutComps: CompInfo[] = [
  { path: 'src/components/layout/', file: 'Header.astro', desc: 'Header responsivo con scroll. Temas, barra progreso, menú móvil.', props: 'initialTheme, scrolledTheme, compactThreshold' },
  { path: 'src/components/layout/', file: 'FooterSection.astro', desc: 'Footer con CTA banner, belt divider, grid marca/nav, tipografía gigante.', props: 'Datos de navigation.ts y site.ts' },
];

const sectionComps: CompInfo[] = [
  { path: 'src/components/sections/home/', file: 'Home', desc: 'Hero y recorrido editorial de portada, agrupados con su cabecera de sección específica.', props: 'Datos de home.ts, catalog.ts y blog.ts' },
  { path: 'src/components/sections/about/', file: 'About', desc: 'Origen, estándares, dirección, contexto y cierre editorial de la marca.', props: 'Bloques tipados de about.ts' },
  { path: 'src/components/sections/contact/', file: 'Contact', desc: 'Canales, formulario, compra, CTA, preguntas frecuentes y cierre por email.', props: 'Datos tipados de contact.ts' },
  { path: 'src/components/blog/', file: 'Blog', desc: 'Portada editorial, navegación temática, lectura, relacionados y CTA de marca compartida.', props: 'BlogPost y datos de blog.ts' },
];

const comps = type === 'layout' ? layoutComps : sectionComps;
---

<div class="grid md:grid-cols-2 gap-4">
  {comps.map((comp, idx) => {
    const isSteel = idx === 0;
    return (
    <Card variant={isSteel ? 'steel' : 'static'} padding="md">
      <div class="flex items-center gap-2 mb-2">
        <span class:list={['kb-code-label', isSteel ? 'text-white/55' : 'text-king-accent/70']}>{comp.path}</span>
      </div>
      <h3 class:list={['font-display text-[1rem] leading-tight mb-2 font-light', isSteel ? 'text-white/90' : 'text-king-text']}>{comp.file}</h3>
      <p class:list={['text-[var(--kb-text-2xs)] leading-relaxed mb-3 font-light', isSteel ? 'text-white/70' : 'text-king-muted']}>{comp.desc}</p>
      {comp.props && (
        <Panel variant={isSteel ? 'dark' : 'light'} padding="sm">
          <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
          <span class:list={['text-[var(--kb-text-eyebrow)] font-mono', isSteel ? 'text-white/75' : 'text-king-text/80']}>{comp.props}</span>
        </Panel>
      )}
    </Card>
    );
  })}
</div>
