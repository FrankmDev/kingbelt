---
import ContactMethod from '../ui/ContactMethod.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-4">
  <Panel padding="md">
    <div class="grid md:grid-cols-3 gap-3">
      <ContactMethod
        label="Email"
        value="hola@kingbelt.com"
        icon="mail"
        href="mailto:hola@kingbelt.com"
        description="Para consultas de producto, pedidos y atención general."
        index={1}
        meta="Respuesta en 24h"
        variant="steel"
      />
      <ContactMethod
        label="Teléfono"
        value="+34 XXX XXX XXX"
        icon="paper-plane"
        description="Canal disponible en horario laboral."
        index={2}
        meta="L–V 9:00–18:00"
      />
      <ContactMethod
        label="Instagram"
        value="@kingbelt"
        icon="instagram"
        href="https://instagram.com/kingbelt"
        description="La actualidad visual de la marca."
        index={3}
        meta="Red social"
      />
    </div>
  </Panel>

  <Panel padding="sm">
    <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">
      label, value, description?, href?, icon?, index?, meta?, variant?
    </span>
  </Panel>
</div>
