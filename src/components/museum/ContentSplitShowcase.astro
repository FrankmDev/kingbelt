---
import Button from '../ui/Button.astro';
import ContentSplit from '../ui/ContentSplit.astro';
import MediaFrame from '../ui/MediaFrame.astro';
import Panel from '../ui/Panel.astro';
import TagList from '../ui/TagList.astro';
---

<div class="space-y-6">
  <Panel padding="lg">
    <ContentSplit marker="Split layout" folio="01" ratio="60-40" align="start">
      <Fragment slot="title">
        Material, oficio y <em>presencia.</em>
      </Fragment>
      <Fragment slot="text">
        <div class="space-y-5">
          <p class="text-base leading-relaxed text-king-muted max-w-prose">
            Dos paneles separados por una línea de acero con remache de latón.
            El título vive en el panel de texto, la imagen horizontal ocupa el
            otro panel, y el cuerpo de texto cierra la lectura.
          </p>
          <TagList
            items={['Cuero vegetal', 'Hebilla maciza', 'Corte limpio']}
            variant="accent"
            size="sm"
            dot
          />
        </div>
      </Fragment>
      <Fragment slot="media">
        <MediaFrame
          src="/image.jpg"
          alt="Detalle de motocicleta en carretera como referencia visual KingBelt"
          ratio="16/9"
          label="Material test"
          width={1100}
          height={618}
        />
      </Fragment>
      <Fragment slot="actions">
        <Button href="#" variant="primary" size="md">Ver cinturones</Button>
        <Button href="#" variant="outline" size="md">Leer más</Button>
      </Fragment>
    </ContentSplit>
  </Panel>

  <Panel padding="lg">
    <ContentSplit
      reverse
      marker="Proceso"
      folio="02"
      ratio="40-60"
      align="start"
      mediaAlign="center"
    >
      <Fragment slot="title">
        La imagen abre, el texto <em>remata.</em>
      </Fragment>
      <Fragment slot="text">
        <div class="space-y-5">
          <p class="text-base leading-relaxed text-king-muted max-w-prose">
            Con <code>reverse</code> los paneles se intercambian en escritorio.
            En móvil el orden se mantiene legible: título, foto y cuerpo.
          </p>
          <TagList
            items={['Selección de piel', 'Corte y sellado', 'Montaje de herraje', 'Control de calidad']}
            variant="accent"
            size="sm"
            dot
          />
        </div>
      </Fragment>
      <Fragment slot="media">
        <MediaFrame
          src="/image.jpg"
          alt="Detalle de cuero y herraje en primer plano"
          ratio="16/9"
          label="Proceso"
          width={1100}
          height={618}
        />
      </Fragment>
      <Fragment slot="actions">
        <Button href="#" variant="primary" size="md">Ver proceso</Button>
        <Button href="#" variant="outline" size="md">Detalles</Button>
      </Fragment>
    </ContentSplit>
  </Panel>

  <Panel padding="lg">
    <ContentSplit marker="Equilibrio" folio="03" ratio="50-50" align="start">
      <Fragment slot="title">
        Equilibrio editorial, <em>sin ruido.</em>
      </Fragment>
      <Fragment slot="text">
        <div class="space-y-5">
          <p class="text-base leading-relaxed text-king-muted max-w-prose">
            Variante 50/50 para comparaciones o parejas de idea + imagen con el
            mismo peso. La fotografía sigue siendo horizontal y el divisor de
            acero mantiene la tensión entre ambos paneles.
          </p>
          <TagList
            items={['Simetría funcional', 'Espacio negativo', 'Jerarquía clara']}
            variant="accent"
            size="sm"
            dot
          />
        </div>
      </Fragment>
      <Fragment slot="media">
        <MediaFrame
          src="/image.jpg"
          alt="Composición de producto sobre superficie asfalto"
          ratio="16/9"
          label="Equilibrio"
          width={1100}
          height={618}
        />
      </Fragment>
      <Fragment slot="actions">
        <Button href="#" variant="primary" size="md">Explorar</Button>
        <Button href="#" variant="outline" size="md">Más info</Button>
      </Fragment>
    </ContentSplit>
  </Panel>

  <Panel padding="sm">
    <span class="kb-code-label block text-king-accent/50 mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">
      slots: title, media, text, caption, actions — props: title, marker, folio,
      reverse, ratio (50-50|40-60|60-40|70-30), gap (sm|md|lg|xl),
      align (start|center|end), mediaAlign (start|center|end)
    </span>
  </Panel>
</div>
