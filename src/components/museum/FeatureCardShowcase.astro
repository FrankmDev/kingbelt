---
import FeatureCard from '../ui/FeatureCard.astro';
import FeatureGrid from '../ui/FeatureGrid.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-6">
  <Panel padding="md">
    <span class="kb-code-label block text-king-accent/50 mb-3">Con numeral folio — reemplaza iconos genéricos SaaS</span>
    <FeatureGrid columns={3}>
      <FeatureCard number="01" eyebrow="Material" title="Cuero seleccionado" description="Grosor y cuerpo que se notan al tacto. Diseñado para la ruta." meta="Fibra / Grosor" />
      <FeatureCard number="02" eyebrow="Hardware" title="Hebilla maciza" description="Metal sólido, sin plástico. El peso justo para cerrar con confianza." meta="Metal / Cierre" variant="steel" />
      <FeatureCard number="03" eyebrow="Origen" title="Hecho en España" description="Producción próxima y controlada. Pieza a pieza, sin stock ciego." meta="Taller / Control" />
    </FeatureGrid>
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label block text-king-accent/50 mb-3">Con icono inline — solo si hace falta marcar la categoría</span>
    <FeatureGrid columns={3}>
      <FeatureCard icon="shield-check" eyebrow="Protección" title="Garantía de por vida" description="Cubrimos defectos de fabricación sin límite de tiempo." meta="Cobertura / Vida útil" />
      <FeatureCard icon="hammer" eyebrow="Proceso" title="Curtido vegetal" description="Sin cromo, sin atajos. Proceso lento que respeta la fibra." meta="Fibra / Tiempo" variant="steel" />
      <FeatureCard icon="ruler" eyebrow="Medida" title="Talla exacta" description="Cinturón cortado a medida. Sin agujeros genéricos." meta="Corte / Ajuste" />
    </FeatureGrid>
  </Panel>

  <Panel padding="sm">
    <span class="kb-code-label text-king-accent/50 block mb-1">FeatureCard props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">eyebrow, title, description, icon, number, meta, href, variant (default|steel|dark)</span>
    <span class="kb-code-label text-king-accent/50 block mt-2 mb-1">FeatureGrid props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">columns (2|3|4), gap (sm|md|lg)</span>
  </Panel>
</div>
