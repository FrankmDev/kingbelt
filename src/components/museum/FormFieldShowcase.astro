---
import FormField from '../ui/FormField.astro';
import Button from '../ui/Button.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-4">
  <Panel padding="md" class="max-w-lg">
    <form class="space-y-5">
      <FormField label="Nombre" for="museum-name" required help="Tu nombre completo">
        <input id="museum-name" name="name" type="text" autocomplete="name" aria-describedby="museum-name-help" class="kb-input" placeholder="Ej: Carlos…" />
      </FormField>

      <FormField label="Email" for="museum-email" required help="Te responderemos aquí" icon="mail">
        <input id="museum-email" name="email" type="email" autocomplete="email" spellcheck="false" aria-describedby="museum-email-help" class="kb-input" placeholder="ej: hola@correo.com…" />
      </FormField>

      <FormField label="Mensaje" for="museum-message" help="Cuéntanos en qué podemos ayudarte">
        <textarea id="museum-message" name="message" autocomplete="off" aria-describedby="museum-message-help" class="kb-input" rows={3} placeholder="Tu mensaje…"></textarea>
      </FormField>

      <FormField label="Teléfono" for="museum-phone" error="Introduce un número válido">
        <input id="museum-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" aria-describedby="museum-phone-error" aria-invalid="true" class="kb-input" placeholder="+34…" />
      </FormField>

      <div class="pt-2">
        <Button type="button" variant="primary" size="md">Enviar</Button>
      </div>
    </form>
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">label, for?, help?, error?, required?, icon?, slot (input/select/textarea)</span>
  </Panel>
</div>
