---
import Icon from '../ui/Icon.astro';
import Panel from '../ui/Panel.astro';

const icons = [
  'arrow-right', 'arrow-left', 'arrow-up-right', 'caret-down', 'chevron-right',
  'star', 'check', 'x', 'menu', 'external-link',
  'motorcycle', 'shield', 'shield-check', 'lightning',
  'hammer', 'wrench', 'engine', 'ruler',
  'clock', 'instagram', 'mail', 'paper-plane',
];
---

<Panel padding="md">
  <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-3">
    {icons.map((ico) => (
      <div class="group flex cursor-default flex-col items-center gap-2 rounded-md border border-king-border/20 bg-king-bg p-3 transition-[border-color,box-shadow,transform] duration-[var(--kb-dur-fast)] hover:-translate-y-0.5 hover:border-king-accent/35 hover:shadow-[var(--kb-shadow-sm)]">
        <Icon name={ico} class="w-4 h-4 text-king-accent group-hover:scale-110 transition-transform duration-[var(--kb-dur-fast)]" />
        <span class="text-[7px] font-mono text-king-muted/75 text-center leading-tight">{ico}</span>
      </div>
    ))}
  </div>

  <p class="text-[var(--kb-text-eyebrow)] font-mono text-king-muted/60 mt-5">Props: name, class, title, strokeWidth</p>
</Panel>
