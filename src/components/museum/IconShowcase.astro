---
import Icon from '../ui/Icon.astro';

const icons = [
  'arrow-right', 'arrow-left', 'caret-down', 'star',
  'motorcycle', 'shield', 'shield-check', 'lightning',
  'hammer', 'wrench', 'engine', 'ruler',
  'clock', 'instagram', 'mail', 'paper-plane',
];
---

<div class="grid grid-cols-4 sm:grid-cols-8 gap-2">
  {icons.map((ico) => (
    <div class="bg-king-surface rounded-md p-3 border border-king-border/20 hover:border-king-accent/30 transition-all duration-300 flex flex-col items-center gap-2 group cursor-default">
      <Icon name={ico} class="w-4 h-4 text-king-accent group-hover:scale-110 transition-transform duration-300" />
      <span class="text-[7px] font-mono text-king-muted/50 text-center leading-tight">{ico}</span>
    </div>
  ))}
</div>

<p class="text-[9px] font-mono text-king-muted/40 mt-4">Props: name, class</p>
