---
import MediaFrame from '../ui/MediaFrame.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-6">
  <Panel padding="md">
    <span class="kb-code-label block text-king-accent/50 mb-3">Hero con información — label + caption</span>
    <MediaFrame
      src="/image.jpg"
      alt="Detalle de cuero y oficio KingBelt"
      variant="hero"
      ratio="16/9"
      label="Ruta"
      caption="La carretera como destino. Cada kilómetro cuenta una historia."
      captionNumber="01"
      width={1600}
      height={900}
      loading="eager"
      fetchpriority="high"
    />
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label block text-king-accent/50 mb-3">Hero sin información — imagen limpia</span>
    <MediaFrame
      src="/image.jpg"
      alt="Detalle de cuero y herraje"
      variant="hero"
      ratio="16/9"
      width={1600}
      height={900}
    />
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label block text-king-accent/50 mb-3">Galería 2x1 — dos imágenes iguales</span>
    <MediaFrame
      variant="gallery"
      images={[
        { src: '/image.jpg', alt: 'Detalle de cuero vegetal' },
        { src: '/image.jpg', alt: 'Detalle de cuero vegetal' },
      ]}
    />
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label block text-king-accent/50 mb-3">Galería — varias imágenes</span>
    <MediaFrame
      variant="gallery"
      images={[
        { src: '/image.jpg', alt: 'Detalle de cuero 1' },
        { src: '/image.jpg', alt: 'Detalle de cuero 2' },
        { src: '/image.jpg', alt: 'Detalle de cuero 3' },
      ]}
    />
  </Panel>

  <Panel padding="sm">
    <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">src, alt, ratio (16/9|21/9|4/3|3/2|1/1), caption?, label?, variant (hero|gallery), captionNumber?, images?, width?, height?, loading?, fetchpriority?</span>
  </Panel>
</div>
