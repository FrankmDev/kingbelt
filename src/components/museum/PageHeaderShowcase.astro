---
import PageHeader from '../ui/PageHeader.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-6">
  <Panel padding="none" class="overflow-hidden">
    <PageHeader
      eyebrow="Colección ruta"
      description="Una cabecera editorial con imagen de fondo para páginas internas, campañas o categorías con fuerte carga visual."
      image="/image.jpg"
      imageAlt=""
      imagePosition="center 58%"
      meta="KingBelt · Est. 2026"
    >
      <Fragment slot="title">Piezas listas para la <em>carretera.</em></Fragment>
    </PageHeader>
  </Panel>

  <Panel padding="none" class="overflow-hidden">
    <PageHeader
      variant="blog"
      eyebrow="Bitácora"
      description="Reflexiones sobre materiales, mantenimiento y oficio alrededor del cuero para la ruta."
      image="/image.jpg"
      imageAlt=""
      imagePosition="center 40%"
      breadcrumbs={[{ label: 'Blog', href: '/blog' }, { label: 'Cuidado del cuero' }]}
      articleMeta={{
        category: 'Mantenimiento',
        date: '09 jul. 2026',
        readTime: '6 min',
        image: '/image.jpg',
        imageAlt: 'Detalle de cuero para artículo de mantenimiento',
        imagePosition: 'center 40%',
      }}
    >
      <Fragment slot="title">Cómo curar el cuero para que dure <em>kilómetros.</em></Fragment>
    </PageHeader>
  </Panel>

  <Panel padding="sm">
    <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">variant, eyebrow, title (slot), description, image, imageAlt, imagePosition, meta, breadcrumbs, articleMeta</span>
  </Panel>
</div>
