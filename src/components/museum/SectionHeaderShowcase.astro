---
import SectionHeader from '../common/SectionHeader.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-4">
  <Panel padding="md">
    <div class="space-y-6">
      <div>
        <span class="kb-code-label text-king-accent/50 block mb-2">Variant: left</span>
        <SectionHeader
          eyebrow="Eyebrow label"
          number="01" numberTotal="04"
          body="Body text description lorem ipsum dolor sit amet."
          meta="Meta"
        >
          <Fragment slot="title">
            Título <span class="italic text-king-accent">con acento.</span>
          </Fragment>
        </SectionHeader>
      </div>

      <div>
        <span class="kb-code-label text-king-accent/50 block mb-2">Variant: center</span>
        <SectionHeader
          eyebrow="Centered"
          number="02" numberTotal="04"
          body="Versión centrada."
          meta="Center"
          align="center"
        >
          <Fragment slot="title">
            Centered <span class="italic text-king-accent">variant.</span>
          </Fragment>
        </SectionHeader>
      </div>

      <Panel variant="dark" padding="md">
        <span class="kb-code-label text-white/40 block mb-2">Variant: dark</span>
        <SectionHeader
          eyebrow="Dark tone"
          number="03" numberTotal="04"
          body="Dark tone example."
          tone="dark"
          align="center"
        >
          <Fragment slot="title">
            Dark <span class="italic">tone</span> example.
          </Fragment>
        </SectionHeader>
      </Panel>
    </div>
  </Panel>

  <Panel padding="sm">
    <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80">eyebrow, title (slot), body, meta, number, numberTotal, align (left|center), tone (light|dark)</span>
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label text-king-accent/50 block mb-3">ScrollReveal.astro</span>
    <p class="text-[var(--kb-text-2xs)] text-king-muted leading-relaxed mb-4 font-light">
      IntersectionObserver que revela <span class="font-mono text-[var(--kb-text-eyebrow)] text-king-accent">.animate-on-scroll</span> con <span class="font-mono text-[var(--kb-text-eyebrow)] text-king-accent">.is-visible</span>.
    </p>
    <div class="flex flex-wrap gap-2">
      {['.animate-on-scroll', 'delay-1', 'delay-2', 'delay-3'].map((d) => (
        <div class="animate-on-scroll is-visible bg-king-accent/8 rounded-md px-3 py-1.5 border border-king-accent/10">
          <span class="text-[var(--kb-text-eyebrow)] font-medium text-king-accent">{d}</span>
        </div>
      ))}
    </div>
  </Panel>
</div>
