---
import SectionHeader from '../common/SectionHeader.astro';
import Panel from '../ui/Panel.astro';
---

<div class="space-y-4">
  <Panel padding="md">
    <div class="space-y-10">
      <div>
        <span class="kb-code-label text-king-accent/50 block mb-3">Default — center</span>
        <SectionHeader
          eyebrow="La marca"
          meta="España"
          body="KingBelt nace para hacer accesorios de cuero pensados para la ruta: material con criterio, revisión pieza a pieza y atención directa."
        >
          <Fragment slot="title">
            Hecho para la ruta, <em>pensado para durar</em>.
          </Fragment>
        </SectionHeader>
      </div>

      <div>
        <span class="kb-code-label text-king-accent/50 block mb-3">Variant: left — sidebar / FAQ</span>
        <SectionHeader
          eyebrow="Preguntas frecuentes"
          body="Filtra por tema o busca directamente. Si no encuentras lo que buscas, escríbenos y te respondemos en menos de 24 horas laborables."
          align="left"
        >
          <Fragment slot="title">
            Resolvemos las dudas <em>antes de que surjan</em>.
          </Fragment>
        </SectionHeader>
      </div>

      <div>
        <span class="kb-code-label text-king-accent/50 block mb-3">Variant: compact — museo / índice</span>
        <SectionHeader
          eyebrow="Patrones"
          density="compact"
        >
          <Fragment slot="title">Section header</Fragment>
        </SectionHeader>
      </div>

      <Panel variant="dark" padding="md">
        <span class="kb-code-label text-white/40 block mb-3">Variant: dark tone</span>
        <SectionHeader
          eyebrow="Proceso"
          meta="3 pasos"
          body="Cada pieza tiene un recorrido: desde la selección del material hasta que llega a tus manos."
          tone="dark"
        >
          <Fragment slot="title">
            Pensado para <em>moverse contigo</em>.
          </Fragment>
        </SectionHeader>
      </Panel>
    </div>
  </Panel>

  <Panel padding="sm">
    <span class="kb-code-label text-king-accent/50 block mb-1">Props</span>
    <span class="text-[var(--kb-text-eyebrow)] font-mono text-king-text/80 leading-relaxed">
      eyebrow, title (slot), body (slot), meta,
      align (left|center, default center), tone (light|dark), density (default|compact).
      Destaca palabras en el título con <span class="text-king-accent">&lt;em&gt;</span>.
    </span>
  </Panel>

  <Panel padding="md">
    <span class="kb-code-label text-king-accent/50 block mb-3">ScrollReveal.astro</span>
    <p class="text-[var(--kb-text-2xs)] text-king-muted leading-relaxed mb-4 font-light">
      IntersectionObserver que revela <span class="font-mono text-[var(--kb-text-eyebrow)] text-king-accent">.animate-on-scroll</span> con <span class="font-mono text-[var(--kb-text-eyebrow)] text-king-accent">.is-visible</span>.
    </p>
    <div class="flex flex-wrap gap-2">
      {['.animate-on-scroll', 'delay-1', 'delay-2', 'delay-3'].map((d) => (
        <div class="animate-on-scroll is-visible bg-king-accent/8 rounded-md px-3 py-1.5 border border-king-accent/10">
          <span class="text-[var(--kb-text-eyebrow)] font-medium text-king-accent">{d}</span>
        </div>
      ))}
    </div>
  </Panel>
</div>
