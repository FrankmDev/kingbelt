---
import Button from '../ui/Button.astro';
import FormField from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';
import { formatMoney } from '../../lib/commerce/money';
import { getFirstAvailableVariant, getMaxSelectableQuantity } from '../../lib/commerce/product-variants';
import type { CommerceProduct } from '../../lib/commerce/types';

interface Props {
  product: CommerceProduct;
}

const { product } = Astro.props;
const formId = `add-to-cart-${product.handle}`;
const quantityErrorId = `${formId}-quantity-error`;
const feedbackId = `${formId}-feedback`;
const initialVariant = getFirstAvailableVariant(product) ?? product.variants[0];
const purchasable = Boolean(initialVariant?.availableForSale);
const initialMax = getMaxSelectableQuantity(initialVariant);
const optionKey = (value: string) => value.toLocaleLowerCase('es').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-');
const initialValue = (name: string) => initialVariant?.selectedOptions.find((option) => option.name === name)?.value;
const publicVariants = product.variants.map((variant) => ({
  id: variant.id,
  selectedOptions: variant.selectedOptions,
  availableForSale: variant.availableForSale,
  quantityAvailable: variant.quantityAvailable,
  price: variant.price,
  compareAtPrice: variant.compareAtPrice,
  image: variant.image,
}));
const variantsJson = JSON.stringify({ options: product.options, variants: publicVariants })
  .replace(/&/g, '\\u0026')
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---

<form
  id={formId}
  class="product-buy"
  data-product-add-form
  aria-describedby={feedbackId}
  novalidate
>
  <div class="product-buy__price-row" aria-live="polite">
    <p class="product-buy__price font-display" data-product-price>
      {initialVariant ? formatMoney(initialVariant.price) : formatMoney(product.priceRange.min)}
    </p>
    <p class="product-buy__compare" data-product-compare hidden={!initialVariant?.compareAtPrice}>
      {initialVariant?.compareAtPrice ? formatMoney(initialVariant.compareAtPrice) : ''}
    </p>
  </div>

  {product.options.map((option) => {
    const key = optionKey(option.name);
    const errorId = `${formId}-${key}-error`;
    const isColor = option.name.toLocaleLowerCase('es') === 'color';
    const isSize = option.name.toLocaleLowerCase('es') === 'talla';
    return (
      <fieldset class="product-buy__fieldset" aria-describedby={errorId} data-product-option-group={option.name}>
        <legend class="product-buy__legend kb-label">{isSize ? 'Talla (cm)' : option.name}</legend>
        <div class={isColor ? 'product-buy__swatches' : 'product-buy__sizes'} role="radiogroup" aria-label={`Seleccionar ${option.name.toLocaleLowerCase('es')}`}>
          {option.values.map((value) => (
            <label class={isColor ? 'product-buy__swatch' : 'product-buy__size'} title={isColor ? value.value : undefined}>
              <input
                type="radio"
                name={`${formId}-option-${key}`}
                value={value.value}
                class="sr-only"
                data-product-option
                data-option-name={option.name}
                checked={initialValue(option.name) === value.value}
                required
              />
              {isColor ? (
                <>
                  <span class="product-buy__swatch-chip" style={`background: ${value.swatch ?? 'transparent'}`} aria-hidden="true" />
                  <span class="product-buy__swatch-label kb-meta-label">{value.value}</span>
                </>
              ) : (
                <span class="product-buy__size-chip kb-meta-label">{value.value}</span>
              )}
            </label>
          ))}
        </div>
        <p id={errorId} class="product-buy__field-error" data-error-for-option={option.name} role="alert" hidden></p>
      </fieldset>
    );
  })}

  <FormField label="Cantidad" for={`qty-${product.handle}`} required>
    <div class="product-buy__qty">
      <button
        type="button"
        class="product-buy__qty-btn"
        data-product-qty-decrease
        aria-label="Reducir cantidad"
        disabled={!purchasable}
      >
        <Icon name="minus" class="h-3.5 w-3.5" />
      </button>
      <input
        id={`qty-${product.handle}`}
        type="number"
        class="kb-input product-buy__qty-input"
        name="quantity"
        value="1"
        min="1"
        max={Math.max(1, initialMax)}
        inputmode="numeric"
        data-product-quantity
        aria-describedby={quantityErrorId}
        required
        disabled={!purchasable}
      />
      <button
        type="button"
        class="product-buy__qty-btn"
        data-product-qty-increase
        aria-label="Aumentar cantidad"
        disabled={!purchasable}
      >
        <Icon name="plus" class="h-3.5 w-3.5" />
      </button>
    </div>
    <p id={quantityErrorId} class="product-buy__field-error" data-error-for="quantity" role="alert" hidden></p>
  </FormField>

  <div class="product-buy__actions">
    <Button
      type="submit"
      variant="primary"
      size="lg"
      class="product-buy__submit"
      data-product-submit
      disabled={!purchasable}
    >
      <span data-product-submit-label>{purchasable ? 'Añadir al carrito' : 'Agotado'}</span>
    </Button>
    <div class="product-buy__drawer-wrap" data-product-drawer-wrap hidden>
      <Button
        type="button"
        variant="outline"
        size="md"
        data-product-open-drawer
      >
        Ver carrito
      </Button>
    </div>
  </div>

  <p
    id={feedbackId}
    class="product-buy__feedback"
    data-product-feedback
    role="status"
    aria-live="polite"
    hidden={purchasable}
  >{purchasable ? '' : 'Este producto no está disponible actualmente.'}</p>

  <script is:inline type="application/json" data-product-variants set:html={variantsJson}></script>
</form>

<script>
  import { initProductAddForms } from '../../lib/commerce/product-add-to-cart';
  initProductAddForms();
</script>

<style>
  .product-buy {
    display: grid;
    gap: var(--kb-space-5);
    min-width: 0;
  }

  .product-buy__price {
    margin: 0;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-king-text);
  }

  .product-buy__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--kb-space-3);
  }

  .product-buy__compare {
    margin: 0;
    font-size: var(--kb-text-sm);
    color: var(--color-king-muted);
    text-decoration: line-through;
    font-variant-numeric: tabular-nums;
  }

  .product-buy__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .product-buy__legend {
    margin-bottom: var(--kb-space-3);
  }

  .product-buy__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kb-space-3);
  }

  .product-buy__swatch {
    display: grid;
    gap: var(--kb-space-2);
    justify-items: center;
    cursor: pointer;
    min-width: 0;
  }

  .product-buy__swatch-chip {
    display: block;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-pill);
    transition:
      box-shadow var(--kb-dur-fast) var(--kb-ease-out),
      border-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__swatch input:checked + .product-buy__swatch-chip {
    border-color: var(--color-king-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-king-accent) 25%, transparent);
  }

  .product-buy__swatch input:focus-visible + .product-buy__swatch-chip {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  .product-buy__swatch input:disabled + .product-buy__swatch-chip,
  .product-buy__size input:disabled + .product-buy__size-chip {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .product-buy__swatch[data-impossible],
  .product-buy__size[data-impossible] {
    cursor: not-allowed;
  }

  .product-buy__fieldset:disabled .product-buy__swatch,
  .product-buy__fieldset:disabled .product-buy__size {
    cursor: not-allowed;
  }

  .product-buy__swatch-label {
    color: var(--color-king-muted);
    text-align: center;
  }

  .product-buy__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kb-space-2);
  }

  .product-buy__size {
    cursor: pointer;
  }

  .product-buy__size-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--kb-space-3);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    color: var(--color-king-text);
    background: var(--color-king-bg);
    transition:
      border-color var(--kb-dur-fast) var(--kb-ease-out),
      color var(--kb-dur-fast) var(--kb-ease-out),
      background-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__size input:checked + .product-buy__size-chip {
    border-color: var(--color-king-accent);
    color: var(--color-king-accent);
    background: color-mix(in srgb, var(--color-king-accent) 6%, var(--color-king-bg));
  }

  .product-buy__size input:focus-visible + .product-buy__size-chip {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  .product-buy__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    overflow: hidden;
    background: var(--color-king-bg);
  }

  .product-buy__qty-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    color: var(--color-king-text);
    background: transparent;
    transition: background-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__qty-btn:hover {
    background: var(--color-king-bone);
  }

  .product-buy__qty-btn:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: -2px;
    z-index: 1;
  }

  .product-buy__qty-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .product-buy__qty-input {
    width: 3.25rem;
    min-height: 2.75rem;
    border: 0;
    border-inline: 1px solid var(--kb-stroke-hairline);
    border-radius: 0;
    text-align: center;
    -moz-appearance: textfield;
  }

  .product-buy__qty-input::-webkit-outer-spin-button,
  .product-buy__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product-buy__actions {
    display: grid;
    gap: var(--kb-space-3);
  }

  .product-buy__actions :global(.kb-btn) {
    width: 100%;
    justify-content: center;
  }

  .product-buy__feedback {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.5;
    color: var(--color-king-accent);
  }

  .product-buy__feedback.is-error {
    color: var(--color-king-error);
  }

  .product-buy__field-error {
    margin: var(--kb-space-2) 0 0;
    font-size: var(--kb-text-meta);
    line-height: 1.5;
    color: var(--color-king-error);
  }
</style>
