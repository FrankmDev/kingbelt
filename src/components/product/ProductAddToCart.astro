---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { formatMoney } from '@commerce/domain/money';
import { calculatePriceRange, getFirstAvailableVariant } from '@commerce/domain/variants';
import { getVariantAvailability } from '@commerce/domain/inventory';
import {
  toCompactPublicBuyBoxPayload,
  toPublicBuyBoxVariant,
} from '@commerce/domain/product-mappers';
import type { Product } from '@commerce/domain/catalog';
import { resolveColorSwatch } from '@commerce/domain/color-swatch';
import { serializeJsonForHtml } from '@shared/security/serialize-json-for-html';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const formId = `add-to-cart-${product.handle}`;
const quantityErrorId = `${formId}-quantity-error`;
const feedbackId = `${formId}-feedback`;
const availabilityId = `${formId}-availability`;
const submitHintId = `${formId}-submit-hint`;
const initialVariant = getFirstAvailableVariant(product) ?? product.variants[0];
const initialAvailability = initialVariant ? getVariantAvailability(initialVariant) : undefined;
const publicInitial = initialVariant ? toPublicBuyBoxVariant(initialVariant) : undefined;
const purchasable = initialAvailability?.purchasable ?? false;
/** Tope HTML público: nunca el stock exacto cuando la política lo oculta. */
const initialMax = publicInitial?.availability.maxQuantity ?? 0;
const initialMinimum = publicInitial?.availability.minimum ?? 1;
const initialIncrement = publicInitial?.availability.increment ?? 1;
const initialSubmitLabel = purchasable
  ? 'Añadir al carrito'
  : initialAvailability?.status === 'out_of_stock'
    ? 'Agotado'
    : 'No disponible';
const priceRange = calculatePriceRange(product.variants);
const optionKey = (value: string) => value.toLocaleLowerCase('es').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-');
const initialValue = (optionId: string) => initialVariant?.optionValues.find((option) => option.optionId === optionId)?.valueId;
const variantsJson = serializeJsonForHtml(toCompactPublicBuyBoxPayload(product));
---

<form
  id={formId}
  class="product-buy"
  data-product-add-form
  aria-describedby={`${availabilityId} ${feedbackId} ${submitHintId}`}
  novalidate
>
  <div class="product-buy__header">
    <div class="product-buy__price-row">
      <p class="product-buy__price font-display" data-product-price>
        {initialVariant ? formatMoney(initialVariant.price) : formatMoney(priceRange.min)}
      </p>
      <p class="product-buy__compare" data-product-compare hidden={!initialVariant?.compareAtPrice}>
        {initialVariant?.compareAtPrice ? formatMoney(initialVariant.compareAtPrice) : ''}
      </p>
    </div>
    <p
      id={availabilityId}
      class="product-buy__availability kb-meta-label"
      data-product-availability
      data-availability-status={initialAvailability?.status}
      role="status"
      aria-live="polite"
    >{initialAvailability?.message ?? 'Esta combinación no está disponible.'}</p>
  </div>

  <slot />

  <div class="product-buy__panel">
    {product.options.map((option) => {
      const key = optionKey(option.name);
      const errorId = `${formId}-${key}-error`;
      const isColor = option.purpose === 'color';
      const isSize = option.purpose === 'size';
      return (
        <fieldset
          class:list={[
            'product-buy__option',
            isColor && 'product-buy__option--color',
            isSize && 'product-buy__option--size',
          ]}
          aria-describedby={errorId}
          data-product-option-group={option.id}
          data-product-option-name={option.name}
          data-product-option-purpose={option.purpose}
        >
          <div class:list={[isSize && 'product-buy__option-row']}>
            <legend class="product-buy__legend">
              <span class="product-buy__legend-label kb-meta-label">{isSize ? 'Talla (cm)' : option.name}</span>
            </legend>
            <div class={isColor ? 'product-buy__swatches' : 'product-buy__sizes'}>
              {option.values.map((value) => (
                <label class={isColor ? 'product-buy__swatch' : 'product-buy__size'} title={isColor ? value.label : undefined}>
                  <input
                    type="radio"
                    name={`${formId}-option-${key}`}
                    value={value.id}
                    class="sr-only"
                    data-product-option
                    data-option-id={option.id}
                    data-option-value-label={value.label}
                    checked={initialValue(option.id) === value.id}
                    required
                  />
                  {isColor ? (
                    <>
                      <span class="product-buy__swatch-media" aria-hidden="true">
                        <span
                          class="product-buy__swatch-chip"
                          style={`background: ${resolveColorSwatch(value.label, value.swatch)}`}
                        />
                      </span>
                      <span class="product-buy__swatch-label kb-meta-label">{value.label}</span>
                    </>
                  ) : (
                    <span class="product-buy__size-chip">{value.label}</span>
                  )}
                  <span class="sr-only" data-impossible-hint hidden>No compatible con la selección actual</span>
                </label>
              ))}
            </div>
          </div>
          <p id={errorId} class="product-buy__field-error" data-error-for-option={option.id} role="alert" hidden></p>
        </fieldset>
      );
    })}

    <div class="product-buy__checkout">
      <fieldset class="product-buy__option product-buy__option--qty">
        <legend class="product-buy__legend">
          <span class="product-buy__legend-label kb-meta-label">Cantidad</span>
        </legend>
        <div class="product-buy__qty" data-product-qty>
          <button
            type="button"
            class="product-buy__qty-btn"
            data-product-qty-decrease
            aria-label="Reducir cantidad"
            disabled={!purchasable}
          >
            <Icon name="minus" class="h-3.5 w-3.5" />
          </button>
          <input
            id={`qty-${product.handle}`}
            type="number"
            class="product-buy__qty-input"
            name="quantity"
            value={initialMinimum}
            min={initialMinimum}
            max={Math.max(1, initialMax)}
            step={initialIncrement}
            inputmode="numeric"
            data-product-quantity
            aria-describedby={quantityErrorId}
            required
            disabled={!purchasable}
          />
          <button
            type="button"
            class="product-buy__qty-btn"
            data-product-qty-increase
            aria-label="Aumentar cantidad"
            disabled={!purchasable}
          >
            <Icon name="plus" class="h-3.5 w-3.5" />
          </button>
        </div>
        <p id={quantityErrorId} class="product-buy__field-error" data-error-for="quantity" role="alert" hidden></p>
      </fieldset>

      <div class="product-buy__actions">
        <Button
          type="submit"
          variant="primary"
          size="md"
          class="product-buy__submit"
          data-product-submit
          disabled={!purchasable}
          aria-describedby={submitHintId}
        >
          <span data-product-submit-label>{initialSubmitLabel}</span>
        </Button>
        <div class="product-buy__drawer-wrap" data-product-drawer-wrap hidden>
          <Button
            type="button"
            variant="outline"
            size="md"
            data-product-open-drawer
          >
            Ver carrito
          </Button>
        </div>
      </div>
    </div>
  </div>

  <p
    id={submitHintId}
    class="sr-only"
    data-product-submit-hint
  >{purchasable ? '' : initialSubmitLabel}</p>

  <p
    id={feedbackId}
    class="product-buy__feedback"
    data-product-feedback
    role="status"
    aria-live="polite"
    hidden
  ></p>

  <script is:inline type="application/json" data-product-variants set:html={variantsJson}></script>
</form>

<script>
  import { initProductAddForms } from '@scripts/commerce/product-add-to-cart';
  initProductAddForms();
</script>

<style>
  .product-buy {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    min-width: 0;
  }

  .product-buy__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--kb-space-2) var(--kb-space-4);
    padding-bottom: var(--kb-space-3);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .product-buy__price {
    margin: 0;
    font-size: clamp(1.6875rem, 1.42rem + 0.9vw, 2.0625rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 0.96;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: "tnum" 1, "lnum" 1;
    color: var(--color-king-text);
  }

  .product-buy__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--kb-space-2) var(--kb-space-3);
  }

  .product-buy__compare {
    margin: 0;
    font-size: var(--kb-text-sm);
    color: var(--color-king-muted);
    text-decoration: line-through;
    font-variant-numeric: tabular-nums;
  }

  .product-buy__availability {
    margin: 0;
    color: var(--color-king-muted);
    letter-spacing: 0.06em;
    text-align: end;
  }

  .product-buy__availability[data-availability-status='limited'] {
    color: var(--color-king-accent);
  }

  .product-buy__availability[data-availability-status='out_of_stock'],
  .product-buy__availability[data-availability-status='unavailable'] {
    color: var(--color-king-error);
  }

  .product-buy__panel {
    display: grid;
    gap: var(--kb-space-4);
    padding: var(--kb-space-4);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-card-radius);
    background: color-mix(in srgb, var(--color-king-bone) 24%, var(--color-king-bg));
  }

  @media (min-width: 48rem) {
    .product-buy__panel {
      margin-top: auto;
    }

    .product-buy__checkout {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
    }
  }

  @media (max-width: 47.99rem) {
    .product-buy__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--kb-space-2);
    }

    .product-buy__availability {
      text-align: start;
    }

    .product-buy__panel {
      padding: var(--kb-space-3);
    }

    .product-buy__checkout {
      grid-template-columns: 1fr;
    }

    .product-buy__size-chip {
      min-height: 2.75rem;
      font-size: var(--kb-text-xs);
    }
  }

  .product-buy__option {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .product-buy__option + .product-buy__option,
  .product-buy__checkout {
    padding-top: var(--kb-space-4);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .product-buy__option-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-3);
  }

  .product-buy__option--size .product-buy__option-row {
    display: grid;
    gap: var(--kb-space-2);
    width: 100%;
  }

  .product-buy__option--size .product-buy__legend {
    margin: 0;
  }

  .product-buy__option--size .product-buy__sizes {
    width: 100%;
  }

  .product-buy__legend {
    display: block;
    margin: 0 0 var(--kb-space-2);
    padding: 0;
  }

  .product-buy__legend-label {
    color: var(--color-king-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: var(--kb-text-meta);
  }

  .product-buy__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kb-space-3) var(--kb-space-4);
  }

  .product-buy__swatch {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    width: 3.75rem;
    cursor: pointer;
    min-width: 0;
  }

  .product-buy__swatch-media {
    display: grid;
    place-items: center;
    width: 2.625rem;
    height: 2.625rem;
    padding: 3px;
    border: 1px solid color-mix(in srgb, var(--kb-stroke-hairline) 90%, var(--color-king-text));
    border-radius: var(--kb-radius-pill);
    background: var(--color-king-bg);
    transition:
      border-color var(--kb-dur-fast) var(--kb-ease-out),
      box-shadow var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__swatch-chip {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-king-text) 12%, transparent);
  }

  .product-buy__swatch input:checked + .product-buy__swatch-media {
    border-color: var(--color-king-text);
    box-shadow: 0 0 0 1px var(--color-king-text);
  }

  .product-buy__swatch input:focus-visible + .product-buy__swatch-media {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 2px;
  }

  .product-buy__swatch input:checked ~ .product-buy__swatch-label {
    color: var(--color-king-text);
  }

  .product-buy__swatch[data-impossible] .product-buy__swatch-media,
  .product-buy__size[data-impossible] .product-buy__size-chip {
    text-decoration: line-through;
    opacity: 0.45;
  }

  .product-buy__swatch input:disabled + .product-buy__swatch-media,
  .product-buy__size input:disabled + .product-buy__size-chip {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .product-buy__swatch[data-impossible],
  .product-buy__size[data-impossible] {
    cursor: not-allowed;
  }

  .product-buy__swatch-label {
    width: 100%;
    color: var(--color-king-muted);
    font-size: var(--kb-text-eyebrow);
    font-weight: var(--kb-label-weight);
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__sizes {
    display: flex;
    width: 100%;
    max-width: 100%;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    overflow: hidden;
    background: var(--color-king-bg);
  }

  .product-buy__size {
    flex: 1 1 0;
    min-width: 0;
    cursor: pointer;
  }

  .product-buy__size + .product-buy__size {
    border-inline-start: 1px solid var(--kb-stroke-hairline);
  }

  .product-buy__size-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.5rem;
    padding: 0 var(--kb-space-1);
    border: 0;
    border-radius: 0;
    font-family: var(--font-sans);
    font-size: var(--kb-text-sm);
    font-weight: var(--kb-w-medium);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    color: var(--color-king-text);
    background: transparent;
    transition:
      color var(--kb-dur-fast) var(--kb-ease-out),
      background-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__size input:checked + .product-buy__size-chip {
    color: var(--color-king-bg);
    background: var(--color-king-accent);
  }

  .product-buy__size input:focus-visible + .product-buy__size-chip {
    outline: 2px solid var(--color-king-accent);
    outline-offset: -2px;
    z-index: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-buy__swatch:hover .product-buy__swatch-media {
      border-color: var(--kb-stroke-accent);
    }

    .product-buy__size:hover .product-buy__size-chip {
      background: color-mix(in srgb, var(--color-king-bone) 55%, var(--color-king-bg));
    }

    .product-buy__size input:checked:hover + .product-buy__size-chip {
      background: color-mix(in srgb, var(--color-king-accent) 88%, var(--color-king-text));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-buy__swatch-media,
    .product-buy__size-chip,
    .product-buy__qty-btn {
      transition: none;
    }
  }

  .product-buy__checkout {
    display: grid;
    gap: var(--kb-space-3);
  }

  .product-buy__option--qty {
    display: grid;
    gap: var(--kb-space-2);
    align-content: start;
  }

  .product-buy__option--qty .product-buy__legend {
    margin-bottom: var(--kb-space-2);
  }

  .product-buy__qty {
    display: inline-grid;
    grid-template-columns: 2.625rem 3.25rem 2.625rem;
    align-items: stretch;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    overflow: hidden;
    background: var(--color-king-bg);
  }

  .product-buy__qty-btn {
    display: grid;
    place-items: center;
    border: 0;
    color: var(--color-king-muted);
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--kb-dur-fast) var(--kb-ease-out),
      color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__qty-btn:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-king-bone) 65%, var(--color-king-bg));
    color: var(--color-king-accent);
  }

  .product-buy__qty-btn:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: -2px;
    z-index: 1;
  }

  .product-buy__qty-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .product-buy__qty-input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    border-inline: 1px solid var(--kb-stroke-hairline);
    border-radius: 0;
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--kb-text-sm);
    font-weight: var(--kb-w-medium);
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: 0.04em;
    color: var(--color-king-text);
    background: var(--color-king-bg);
    -moz-appearance: textfield;
  }

  .product-buy__qty-input:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: -2px;
    z-index: 1;
  }

  .product-buy__qty-input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .product-buy__qty-input::-webkit-outer-spin-button,
  .product-buy__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product-buy__actions {
    display: grid;
    gap: var(--kb-space-2);
  }

  .product-buy__actions :global(.kb-btn) {
    width: 100%;
    justify-content: center;
  }

  .product-buy__feedback {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.5;
    color: var(--color-king-accent);
  }

  .product-buy__feedback.is-error {
    color: var(--color-king-error);
  }

  .product-buy__field-error {
    margin: var(--kb-space-1) 0 0;
    font-size: var(--kb-text-meta);
    line-height: 1.4;
    color: var(--color-king-error);
  }
</style>
