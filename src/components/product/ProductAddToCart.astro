---
import Button from '../ui/Button.astro';
import FormField from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';
import type { ProductColorOption, ProductDetail } from '../../data/catalog';
import { formatPrice } from '../../data/catalog';

interface Props {
  product: ProductDetail;
  purchasable?: boolean;
}

const { product, purchasable = true } = Astro.props;
const formId = `add-to-cart-${product.slug}`;
const colorGroup = `color-${product.slug}`;
const sizeGroup = `size-${product.slug}`;
const colorErrorId = `${formId}-color-error`;
const sizeErrorId = `${formId}-size-error`;
const quantityErrorId = `${formId}-quantity-error`;
const feedbackId = `${formId}-feedback`;
---

<form
  id={formId}
  class="product-buy"
  data-product-add-form
  data-product-id={product.id}
  aria-describedby={feedbackId}
  novalidate
>
  <p class="product-buy__price font-display" aria-live="polite">
    {formatPrice(product.price, product.currency)}
  </p>

  <fieldset
    class="product-buy__fieldset"
    aria-describedby={colorErrorId}
    disabled={!purchasable}
  >
    <legend class="product-buy__legend kb-label">Color</legend>
    <div class="product-buy__swatches" role="radiogroup" aria-label="Seleccionar color">
      {product.colorOptions.map((option: ProductColorOption) => (
        <label class="product-buy__swatch" title={option.name}>
          <input
            type="radio"
            name={colorGroup}
            value={option.name}
            class="sr-only"
            data-product-color
            required
          />
          <span
            class="product-buy__swatch-chip"
            style={`background: ${option.swatch}`}
            aria-hidden="true"
          />
          <span class="product-buy__swatch-label kb-meta-label">{option.name}</span>
        </label>
      ))}
    </div>
    <p id={colorErrorId} class="product-buy__field-error" data-error-for="color" role="alert" hidden></p>
  </fieldset>

  <fieldset
    class="product-buy__fieldset"
    aria-describedby={sizeErrorId}
    disabled={!purchasable}
  >
    <legend class="product-buy__legend kb-label">Talla (cm)</legend>
    <div class="product-buy__sizes" role="radiogroup" aria-label="Seleccionar talla">
      {product.sizes.map((size) => (
        <label class="product-buy__size">
          <input
            type="radio"
            name={sizeGroup}
            value={size}
            class="sr-only"
            data-product-size
            required
          />
          <span class="product-buy__size-chip kb-meta-label">{size}</span>
        </label>
      ))}
    </div>
    <p id={sizeErrorId} class="product-buy__field-error" data-error-for="size" role="alert" hidden></p>
  </fieldset>

  <FormField label="Cantidad" for={`qty-${product.slug}`} required>
    <div class="product-buy__qty">
      <button
        type="button"
        class="product-buy__qty-btn"
        data-product-qty-decrease
        aria-label="Reducir cantidad"
        disabled={!purchasable}
      >
        <Icon name="minus" class="h-3.5 w-3.5" />
      </button>
      <input
        id={`qty-${product.slug}`}
        type="number"
        class="kb-input product-buy__qty-input"
        name="quantity"
        value="1"
        min="1"
        max="10"
        inputmode="numeric"
        data-product-quantity
        aria-describedby={quantityErrorId}
        required
        disabled={!purchasable}
      />
      <button
        type="button"
        class="product-buy__qty-btn"
        data-product-qty-increase
        aria-label="Aumentar cantidad"
        disabled={!purchasable}
      >
        <Icon name="plus" class="h-3.5 w-3.5" />
      </button>
    </div>
    <p id={quantityErrorId} class="product-buy__field-error" data-error-for="quantity" role="alert" hidden></p>
  </FormField>

  <div class="product-buy__actions">
    <Button
      type="submit"
      variant="primary"
      size="lg"
      class="product-buy__submit"
      data-product-submit
      disabled={!purchasable}
    >
      {purchasable ? 'Añadir al carrito' : 'Agotado'}
    </Button>
    <div class="product-buy__drawer-wrap" data-product-drawer-wrap hidden>
      <Button
        type="button"
        variant="outline"
        size="md"
        data-product-open-drawer
      >
        Ver carrito
      </Button>
    </div>
  </div>

  <p
    id={feedbackId}
    class="product-buy__feedback"
    data-product-feedback
    role="status"
    aria-live="polite"
    hidden={purchasable}
  >{purchasable ? '' : 'Este producto no está disponible actualmente.'}</p>
</form>

<script>
  import { initProductAddForms } from '../../lib/commerce/product-add-to-cart';
  initProductAddForms();
</script>

<style>
  .product-buy {
    display: grid;
    gap: var(--kb-space-5);
    min-width: 0;
  }

  .product-buy__price {
    margin: 0;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-king-text);
  }

  .product-buy__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .product-buy__legend {
    margin-bottom: var(--kb-space-3);
  }

  .product-buy__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kb-space-3);
  }

  .product-buy__swatch {
    display: grid;
    gap: var(--kb-space-2);
    justify-items: center;
    cursor: pointer;
    min-width: 0;
  }

  .product-buy__swatch-chip {
    display: block;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-pill);
    transition:
      box-shadow var(--kb-dur-fast) var(--kb-ease-out),
      border-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__swatch input:checked + .product-buy__swatch-chip {
    border-color: var(--color-king-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-king-accent) 25%, transparent);
  }

  .product-buy__swatch input:focus-visible + .product-buy__swatch-chip {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  .product-buy__swatch input:disabled + .product-buy__swatch-chip,
  .product-buy__size input:disabled + .product-buy__size-chip {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .product-buy__fieldset:disabled .product-buy__swatch,
  .product-buy__fieldset:disabled .product-buy__size {
    cursor: not-allowed;
  }

  .product-buy__swatch-label {
    color: var(--color-king-muted);
    text-align: center;
  }

  .product-buy__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kb-space-2);
  }

  .product-buy__size {
    cursor: pointer;
  }

  .product-buy__size-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--kb-space-3);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    color: var(--color-king-text);
    background: var(--color-king-bg);
    transition:
      border-color var(--kb-dur-fast) var(--kb-ease-out),
      color var(--kb-dur-fast) var(--kb-ease-out),
      background-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__size input:checked + .product-buy__size-chip {
    border-color: var(--color-king-accent);
    color: var(--color-king-accent);
    background: color-mix(in srgb, var(--color-king-accent) 6%, var(--color-king-bg));
  }

  .product-buy__size input:focus-visible + .product-buy__size-chip {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  .product-buy__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    overflow: hidden;
    background: var(--color-king-bg);
  }

  .product-buy__qty-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    color: var(--color-king-text);
    background: transparent;
    transition: background-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-buy__qty-btn:hover {
    background: var(--color-king-bone);
  }

  .product-buy__qty-btn:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: -2px;
    z-index: 1;
  }

  .product-buy__qty-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .product-buy__qty-input {
    width: 3.25rem;
    min-height: 2.75rem;
    border: 0;
    border-inline: 1px solid var(--kb-stroke-hairline);
    border-radius: 0;
    text-align: center;
    -moz-appearance: textfield;
  }

  .product-buy__qty-input::-webkit-outer-spin-button,
  .product-buy__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product-buy__actions {
    display: grid;
    gap: var(--kb-space-3);
  }

  .product-buy__actions :global(.kb-btn) {
    width: 100%;
    justify-content: center;
  }

  .product-buy__feedback {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.5;
    color: var(--color-king-accent);
  }

  .product-buy__feedback.is-error {
    color: var(--color-king-error);
  }

  .product-buy__field-error {
    margin: var(--kb-space-2) 0 0;
    font-size: var(--kb-text-meta);
    line-height: 1.5;
    color: var(--color-king-error);
  }
</style>
