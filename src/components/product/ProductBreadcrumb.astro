---
import type { Product } from '../../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<nav class="mb-8 md:mb-12" aria-label="Breadcrumb">
  <ol class="flex items-center gap-2 text-[10px] uppercase tracking-[0.25em] text-king-muted/50">
    <li>
      <a href="/" class="hover:text-king-text transition-colors duration-300">Inicio</a>
    </li>
    <li class="text-king-border">/</li>
    <li>
      <a href="/#coleccion" class="hover:text-king-text transition-colors duration-300">Colección</a>
    </li>
    <li class="text-king-border">/</li>
    <li class="text-king-text font-medium">{product.name}</li>
  </ol>
</nav>
