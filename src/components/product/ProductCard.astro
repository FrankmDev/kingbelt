---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Product } from '../../data/products';
import Badge from '../ui/Badge.astro';
import ProductColorSwatches from './ProductColorSwatches.astro';

interface Props {
  product: Product;
  featured?: boolean;
  imageSrc?: string | ImageMetadata;
  hoverImageSrc?: string | ImageMetadata;
}

const { product, featured = false, imageSrc, hoverImageSrc } = Astro.props;
const primaryImage = imageSrc ?? product.images[0];
const secondaryImage = hoverImageSrc ?? product.images[1] ?? primaryImage;
const usesLocalPrimary = typeof primaryImage !== 'string';
const usesLocalSecondary = typeof secondaryImage !== 'string';
---

<a
  href={`/product/${product.slug}`}
  class:list={[
    'group relative block w-full overflow-hidden border border-king-border/60 bg-king-secondary/90 shadow-[0_24px_80px_rgba(0,0,0,0.28)]',
    featured ? 'aspect-[4/4.85] md:aspect-[5/4.9] lg:h-full min-h-[36rem]' : 'aspect-[4/5.3]',
  ]}
  data-product-card
>
  <div class="absolute inset-0 overflow-hidden">
    {
      usesLocalPrimary ? (
        <Image
          src={primaryImage}
          alt={product.name}
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
          loading="lazy"
          sizes={featured ? '(min-width: 1280px) 42vw, 100vw' : '(min-width: 1280px) 18vw, (min-width: 640px) 50vw, 100vw'}
        />
      ) : (
        <img
          src={primaryImage}
          alt={product.name}
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
          loading="lazy"
        />
      )
    }
    {
      usesLocalSecondary ? (
        <Image
          src={secondaryImage}
          alt={`${product.name} detalle`}
          class="absolute inset-0 h-full w-full object-cover opacity-0 scale-[1.08] transition-[opacity,transform] duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:opacity-100 group-hover:scale-[1.02]"
          loading="lazy"
          sizes={featured ? '(min-width: 1280px) 42vw, 100vw' : '(min-width: 1280px) 18vw, (min-width: 640px) 50vw, 100vw'}
        />
      ) : (
        <img
          src={secondaryImage}
          alt={`${product.name} detalle`}
          class="absolute inset-0 h-full w-full object-cover opacity-0 scale-[1.08] transition-[opacity,transform] duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:opacity-100 group-hover:scale-[1.02]"
          loading="lazy"
          aria-hidden="true"
        />
      )
    }
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,5,5,0.06)_0%,rgba(5,5,5,0.2)_26%,rgba(5,5,5,0.62)_62%,rgba(5,5,5,0.92)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.18),transparent_34%)] opacity-70"></div>
    <div class="absolute inset-x-0 bottom-0 h-[40%] bg-gradient-to-t from-black/40 to-transparent"></div>
  </div>

  <div class="absolute inset-x-5 top-5 flex items-start justify-between gap-4 md:inset-x-6 md:top-6 lg:inset-x-7">
    <div class="flex items-center gap-3">
      {product.badge && (
        <div>
          <Badge type={product.badge} />
        </div>
      )}
      <span class="rounded-full border border-white/12 bg-black/20 px-3 py-1 text-[10px] uppercase tracking-[0.22em] text-white/70 backdrop-blur-sm">
        {featured ? 'Destacado' : 'Seleccion'}
      </span>
    </div>
    <span class="text-[10px] uppercase tracking-[0.32em] text-white/40">
      {product.id}
    </span>
  </div>

  <div class="absolute inset-0 flex flex-col justify-end p-5 md:p-6 lg:p-7 xl:p-8">
    <div class="absolute inset-x-5 top-[5.1rem] md:inset-x-6 lg:inset-x-7 xl:inset-x-8">
      <div class="h-px origin-left scale-x-0 bg-gradient-to-r from-king-accent via-white/60 to-transparent transition-transform duration-700 ease-out group-hover:scale-x-100"></div>
    </div>

    <div class="translate-y-3 transition-transform duration-700 ease-out group-hover:translate-y-0">
      <p class="mb-4 text-[11px] uppercase tracking-[0.26em] text-white/46">
        {featured ? 'El buque insignia' : 'Piel, acero y uso real'}
      </p>

      <h3
        class:list={[
          'font-display tracking-tight text-white',
          featured ? 'max-w-md text-4xl md:text-[3.4rem] leading-[0.88] mb-4' : 'text-[1.8rem] md:text-[2rem] leading-[0.92] mb-3',
        ]}
      >
        {product.name}
      </h3>

      <p
        class:list={[
          'leading-relaxed text-white/72',
          featured ? 'max-w-md text-[15px] md:text-[16px] mb-6' : 'text-[15px] mb-5 max-w-[28ch]',
        ]}
      >
        {product.shortDescription}
      </p>

      <div class="flex items-end justify-between gap-5 border-t border-white/10 pt-4">
        <ProductColorSwatches colors={product.colors} />
        <span class="inline-flex items-center gap-2 whitespace-nowrap text-[11px] uppercase tracking-[0.22em] text-white/78">
          Ver producto
          <span class="inline-block h-px w-8 bg-king-accent transition-all duration-500 group-hover:w-12"></span>
        </span>
      </div>
    </div>
  </div>

  <div class="absolute inset-0 border border-white/0 transition-colors duration-500 group-hover:border-white/12"></div>
  <div class="absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-king-accent transition-transform duration-500 ease-out group-hover:scale-x-100"></div>
</a>
