---
import type { Product } from '../../data/products';

interface Props {
  colors: Product['colors'];
}

const { colors } = Astro.props;
---

<div class="flex items-center gap-2">
  {colors.map((color) => (
    <span
      class="inline-block w-3 h-3 rounded-full border border-king-text/20"
      style={`background-color: ${color.hex};`}
      title={color.name}
    />
  ))}
  <span class="text-[10px] text-king-muted uppercase tracking-wider ml-1">
    {colors.length} colores
  </span>
</div>
