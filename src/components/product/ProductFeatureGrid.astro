---
interface Props {
  features: string[];
}

const { features } = Astro.props;
---

<div class="mb-24">
  <div class="border-t border-king-border/60 pt-16">
    {/* Section header — blueprint style */}
    <div class="flex items-center gap-4 mb-10">
      <span class="text-[10px] font-mono uppercase tracking-[0.22em] text-king-accent/50">01</span>
      <span class="h-px flex-1 bg-king-border/60"></span>
      <h2 class="text-[11px] uppercase tracking-[0.22em] text-king-text font-medium">Detalles Artesanales</h2>
      <span class="h-px flex-1 bg-king-border/60"></span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0">
      {features.map((feature, index) => (
        <article class="feature-card group relative px-5 py-6 md:px-6 md:py-7 border-b border-king-border/40 lg:border-b-0 lg:border-r last:!border-r-0 last:!border-b-0">
          {/* Index + accent line */}
          <div class="flex items-center gap-3 mb-4">
            <span class="text-[10px] font-mono text-king-accent/50 tabular-nums">
              0{index + 1}
            </span>
            <span class="h-px flex-1 bg-king-border/40 transition-colors duration-500 group-hover:bg-king-accent/30"></span>
          </div>
          {/* Feature text */}
          <p class="text-king-text text-[14px] md:text-[15px] leading-[1.75]">{feature}</p>
          {/* Hover accent */}
          <span class="absolute bottom-0 left-0 w-full h-[1px] bg-king-accent scale-x-0 origin-left transition-transform duration-500 group-hover:scale-x-100"></span>
        </article>
      ))}
    </div>
  </div>
</div>
