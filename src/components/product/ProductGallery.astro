---
import type { ProductImage, ProductMediaGroup } from '@commerce/domain/catalog';
import { escapeCssIdentifier } from '@shared/css/css-identifier';
import { buildProductGalleryRules } from './build-product-gallery-rules';
import { buildSlideSource, buildThumbnailUrl } from '@shared/image-source';

interface Props {
  images: ProductImage[];
  mediaGroups?: ProductMediaGroup[];
  /** Prefijo único para name/ids del grupo de radios (p. ej. slug del producto). */
  idPrefix: string;
  class?: string;
}

const { images, mediaGroups = [], idPrefix, class: className } = Astro.props;

const safePrefix = escapeCssIdentifier(idPrefix);
const groupName = `gallery-${safePrefix}`;
const galleryClass = `product-gallery--${safePrefix}`;
const galleryRules = buildProductGalleryRules({ idPrefix, images, mediaGroups });

const mediaGroupByImageId = new Map(
  mediaGroups.flatMap((group) => group.imageIds.map((imageId) => [imageId, group.id] as const))
);

/** `sizes` de la escena: columna acotada del PDP en escritorio, ancho de shell en móvil. */
const slideSizes = '(min-width: 64rem) 28rem, (min-width: 48rem) 22rem, 100vw';
---

<div
  class:list={['product-gallery', galleryClass, className]}
  data-product-gallery={idPrefix}
>
  {images.map((image, index) => (
    <input
      type="radio"
      class="product-gallery__input sr-only"
      id={`${groupName}-${index + 1}`}
      name={groupName}
      checked={index === 0}
      aria-label={`Ver imagen ${index + 1} de ${images.length}`}
      data-gallery-choice
      data-gallery-image-id={image.id}
      data-gallery-media-group={mediaGroupByImageId.get(image.id)}
    />
  ))}

  <div class="product-gallery__stage">
    {images.map((image, index) => {
      const source = buildSlideSource(image.url, slideSizes);
      return (
        <img
          src={source.src}
          srcset={source.srcset}
          sizes={source.sizes}
          alt={image.altText}
          width={image.width}
          height={image.height}
          class="product-gallery__slide"
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
          decoding="async"
          style={`object-position: ${image.position ?? 'center'}`}
          data-gallery-slide
          data-gallery-media-group={mediaGroupByImageId.get(image.id)}
        />
      );
    })}
  </div>

  <div class="product-gallery__thumbs" role="radiogroup" aria-label={`Imágenes del producto, ${images.length} en total`}>
    {images.map((image, index) => (
      <label
        class="product-gallery__thumb"
        for={`${groupName}-${index + 1}`}
        data-gallery-thumb
        data-gallery-media-group={mediaGroupByImageId.get(image.id)}
      >
        <img
          src={buildThumbnailUrl(image.url)}
          alt=""
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
          aria-hidden="true"
          style={`object-position: ${image.position ?? 'center'}`}
        />
      </label>
    ))}
  </div>
</div>

{galleryRules.length > 0 && <style is:global set:html={galleryRules} />}

<style>
  .product-gallery {
    display: grid;
    gap: var(--kb-space-3);
    min-width: 0;
    align-content: start;
  }

  .product-gallery__stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-sm);
    background: var(--color-king-bone);
  }

  .product-gallery__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    visibility: hidden;
    filter: saturate(0.92) contrast(1.03);
    transition: opacity var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(5rem, 25%), 1fr));
    gap: var(--kb-space-3);
  }

  .product-gallery__thumb {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    background: var(--color-king-bone);
    cursor: pointer;
    transition:
      border-color var(--kb-dur-fast) var(--kb-ease-out),
      box-shadow var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    filter: saturate(0.92) contrast(1.03);
    transition: opacity var(--kb-dur-fast) var(--kb-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-gallery__thumb:hover {
      border-color: var(--kb-stroke-accent);
    }

    .product-gallery__thumb:hover img {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-gallery__slide,
    .product-gallery__thumb,
    .product-gallery__thumb img {
      transition: none;
    }
  }
</style>
