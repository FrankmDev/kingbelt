---
import type { Product } from '../../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const defaultColor = product.colors[0]?.name;
---

<div class="lg:col-span-7" data-product-gallery data-color-images={JSON.stringify(product.colorImages)} data-default-color={defaultColor}>
  {/* Main image — full bleed with blueprint corners */}
  <div class="relative aspect-[4/5] md:aspect-[3/4] bg-king-secondary overflow-hidden mb-4">
    {/* Blueprint corner marks */}
    <div class="absolute inset-3 md:inset-5 z-10 pointer-events-none">
      <span class="absolute top-0 left-0 w-5 h-[1px] bg-king-accent/25"></span>
      <span class="absolute top-0 left-0 w-[1px] h-5 bg-king-accent/25"></span>
      <span class="absolute top-0 right-0 w-5 h-[1px] bg-king-accent/25"></span>
      <span class="absolute top-0 right-0 w-[1px] h-5 bg-king-accent/25"></span>
      <span class="absolute bottom-0 left-0 w-5 h-[1px] bg-king-accent/25"></span>
      <span class="absolute bottom-0 left-0 w-[1px] h-5 bg-king-accent/25"></span>
      <span class="absolute bottom-0 right-0 w-5 h-[1px] bg-king-accent/25"></span>
      <span class="absolute bottom-0 right-0 w-[1px] h-5 bg-king-accent/25"></span>
    </div>
    {/* Product ID label */}
    <div class="absolute top-4 right-4 md:top-6 md:right-6 z-10">
      <span class="text-[9px] font-mono uppercase tracking-[0.2em] text-king-text/20">{product.id}</span>
    </div>
    <img
      id={`main-image-${product.slug}`}
      src={product.images[0]}
      alt={product.name}
      class="product-main-image h-full w-full object-cover transition-opacity duration-500"
    />
    {/* Bottom gradient */}
    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-king-bg/60 to-transparent pointer-events-none"></div>
  </div>

  {/* Thumbnails */}
  {product.images.length > 1 && (
    <div class="grid grid-cols-4 gap-2">
      {product.images.map((img, index) => (
        <button
          class={`thumbnail-btn aspect-square overflow-hidden border transition-all duration-300 ${index === 0 ? 'border-king-accent' : 'border-king-border/40 hover:border-king-accent/40'}`}
          data-src={img}
          data-index={index}
          type="button"
          aria-label={`${product.name} vista ${index + 1}`}
        >
          <img src={img} alt={`${product.name} vista ${index + 1}`} class="h-full w-full object-cover transition-opacity duration-300" loading="lazy" />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>('.product-main-image');
    const thumbnails = gallery.querySelectorAll<HTMLElement>('.thumbnail-btn');
    const colorImagesData = gallery.getAttribute('data-color-images');
    const colorImages: Record<string, string[]> = colorImagesData ? JSON.parse(colorImagesData) : {};
    let currentColor = gallery.getAttribute('data-default-color') || '';
    let currentThumbIndex = 0;

    function updateGallery(color: string, thumbIdx = 0) {
      const imgs = colorImages[color];
      if (!imgs || !mainImage) return;
      currentColor = color;
      currentThumbIndex = thumbIdx;

      mainImage.style.opacity = '0';
      setTimeout(() => {
        mainImage.src = imgs[thumbIdx] || imgs[0];
        mainImage.style.opacity = '1';
      }, 250);

      // Update thumbnails
      thumbnails.forEach((thumb, i) => {
        const img = thumb.querySelector('img');
        if (img && imgs[i]) {
          img.src = imgs[i];
        }
        if (i === thumbIdx) {
          thumb.classList.remove('border-king-border/40');
          thumb.classList.add('border-king-accent');
        } else {
          thumb.classList.remove('border-king-accent');
          thumb.classList.add('border-king-border/40');
        }
      });
    }

    // Thumbnail clicks
    thumbnails.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const idx = parseInt(thumb.getAttribute('data-index') || '0', 10);
        updateGallery(currentColor, idx);
      });
    });

    // Expose for color switcher
    (gallery as any).__updateGallery = updateGallery;
  });
</script>
