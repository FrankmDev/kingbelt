---
import type { ProductImage, ProductMediaGroup, ProductOption, ProductVariant } from '@commerce/domain/catalog';
import {
  getColorGalleries,
  getInitialColorValueId,
} from '@commerce/domain/product-media';
import { escapeCssIdentifier } from '@shared/css/css-identifier';
import { buildProductGalleryRules } from './build-product-gallery-rules';
import { buildSlideSource, buildThumbnailUrl } from '@shared/image-source';

interface Props {
  images: ProductImage[];
  mediaGroups?: ProductMediaGroup[];
  options?: ProductOption[];
  initialVariant?: Pick<ProductVariant, 'imageId' | 'optionValues'>;
  idPrefix: string;
  class?: string;
}

const { images, mediaGroups = [], options = [], initialVariant, idPrefix, class: className } = Astro.props;

const colorGalleries = getColorGalleries({ images, mediaGroups });
const initialColorValueId = getInitialColorValueId(initialVariant, colorGalleries, options);
const multiColor = colorGalleries.length > 1;
const safePrefix = escapeCssIdentifier(idPrefix);
const galleryClass = `product-gallery--${safePrefix}`;
const galleryRules = buildProductGalleryRules({ idPrefix, colorGalleries });
const slideSizes = '(min-width: 90rem) 32rem, (min-width: 64rem) 28vw, (min-width: 48rem) 36vw, calc(100vw - 3rem)';
---

<div
  class:list={['product-gallery', galleryClass, className]}
  data-product-gallery={idPrefix}
>
  {colorGalleries.map((gallery, setIndex) => {
    const setName = `gallery-${safePrefix}-set-${setIndex + 1}`;
    const isInitialSet = gallery.optionValueId === initialColorValueId;
    const activeImageId = isInitialSet && initialVariant?.imageId && gallery.images.some((image) => image.id === initialVariant.imageId)
      ? initialVariant.imageId
      : gallery.images[0]?.id;
    const showThumbs = gallery.images.length > 1;

    return (
      <div
        class="product-gallery__set"
        data-gallery-set={gallery.optionValueId}
        hidden={multiColor && gallery.optionValueId !== initialColorValueId}
      >
        {gallery.images.map((image, index) => (
          <input
            type="radio"
            class="product-gallery__input sr-only"
            id={`${setName}-${index + 1}`}
            name={setName}
            checked={image.id === activeImageId}
            aria-label={`Ver imagen ${index + 1} de ${gallery.images.length}`}
            data-gallery-choice
            data-gallery-image-id={image.id}
          />
        ))}

        <div
          class="product-gallery__layout"
          style={`--gallery-thumb-count: ${gallery.images.length}`}
          role={showThumbs ? 'radiogroup' : undefined}
          aria-label={showThumbs ? `Imágenes del color seleccionado, ${gallery.images.length} en total` : undefined}
        >
          <div class="product-gallery__thumbs" hidden={!showThumbs}>
            {gallery.images.map((image, index) => (
              <label
                class="product-gallery__thumb"
                for={`${setName}-${index + 1}`}
                data-gallery-thumb
              >
                <img
                  src={buildThumbnailUrl(image.url)}
                  alt=""
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                  style={`object-position: ${image.position ?? 'center'}`}
                />
              </label>
            ))}
          </div>

          <div class="product-gallery__stage">
            {gallery.images.map((image) => {
              const source = buildSlideSource(image.url, slideSizes);
              const isActive = image.id === activeImageId;
              return (
                <img
                  src={source.src}
                  srcset={source.srcset}
                  sizes={source.sizes}
                  alt={image.altText}
                  width={image.width}
                  height={image.height}
                  class="product-gallery__slide"
                  loading={isActive ? 'eager' : 'lazy'}
                  fetchpriority={isActive ? 'high' : undefined}
                  decoding="async"
                  style={`object-position: ${image.position ?? 'center'}`}
                  data-gallery-slide
                />
              );
            })}
          </div>
        </div>
      </div>
    );
  })}
</div>

{galleryRules.length > 0 && <style is:global set:html={galleryRules} />}

<style>
  .product-gallery {
    --gallery-thumb-width: 4.5rem;
    --gallery-gutter: var(--kb-space-3);
    --gallery-stage-ratio: 4 / 5;
    --gallery-radius: var(--kb-card-radius);
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  .product-gallery__set {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  .product-gallery__set[hidden] {
    display: none !important;
  }

  .product-gallery__layout {
    display: grid;
    grid-template-columns: var(--gallery-thumb-width) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    column-gap: var(--gallery-gutter);
    align-items: stretch;
    flex: 1 1 auto;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  .product-gallery__thumbs {
    display: flex;
    flex-direction: column;
    gap: var(--gallery-gutter);
    grid-column: 1;
    grid-row: 1;
    min-height: 0;
    height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  .product-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  .product-gallery__thumbs[hidden] {
    display: none;
  }

  .product-gallery__layout:has(.product-gallery__thumbs[hidden]) {
    grid-template-columns: minmax(0, 1fr);
  }

  .product-gallery__stage {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 0;
    height: 100%;
    aspect-ratio: var(--gallery-stage-ratio);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--gallery-radius);
    background: var(--color-king-bone);
    box-shadow: var(--kb-shadow-xs);
  }

  .product-gallery__layout:has(.product-gallery__thumbs[hidden]) .product-gallery__stage {
    grid-column: 1;
  }

  .product-gallery__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-king-text) 4%, transparent);
  }

  .product-gallery__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transition: opacity var(--kb-dur-med) var(--kb-ease-out);
  }

  .product-gallery__thumb {
    position: relative;
    flex: 0 0 auto;
    display: block;
    width: 100%;
    aspect-ratio: var(--gallery-stage-ratio);
    overflow: hidden;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--gallery-radius);
    background: var(--color-king-bone);
    cursor: pointer;
    transition:
      border-color var(--kb-dur-fast) var(--kb-ease-out),
      box-shadow var(--kb-dur-fast) var(--kb-ease-out),
      transform var(--kb-dur-fast) var(--kb-ease-out);
  }

  .product-gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    filter: saturate(0.94) contrast(1.02);
    transition: opacity var(--kb-dur-fast) var(--kb-ease-out);
  }

  @media (max-width: 47.99rem) {
    .product-gallery {
      --gallery-thumb-width: 3.25rem;
    }

    .product-gallery,
    .product-gallery__set {
      height: auto;
    }

    .product-gallery__layout {
      display: flex;
      flex-direction: column;
      flex: none;
      width: 100%;
      max-width: 100%;
      height: auto;
      align-items: stretch;
    }

    .product-gallery__stage {
      order: 1;
      grid-column: unset;
      grid-row: unset;
      width: 100%;
      max-width: 100%;
      height: auto;
      aspect-ratio: var(--gallery-stage-ratio);
    }

    .product-gallery__thumbs {
      display: flex;
      flex-direction: row;
      order: 2;
      gap: var(--kb-space-2);
      height: auto;
      min-height: 0;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      padding-block: 2px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .product-gallery__thumbs::-webkit-scrollbar {
      display: none;
    }

    .product-gallery__thumb {
      flex: 0 0 var(--gallery-thumb-width);
      width: var(--gallery-thumb-width);
      grid-column: unset;
      scroll-snap-align: start;
    }
  }

  @media (min-width: 48rem) {
    .product-gallery {
      --gallery-thumb-width: 7.5rem;
      --gallery-gutter: var(--kb-space-4);
      width: 100%;
      height: 100%;
    }

    .product-gallery__layout {
      width: 100%;
      height: 100%;
      grid-template-columns: var(--gallery-thumb-width) minmax(0, 1fr);
    }

    .product-gallery__thumbs {
      overflow: hidden;
    }

    .product-gallery__thumb {
      flex: 1 1 0;
      min-height: 0;
      aspect-ratio: auto;
    }

    .product-gallery__stage {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  @media (min-width: 64rem) {
    .product-gallery {
      --gallery-thumb-width: 9.5rem;
    }
  }

  @media (min-width: 80rem) {
    .product-gallery {
      --gallery-thumb-width: 10.5rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .product-gallery__thumb:hover {
      border-color: var(--kb-stroke-accent);
      transform: translateX(1px);
    }

    .product-gallery__thumb:hover img {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-gallery__slide,
    .product-gallery__thumb,
    .product-gallery__thumb img {
      transition: none;
    }

    .product-gallery__thumb:hover {
      transform: none;
    }
  }
</style>
