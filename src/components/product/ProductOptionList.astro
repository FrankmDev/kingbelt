---
interface Props {
  title: string;
  items: string[];
  variant?: 'bullets' | 'pills';
}

const { title, items, variant = 'bullets' } = Astro.props;
---

<div class="mb-8">
  <h3 class="text-xs uppercase tracking-[0.2em] text-king-text mb-3 font-medium">{title}</h3>
  {variant === 'pills' ? (
    <div class="flex flex-wrap gap-2">
      {items.map((item) => (
        <span class="px-3 py-1.5 border border-king-border text-king-text text-xs font-medium">
          {item}
        </span>
      ))}
    </div>
  ) : (
    <ul class="space-y-2">
      {items.map((item) => (
        <li class="text-king-muted text-sm flex items-center gap-2">
          <span class="w-1 h-1 bg-king-accent rounded-full"></span>
          {item}
        </li>
      ))}
    </ul>
  )}
</div>
