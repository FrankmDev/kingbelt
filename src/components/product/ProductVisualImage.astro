---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
  width?: number;
  height?: number;
  decoding?: 'async' | 'auto' | 'sync';
  format?: 'avif' | 'jpeg' | 'jpg' | 'png' | 'webp';
  quality?: number | string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  sizes,
  width,
  height,
  decoding = 'async',
  ...attrs
} = Astro.props;

const isLocalImage = typeof src !== 'string';
---

{
  isLocalImage ? (
    <Image
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      sizes={sizes}
      width={width}
      height={height}
      decoding={decoding}
      {...attrs}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      sizes={sizes}
      width={width}
      height={height}
      decoding={decoding}
      {...attrs}
    />
  )
}
