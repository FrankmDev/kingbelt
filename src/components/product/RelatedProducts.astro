---
import type { Product } from '../../data/products';
import ProductCard from './ProductCard.astro';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

{products.length > 0 && (
  <div>
    <div class="flex items-end justify-between mb-10">
      <h2 class="font-display text-[1.75rem] md:text-[2.25rem] text-king-text tracking-tight leading-[0.95]">También te puede gustar</h2>
      <a href="/#coleccion" class="text-[11px] uppercase tracking-[0.2em] text-king-muted hover:text-king-accent transition-colors hidden md:block">
        Ver todo
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </div>
)}
