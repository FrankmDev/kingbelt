---
import EditorialCtaBanner from '../ui/EditorialCtaBanner.astro';

interface CtaData {
  eyebrow: string;
  title: string;
  description: string;
  buttonLabel: string;
  buttonHref: string;
  image: string;
  imagePosition?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

interface Props {
  cta: CtaData;
  index?: string;
  meta?: string;
  titleId?: string;
  id?: string;
  class?: string;
  spacing?: 'default' | 'close';
}

const {
  cta,
  index,
  meta,
  titleId = 'editorial-cta-title',
  id,
  class: className = '',
  spacing = 'default',
} = Astro.props;

const secondary =
  cta.secondaryLabel && cta.secondaryHref
    ? { label: cta.secondaryLabel, href: cta.secondaryHref }
    : undefined;
---

<section
  id={id}
  class:list={[
    'editorial-cta section-spacing',
    spacing === 'close' && 'section-spacing-close',
    className,
  ]}
  aria-labelledby={titleId}
>
  <div class="editorial-cta__inner kb-shell-wide">
    <EditorialCtaBanner
      index={index}
      eyebrow={cta.eyebrow}
      meta={meta}
      title={cta.title}
      description={cta.description}
      titleId={titleId}
      primary={{ label: cta.buttonLabel, href: cta.buttonHref }}
      secondary={secondary}
      backgroundImage={cta.image}
      backgroundAlt=""
      backgroundPosition={cta.imagePosition ?? 'center 40%'}
    />
  </div>
</section>

<style>
  .editorial-cta {
    background: var(--color-king-bg);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .editorial-cta__inner {
    min-width: 0;
  }
</style>
