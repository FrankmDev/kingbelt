---
import SectionHeader from '@components/ui/SectionHeader.astro';
import EditorialBanner from '../../ui/EditorialBanner.astro';
import type { AboutContextPoint } from '@content/about';

interface ContextBanner {
  eyebrow: string;
  title: string;
  statement: string;
  tags: readonly string[];
  image: string;
  imageAlt: string;
  imagePosition: string;
  imageCaption: string;
}

interface ContextData {
  eyebrow: string;
  title: string;
  lede: string;
  banner: ContextBanner;
  points: readonly AboutContextPoint[];
}

interface Props {
  data: ContextData;
  class?: string;
}

const { data, class: className = '' } = Astro.props;
const { banner } = data;
---

<section
  class:list={['about-context section-spacing', className]}
  aria-labelledby="about-context-title"
>
  <div class="kb-shell-wide about-context__shell">
    <SectionHeader
      index="04"
      eyebrow={data.eyebrow}
      meta="Vestuario / Integración"
      body={data.lede}
      class="about-context__header"
    >
      <Fragment slot="title">
        <span id="about-context-title" set:html={data.title} />
      </Fragment>
    </SectionHeader>

    <EditorialBanner
      id="about-context-banner"
      eyebrow={banner.eyebrow}
      title={banner.title}
      statement={banner.statement}
      tags={banner.tags}
      image={banner.image}
      imageAlt={banner.imageAlt}
      imagePosition={banner.imagePosition}
      imageCaption={banner.imageCaption}
      class="about-context__banner"
    />

    <ol class="about-context__points" aria-label="Puntos de integración">
      {data.points.map((point) => (
        <li class="about-context__point kb-card-dry">
          <header class="about-context__point-head">
            <span class="about-context__point-num kb-folio" aria-hidden="true">{point.number}</span>
            <p class="kb-eyebrow text-king-accent">{point.label}</p>
          </header>
          <h3>{point.title}</h3>
          <p class="body-copy text-king-muted">{point.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about-context {
    background: var(--color-king-bg);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .about-context__header:global(.section-header) {
    margin-bottom: var(--kb-space-gap);
  }

  .about-context__banner {
    margin-bottom: var(--kb-space-gap);
  }

  .about-context__points {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-context__point {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    min-width: 0;
    min-height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) var(--kb-space-5);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-context__point:hover {
      transform: none;
      border-color: var(--kb-stroke-dark);
      box-shadow: var(--kb-shadow-sm);
    }
  }

  .about-context__point-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    padding-bottom: var(--kb-space-3);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .about-context__point-head p,
  .about-context__point h3,
  .about-context__point > p {
    margin: 0;
  }

  .about-context__point-num {
    color: var(--color-king-accent);
    opacity: 0.55;
  }

  .about-context__point h3 {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--kb-text-h5);
    font-weight: var(--kb-w-medium);
    line-height: 1.2;
    text-wrap: balance;
    color: var(--color-king-text);
  }

  .about-context__point > p {
    max-width: 40ch;
    font-size: var(--kb-text-sm);
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-king-text) 68%, var(--color-king-muted));
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .about-context__points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--kb-space-4);
    }
  }
</style>
