---
import EditorialCtaSection from '../EditorialCtaSection.astro';

interface CtaData {
  eyebrow: string;
  title: string;
  description: string;
  label: string;
  href: string;
}

interface Props {
  cta: CtaData;
  backgroundImage: string;
}

const { cta, backgroundImage } = Astro.props;
---

<EditorialCtaSection
  index="05"
  titleId="about-cta-title"
  spacing="close"
  cta={{
    eyebrow: cta.eyebrow,
    title: cta.title,
    description: cta.description,
    buttonLabel: cta.label,
    buttonHref: cta.href,
    image: backgroundImage,
    imagePosition: 'center 58%',
  }}
/>
