---
import SectionHeaderHome from '../home/SectionHeaderHome.astro';
import CTABox from '../../ui/CTABox.astro';

interface CtaData {
  eyebrow: string;
  title: string;
  description: string;
  label: string;
  href: string;
}

interface Props {
  cta: CtaData;
  backgroundImage: string;
}

const { cta, backgroundImage } = Astro.props;
---

<section class="about-cta section-spacing section-spacing-close" aria-label={cta.eyebrow}>
  <div class="cta-section-inner kb-shell-wide">
    <CTABox
      title={cta.title}
      buttonLabel={cta.label}
      buttonHref={cta.href}
      buttonVariant="secondary"
      backgroundImage={backgroundImage}
      backgroundAlt=""
      backgroundWidth={1920}
      backgroundHeight={1080}
      backgroundPosition="center 58%"
      titleTag="h2"
    >
      <SectionHeaderHome
        slot="header"
        index="05"
        eyebrow={cta.eyebrow}
        body={cta.description}
        tone="dark"
        density="compact"
      >
        <Fragment slot="title">
          <span set:html={cta.title} />
        </Fragment>
      </SectionHeaderHome>
    </CTABox>
  </div>
</section>

<style>
  .about-cta {
    padding-top: var(--kb-space-section);
    background: var(--color-king-bg);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .about-cta :global(.section-header-home) {
    margin-bottom: 0;
  }
</style>
