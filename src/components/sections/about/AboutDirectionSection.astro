---
import SectionHeader from '@components/ui/SectionHeader.astro';
import MediaFrame from '../../ui/MediaFrame.astro';
import type { AboutReadingLayer } from '@content/about';

interface DirectionPanel {
  eyebrow: string;
  statement: string;
  layers: readonly AboutReadingLayer[];
}

interface DirectionData {
  eyebrow: string;
  title: string;
  lede: string;
  panel: DirectionPanel;
  image: string;
  imageAlt: string;
  imageLabel: string;
  imageCaption: string;
}

interface Props {
  data: DirectionData;
  class?: string;
}

const { data, class: className = '' } = Astro.props;
const { panel } = data;
const layerCount = panel.layers.length;
---

<section
  class:list={['about-direction section-spacing about-direction--chapter-start', className]}
  aria-labelledby="about-direction-title"
>
  <div class="kb-shell-wide section-stack-lg">
    <SectionHeader
      eyebrow={data.eyebrow}
      body={data.lede}
      meta="Material / Proporción / Cierre"
    >
      <Fragment slot="title">
        <span id="about-direction-title" set:html={data.title} />
      </Fragment>
    </SectionHeader>

    <div class="about-direction-layout">
      <MediaFrame
        src={data.image}
        alt={data.imageAlt}
        ratio="4/3"
        label={data.imageLabel}
        caption={data.imageCaption}
        captionNumber="02"
        width={1600}
        height={1200}
        loading="lazy"
        class="about-direction-media"
      />

      <aside
        class="kb-reading-panel"
        aria-labelledby="about-direction-panel-title"
      >
        <header class="kb-reading-panel__head">
          <div class="kb-reading-panel__head-bar">
            <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">
              {panel.eyebrow}
            </p>
            <span class="kb-reading-panel__folio kb-meta-label" aria-hidden="true">
              {String(layerCount).padStart(2, '0')}
            </span>
          </div>

          <p id="about-direction-panel-title" class="kb-reading-panel__statement">
            {panel.statement}
          </p>
        </header>

        <ol class="kb-reading-panel__layers">
          {panel.layers.map((layer, index) => (
            <li class="kb-reading-panel__layer">
              <div class="kb-reading-panel__rail" aria-hidden="true">
                <span class="kb-reading-panel__num">{layer.number}</span>
                {index < layerCount - 1 && (
                  <span class="kb-reading-panel__rail-line"></span>
                )}
              </div>

              <div class="kb-reading-panel__body">
                <div class="kb-reading-panel__layer-head">
                  <h3 class="kb-reading-panel__label">{layer.label}</h3>
                  <span class="kb-reading-panel__tag">{layer.meta}</span>
                </div>
                <p class="kb-reading-panel__text">{layer.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="kb-reading-panel__foot" aria-hidden="true">
          <span class="kb-reading-panel__track"></span>
          <span class="kb-reading-panel__track"></span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-direction {
    background: var(--color-king-surface);
  }

  .about-direction--chapter-start {
    padding-top: clamp(4.25rem, 7.5vw, 6.5rem);
  }

  .about-direction-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap-lg);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .about-direction-layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: stretch;
    }

    .kb-reading-panel {
      height: 100%;
    }

    :global(.about-direction-media.media-frame) {
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }
  }
</style>
