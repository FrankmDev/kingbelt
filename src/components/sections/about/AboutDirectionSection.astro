---
import SectionHeader from '@components/ui/SectionHeader.astro';
import MediaFrame from '../../ui/MediaFrame.astro';
import type { AboutReadingLayer } from '@content/about';

interface DirectionPanel {
  eyebrow: string;
  statement: string;
  layers: readonly AboutReadingLayer[];
}

interface DirectionData {
  eyebrow: string;
  title: string;
  lede: string;
  panel: DirectionPanel;
  image: string;
  imageAlt: string;
  imageLabel: string;
  imageCaption: string;
}

interface Props {
  data: DirectionData;
  class?: string;
}

const { data, class: className = '' } = Astro.props;
const { panel } = data;
const layerCount = panel.layers.length;
---

<section
  class:list={['about-direction section-spacing', className]}
  aria-labelledby="about-direction-title"
>
  <div class="kb-shell-wide">
    <SectionHeader
      index="03"
      eyebrow={data.eyebrow}
      title={data.title}
      meta="Material / Proporción / Cierre"
      body={data.lede}
      titleId="about-direction-title"
      class="about-direction__header"
    />

    <div class="about-direction__layout">
      <MediaFrame
        src={data.image}
        alt={data.imageAlt}
        ratio="3/2"
        label={data.imageLabel}
        caption={data.imageCaption}
        captionNumber="03"
        width={1500}
        height={1000}
        loading="lazy"
        class="about-direction__media"
      />

      <aside class="kb-reading-panel" aria-labelledby="about-direction-panel-title">
        <header class="kb-reading-panel__head">
          <div class="kb-reading-panel__head-bar">
            <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">
              {panel.eyebrow}
            </p>
            <span class="kb-reading-panel__folio kb-meta-label" aria-hidden="true">
              {String(layerCount).padStart(2, '0')}
            </span>
          </div>

          <p id="about-direction-panel-title" class="kb-reading-panel__statement">
            {panel.statement}
          </p>
        </header>

        <ol class="kb-reading-panel__layers">
          {panel.layers.map((layer, index) => (
            <li class="kb-reading-panel__layer">
              <div class="kb-reading-panel__rail" aria-hidden="true">
                <span class="kb-reading-panel__num">{layer.number}</span>
                {index < layerCount - 1 && (
                  <span class="kb-reading-panel__rail-line"></span>
                )}
              </div>

              <div class="kb-reading-panel__body">
                <div class="kb-reading-panel__layer-head">
                  <h3 class="kb-reading-panel__label">{layer.label}</h3>
                  <span class="kb-reading-panel__tag">{layer.meta}</span>
                </div>
                <p class="kb-reading-panel__text">{layer.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="kb-reading-panel__foot" aria-hidden="true">
          <span class="kb-reading-panel__track"></span>
          <span class="kb-reading-panel__track"></span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-direction {
    background: var(--color-king-surface);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .about-direction__header:global(.section-header) {
    margin-bottom: var(--kb-space-gap);
  }

  .about-direction__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap-lg);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .about-direction__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: stretch;
    }

    .about-direction__media:global(.media-frame) {
      width: 100%;
      height: 100%;
      min-height: 100%;
      aspect-ratio: auto;
    }

    .about-direction__media:global(.media-frame .media-frame__stage) {
      min-height: 100%;
      height: 100%;
    }

    .about-direction__media:global(.media-frame .media-frame__image) {
      object-fit: cover;
      transform: scale(1.28);
      transform-origin: center;
    }

    @media (hover: hover) and (pointer: fine) {
      .about-direction__media:global(.media-frame:hover .media-frame__image) {
        transform: scale(1.36);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .about-direction__media:global(.media-frame .media-frame__image) {
        transform: scale(1.28);
      }
    }
  }
</style>
