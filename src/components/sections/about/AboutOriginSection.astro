---
import SectionHeader from '@components/ui/SectionHeader.astro';
import MediaFrame from '../../ui/MediaFrame.astro';

interface OriginData {
  eyebrow: string;
  title: string;
  body: string;
  statement: string;
  image: string;
  imageAlt: string;
  imageLabel: string;
  imageCaption: string;
}

interface Props {
  data: OriginData;
  class?: string;
}

const { data, class: className = '' } = Astro.props;
---

<section
  id="origen"
  class:list={['about-origin section-spacing', className]}
  aria-labelledby="about-origin-title"
>
  <div class="kb-shell-wide about-origin__shell">
    <SectionHeader
      index="01"
      eyebrow={data.eyebrow}
      title={data.title}
      meta="KingBelt / Marca"
      titleId="about-origin-title"
      class="about-origin__header"
    />

    <div class="about-origin__layout">
      <div class="about-origin__panel kb-origin-panel">
        <div class="kb-origin-panel__main">
          <p class="kb-meta-label text-king-muted kb-origin-panel__kicker">Posicionamiento</p>
          <p class="body-copy-lg kb-origin-panel__body">{data.body}</p>
        </div>

        <blockquote class="kb-origin-panel__quote">
          <p>{data.statement}</p>
        </blockquote>
      </div>

      <MediaFrame
        src={data.image}
        alt={data.imageAlt}
        ratio="3/2"
        label={data.imageLabel}
        caption={data.imageCaption}
        captionNumber="01"
        width={1500}
        height={1000}
        loading="lazy"
        class="about-origin__media"
      />
    </div>
  </div>
</section>

<style>
  .about-origin {
    padding-top: clamp(2.5rem, 5vw, var(--kb-space-section));
    background: var(--color-king-bg);
  }

  .about-origin__header:global(.section-header) {
    margin-bottom: var(--kb-space-gap);
  }

  .about-origin__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap-lg);
    align-items: start;
    min-width: 0;
  }

  .about-origin__panel {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0;
    padding: var(--kb-space-5);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-card-radius);
    background: color-mix(in srgb, var(--color-king-bone) 18%, var(--color-king-bg));
  }

  .about-origin__panel .kb-origin-panel__body {
    color: color-mix(in srgb, var(--color-king-text) 68%, var(--color-king-muted));
  }

  .about-origin__panel .kb-origin-panel__quote {
    border-top-color: var(--kb-stroke-hairline);
  }

  .about-origin__panel .kb-origin-panel__kicker {
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 64rem) {
    .about-origin__layout {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: start;
    }

    .about-origin__media:global(.media-frame) {
      width: 100%;
    }
  }
</style>
