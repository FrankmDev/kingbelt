---
import SectionHeaderHome from '../home/SectionHeaderHome.astro';
import type { AboutPrinciple } from '@content/about';

interface StandardsData {
  eyebrow: string;
  title: string;
  lede: string;
  badge: string;
  principles: readonly AboutPrinciple[];
}

interface Props {
  data: StandardsData;
  class?: string;
}

const { data, class: className = '' } = Astro.props;
---

<section
  class:list={['about-standards section-spacing section-asphalt', className]}
  aria-labelledby="about-standards-title"
>
  <div class="kb-shell-wide about-standards__shell">
    <SectionHeaderHome
      index="02"
      eyebrow={data.eyebrow}
      meta={data.badge}
      body={data.lede}
      tone="dark"
      class="about-standards__header"
    >
      <Fragment slot="title">
        <span id="about-standards-title" set:html={data.title} />
      </Fragment>
    </SectionHeaderHome>

    <ol class="about-standards__grid" aria-label="Filtros de producto">
      {data.principles.map((principle) => (
        <li class="about-standard kb-card-dark">
          <header class="about-standard__head">
            <span class="about-standard__num kb-folio" aria-hidden="true">{principle.number}</span>
            <p class="kb-eyebrow about-standard__label">{principle.label}</p>
          </header>

          <div class="about-standard__copy">
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </div>

          <p class="kb-meta-label about-standard__meta">{principle.meta}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about-standards__header:global(.section-header-home) {
    margin-bottom: var(--kb-space-gap);
  }

  .about-standards__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-standard {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-5);
    min-width: 0;
    min-height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) var(--kb-space-5);
  }

  .about-standard__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--kb-space-4);
    padding-bottom: var(--kb-space-4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .about-standard__num {
    margin: 0;
    color: var(--color-king-accent-light);
    opacity: 0.55;
  }

  .about-standard__label {
    margin: 0;
    color: var(--color-king-accent-light);
  }

  .about-standard__copy {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-3);
    flex: 1 1 auto;
  }

  .about-standard__copy h3,
  .about-standard__copy p {
    margin: 0;
  }

  .about-standard__copy h3 {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--kb-text-h4);
    font-weight: var(--kb-w-medium);
    line-height: 1.15;
    text-wrap: balance;
    color: var(--color-king-bone);
  }

  .about-standard__copy p {
    max-width: 40ch;
    font-size: var(--kb-text-sm);
    line-height: 1.65;
    color: rgba(255, 250, 241, 0.64);
    text-wrap: pretty;
  }

  .about-standard__meta {
    margin: 0;
    padding-top: var(--kb-space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-king-accent-light);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .about-standards__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--kb-space-4);
    }
  }
</style>
