---
import SectionHeader from '@components/ui/SectionHeader.astro';
import type { AboutPrinciple } from '@content/about';

interface StandardsData {
  eyebrow: string;
  title: string;
  lede: string;
  badge: string;
  principles: readonly AboutPrinciple[];
}

interface Props {
  data: StandardsData;
  class?: string;
}

const { data, class: className = '' } = Astro.props;
---

<section
  class:list={['about-standards section-spacing section-asphalt about-standards--chapter-end', className]}
  aria-labelledby="about-standards-title"
>
  <div class="kb-shell-wide section-stack-lg">
    <SectionHeader
      eyebrow={data.eyebrow}
      body={data.lede}
      meta={data.badge}
      tone="dark"
    >
      <Fragment slot="title">
        <span id="about-standards-title" set:html={data.title} />
      </Fragment>
    </SectionHeader>

    <ol class="about-standards-list">
      {data.principles.map((principle) => (
        <li class="about-standard">
          <div class="about-standard-head">
            <span class="about-standard-number" aria-hidden="true">{principle.number}</span>
            <p class="kb-eyebrow about-standard-label">{principle.label}</p>
          </div>

          <div class="about-standard-copy">
            <h3>{principle.title}</h3>
            <p>{principle.text}</p>
          </div>

          <p class="kb-meta-label about-standard-meta">{principle.meta}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about-standards--chapter-end {
    padding-bottom: clamp(2.5rem, 4.5vw, 4rem);
  }

  .about-standards-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--kb-stroke-soft);
    border-bottom: 1px solid var(--kb-stroke-soft);
  }

  .about-standard {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--kb-space-6);
    padding: var(--kb-space-6) 0;
    border-bottom: 1px solid var(--kb-stroke-soft);
  }

  .about-standard:last-child {
    border-bottom: 0;
  }

  .about-standard-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--kb-space-4);
  }

  .about-standard-number {
    font-family: var(--font-display);
    font-size: var(--kb-text-h2);
    font-variant-numeric: tabular-nums;
    font-weight: var(--kb-w-heading-light);
    line-height: 1;
    color: var(--color-king-accent-light);
  }

  .about-standard-label,
  .about-standard-meta {
    margin: 0;
    color: var(--color-king-accent-light);
  }

  .about-standard-copy {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
  }

  .about-standard-copy h3,
  .about-standard-copy p {
    margin: 0;
  }

  .about-standard-copy h3 {
    max-width: 22ch;
    font-size: var(--kb-text-h3);
    line-height: 1.12;
    color: var(--color-king-bone);
  }

  .about-standard-copy p {
    max-width: 40ch;
    color: var(--color-king-secondary);
    font-size: var(--kb-text-body-lg);
    line-height: 1.72;
  }

  .about-standard-meta {
    margin-top: auto;
    padding-top: var(--kb-space-4);
    border-top: 1px solid var(--kb-stroke-soft);
  }

  @media (min-width: 48rem) {
    .about-standards-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about-standard {
      gap: var(--kb-space-7);
      padding: var(--kb-space-7) var(--kb-space-8);
      border-right: 1px solid var(--kb-stroke-soft);
      border-bottom: 0;
    }

    .about-standard:first-child {
      padding-left: 0;
    }

    .about-standard:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
