---
import SectionHeaderHome from '../home/SectionHeaderHome.astro';
import CTABox from '../../ui/CTABox.astro';
---

<section class="contact-collection-cta" aria-labelledby="contact-collection-title">
  <div class="contact-collection-cta__inner kb-shell-wide">
    <CTABox
      title="Piezas pensadas para durar."
      buttonLabel="Ver colección"
      buttonHref="/productos"
      buttonVariant="secondary"
      backgroundImage="/images/brand/cinturones-en-taller.jpg"
      backgroundAlt="Cinturón KingBelt de cuero"
      backgroundPosition="center 40%"
      titleTag="h2"
    >
      <SectionHeaderHome
        slot="header"
        index="04"
        eyebrow="Colección"
        meta="Catálogo"
        titleId="contact-collection-title"
        body="Cuero vegetal, herrajes macizos y diseño español. Explora la colección antes de escribirnos."
        tone="dark"
        density="compact"
      >
        <Fragment slot="title">Piezas pensadas para durar.</Fragment>
      </SectionHeaderHome>
    </CTABox>
  </div>
</section>

<style>
  .contact-collection-cta {
    padding-block: var(--kb-space-section);
    border-top: 1px solid var(--kb-stroke-hairline);
    background: var(--color-king-bg);
  }

  .contact-collection-cta :global(.section-header-home) {
    margin-bottom: 0;
  }
</style>
