---
import SectionHeader from '../../common/SectionHeader.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description: string;
  email: string;
  ctaLabel?: string;
  class?: string;
}

const {
  id = 'contact-email-banner',
  eyebrow,
  title,
  description,
  email,
  ctaLabel = 'Enviar email',
  class: className = '',
} = Astro.props;

const titleId = `${id}-title`;
---

<section
  id={id}
  class:list={['contact-email-banner', className]}
  aria-labelledby={titleId}
>
  <div class="contact-email-banner-inner kb-shell-wide">
    <div class="contact-email-banner-frame">
      <div class="contact-email-banner-grid">
        <div class="contact-email-banner-statement">
          <SectionHeader
            eyebrow={eyebrow}
            title={title}
            titleId={titleId}
            body={description}
            meta="06"
            align="left"
            class="contact-email-banner-header"
          />
        </div>

        <div class="contact-email-banner-card">
          <div class="contact-email-banner-card-head">
            <span class="contact-email-banner-card-label">Canal directo</span>
            <span class="contact-email-banner-card-status">
              <span class="contact-email-banner-status-dot" aria-hidden="true"></span>
              Respuesta en 24h
            </span>
          </div>

          <a
            class="contact-email-banner-address"
            href={`mailto:${email}`}
            aria-label={`Enviar correo a ${email}`}
          >
            <span class="contact-email-banner-address-text">{email}</span>
            <span class="contact-email-banner-address-icon" aria-hidden="true">
              <Icon name="arrow-up-right" />
            </span>
          </a>

          <div class="contact-email-banner-actions">
            <Button href={`mailto:${email}`} variant="primary" size="md">
              {ctaLabel}
              <Icon name="mail" />
            </Button>
          </div>

          <div class="contact-email-banner-card-stamp" aria-hidden="true">
            <span>KINGBELT</span>
            <span>ESP</span>
          </div>
        </div>
      </div>

      <div class="contact-email-banner-tracks" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-email-banner {
    padding-top: var(--kb-space-section);
    padding-bottom: clamp(1.75rem, 3vw, 2.75rem);
    background: var(--color-king-bg);
  }

  .contact-email-banner-inner {
    container-type: inline-size;
  }

  .contact-email-banner-frame {
    position: relative;
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--kb-stroke-dark);
    border-radius: var(--kb-radius-2xl);
    background: var(--color-king-surface);
    box-shadow:
      var(--kb-shadow-sm),
      inset 0 1px 0 rgba(255, 255, 255, 0.45);
    overflow: hidden;
  }

  .contact-email-banner-frame::before {
    content: '';
    position: absolute;
    inset: 0.75rem;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: calc(var(--kb-radius-2xl) - 0.5rem);
    pointer-events: none;
  }

  .contact-email-banner-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .contact-email-banner-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: clamp(3rem, 8vw, 8rem);
    }
  }

  .contact-email-banner-statement {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-6);
  }

  .contact-email-banner-header:global(.section-header) {
    --sh-max-title: 16ch;
    --sh-max-copy: 42ch;
  }

  .contact-email-banner-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-6);
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--kb-stroke-steel);
    border-radius: var(--kb-radius-xl);
    background: var(--color-king-graphite);
    box-shadow:
      var(--kb-shadow-float-dark),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .contact-email-banner-card::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 100%;
    background: linear-gradient(
      135deg,
      rgba(142, 120, 56, 0.08) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .contact-email-banner-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    padding-bottom: var(--kb-space-4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .contact-email-banner-card-label {
    font-family: var(--font-sans);
    font-size: var(--kb-text-2xs);
    font-weight: var(--kb-w-semibold);
    letter-spacing: var(--kb-label-tracking);
    text-transform: uppercase;
    color: var(--color-king-steel);
  }

  .contact-email-banner-card-status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-sans);
    font-size: var(--kb-text-2xs);
    font-weight: var(--kb-w-medium);
    color: var(--color-king-bone);
  }

  .contact-email-banner-status-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-king-brass);
    box-shadow: 0 0 0 2px rgba(142, 120, 56, 0.25);
  }

  .contact-email-banner-address {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-3);
    padding-bottom: var(--kb-space-5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-king-bone);
    text-decoration: none;
    transition:
      color var(--kb-dur-med) var(--kb-ease-out),
      border-color var(--kb-dur-med) var(--kb-ease-out);
  }

  .contact-email-banner-address:hover,
  .contact-email-banner-address:focus-visible {
    color: var(--color-king-accent-light);
    border-color: var(--color-king-accent-light);
  }

  .contact-email-banner-address-text {
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 2.2vw, 1.625rem);
    font-weight: var(--kb-w-semibold);
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .contact-email-banner-address-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    color: var(--color-king-bone);
    transition:
      background-color var(--kb-dur-med) var(--kb-ease-out),
      border-color var(--kb-dur-med) var(--kb-ease-out),
      transform var(--kb-dur-med) var(--kb-ease-out);
  }

  .contact-email-banner-address:hover .contact-email-banner-address-icon,
  .contact-email-banner-address:focus-visible .contact-email-banner-address-icon {
    background-color: var(--color-king-accent);
    border-color: var(--color-king-accent);
    transform: translate(2px, -2px);
  }

  .contact-email-banner-address-icon :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .contact-email-banner-actions :global(.kb-btn) {
    width: 100%;
  }

  .contact-email-banner-card-stamp {
    position: absolute;
    bottom: 1.25rem;
    right: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 1px dashed rgba(142, 120, 56, 0.35);
    border-radius: 50%;
    font-family: var(--font-sans);
    font-size: var(--kb-text-2xs);
    font-weight: var(--kb-w-semibold);
    letter-spacing: 0.06em;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.25);
    transform: rotate(-12deg);
    pointer-events: none;
  }

  .contact-email-banner-tracks {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0 clamp(2rem, 5vw, 4rem) clamp(1.25rem, 2.5vw, 2rem);
    pointer-events: none;
  }

  .contact-email-banner-tracks span {
    display: block;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      transparent,
      transparent 8px,
      rgba(123, 125, 120, 0.22) 8px,
      rgba(123, 125, 120, 0.22) 22px
    );
  }

  .contact-email-banner-tracks span:nth-child(2) {
    opacity: 0.6;
  }

  .contact-email-banner-tracks span:nth-child(3) {
    opacity: 0.3;
  }

  @media (max-width: 47.99rem) {
    .contact-email-banner-frame {
      padding: clamp(1.5rem, 5vw, 2rem);
      border-radius: var(--kb-radius-xl);
    }

    .contact-email-banner-frame::before {
      display: none;
    }

    .contact-email-banner-card-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--kb-space-3);
    }

    .contact-email-banner-card-stamp {
      display: none;
    }
  }
</style>
