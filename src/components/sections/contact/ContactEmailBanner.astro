---
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';

interface Hint {
  label: string;
  text: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description: string;
  email: string;
  ctaLabel?: string;
  hints?: readonly Hint[];
  class?: string;
}

const {
  id = 'contact-email-banner',
  eyebrow,
  title,
  description,
  email,
  ctaLabel = 'Enviar email',
  hints = [],
  class: className = '',
} = Astro.props;

const titleId = `${id}-title`;
const hintCount = hints.length;
---

<section
  id={id}
  class:list={['contact-email-banner', className]}
  aria-labelledby={titleId}
>
  <div class="contact-email-banner__inner kb-shell-wide">
    <div class="contact-email-banner__grid">
      <div class="contact-email-banner__intro">
        <SectionHeader
          index="05"
          eyebrow={eyebrow}
          meta="Canal directo"
          title={title}
          body={description}
          titleId={titleId}
          density="compact"
          class="contact-email-banner__header"
        />

        {hintCount > 0 && (
          <div class="contact-email-banner__brief">
            <ol class="contact-email-banner__hints" aria-label="Qué incluir en tu mensaje">
              {hints.map((hint, index) => (
                <li class="contact-email-banner__hint">
                  <div class="contact-email-banner__hint-rail" aria-hidden="true">
                    <span class="contact-email-banner__hint-num">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    {index < hintCount - 1 && (
                      <span class="contact-email-banner__hint-line"></span>
                    )}
                  </div>

                  <div class="contact-email-banner__hint-body">
                    <div class="contact-email-banner__hint-head">
                      <h3 class="contact-email-banner__hint-label">{hint.label}</h3>
                    </div>
                    <p class="contact-email-banner__hint-text">{hint.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>

      <aside class="contact-email-banner__panel kb-reading-panel" aria-label="Email de contacto">
        <header class="kb-reading-panel__head">
          <div class="kb-reading-panel__head-bar">
            <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">Email</p>
            <span class="contact-email-banner__status kb-reading-panel__tag">Canal directo</span>
          </div>

          <p class="kb-reading-panel__statement">Escríbenos con el contexto de tu consulta.</p>
        </header>

        <div class="contact-email-banner__body">
          <a
            class="contact-email-banner__address"
            href={`mailto:${email}`}
            aria-label={`Enviar correo a ${email}`}
          >
            <span class="contact-email-banner__address-text">{email}</span>
            <span class="contact-email-banner__address-icon" aria-hidden="true">
              <Icon name="arrow-up-right" />
            </span>
          </a>

          <div class="contact-email-banner__actions">
            <Button href={`mailto:${email}`} variant="primary" size="md">
              {ctaLabel}
              <Icon name="mail" />
            </Button>
          </div>
        </div>

        <div class="kb-reading-panel__foot" aria-hidden="true">
          <span class="kb-reading-panel__track"></span>
          <span class="kb-reading-panel__track"></span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact-email-banner {
    padding-block: var(--kb-space-section);
    border-top: 1px solid var(--kb-stroke-hairline);
    background: var(--color-king-surface);
  }

  .contact-email-banner__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap-lg);
    align-items: stretch;
  }

  .contact-email-banner__intro {
    display: grid;
    gap: var(--kb-space-5);
    min-width: 0;
  }

  .contact-email-banner__header:global(.section-header) {
    width: 100%;
    margin-bottom: 0;
  }

  .contact-email-banner__brief {
    display: grid;
    gap: var(--kb-space-5);
    min-width: 0;
  }

  .contact-email-banner__hints {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .contact-email-banner__hint {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--kb-space-4);
    padding-block: var(--kb-space-4);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .contact-email-banner__hint-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--kb-space-2);
    padding-top: 0.125rem;
  }

  .contact-email-banner__hint-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    font-family: var(--font-display);
    font-size: var(--kb-text-sm);
    font-weight: var(--kb-w-heading-light);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-king-on-dark-muted);
    opacity: 0.72;
  }

  .contact-email-banner__hint-line {
    display: block;
    width: 1px;
    flex: 1 1 auto;
    min-height: 1.25rem;
    background: linear-gradient(
      180deg,
      var(--color-king-on-dark-line-faint),
      transparent
    );
  }

  .contact-email-banner__hint-body {
    display: grid;
    gap: var(--kb-space-1);
    min-width: 0;
    padding-bottom: var(--kb-space-1);
  }

  .contact-email-banner__hint-label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--kb-text-sm);
    font-weight: var(--kb-w-semibold);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--color-king-text);
  }

  .contact-email-banner__hint-text {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.6;
    color: var(--color-king-muted);
    text-wrap: pretty;
  }

  .contact-email-banner__panel {
    height: 100%;
  }

  .contact-email-banner__status {
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .contact-email-banner__body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--kb-space-5);
    padding-top: var(--kb-space-5);
  }

  .contact-email-banner__address {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    padding-bottom: var(--kb-space-5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-king-bone);
    text-decoration: none;
    transition: color var(--kb-dur-med) var(--kb-ease-out);
  }

  .contact-email-banner__address:hover,
  .contact-email-banner__address:focus-visible {
    color: var(--color-king-on-dark-soft);
  }

  .contact-email-banner__address-text {
    font-family: var(--font-sans);
    font-size: clamp(1.0625rem, 2vw, 1.375rem);
    font-weight: var(--kb-w-semibold);
    letter-spacing: -0.01em;
    line-height: 1.3;
    word-break: break-word;
  }

  .contact-email-banner__address-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    color: inherit;
    transition:
      background-color var(--kb-dur-med) var(--kb-ease-out),
      border-color var(--kb-dur-med) var(--kb-ease-out),
      transform var(--kb-dur-med) var(--kb-ease-out);
  }

  .contact-email-banner__address:hover .contact-email-banner__address-icon,
  .contact-email-banner__address:focus-visible .contact-email-banner__address-icon {
    background-color: var(--color-king-accent);
    border-color: var(--color-king-accent);
    transform: translate(2px, -2px);
  }

  .contact-email-banner__address-icon :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .contact-email-banner__actions :global(.kb-btn) {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 64rem) {
    .contact-email-banner__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: var(--kb-space-10);
      align-items: center;
    }

    .contact-email-banner__intro {
      gap: var(--kb-space-6);
      padding-right: var(--kb-space-4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-email-banner__address,
    .contact-email-banner__address-icon {
      transition: none;
    }
  }
</style>
