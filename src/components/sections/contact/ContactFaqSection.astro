---
import SectionHeader from '@components/ui/SectionHeader.astro';
import FAQ from '@components/faq/FAQ.astro';
import Icon from '../../ui/Icon.astro';
import MediaFrame from '../../ui/MediaFrame.astro';
import type { FAQItem } from '@content/faq';
import type { FAQSidebar } from '@content/contact';

interface Props {
  items: readonly FAQItem[];
  sidebar: FAQSidebar;
}

const { items, sidebar } = Astro.props;
---

<FAQ
  id="preguntas-frecuentes"
  class="contact-faq"
  items={items}
  tone="light"
  stickySidebar={true}
  itemVariant="editorial"
>
  <SectionHeader
    slot="header"
    index="03"
    eyebrow="Preguntas frecuentes"
    meta="Ayuda"
    title="Resolvemos las dudas <em>antes de que surjan</em>."
    titleId="contact-faq-title"
    body="Respuestas a dudas habituales. Si no encuentras lo que buscas, escríbenos desde el formulario."
    class="contact-faq__header"
  />

  <aside slot="sidebar" class="contact-faq__sidebar" aria-label="Soporte">
    <MediaFrame
      src={sidebar.image}
      alt={sidebar.imageAlt}
      ratio="3/4"
      label={sidebar.label}
      caption={sidebar.caption}
      captionNumber="03"
      width={800}
      height={1067}
      loading="lazy"
      class="contact-faq__media"
    />

    <div class="contact-faq__support">
      <span class="contact-faq__support-label kb-meta-label">Soporte</span>
      <div class="contact-faq__support-row">
        <span class="contact-faq__support-icon" aria-hidden="true">
          <Icon name="mail" />
        </span>
        <span class="contact-faq__support-text">Atención por email, teléfono y WhatsApp.</span>
      </div>
    </div>
  </aside>
</FAQ>

<style>
  .contact-faq:global(.faq-section) {
    padding-block: var(--kb-space-section);
    border-top: 1px solid var(--kb-stroke-hairline);
    background: var(--color-king-surface);
  }

  .contact-faq:global(.faq-section--light)::before {
    opacity: 0.12;
  }

  .contact-faq__header:global(.section-header) {
    width: 100%;
    margin-bottom: var(--kb-space-gap);
  }

  .contact-faq__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    min-width: 0;
    min-height: 0;
  }

  .contact-faq :global(.contact-faq__media.media-frame.media-frame--ratio-3-4) {
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--kb-panel-radius);
  }

  .contact-faq :global(.contact-faq__media.media-frame .media-frame__stage) {
    min-height: 100%;
  }

  .contact-faq :global(.contact-faq__media.media-frame.media-frame--ratio-3-4 .media-frame__image) {
    object-position: center 42%;
    transform: scale(1.42);
    transform-origin: center 42%;
  }

  .contact-faq__support {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-3);
    flex-shrink: 0;
    padding: var(--kb-space-4);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-card-radius);
    background: color-mix(in srgb, var(--color-king-bone) 18%, var(--color-king-bg));
  }

  .contact-faq__support-label {
    display: block;
    color: var(--color-king-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-faq__support-row {
    display: flex;
    align-items: center;
    gap: var(--kb-space-3);
  }

  .contact-faq__support-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--kb-radius-xs);
    border: 1px solid var(--kb-stroke-hairline);
    background: color-mix(in srgb, var(--color-king-accent) 7%, transparent);
    color: var(--color-king-accent);
  }

  .contact-faq__support-icon :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .contact-faq__support-text {
    font-size: var(--kb-text-xs);
    line-height: 1.5;
    color: var(--color-king-muted);
  }

  .contact-faq :global(.faq-list) {
    gap: var(--kb-space-3);
  }

  @media (min-width: 64rem) {
    .contact-faq :global(.faq-layout) {
      grid-template-columns: minmax(16rem, 0.34fr) minmax(0, 0.66fr);
      gap: var(--kb-space-10);
      align-items: stretch;
    }

    .contact-faq :global(.faq-sidebar) {
      display: flex;
      align-self: stretch;
      min-height: 100%;
    }

    .contact-faq__sidebar {
      flex: 1 1 auto;
      width: 100%;
      min-height: 100%;
      position: sticky;
      top: var(--kb-sticky-below-header);
    }

    .contact-faq :global(.contact-faq__media.media-frame.media-frame--ratio-3-4) {
      flex: 1 1 0;
      height: 100%;
      min-height: clamp(18rem, 42vh, 28rem);
      aspect-ratio: auto;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-faq :global(.contact-faq__media.media-frame.media-frame--ratio-3-4:hover .media-frame__image) {
      transform: scale(1.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-faq :global(.contact-faq__media.media-frame.media-frame--ratio-3-4 .media-frame__image) {
      transform: scale(1.42);
    }
  }

  @media (max-width: 63.99rem) {
    .contact-faq__sidebar {
      min-height: auto;
    }

    .contact-faq :global(.contact-faq__media) {
      aspect-ratio: 3 / 4;
    }
  }
</style>
