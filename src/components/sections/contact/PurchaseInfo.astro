---
import HomeSectionHead from '../home/HomeSectionHead.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import MediaFrame from '../../ui/MediaFrame.astro';
import type { PurchaseInfoItem } from '@content/contact';

interface BadgeData {
  label: string;
}

interface CtaData {
  label: string;
  href: string;
}

interface ImageData {
  src: string;
  alt: string;
  label?: string;
  caption?: string;
}

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description: string;
  items: readonly PurchaseInfoItem[];
  badge?: BadgeData;
  cta?: CtaData;
  image?: ImageData;
  class?: string;
}

const {
  id = 'purchase-info',
  eyebrow,
  title,
  description,
  items,
  badge,
  cta,
  image,
  class: className = '',
} = Astro.props;

const titleId = `${id}-title`;
const layerCount = items.length;
---

<section
  id={id}
  class:list={['purchase-info', className]}
  aria-labelledby={titleId}
>
  <div class="purchase-info__inner kb-shell-wide">
    <HomeSectionHead
      index="02"
      eyebrow={eyebrow}
      meta={badge ? badge.label : 'Tu compra'}
      titleId={titleId}
      body={description}
      class="purchase-info__header"
    >
      <Fragment slot="title">{title}</Fragment>

      {cta && (
        <Fragment slot="action">
          <Button href={cta.href} variant="outline" size="md">
            {cta.label}
            <Icon name="arrow-right" />
          </Button>
        </Fragment>
      )}
    </HomeSectionHead>

    <div class="purchase-info__layout">
      {image && (
        <MediaFrame
          src={image.src}
          alt={image.alt}
          ratio="4/3"
          label={image.label}
          caption={image.caption}
          captionNumber="02"
          width={960}
          height={720}
          loading="lazy"
          class="purchase-info__media"
        />
      )}

      <aside class="kb-reading-panel" aria-labelledby={`${id}-panel-title`}>
        <header class="kb-reading-panel__head">
          <div class="kb-reading-panel__head-bar">
            <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">
              Información
            </p>
            <span class="kb-reading-panel__folio kb-meta-label" aria-hidden="true">
              {String(layerCount).padStart(2, '0')}
            </span>
          </div>

          <p id={`${id}-panel-title`} class="kb-reading-panel__statement">
            Todo lo que necesitas saber antes y después de comprar.
          </p>
        </header>

        <ol class="kb-reading-panel__layers">
          {items.map((item, index) => (
            <li class="kb-reading-panel__layer">
              <div class="kb-reading-panel__rail" aria-hidden="true">
                <span class="kb-reading-panel__num">{String(index + 1).padStart(2, '0')}</span>
                {index < layerCount - 1 && (
                  <span class="kb-reading-panel__rail-line"></span>
                )}
              </div>

              <div class="kb-reading-panel__body">
                <div class="kb-reading-panel__layer-head">
                  <h3 class="kb-reading-panel__label">{item.title}</h3>
                  <span class="kb-reading-panel__tag">{item.label}</span>
                </div>
                <p class="kb-reading-panel__text">{item.description}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="kb-reading-panel__foot" aria-hidden="true">
          <span class="kb-reading-panel__track"></span>
          <span class="kb-reading-panel__track"></span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .purchase-info {
    padding-block: var(--kb-space-section);
    background: var(--color-king-surface);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .purchase-info__header:global(.section-header-home) {
    width: 100%;
    margin-bottom: var(--kb-space-gap);
  }

  .purchase-info__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .purchase-info__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: stretch;
    }

    .purchase-info__layout .kb-reading-panel {
      height: 100%;
    }

    .purchase-info__media:global(.media-frame) {
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }
  }
</style>
