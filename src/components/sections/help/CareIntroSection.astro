---
import HomeSectionHead from '../home/HomeSectionHead.astro';
import MediaFrame from '../../ui/MediaFrame.astro';

interface ImageData {
  src: string;
  alt: string;
  label: string;
  caption: string;
}

interface NoteData {
  label: string;
  text: string;
}

interface SectionCopy {
  index: string;
  eyebrow: string;
  meta: string;
  title: string;
  body: string;
  image: ImageData;
  note: NoteData;
}

interface Props {
  section: SectionCopy;
}

const { section } = Astro.props;
const titleId = 'care-intro-title';
---

<section class="care-intro" aria-labelledby={titleId}>
  <div class="care-intro__inner kb-shell-wide">
    <HomeSectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      meta={section.meta}
      titleId={titleId}
      body={section.body}
      class="care-intro__header"
    >
      <Fragment slot="title">{section.title}</Fragment>
    </HomeSectionHead>

    <div class="care-intro__layout">
      <MediaFrame
        src={section.image.src}
        alt={section.image.alt}
        ratio="4/3"
        label={section.image.label}
        caption={section.image.caption}
        captionNumber={section.index}
        width={960}
        height={720}
        loading="lazy"
        class="care-intro__media"
      />

      <aside class="kb-reading-panel" aria-labelledby="care-intro-note-title">
        <header class="kb-reading-panel__head">
          <div class="kb-reading-panel__head-bar">
            <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">Alcance</p>
            <span class="kb-reading-panel__tag">{section.note.label}</span>
          </div>
          <p id="care-intro-note-title" class="kb-reading-panel__statement">
            Hasta que cada ficha publique lo específico.
          </p>
        </header>
        <p class="kb-reading-panel__text care-intro__note">{section.note.text}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .care-intro {
    padding-block: var(--kb-space-section);
    background: var(--color-king-surface);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .care-intro__header:global(.section-header-home) {
    width: 100%;
    margin-bottom: var(--kb-space-gap);
  }

  .care-intro__layout {
    display: grid;
    gap: var(--kb-space-gap);
    align-items: start;
  }

  .care-intro__note {
    padding-top: var(--kb-space-4);
    max-width: none;
  }

  @media (min-width: 64rem) {
    .care-intro__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: stretch;
    }

    .care-intro__layout .kb-reading-panel {
      height: 100%;
    }

    .care-intro__media:global(.media-frame) {
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }
  }
</style>
