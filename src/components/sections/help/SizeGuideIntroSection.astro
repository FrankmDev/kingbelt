---
import SectionHeader from '@components/ui/SectionHeader.astro';
import MediaFrame from '../../ui/MediaFrame.astro';

interface ImageData {
  src: string;
  alt: string;
  label: string;
  caption: string;
}

interface SectionCopy {
  index: string;
  eyebrow: string;
  meta: string;
  title: string;
  body: string;
  image: ImageData;
}

interface Props {
  section: SectionCopy;
}

const { section } = Astro.props;
const titleId = 'size-guide-intro-title';
---

<section class="size-guide-intro" aria-labelledby={titleId}>
  <div class="size-guide-intro__inner kb-shell-wide">
    <SectionHeader
      index={section.index}
      eyebrow={section.eyebrow}
      meta={section.meta}
      title={section.title}
      titleId={titleId}
      body={section.body}
      class="size-guide-intro__header"
    />

    <MediaFrame
      src={section.image.src}
      alt={section.image.alt}
      ratio="3/2"
      label={section.image.label}
      caption={section.image.caption}
      captionNumber={section.index}
      width={1500}
      height={1000}
      loading="lazy"
      class="size-guide-intro__media"
    />
  </div>
</section>

<style>
  .size-guide-intro {
    padding-block: var(--kb-space-section);
    background: var(--color-king-surface);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .size-guide-intro__header:global(.section-header) {
    width: 100%;
    margin-bottom: var(--kb-space-gap);
  }

  .size-guide-intro__media:global(.media-frame) {
    width: 100%;
  }
</style>
