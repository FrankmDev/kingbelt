---
import SectionHeader from '@components/ui/SectionHeader.astro';
import SizeGuideTable from '../../help/SizeGuideTable.astro';

interface SectionCopy {
  index: string;
  eyebrow: string;
  meta: string;
  title: string;
  body: string;
}

interface Props {
  section: SectionCopy;
}

const { section } = Astro.props;
const titleId = 'size-guide-table-title';
---

<section class="size-guide-table" aria-labelledby={titleId}>
  <div class="size-guide-table__inner kb-shell-wide">
    <SectionHeader
      index={section.index}
      eyebrow={section.eyebrow}
      meta={section.meta}
      title={section.title}
      titleId={titleId}
      body={section.body}
      class="size-guide-table__header"
    />

    <SizeGuideTable />
  </div>
</section>

<style>
  .size-guide-table {
    padding-block: var(--kb-space-section);
    background: var(--color-king-surface);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .size-guide-table__header:global(.section-header) {
    width: 100%;
    margin-bottom: var(--kb-space-gap);
  }
</style>
