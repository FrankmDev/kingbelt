<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const scope = document.querySelector<HTMLElement>('[data-hero-home]');

  if (scope && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const video = scope.querySelector<HTMLElement>('.hero-home__video');
    const wordmark = scope.querySelector<HTMLElement>('[data-hero-wordmark]');
    const items = scope.querySelectorAll<HTMLElement>('[data-hero-item]');
    const horizon = scope.querySelector<HTMLElement>('.hero-home__horizon');

    const intro = gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.08 });

    if (horizon) {
      gsap.set(horizon, { opacity: 0 });
      intro.to(horizon, { opacity: 0.42, duration: 0.9 }, 0.95);
    }

    if (wordmark) {
      gsap.set(wordmark, { yPercent: 14, opacity: 0, filter: 'blur(6px)' });
      intro.to(
        wordmark,
        { yPercent: 0, opacity: 1, filter: 'blur(0px)', duration: 1.05 },
        0.34,
      );
    }

    if (items.length) {
      gsap.set(items, { y: 18, opacity: 0 });
      intro.to(items, { y: 0, opacity: 1, duration: 0.78, stagger: 0.09 }, 0.48);
    }

    if (video) {
      gsap.to(video, {
        scale: 1.12,
        ease: 'none',
        scrollTrigger: {
          trigger: scope,
          start: 'top top',
          end: 'bottom top',
          scrub: 1.1,
        },
      });
    }
  }
</script>

<style is:global>
  html:has(#inicio) {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  html:has(#inicio)::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
</style>
