---
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import MediaFrame from '../../ui/MediaFrame.astro';
import { brandStatement } from '@content/home';

const signalCount = brandStatement.signals.length;
---

<section
  id="marca"
  class="home-brand section-spacing"
  aria-labelledby="home-brand-title"
>
  <div class="kb-shell-wide">
    <SectionHeader
      index={brandStatement.index}
      eyebrow={brandStatement.eyebrow}
      body={brandStatement.lede}
      meta={brandStatement.meta}
      titleId="home-brand-title"
      class="home-brand__header"
    >
      <Fragment slot="title">
        <span set:html={brandStatement.title} />
      </Fragment>

      <Fragment slot="aside">
        <Button href={brandStatement.cta.href} variant="outline" size="md">
          {brandStatement.cta.label}
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
          />
        </Button>
      </Fragment>
    </SectionHeader>

    <div class="home-brand__layout">
      <div class="home-brand__panel kb-origin-panel">
        <div class="home-brand__intro">
          <p class="kb-meta-label text-king-muted kb-origin-panel__kicker">
            {brandStatement.kicker}
          </p>
          <p class="body-copy-lg kb-origin-panel__body">{brandStatement.body}</p>
        </div>

        <ol class="home-brand__signals" aria-label="Señales de la marca">
          {brandStatement.signals.map((signal, index) => (
            <li class="home-brand__signal">
              <div class="home-brand__signal-rail" aria-hidden="true">
                <span class="home-brand__signal-num">{signal.number}</span>
                {index < signalCount - 1 && <span class="home-brand__signal-line"></span>}
              </div>

              <div class="home-brand__signal-body">
                <h3 class="home-brand__signal-label">{signal.label}</h3>
                <p class="home-brand__signal-text">{signal.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <blockquote class="kb-origin-panel__quote home-brand__quote">
          <p>{brandStatement.quote}</p>
        </blockquote>
      </div>

      <MediaFrame
        src={brandStatement.image}
        alt={brandStatement.imageAlt}
        ratio="3/2"
        label={brandStatement.imageLabel}
        caption={brandStatement.imageCaption}
        captionNumber={brandStatement.index}
        imagePosition={brandStatement.imagePosition}
        width={1500}
        height={1000}
        loading="lazy"
        class="home-brand__media"
      />
    </div>
  </div>
</section>

<style>
  .home-brand {
    border-top: 1px solid var(--kb-stroke-hairline);
    background: var(--color-king-bg);
  }

  .home-brand__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap-lg);
    align-items: start;
    min-width: 0;
  }

  .home-brand__panel {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0;
    padding: clamp(var(--kb-space-5), 2.8vw, var(--kb-space-6));
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-card-radius);
    background: color-mix(in srgb, var(--color-king-bone) 18%, var(--color-king-bg));
    box-shadow: var(--kb-shadow-sm);
    overflow: hidden;
  }

  .home-brand__panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: clamp(var(--kb-space-5), 2.8vw, var(--kb-space-6));
    right: clamp(var(--kb-space-5), 2.8vw, var(--kb-space-6));
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-brass) 55%, transparent) 48%,
      transparent
    );
    opacity: 0.72;
    pointer-events: none;
  }

  .home-brand__intro {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--kb-space-4);
    align-items: start;
    min-width: 0;
  }

  .home-brand__intro::before {
    content: '';
    display: block;
    width: 1px;
    min-height: 100%;
    align-self: stretch;
    background: linear-gradient(
      180deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-accent) 18%, transparent) 78%,
      transparent
    );
    opacity: 0.85;
  }

  .home-brand__panel :global(.kb-origin-panel__kicker) {
    margin: 0;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-brand__panel :global(.kb-origin-panel__body) {
    margin: 0;
    color: color-mix(in srgb, var(--color-king-text) 68%, var(--color-king-muted));
  }

  .home-brand__signals {
    display: grid;
    gap: 0;
    margin: var(--kb-space-5) 0 0;
    padding: var(--kb-space-5) 0 0;
    list-style: none;
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .home-brand__signal {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--kb-space-4);
    row-gap: var(--kb-space-1);
    padding-block: var(--kb-space-4);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .home-brand__signal:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .home-brand__signal-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--kb-space-2);
    padding-top: 0.125rem;
  }

  .home-brand__signal-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    border: 1px solid color-mix(in srgb, var(--kb-stroke-hairline) 90%, transparent);
    border-radius: var(--kb-radius-xs);
    font-family: var(--font-display);
    font-size: var(--kb-text-sm);
    font-weight: var(--kb-w-heading-light);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-king-accent);
    background: color-mix(in srgb, var(--color-king-bone) 24%, var(--color-king-bg));
  }

  .home-brand__signal-line {
    display: block;
    width: 1px;
    flex: 1 1 auto;
    min-height: 1.25rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-king-accent) 28%, var(--kb-stroke-hairline)),
      transparent
    );
  }

  .home-brand__signal-body {
    display: grid;
    gap: var(--kb-space-1);
    min-width: 0;
    padding-bottom: var(--kb-space-1);
  }

  .home-brand__signal-label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--kb-text-sm);
    font-weight: var(--kb-w-semibold);
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--color-king-text);
  }

  .home-brand__signal-text {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.6;
    color: var(--color-king-muted);
    text-wrap: pretty;
  }

  .home-brand__quote:global(.kb-origin-panel__quote) {
    margin-top: auto;
    padding-top: clamp(1.15rem, 2.4vw, 1.5rem);
    border-top-color: var(--kb-stroke-hairline);
  }

  @media (max-width: 47.99rem) {
    .home-brand__intro {
      grid-template-columns: minmax(0, 1fr);
    }

    .home-brand__intro::before {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .home-brand__signals {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0;
    }

    .home-brand__signal {
      grid-template-columns: minmax(0, 1fr);
      padding: 0 var(--kb-space-5) 0 0;
      border-bottom: 0;
      border-right: 1px solid var(--kb-stroke-hairline);
    }

    .home-brand__signal:last-child {
      padding-right: 0;
      border-right: 0;
    }

    .home-brand__signal-rail {
      flex-direction: row;
      align-items: center;
      gap: 0;
      padding-top: 0;
    }

    .home-brand__signal-line {
      display: none;
    }

    .home-brand__signal-body {
      padding-bottom: 0;
    }
  }

  @media (min-width: 64rem) {
    .home-brand__layout {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: stretch;
    }

    .home-brand__panel {
      min-height: 100%;
    }

    .home-brand__media:global(.media-frame) {
      width: 100%;
      height: 100%;
      min-height: 100%;
      aspect-ratio: auto;
    }

    .home-brand__media:global(.media-frame .media-frame__stage) {
      min-height: 100%;
      height: 100%;
    }

    .home-brand__media:global(.media-frame .media-frame__image) {
      object-fit: cover;
      transform: scale(1.06);
      transform-origin: center 42%;
    }

    @media (hover: hover) and (pointer: fine) {
      .home-brand__media:global(.media-frame:hover .media-frame__image) {
        transform: scale(1.12);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-brand__media:global(.media-frame .media-frame__image) {
        transform: scale(1.06);
      }
    }
  }
</style>
