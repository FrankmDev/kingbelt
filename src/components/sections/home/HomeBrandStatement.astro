---
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '../../ui/Button.astro';
import FeatureCard from '../../ui/FeatureCard.astro';
import Icon from '../../ui/Icon.astro';
import MediaFrame from '../../ui/MediaFrame.astro';
import Panel from '../../ui/Panel.astro';
import { brandStatement } from '@content/home';

const { panel, highlights, shortcuts } = brandStatement;
---

<section
  id="marca"
  class="home-brand section-spacing"
  aria-labelledby="home-brand-title"
>
  <div class="kb-shell-wide home-brand__shell">
    <SectionHeader
      index={brandStatement.index}
      eyebrow={brandStatement.eyebrow}
      body={brandStatement.lede}
      meta={brandStatement.meta}
      titleId="home-brand-title"
      class="home-brand__header"
    >
      <Fragment slot="title">
        <span set:html={brandStatement.title} />
      </Fragment>

      <Fragment slot="aside">
        <Button href={brandStatement.cta.href} variant="outline" size="md">
          {brandStatement.cta.label}
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
          />
        </Button>
      </Fragment>
    </SectionHeader>

    <div class="home-brand__layout">
      <Panel padding="lg" class="home-brand__panel">
        <div class="kb-origin-panel">
          <header class="home-brand__panel-head">
            <p class="kb-eyebrow kb-eyebrow-lined text-king-accent">{panel.eyebrow}</p>
            <p class="home-brand__statement font-display">{panel.statement}</p>
          </header>

          <div class="kb-origin-panel__main home-brand__panel-main">
            <p class="kb-meta-label text-king-muted kb-origin-panel__kicker">{brandStatement.kicker}</p>
            <p class="body-copy-lg kb-origin-panel__body">{brandStatement.body}</p>
          </div>

          <ul class="home-brand__highlights" aria-label="Datos de la marca">
            {highlights.map((item) => (
              <li class="home-brand__highlight">
                <span class="home-brand__highlight-label kb-meta-label">{item.label}</span>
                <p class="home-brand__highlight-text body-copy text-king-muted">{item.text}</p>
              </li>
            ))}
          </ul>

          <blockquote class="kb-origin-panel__quote home-brand__quote">
            <p>{brandStatement.quote}</p>
          </blockquote>

          {shortcuts.length > 0 && (
            <footer class="home-brand__foot">
              <nav aria-label="Accesos de la marca">
                <ul class="home-brand__shortcut-list">
                  {shortcuts.map((shortcut) => (
                    <li>
                      <a href={shortcut.href} class="home-brand__shortcut">
                        {shortcut.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </footer>
          )}
        </div>
      </Panel>

      <MediaFrame
        src={brandStatement.image}
        alt={brandStatement.imageAlt}
        ratio="3/2"
        label={brandStatement.imageLabel}
        caption={brandStatement.imageCaption}
        captionNumber={brandStatement.index}
        imagePosition={brandStatement.imagePosition}
        width={1500}
        height={1000}
        loading="lazy"
        class="home-brand__media"
      />
    </div>

    <ul class="home-brand__signals">
      {brandStatement.signals.map((signal) => (
        <li class="home-brand__signal-item">
          <FeatureCard
            number={signal.number}
            eyebrow={signal.meta}
            title={signal.label}
            description={signal.text}
            class="home-brand__signal-card"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-brand {
    background: var(--color-king-surface);
  }

  .home-brand__shell {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--kb-space-gap);
  }

  .home-brand__header:global(.section-header) {
    margin-bottom: 0;
  }

  .home-brand__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap);
    align-items: start;
    min-width: 0;
  }

  .home-brand__panel {
    min-width: 0;
  }

  .home-brand__panel-head {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-3);
    margin-bottom: var(--kb-space-5);
    min-width: 0;
  }

  .home-brand__panel-head .kb-eyebrow {
    margin: 0;
  }

  .home-brand__statement {
    margin: 0;
    max-width: 28ch;
    font-size: var(--kb-text-h4);
    font-weight: var(--kb-w-medium);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--color-king-text);
  }

  .home-brand__panel-main {
    margin-bottom: var(--kb-space-4);
  }

  .home-brand__panel :global(.kb-origin-panel__kicker) {
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-brand__panel :global(.kb-origin-panel__body) {
    color: color-mix(in srgb, var(--color-king-text) 72%, var(--color-king-muted));
  }

  .home-brand__highlights {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    margin: 0;
    padding: var(--kb-space-4) 0;
    list-style: none;
    border-top: 1px solid var(--kb-stroke-hairline);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .home-brand__highlight {
    display: grid;
    grid-template-columns: minmax(5.5rem, 6.5rem) minmax(0, 1fr);
    gap: var(--kb-space-3) var(--kb-space-4);
    align-items: baseline;
    min-width: 0;
    padding-block: var(--kb-space-3);
  }

  .home-brand__highlight + .home-brand__highlight {
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .home-brand__highlight-label {
    margin: 0;
    color: var(--color-king-accent);
  }

  .home-brand__highlight-text {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .home-brand__quote:global(.kb-origin-panel__quote) {
    margin-top: var(--kb-space-5);
    border-top-color: var(--kb-stroke-hairline);
  }

  .home-brand__foot {
    margin-top: var(--kb-space-5);
    padding-top: var(--kb-space-4);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .home-brand__shortcut-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-2) var(--kb-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-brand__shortcut-list li {
    display: inline-flex;
    align-items: center;
  }

  .home-brand__shortcut-list li + li::before {
    content: '·';
    margin-right: var(--kb-space-4);
    color: var(--color-king-muted);
    font-size: var(--kb-text-meta);
    line-height: 1;
  }

  .home-brand__shortcut {
    font-size: var(--kb-text-meta);
    font-weight: var(--kb-label-weight);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-king-accent) 30%, transparent);
    text-underline-offset: 0.22em;
    color: var(--color-king-accent);
    transition:
      color var(--kb-dur-fast) var(--kb-ease-out),
      text-decoration-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .home-brand__shortcut:focus-visible {
    border-radius: var(--kb-radius-sm);
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  .home-brand__signals {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .home-brand__signal-item {
    min-width: 0;
    display: flex;
  }

  .home-brand__signal-card:global(.feature-card) {
    width: 100%;
    min-height: 100%;
  }

  @media (max-width: 47.99rem) {
    .home-brand__signals {
      gap: 0;
    }

    .home-brand__signal-item {
      padding-block: var(--kb-space-6);
      border-bottom: 1px solid var(--kb-stroke-hairline);
    }

    .home-brand__signal-item:first-child {
      padding-top: 0;
    }

    .home-brand__signal-item:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .home-brand__signal-card:global(.feature-card) {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .home-brand__signal-card:global(.feature-card)::before,
    .home-brand__signal-card:global(.feature-card)::after {
      display: none;
    }

    .home-brand__signal-card:global(.feature-card):hover {
      transform: none;
      border-color: transparent;
      box-shadow: none;
    }
  }

  @media (min-width: 48rem) {
    .home-brand__highlights {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 var(--kb-space-4);
      padding-block: var(--kb-space-5);
    }

    .home-brand__highlight {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--kb-space-2);
      padding: 0 var(--kb-space-4) 0 0;
      border-top: 0;
      border-right: 1px solid var(--kb-stroke-hairline);
    }

    .home-brand__highlight + .home-brand__highlight {
      border-top: 0;
    }

    .home-brand__highlight:last-child {
      padding-right: 0;
      border-right: 0;
    }

    .home-brand__signals {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--kb-space-4);
      align-items: stretch;
    }
  }

  @media (min-width: 64rem) {
    .home-brand__layout {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: var(--kb-space-gap-lg);
      align-items: stretch;
    }

    .home-brand__panel {
      min-height: 100%;
    }

    .home-brand__media:global(.media-frame) {
      width: 100%;
      height: 100%;
      min-height: 100%;
      aspect-ratio: auto;
    }

    .home-brand__media:global(.media-frame .media-frame__stage) {
      min-height: 100%;
      height: 100%;
    }

    .home-brand__media:global(.media-frame .media-frame__image) {
      object-fit: cover;
      transform: scale(1.04);
      transform-origin: center 42%;
    }

    @media (hover: hover) and (pointer: fine) {
      .home-brand__media:global(.media-frame:hover .media-frame__image) {
        transform: scale(1.09);
      }

      .home-brand__shortcut:hover {
        color: var(--color-king-text);
        text-decoration-color: var(--color-king-accent);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-brand__media:global(.media-frame .media-frame__image) {
        transform: scale(1.04);
      }

      .home-brand__shortcut {
        transition: none;
      }
    }
  }
</style>
