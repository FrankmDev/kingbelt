---
import SectionHeader from '@components/ui/SectionHeader.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import MediaFrame from '../../ui/MediaFrame.astro';
import Panel from '../../ui/Panel.astro';
import { brandStatement } from '@content/home';

const { panel, highlights, shortcuts } = brandStatement;
const layerCount = highlights.length;
---

<section
  id="marca"
  class="home-brand section-spacing"
  aria-labelledby="home-brand-title"
>
  <div class="kb-shell-wide home-brand__shell">
    <SectionHeader
      index={brandStatement.index}
      eyebrow={brandStatement.eyebrow}
      title={brandStatement.title}
      body={brandStatement.lede}
      meta={brandStatement.meta}
      titleId="home-brand-title"
      class="home-brand__header"
    >
      <Fragment slot="aside">
        <Button href={brandStatement.cta.href} variant="outline" size="md">
          {brandStatement.cta.label}
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
          />
        </Button>
      </Fragment>
    </SectionHeader>

    <div class="home-brand__layout">
      <Panel padding="lg" class="home-brand__panel">
        <header class="home-brand__panel-head">
          <div class="home-brand__panel-bar">
            <p class="kb-eyebrow kb-eyebrow-lined home-brand__eyebrow">{panel.eyebrow}</p>
            <span class="kb-meta-label home-brand__folio" aria-hidden="true">
              {String(layerCount).padStart(2, '0')}
            </span>
          </div>

          <p id="home-brand-panel-title" class="home-brand__statement">
            {panel.statement}
          </p>

          <p class="home-brand__panel-lede">{brandStatement.body}</p>
        </header>

        <ol class="home-brand__facts">
          {highlights.map((item, index) => (
            <li class="home-brand__fact">
              <div class="home-brand__fact-rail" aria-hidden="true">
                <span class="home-brand__fact-num">{item.number}</span>
                {index < layerCount - 1 && <span class="home-brand__fact-line"></span>}
              </div>

              <div class="home-brand__fact-copy">
                <h3 class="home-brand__fact-label">{item.label}</h3>
                <p class="home-brand__fact-text">{item.text}</p>
              </div>
            </li>
          ))}
        </ol>

        {shortcuts.length > 0 && (
          <footer class="home-brand__foot">
            <nav aria-label="Accesos de la marca">
              <ul class="home-brand__shortcut-list">
                {shortcuts.map((shortcut) => (
                  <li>
                    <a href={shortcut.href} class="home-brand__shortcut kb-action-label">
                      {shortcut.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </footer>
        )}
      </Panel>

      <MediaFrame
        src={brandStatement.image}
        alt={brandStatement.imageAlt}
        ratio="3/2"
        label={brandStatement.imageLabel}
        caption={brandStatement.imageCaption}
        captionNumber={brandStatement.index}
        imagePosition={brandStatement.imagePosition}
        width={1500}
        height={1000}
        loading="lazy"
        class="home-brand__media"
      />
    </div>
  </div>
</section>

<style>
  .home-brand {
    background: var(--color-king-surface);
  }

  .home-brand__shell {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--kb-space-gap);
  }

  .home-brand__header:global(.section-header) {
    margin-bottom: 0;
  }

  .home-brand__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap);
    align-items: start;
    min-width: 0;
  }

  .home-brand__panel {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .home-brand__panel-head {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-3);
    padding-bottom: var(--kb-space-5);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .home-brand__panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
  }

  .home-brand__eyebrow {
    margin: 0;
    color: var(--color-king-accent);
  }

  .home-brand__folio {
    margin: 0;
    flex-shrink: 0;
    color: var(--color-king-muted);
    letter-spacing: 0.16em;
  }

  .home-brand__statement {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    font-style: italic;
    font-weight: var(--kb-w-heading);
    line-height: 1.32;
    letter-spacing: -0.012em;
    color: var(--color-king-text);
    text-wrap: balance;
  }

  .home-brand__panel-lede {
    margin: 0;
    max-width: 40ch;
    font-size: var(--kb-text-body);
    line-height: 1.55;
    color: var(--color-king-muted);
  }

  .home-brand__facts {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    margin: 0;
    padding: var(--kb-space-5) 0 0;
    list-style: none;
  }

  .home-brand__fact {
    display: grid;
    grid-template-columns: 2.35rem minmax(0, 1fr);
    column-gap: clamp(0.85rem, 1.8vw, 1.15rem);
    align-items: stretch;
  }

  .home-brand__fact-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
  }

  .home-brand__fact-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid color-mix(in srgb, var(--color-king-accent) 28%, var(--kb-stroke-hairline));
    border-radius: var(--kb-radius-xs);
    background: color-mix(in srgb, var(--color-king-accent) 6%, var(--color-king-surface));
    font-family: var(--font-display);
    font-size: var(--kb-text-body);
    font-variant-numeric: tabular-nums;
    font-weight: var(--kb-w-heading-light);
    line-height: 1;
    color: var(--color-king-accent);
  }

  .home-brand__fact-line {
    flex: 1;
    width: 1px;
    min-height: 0.65rem;
    margin-block: 0.35rem;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-king-accent) 32%, transparent) 0%,
      var(--kb-stroke-hairline) 100%
    );
  }

  .home-brand__fact-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: var(--kb-space-4);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .home-brand__fact:last-child .home-brand__fact-copy {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .home-brand__fact-label {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--kb-text-body-lg);
    font-weight: var(--kb-w-semibold);
    line-height: 1.2;
    letter-spacing: 0.01em;
    color: var(--color-king-text);
  }

  .home-brand__fact-text {
    margin: 0;
    max-width: 36ch;
    font-size: var(--kb-text-body);
    line-height: 1.55;
    color: var(--color-king-muted);
  }

  .home-brand__foot {
    margin-top: auto;
    padding-top: var(--kb-space-5);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .home-brand__shortcut-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-2) var(--kb-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-brand__shortcut-list li {
    display: inline-flex;
    align-items: center;
  }

  .home-brand__shortcut-list li + li::before {
    content: '·';
    margin-right: var(--kb-space-4);
    color: var(--color-king-muted);
    font-size: var(--kb-text-meta);
    font-weight: var(--kb-w-body);
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
  }

  .home-brand__shortcut {
    color: var(--color-king-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-king-accent) 30%, transparent);
    text-underline-offset: 0.22em;
    transition:
      color var(--kb-dur-fast) var(--kb-ease-out),
      text-decoration-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .home-brand__shortcut:focus-visible {
    border-radius: var(--kb-radius-sm);
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  @media (min-width: 64rem) {
    .home-brand__layout {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: var(--kb-space-gap-lg);
      align-items: stretch;
    }

    .home-brand__panel {
      min-height: 100%;
    }

    .home-brand__fact {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      column-gap: 1.25rem;
    }

    .home-brand__fact-num {
      width: 2.5rem;
      height: 2.5rem;
    }

    .home-brand__media:global(.media-frame) {
      width: 100%;
      height: 100%;
      min-height: 100%;
      aspect-ratio: auto;
    }

    .home-brand__media:global(.media-frame .media-frame__stage) {
      min-height: 100%;
      height: 100%;
    }

    .home-brand__media:global(.media-frame .media-frame__image) {
      object-fit: cover;
      transform: scale(1.04);
      transform-origin: center 42%;
    }

    @media (hover: hover) and (pointer: fine) {
      .home-brand__media:global(.media-frame:hover .media-frame__image) {
        transform: scale(1.09);
      }

      .home-brand__shortcut:hover {
        color: var(--color-king-text);
        text-decoration-color: var(--color-king-accent);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-brand__media:global(.media-frame .media-frame__image) {
        transform: scale(1.04);
      }

      .home-brand__shortcut {
        transition: none;
      }
    }
  }
</style>
