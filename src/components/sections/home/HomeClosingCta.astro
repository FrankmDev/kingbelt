---
import EditorialCtaSection from '../EditorialCtaSection.astro';
import { closingCta } from '@content/home';
---

<EditorialCtaSection
  id="cierre"
  index={closingCta.index}
  titleId="home-closing-title"
  spacing="close"
  cta={{
    eyebrow: closingCta.eyebrow,
    title: closingCta.title,
    description: closingCta.description,
    buttonLabel: closingCta.primary.label,
    buttonHref: closingCta.primary.href,
    secondaryLabel: closingCta.secondary.label,
    secondaryHref: closingCta.secondary.href,
    image: closingCta.backgroundImage,
    imagePosition: closingCta.backgroundPosition,
  }}
/>
