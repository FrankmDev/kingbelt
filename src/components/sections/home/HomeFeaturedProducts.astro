---
import HomeSectionHead from './HomeSectionHead.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import ProductCard from '../../collection/ProductCard.astro';
import { featuredSection } from '@content/home';
import type { ProductSummary } from '@commerce/domain/catalog';

interface Props {
  products: ProductSummary[];
}

const { products } = Astro.props;
---

<section
  id="seleccion"
  class="home-featured section-spacing"
  aria-labelledby="home-featured-title"
>
  <div class="kb-shell-wide">
    <HomeSectionHead
      index={featuredSection.index}
      eyebrow={featuredSection.eyebrow}
      body={featuredSection.body}
      meta={featuredSection.meta}
      titleId="home-featured-title"
    >
      <Fragment slot="title">
        <span set:html={featuredSection.title} />
      </Fragment>

      <Fragment slot="action">
        <Button href={featuredSection.cta.href} variant="outline" size="md">
          {featuredSection.cta.label}
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
          />
        </Button>
      </Fragment>
    </HomeSectionHead>

    <ul class="home-featured__grid">
      {products.map((product, index) => (
        <li class="home-featured__item">
          <ProductCard
            product={product}
            index={index}
            priority={index < 2}
            sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 38vw"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .home-featured {
    background: var(--color-king-bg);
  }

  .home-featured__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-featured__item {
    min-width: 0;
  }

  @media (max-width: 47.99rem) {
    .home-featured__grid {
      gap: 0;
    }

    .home-featured__item {
      padding-block: var(--kb-space-6);
      border-bottom: 1px solid var(--kb-stroke-hairline);
    }

    .home-featured__item:first-child {
      padding-top: 0;
    }

    .home-featured__item:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }

  @media (min-width: 40rem) {
    .home-featured__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--kb-space-gap) var(--kb-space-5);
    }
  }

  @media (min-width: 64rem) {
    .home-featured__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--kb-space-gap) var(--kb-space-5);
    }
  }
</style>
