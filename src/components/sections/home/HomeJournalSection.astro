---
import SectionHeaderHome from './SectionHeaderHome.astro';
import FeaturedArticleSection from '../../blog/FeaturedArticleSection.astro';
import LatestPostsSection from '../../blog/LatestPostsSection.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import type { BlogPost } from '../../../data/blog';
import { journalSection } from '../../../data/home';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const [lead, ...secondary] = posts;
---

<div id="revista" class="home-journal">
  <section class="home-journal__intro section-spacing section-spacing-chapter" aria-labelledby="home-journal-title">
    <div class="kb-shell-wide">
      <div class="home-journal__head">
        <SectionHeaderHome
          index={journalSection.index}
          eyebrow={journalSection.eyebrow}
          body={journalSection.body}
          meta={journalSection.meta}
          titleId="home-journal-title"
          class="home-journal__header"
        >
          <Fragment slot="title">
            <span set:html={journalSection.title} />
          </Fragment>
        </SectionHeaderHome>

        <div class="home-journal__cta">
          <Button href={journalSection.cta.href} variant="outline" size="md">
            {journalSection.cta.label}
            <Icon
              name="arrow-right"
              class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
            />
          </Button>
        </div>
      </div>
    </div>
  </section>

  {lead && (
    <FeaturedArticleSection
      post={lead}
      showHeader={false}
      afterNav={false}
      class="home-journal__featured"
    />
  )}

  {secondary.length > 0 && (
    <LatestPostsSection posts={secondary} showHeader={false} class="home-journal__latest" />
  )}
</div>

<style>
  .home-journal__intro {
    background: var(--color-king-bg);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .home-journal__head {
    display: grid;
    gap: var(--kb-space-6);
    align-items: end;
  }

  .home-journal__header:global(.section-header-home) .shh-body {
    max-width: 40ch;
  }

  .home-journal__featured:global(.blog-featured) {
    padding-top: 0;
    background: var(--color-king-bg);
  }

  .home-journal__featured:global(.blog-featured--chapter-end) {
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .home-journal__latest:global(.blog-latest) {
    padding-top: 0;
    background: var(--color-king-surface);
  }

  .home-journal__latest:global(.blog-latest-inner) {
    gap: 0;
  }

  .home-journal__latest :global(.blog-latest-grid) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .home-journal__latest :global(.blog-latest-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .home-journal__head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--kb-space-8);
    }

    .home-journal__cta {
      padding-bottom: 0.35rem;
    }
  }
</style>
