---
import HomeSectionHead from './HomeSectionHead.astro';
import FeaturedArticleSection from '../../blog/FeaturedArticleSection.astro';
import LatestPostsSection from '../../blog/LatestPostsSection.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import type { BlogPost } from '@content/blog';
import { journalSection } from '@content/home';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const [lead, ...secondary] = posts;
---

<section id="revista" class="home-journal section-spacing" aria-labelledby="home-journal-title">
  <div class="kb-shell-wide home-journal__shell">
    <HomeSectionHead
      index={journalSection.index}
      eyebrow={journalSection.eyebrow}
      body={journalSection.body}
      meta={journalSection.meta}
      titleId="home-journal-title"
    >
      <Fragment slot="title">
        <span set:html={journalSection.title} />
      </Fragment>

      <Fragment slot="action">
        <Button href={journalSection.cta.href} variant="outline" size="md">
          {journalSection.cta.label}
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
          />
        </Button>
      </Fragment>
    </HomeSectionHead>

    {lead && (
      <FeaturedArticleSection
        post={lead}
        showHeader={false}
        afterNav={false}
        embedded
        class="home-journal__featured"
      />
    )}
  </div>

  {secondary.length > 0 && (
    <LatestPostsSection
      posts={secondary}
      showHeader={false}
      embedded
      class="home-journal__latest"
    />
  )}
</section>

<style>
  .home-journal {
    background: var(--color-king-bg);
  }

  .home-journal__shell {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-gap);
  }

  .home-journal__shell :global(.home-section-head) {
    margin-bottom: 0;
  }

  .home-journal__featured :global(.kb-shell-wide) {
    width: 100%;
  }

  .home-journal__latest:global(.blog-latest) {
    margin-top: var(--kb-space-gap-lg);
    padding-block: var(--kb-space-gap-lg) var(--kb-space-section);
    background: var(--color-king-surface);
  }

  .home-journal__latest:global(.blog-latest-inner) {
    gap: 0;
  }

  .home-journal__latest :global(.blog-latest-grid) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .home-journal__latest :global(.blog-latest-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
