---
import BlogFeedSection from '../blog/BlogFeedSection.astro';
import type { BlogPost } from '@content/blog';
import { journalSection } from '@content/home';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<BlogFeedSection
  id="revista"
  posts={posts}
  section={journalSection}
  titleId="home-journal-title"
  cta={journalSection.cta}
/>
