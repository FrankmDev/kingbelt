---
import SectionHeaderHome from './SectionHeaderHome.astro';

interface Props {
  index?: string;
  eyebrow?: string;
  meta?: string;
  titleId?: string;
  body?: string;
  class?: string;
}

const { index, eyebrow, meta, titleId, body, class: className = '' } = Astro.props;
const hasAction = Astro.slots.has('action');
---

<SectionHeaderHome
  index={index}
  eyebrow={eyebrow}
  meta={meta}
  body={body}
  titleId={titleId}
  class:list={['home-section-head', className]}
>
  <slot name="title" slot="title" />
  {Astro.slots.has('body') && <slot name="body" slot="body" />}

  {hasAction && (
    <div slot="aside" class="home-section-head__action">
      <slot name="action" />
    </div>
  )}
</SectionHeaderHome>

<style>
  .home-section-head:global(.section-header-home) {
    width: 100%;
    margin-bottom: var(--kb-space-gap);
  }

  .home-section-head__action {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: 0.2rem;
  }

  @media (max-width: 47.99rem) {
    .home-section-head__action {
      justify-content: flex-start;
      padding-bottom: 0;
    }

    .home-section-head__action :global(.kb-btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
