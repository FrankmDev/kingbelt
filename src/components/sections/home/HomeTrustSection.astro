---
import SectionHeader from '@components/ui/SectionHeader.astro';
import FeatureCard from '../../ui/FeatureCard.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import { trustSection, trustContactChannels } from '@content/home';

const cardVariants = ['default', 'default', 'default'] as const;

const hasChannels = (
  item: (typeof trustSection.items)[number],
): item is (typeof trustSection.items)[number] & {
  channels: typeof trustContactChannels;
} => 'channels' in item && Boolean(item.channels);
---

<section
  id="atencion"
  class="home-trust section-spacing"
  aria-labelledby="home-trust-title"
>
  <div class="kb-shell-wide home-trust__shell">
    <SectionHeader
      index={trustSection.index}
      eyebrow={trustSection.eyebrow}
      title={trustSection.title}
      body={trustSection.body}
      meta={trustSection.meta}
      titleId="home-trust-title"
      class="home-trust__header"
    >
      <Fragment slot="aside">
        <Button href={trustSection.cta.href} variant="outline" size="md">
          {trustSection.cta.label}
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
          />
        </Button>
      </Fragment>
    </SectionHeader>

    <ul class="home-trust__grid">
      {trustSection.items.map((item, index) => (
        <li class="home-trust__item">
          <FeatureCard
            number={item.number}
            eyebrow={item.meta}
            title={item.title}
            description={item.text}
            meta={item.linkLabel}
            href={'href' in item ? item.href : undefined}
            variant={cardVariants[index] ?? 'default'}
            class="home-trust__card"
          >
            {hasChannels(item) && (
              <ul class="home-trust__channels" aria-label="Canales de contacto">
                {item.channels.map((channel) => (
                  <li class="home-trust__channel-item">
                    <a
                      href={channel.href}
                      class="home-trust__channel"
                      target={channel.external ? '_blank' : undefined}
                      rel={channel.external ? 'noopener noreferrer' : undefined}
                    >
                      <span class="home-trust__channel-icon" aria-hidden="true">
                        <Icon name={channel.icon} class="h-3.5 w-3.5" strokeWidth={1.65} />
                      </span>
                      <span class="home-trust__channel-copy">
                        <span class="home-trust__channel-label">{channel.label}</span>
                        <span class="home-trust__channel-value">{channel.value}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </FeatureCard>
        </li>
      ))}
    </ul>

    {trustSection.shortcuts.length > 0 && (
      <footer class="home-trust__foot">
        <nav class="home-trust__shortcuts" aria-label="Accesos rápidos">
          <ul class="home-trust__shortcut-list">
            {trustSection.shortcuts.map((shortcut) => (
              <li>
                <a href={shortcut.href} class="home-trust__shortcut">
                  {shortcut.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </footer>
    )}
  </div>
</section>

<style>
  .home-trust {
    background: var(--color-king-bg);
  }

  .home-trust__shell {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .home-trust__header:global(.section-header) {
    margin-bottom: var(--kb-space-gap);
  }

  .home-trust__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .home-trust__item {
    min-width: 0;
    display: flex;
  }

  .home-trust__card:global(.feature-card) {
    width: 100%;
    min-height: 100%;
  }

  .home-trust__channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--kb-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .home-trust__channel-item {
    min-width: 0;
  }

  .home-trust__channel {
    display: flex;
    align-items: flex-start;
    gap: var(--kb-space-2);
    min-width: 0;
    min-height: 100%;
    padding: var(--kb-space-2) var(--kb-space-3);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-xs);
    background: color-mix(in srgb, var(--color-king-accent) 3%, transparent);
    text-decoration: none;
    transition:
      border-color var(--kb-dur-fast) var(--kb-ease-out),
      background-color var(--kb-dur-fast) var(--kb-ease-out),
      transform var(--kb-dur-fast) var(--kb-ease-out);
  }

  .home-trust__channel-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--kb-radius-xs);
    border: 1px solid color-mix(in srgb, var(--color-king-accent) 18%, transparent);
    background: var(--color-king-bg);
    color: var(--color-king-accent);
  }

  .home-trust__channel-copy {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    padding-top: 0.125rem;
  }

  .home-trust__channel-label {
    font-size: var(--kb-text-2xs);
    font-weight: var(--kb-w-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-king-muted);
    line-height: 1.2;
  }

  .home-trust__channel-value {
    font-size: var(--kb-text-xs);
    font-weight: var(--kb-w-medium);
    line-height: 1.35;
    color: var(--color-king-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-trust__foot {
    margin-top: var(--kb-space-gap);
    padding-top: var(--kb-space-4);
    border-top: 1px solid var(--kb-stroke-hairline);
  }

  .home-trust__shortcut-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-2) var(--kb-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-trust__shortcut-list li {
    display: inline-flex;
    align-items: center;
  }

  .home-trust__shortcut-list li + li::before {
    content: '·';
    margin-right: var(--kb-space-4);
    color: var(--color-king-muted);
    font-size: var(--kb-text-meta);
    line-height: 1;
  }

  .home-trust__shortcut {
    font-size: var(--kb-text-meta);
    font-weight: var(--kb-label-weight);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-king-accent) 30%, transparent);
    text-underline-offset: 0.22em;
    color: var(--color-king-accent);
    transition:
      color var(--kb-dur-fast) var(--kb-ease-out),
      text-decoration-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .home-trust__shortcut:focus-visible {
    border-radius: var(--kb-radius-sm);
    outline: 2px solid var(--color-king-accent);
    outline-offset: 3px;
  }

  @media (max-width: 47.99rem) {
    .home-trust__grid {
      gap: 0;
    }

    .home-trust__item {
      padding-block: var(--kb-space-6);
      border-bottom: 1px solid var(--kb-stroke-hairline);
    }

    .home-trust__item:first-child {
      padding-top: 0;
    }

    .home-trust__item:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    .home-trust__card:global(.feature-card) {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .home-trust__card:global(.feature-card)::before,
    .home-trust__card:global(.feature-card)::after {
      display: none;
    }

    .home-trust__card:global(.feature-card):hover {
      transform: none;
      border-color: transparent;
      box-shadow: none;
    }

    .home-trust__channels {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 48rem) {
    .home-trust__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--kb-space-4);
      align-items: stretch;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-trust__shortcut:hover {
      color: var(--color-king-text);
      text-decoration-color: var(--color-king-accent);
    }

    .home-trust__channel:hover {
      border-color: color-mix(in srgb, var(--color-king-accent) 35%, transparent);
      background: color-mix(in srgb, var(--color-king-accent) 6%, transparent);
      transform: translateY(-1px);
    }

    .home-trust__channel:hover .home-trust__channel-value {
      color: var(--color-king-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-trust__shortcut {
      transition: none;
    }
  }
</style>
