---
interface Props {
  index?: string;
  eyebrow?: string;
  meta?: string;
  title?: string;
  titleId?: string;
  body?: string;
  tone?: 'light' | 'dark';
  density?: 'default' | 'compact';
  trackCell?: boolean;
  asideLayout?: 'action' | 'panel';
  class?: string;
}

const {
  index,
  eyebrow,
  meta,
  title,
  titleId,
  body,
  tone = 'light',
  density = 'default',
  trackCell = false,
  asideLayout = 'action',
  class: className = '',
} = Astro.props;

const hasChapter = Boolean(index || eyebrow || meta);
const hasTitle = Boolean(title || Astro.slots.has('title'));
const hasBody = Boolean(body || Astro.slots.has('body'));
const hasEditorial = hasTitle || hasBody;
const hasAside = Astro.slots.has('aside');
---

<header
  class:list={[
    'section-header-home',
    hasAside && 'section-header-home--with-aside',
    hasAside && asideLayout === 'panel' && 'section-header-home--with-panel',
    className,
  ]}
  data-tone={tone}
  data-density={density}
  {...trackCell ? { 'data-brand-cell': true } : {}}
>
  {hasChapter && (
    <div class="shh-chapter">
      {index && <span class="shh-folio kb-folio">{index}</span>}
      {eyebrow && <span class="kb-eyebrow shh-eyebrow">{eyebrow}</span>}
      <span class="shh-rule" aria-hidden="true"></span>
      {meta && <span class="kb-meta-label shh-meta">{meta}</span>}
    </div>
  )}

  {(hasEditorial || hasAside) && (
    <div class="shh-row">
      {hasEditorial && (
        <div class="shh-editorial">
          {hasTitle && (
            <h2 id={titleId} class="shh-title font-display">
              {Astro.slots.has('title') ? (
                <slot name="title" />
              ) : (
                <span set:html={title} />
              )}
            </h2>
          )}

          {hasBody && (
            <div class="shh-body">
              {body ? (
                <p>{body}</p>
              ) : (
                <slot name="body" />
              )}
            </div>
          )}
        </div>
      )}

      {hasAside && (
        <div class="shh-aside">
          <slot name="aside" />
        </div>
      )}
    </div>
  )}
</header>

<style>
  .section-header-home {
    --shh-ink: var(--color-king-text);
    --shh-muted: var(--color-king-muted);
    --shh-line: var(--kb-stroke-dark);
    --shh-accent: var(--color-king-accent);

    display: flex;
    flex-direction: column;
    gap: var(--kb-space-5);
    width: 100%;
    min-width: 0;
    margin-bottom: var(--kb-space-gap);
    color: var(--shh-ink);
  }

  .section-header-home[data-tone='dark'] {
    --shh-ink: rgba(255, 250, 241, 0.96);
    --shh-muted: rgba(255, 250, 241, 0.64);
    --shh-line: rgba(255, 255, 255, 0.12);
    --shh-accent: var(--color-king-accent-light);
  }

  .shh-chapter {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: var(--kb-space-4);
    width: 100%;
    padding-block: var(--kb-space-3);
    border-block: 1px solid var(--shh-line);
  }

  .shh-folio {
    margin: 0;
    color: var(--shh-accent);
  }

  .shh-eyebrow {
    margin: 0;
    white-space: nowrap;
    color: var(--shh-accent);
  }

  .shh-rule {
    display: block;
    height: 1px;
    background: linear-gradient(
      90deg,
      var(--kb-stroke-accent),
      color-mix(in srgb, var(--color-king-accent) 12%, transparent) 72%,
      transparent
    );
  }

  .section-header-home[data-tone='dark'] .shh-rule {
    background: linear-gradient(
      90deg,
      rgba(166, 124, 78, 0.55),
      rgba(166, 124, 78, 0.12) 72%,
      transparent
    );
  }

  .shh-meta {
    margin: 0;
    justify-self: end;
    color: var(--shh-muted);
    white-space: nowrap;
  }

  .shh-row {
    display: grid;
    gap: var(--kb-space-5);
    align-items: end;
    width: 100%;
    min-width: 0;
  }

  .section-header-home--with-aside .shh-row {
    align-items: stretch;
  }

  @media (min-width: 48rem) {
    .section-header-home--with-aside .shh-row {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--kb-space-6);
      align-items: end;
    }
  }

  @media (min-width: 64rem) {
    .section-header-home--with-panel .shh-row {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: var(--kb-space-10);
      align-items: center;
    }
  }

  .shh-editorial {
    display: grid;
    gap: var(--kb-space-4);
    min-width: 0;
  }

  .shh-aside {
    min-width: 0;
  }

  .shh-title {
    margin: 0;
    max-width: 24ch;
    font-size: var(--kb-text-h2);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--shh-ink);
  }

  .shh-title :global(em) {
    color: var(--shh-accent);
    font-style: italic;
    font-weight: var(--kb-w-heading-strong);
  }

  .shh-body {
    max-width: 42ch;
  }

  .shh-body :global(p) {
    margin: 0;
    font-size: var(--kb-text-body-lg);
    line-height: 1.55;
    color: var(--shh-muted);
  }

  .section-header-home[data-density='compact'] {
    gap: var(--kb-space-4);
  }

  .section-header-home[data-density='compact'] .shh-chapter {
    padding-block: var(--kb-space-2);
  }

  .section-header-home[data-density='compact'] .shh-title {
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    max-width: 22ch;
  }

  .section-header-home[data-density='compact'] .shh-body {
    max-width: 46ch;
  }

  .section-header-home[data-density='compact'] .shh-body :global(p) {
    font-size: var(--kb-text-body-lg);
    line-height: 1.65;
  }
</style>
