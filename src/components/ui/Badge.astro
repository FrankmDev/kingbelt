---
interface Props {
  type: 'new' | 'bestseller' | 'featured' | 'default';
}

const { type = 'default' } = Astro.props;

const labels = {
  new: 'Nuevo',
  bestseller: 'Más vendido',
  featured: 'Destacado',
  default: 'Selección',
};

const styles = {
  new: 'bg-king-text text-king-surface',
  bestseller: 'bg-king-accent text-king-surface',
  featured: 'bg-king-text text-king-surface',
  default: 'bg-black/16 text-white/74 backdrop-blur-md border border-white/14',
};
---

<span class={`inline-block px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] ${styles[type]}`}>
  {labels[type]}
</span>
