---
interface Props {
  type?: 'new' | 'bestseller' | 'featured';
}

const { type } = Astro.props;

const labels: Record<string, string> = {
  new: 'Nuevo',
  bestseller: 'Más vendido',
  featured: 'Destacado',
};

const styles: Record<string, string> = {
  new: 'bg-king-text text-king-surface',
  bestseller: 'bg-king-accent text-king-surface',
  featured: 'bg-king-text text-king-surface',
};
---

{type && labels[type] && (
  <span class={`inline-block px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] ${styles[type]}`}>
    {labels[type]}
  </span>
)}
