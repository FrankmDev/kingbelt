---
import ArticleMeta from './ArticleMeta.astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  excerpt?: string;
  href?: string;
  slug?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imagePosition?: string;
  imageLoading?: 'lazy' | 'eager';
  imageFetchPriority?: 'high' | 'low' | 'auto';
  category?: string;
  date?: string;
  readingTime?: string;
  folio?: string;
  variant?: 'default' | 'feature' | 'horizontal' | 'compact' | 'index' | 'strip' | 'bento';
  class?: string;
}

const {
  title,
  excerpt,
  href,
  slug,
  image,
  imageAlt = '',
  imageWidth = 960,
  imageHeight = 540,
  imagePosition = 'center',
  imageLoading = 'lazy',
  imageFetchPriority,
  category,
  date,
  readingTime,
  folio,
  variant = 'default',
  class: className,
} = Astro.props;

if (!href && !slug) {
  throw new Error('BlogCard necesita una prop `href` o `slug`.');
}

const resolvedHref = href ?? `/blog/${slug}`;

const hasImage = Boolean(image);
const hasCategory = Boolean(category);
const hasMeta = Boolean(date || readingTime);
const showCategoryOnImage = hasImage && hasCategory && (variant === 'default' || variant === 'bento');
const showMeta = hasMeta || (!showCategoryOnImage && hasCategory);
const isSurfaceCard = variant === 'default' || variant === 'bento';
---

<article
  class:list={['kb-blog-card', isSurfaceCard && 'kb-card-dry', className]}
  data-variant={variant}
>
  <a href={resolvedHref} class="kb-blog-card__link" aria-label={`Leer artículo: ${title}`}>
    {folio && (
      <span class="kb-blog-card__folio kb-section-num" aria-hidden="true">{folio}</span>
    )}

    {hasImage && variant !== 'index' && (
      <div class="kb-blog-card__media">
        <img
          src={image}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          loading={imageLoading}
          fetchpriority={imageFetchPriority}
          decoding="async"
          class="kb-blog-card__image"
          style={`object-position: ${imagePosition}`}
        />

        {showCategoryOnImage && (
          <span class="kb-blog-card__category kb-meta-label">{category}</span>
        )}
      </div>
    )}

    {hasImage && variant === 'index' && (
      <div class="kb-blog-card__thumb" aria-hidden="true">
        <img
          src={image}
          alt=""
          width={imageWidth}
          height={imageHeight}
          loading="lazy"
          decoding="async"
          class="kb-blog-card__thumb-image"
          style={`object-position: ${imagePosition}`}
        />
      </div>
    )}

    <div class="kb-blog-card__body">
      {showMeta && (
        <div class="kb-blog-card__meta">
          {!showCategoryOnImage && hasCategory ? (
            <ArticleMeta category={category} date={date} readingTime={readingTime} />
          ) : (
            <ArticleMeta date={date} readingTime={readingTime} />
          )}
        </div>
      )}

      <h3 class="kb-blog-card__title">{title}</h3>

      {excerpt && variant !== 'index' && variant !== 'compact' && (
        <p class="kb-blog-card__excerpt">{excerpt}</p>
      )}

      <span class="kb-blog-card__cta">
        <span class="kb-blog-card__cta-label">Leer artículo</span>
        <Icon name="arrow-up-right" class="kb-blog-card__arrow" strokeWidth={2} />
      </span>
    </div>
  </a>
</article>
