---
import Icon from './Icon.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  includeHome?: boolean;
  class?: string;
}

const { items, includeHome = true, class: className } = Astro.props;

const linkClass = 'kb-meta-label text-king-muted/85 hover:text-king-accent transition-colors duration-[var(--kb-dur-fast)]';
---

<nav aria-label="Breadcrumb" class:list={['flex items-center flex-wrap gap-2', className]}>
  {includeHome && (
    <a href="/" class:list={['group inline-flex items-center gap-1.5', linkClass]}>
      <span>Inicio</span>
    </a>
  )}
  {items.map((crumb, i) => (
    <>
      {(includeHome || i > 0) && (
        <Icon name="chevron-right" class="h-2.5 w-2.5 text-king-muted/50" />
      )}
      {crumb.href ? (
        <a
          href={crumb.href}
          class={linkClass}
        >
          {crumb.label}
        </a>
      ) : (
        <span class="kb-meta-label text-king-accent" aria-current="page">
          {crumb.label}
        </span>
      )}
    </>
  ))}
</nav>
