---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'surface' | 'surfaceOutline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  target,
  rel,
  type = 'button',
  disabled = false,
  loading = false,
  'aria-label': ariaLabel,
} = Astro.props;

const btnVariants: Record<NonNullable<Props['variant']>, string> = {
  primary: 'kb-btn-primary',
  secondary: 'kb-btn-secondary',
  outline: 'kb-btn-outline',
  ghost: 'kb-btn-ghost',
  surface: 'kb-btn-surface',
  surfaceOutline: 'kb-btn-surface-outline',
};

const btnSizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'kb-btn-sm',
  md: 'kb-btn-md',
  lg: 'kb-btn-lg',
};

const classes = [
  'kb-btn',
  btnSizes[size],
  btnVariants[variant],
  disabled && 'kb-btn-disabled',
  loading && 'kb-btn-loading',
  className,
]
  .filter(Boolean)
  .join(' ');

const Element = href ? 'a' : 'button';
const isInactive = disabled || loading;
const safeRel = target === '_blank' && !rel ? 'noopener noreferrer' : rel;

const elementProps = href
  ? {
      href: isInactive ? undefined : href,
      target,
      rel: safeRel,
      'aria-disabled': isInactive || undefined,
    }
  : {
      type,
      disabled: isInactive,
    };
---

<Element class={classes} {...elementProps} aria-label={ariaLabel}>
  <span class="kb-btn-text"><slot /></span>
  {loading && <span class="kb-btn-spinner" aria-hidden="true"></span>}
  <span class="kb-btn-rivet" aria-hidden="true"></span>
</Element>
