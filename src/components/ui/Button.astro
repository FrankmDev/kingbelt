---
import type { HTMLAttributes } from 'astro/types';

interface SharedProps {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'surface' | 'surfaceOutline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  loading?: boolean;
}

type LinkProps = SharedProps &
  Omit<HTMLAttributes<'a'>, 'class' | 'href' | 'target' | 'rel' | 'type' | 'disabled'> & {
  href: string;
  target?: HTMLAttributes<'a'>['target'];
  rel?: HTMLAttributes<'a'>['rel'];
  disabled?: boolean;
  type?: never;
  name?: never;
  form?: never;
};

type ButtonProps = SharedProps &
  Omit<HTMLAttributes<'button'>, 'class' | 'type' | 'disabled'> & {
  href?: never;
  target?: never;
  rel?: never;
  type?: HTMLAttributes<'button'>['type'];
  disabled?: boolean;
};

type Props = LinkProps | ButtonProps;

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  target,
  rel,
  type = 'button',
  disabled = false,
  loading = false,
  'aria-busy': ariaBusy,
  'aria-disabled': ariaDisabled,
  ...rest
} = Astro.props;

const btnVariants: Record<NonNullable<SharedProps['variant']>, string> = {
  primary: 'kb-btn-primary',
  secondary: 'kb-btn-secondary',
  outline: 'kb-btn-outline',
  ghost: 'kb-btn-ghost',
  surface: 'kb-btn-surface',
  surfaceOutline: 'kb-btn-surface-outline',
};

const btnSizes: Record<NonNullable<SharedProps['size']>, string> = {
  sm: 'kb-btn-sm',
  md: 'kb-btn-md',
  lg: 'kb-btn-lg',
};

const isLink = typeof href === 'string';
const Element = isLink ? 'a' : 'button';
const isInactive = disabled || loading;
const relTokens = new Set((rel ?? '').split(/\s+/).filter(Boolean));
if (target === '_blank') {
  relTokens.add('noopener');
  relTokens.add('noreferrer');
}
const safeRel = relTokens.size ? Array.from(relTokens).join(' ') : undefined;

const elementProps = isLink
  ? {
      href: isInactive ? undefined : href,
      target,
      rel: safeRel,
      'aria-disabled': isInactive ? 'true' : ariaDisabled,
    }
  : {
      type,
      disabled: isInactive,
    };
---

<Element
  class:list={[
    'kb-btn',
    'group',
    btnSizes[size],
    btnVariants[variant],
    disabled && 'kb-btn-disabled',
    loading && 'kb-btn-loading',
    className,
  ]}
  {...rest}
  {...elementProps}
  aria-busy={loading ? 'true' : ariaBusy}
>
  <span class="kb-btn-text"><slot /></span>
  {loading && <span class="kb-btn-spinner" aria-hidden="true"></span>}
  <span class="kb-btn-rivet" aria-hidden="true"></span>
</Element>
