---
interface BaseProps {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'surface' | 'surfaceOutline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
  disabled?: boolean;
  loading?: boolean;
  title?: string;
  'aria-label'?: string;
  'aria-describedby'?: string;
}

interface LinkProps extends BaseProps {
  href: string;
  target?: string;
  rel?: string;
  type?: never;
  name?: never;
  form?: never;
}

interface ButtonProps extends BaseProps {
  href?: undefined;
  target?: never;
  rel?: never;
  type?: 'button' | 'submit' | 'reset';
  name?: string;
  form?: string;
}

type Props = LinkProps | ButtonProps;

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  target,
  rel,
  type = 'button',
  disabled = false,
  loading = false,
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

const btnVariants: Record<NonNullable<BaseProps['variant']>, string> = {
  primary: 'kb-btn-primary',
  secondary: 'kb-btn-secondary',
  outline: 'kb-btn-outline',
  ghost: 'kb-btn-ghost',
  surface: 'kb-btn-surface',
  surfaceOutline: 'kb-btn-surface-outline',
};

const btnSizes: Record<NonNullable<BaseProps['size']>, string> = {
  sm: 'kb-btn-sm',
  md: 'kb-btn-md',
  lg: 'kb-btn-lg',
};

const Element = href ? 'a' : 'button';
const isInactive = disabled || loading;
const safeRel = target === '_blank' && !rel ? 'noopener noreferrer' : rel;

const elementProps = href
  ? {
      href: isInactive ? undefined : href,
      target,
      rel: safeRel,
      'aria-disabled': isInactive || undefined,
    }
  : {
      type,
      disabled: isInactive,
    };
---

<Element
  class:list={[
    'kb-btn',
    'group',
    btnSizes[size],
    btnVariants[variant],
    disabled && 'kb-btn-disabled',
    loading && 'kb-btn-loading',
    className,
  ]}
  {...elementProps}
  {...rest}
  aria-label={ariaLabel}
  aria-busy={loading || undefined}
>
  <span class="kb-btn-text"><slot /></span>
  {loading && <span class="kb-btn-spinner" aria-hidden="true"></span>}
  <span class="kb-btn-rivet" aria-hidden="true"></span>
</Element>
