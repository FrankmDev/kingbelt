---
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import OptimizedImage from './OptimizedImage.astro';

interface Props {
  title: string;
  description?: string;
  buttonLabel: string;
  buttonHref: string;
  buttonVariant?: 'primary' | 'secondary' | 'outline' | 'surfaceOutline';
  secondaryButtonLabel?: string;
  secondaryButtonHref?: string;
  secondaryButtonVariant?: 'primary' | 'secondary' | 'outline' | 'surfaceOutline';
  eyebrow?: string;
  index?: string;
  meta?: string;
  backgroundImage: string;
  backgroundAlt?: string;
  backgroundWidth?: number;
  backgroundHeight?: number;
  backgroundPosition?: string;
  titleTag?: 'h2' | 'h3';
  class?: string;
}

const {
  title,
  description,
  buttonLabel,
  buttonHref,
  buttonVariant = 'secondary',
  secondaryButtonLabel,
  secondaryButtonHref,
  secondaryButtonVariant = 'surfaceOutline',
  eyebrow,
  index,
  meta,
  backgroundImage,
  backgroundAlt = '',
  backgroundWidth = 1600,
  backgroundHeight = 900,
  backgroundPosition = 'center',
  titleTag: TitleTag = 'h2',
  class: className,
} = Astro.props;

const hasHeader = Astro.slots.has('header');
const hasLedger = Boolean(index || eyebrow || meta);
const hasSecondaryAction = Boolean(secondaryButtonLabel && secondaryButtonHref);
---

<div class:list={['cta-box kb-cta-dark', hasSecondaryAction && 'cta-box--dual', className]}>
  <OptimizedImage
    src={backgroundImage}
    alt={backgroundAlt}
    preset="background"
    width={backgroundWidth}
    height={backgroundHeight}
    class="cta-box__bg-image"
    style={`object-position: ${backgroundPosition}`}
    loading="lazy"
    aria-hidden={backgroundAlt ? undefined : true}
  />

  <div class="cta-box__overlay" aria-hidden="true"></div>
  <div class="cta-box__texture kb-texture-asphalt" aria-hidden="true"></div>

  {Astro.slots.has('decorations') && (
    <div class="cta-box__decorations" aria-hidden="true">
      <slot name="decorations" />
    </div>
  )}

  <div class="cta-box__inner">
    <div class="cta-box__copy">
      {hasHeader ? (
        <slot name="header" />
      ) : (
        <>
          {hasLedger && (
            <div class="cta-box__ledger">
              {index && <span class="cta-box__index kb-folio">{index}</span>}
              {eyebrow && (
                <Eyebrow class="cta-box__eyebrow">
                  {eyebrow}
                </Eyebrow>
              )}
              {(eyebrow || index) && meta && (
                <span class="cta-box__ledger-sep" aria-hidden="true"></span>
              )}
              {meta && <span class="cta-box__meta kb-meta-label">{meta}</span>}
            </div>
          )}

          {!hasLedger && eyebrow && (
            <Eyebrow class="cta-box__eyebrow">
              {eyebrow}
            </Eyebrow>
          )}

          <TitleTag class="cta-box__title" set:html={title} />

          {description && (
            <p class="cta-box__desc">
              {description}
            </p>
          )}
        </>
      )}
    </div>

    <div class="cta-box__action">
      <Button href={buttonHref} variant={buttonVariant} size="md">
        {buttonLabel}
      </Button>
      {hasSecondaryAction && (
        <Button href={secondaryButtonHref!} variant={secondaryButtonVariant} size="md">
          {secondaryButtonLabel}
        </Button>
      )}
    </div>
  </div>
</div>

<style>
  .cta-box {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(20rem, 48vw, 32rem);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: var(--kb-radius-xl);
    overflow: hidden;
    box-shadow: var(--kb-shadow-float-dark);
    transform: translateZ(0);
  }

  .cta-box__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transform: scale(1);
    transition: transform var(--kb-dur-slow) var(--kb-ease-out);
  }

  .cta-box :global(picture.kb-optimized-image) {
    z-index: 0;
  }

  .cta-box__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(13, 13, 12, 0.22) 0%,
        rgba(13, 13, 12, 0.42) 35%,
        rgba(13, 13, 12, 0.72) 70%,
        rgba(13, 13, 12, 0.84) 100%
      );
    mix-blend-mode: multiply;
  }

  .cta-box__texture {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.55;
  }

  .cta-box__texture::before {
    opacity: 0.06;
  }

  .cta-box__decorations {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .cta-box__inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-5);
  }

  .cta-box__copy {
    min-width: 0;
    flex: 1;
  }

  .cta-box__ledger {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-2) var(--kb-space-4);
    margin-bottom: var(--kb-space-4);
  }

  .cta-box__index {
    color: rgba(255, 250, 241, 0.9);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: var(--kb-w-heading-light);
    letter-spacing: -0.02em;
  }

  .cta-box__ledger-sep {
    width: 1px;
    height: 0.75rem;
    background: rgba(255, 255, 255, 0.18);
    flex-shrink: 0;
  }

  .cta-box__meta {
    margin-left: auto;
    color: rgba(255, 250, 241, 0.62);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cta-box__eyebrow {
    margin-bottom: var(--kb-space-5);
    color: var(--color-king-bone);
  }

  .cta-box__ledger .cta-box__eyebrow {
    margin-bottom: 0;
    color: rgba(255, 250, 241, 0.78);
  }

  .cta-box__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: var(--kb-w-heading-hero);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: 0 0 var(--kb-space-4);
    color: rgba(255, 255, 255, 0.97);
    max-width: 20ch;
  }

  .cta-box__desc {
    font-size: var(--kb-text-body-lg);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    max-width: 46ch;
    margin: 0;
    text-wrap: pretty;
  }

  .cta-box__action {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: var(--kb-space-3);
  }

  .cta-box--dual .cta-box__action {
    align-items: center;
  }

  @media (min-width: 768px) {
    .cta-box__inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--kb-space-6);
    }

    .cta-box__action {
      justify-content: flex-end;
    }
  }

  @media (max-width: 47.99rem) {
    .cta-box__meta {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-box:hover .cta-box__bg-image {
      transform: scale(1.04);
    }
  }
</style>
