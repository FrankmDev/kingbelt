---
interface Props {
  variant?: 'premium' | 'dry' | 'static' | 'dark' | 'steel' | 'leather';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
  class?: string;
}

const { variant = 'premium', padding = 'none', hover = true, class: className } = Astro.props;

const variantClass = (() => {
  if (variant === 'steel') return 'kb-card-steel';
  if (variant === 'leather') return 'kb-card kb-leather';
  return {
    premium: hover ? 'kb-card' : 'kb-card-static',
    dry: 'kb-card-dry',
    static: 'kb-card-static',
    dark: 'kb-card-dark',
  }[variant];
})();

const paddingClass = {
  none: '',
  sm: 'p-5 md:p-6',
  md: 'p-6 md:p-7',
  lg: 'p-7 md:p-8 lg:p-9',
}[padding];

const showFrame = variant === 'premium' || variant === 'steel';
---

<div
  class:list={['kb-card-root', variantClass, paddingClass, className]}
  data-card-variant={variant}
>
  {showFrame && (
    <>
      <span class="kb-card-corner kb-corner-bracket kb-corner-bracket-tl" aria-hidden="true"></span>
      <span class="kb-card-corner kb-corner-bracket kb-corner-bracket-tr" aria-hidden="true"></span>
      <span class="kb-card-corner kb-corner-bracket kb-corner-bracket-bl" aria-hidden="true"></span>
      <span class="kb-card-corner kb-corner-bracket kb-corner-bracket-br" aria-hidden="true"></span>
    </>
  )}

  <div class="kb-card-body">
    <slot />
  </div>
</div>
