---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icon-paths';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  label: string;
  value: string;
  description?: string;
  href?: string;
  icon?: IconName;
  index?: number | string;
  meta?: string;
  variant?: 'default' | 'steel';
}

const {
  label,
  value,
  description,
  href,
  icon,
  index,
  meta,
  variant = 'default',
  class: className,
  ...rest
} = Astro.props;

const Element = href ? 'a' : 'article';
const isExternal = Boolean(href && /^https?:/.test(href));
const linkProps = href
  ? { href, target: isExternal ? '_blank' : undefined, rel: isExternal ? 'noopener noreferrer' : undefined }
  : {};

const formattedIndex =
  index !== undefined
    ? typeof index === 'number'
      ? String(index).padStart(2, '0')
      : index
    : undefined;

const cardClass = variant === 'steel' ? 'kb-card-steel' : 'kb-card-dry';
const showFoot = Boolean(meta || href);
const footLabel = meta ?? (href ? (isExternal ? 'Abrir enlace' : 'Ir al canal') : undefined);
---

<Element
  class:list={[
    'contact-method',
    cardClass,
    variant === 'steel' && 'contact-method--steel',
    href && 'contact-method--linked',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-king-accent/45 focus-visible:ring-offset-2 focus-visible:ring-offset-king-bg',
    className,
  ]}
  aria-label={href ? `${label}: ${value}` : undefined}
  {...linkProps}
  {...rest}
>
  <header class="contact-method__head">
    <div class="contact-method__kicker">
      {formattedIndex && <span class="contact-method__index kb-folio" aria-hidden="true">{formattedIndex}</span>}
      <p class="contact-method__label kb-eyebrow">{label}</p>
    </div>

    {icon && (
      <div class="contact-method__icon" aria-hidden="true">
        <Icon name={icon} strokeWidth={1.65} />
      </div>
    )}
  </header>

  <div class="contact-method__body">
    <p class="contact-method__value">{value}</p>
    {description && <p class="contact-method__description">{description}</p>}
  </div>

  {showFoot && (
    <footer class="contact-method__foot">
      {footLabel && (
        <span class="contact-method__meta kb-meta-label">
          {footLabel}
          {href && !meta && (
            <Icon
              name={isExternal ? 'external-link' : 'arrow-right'}
              class="contact-method__meta-icon"
              aria-hidden="true"
            />
          )}
        </span>
      )}
    </footer>
  )}
</Element>

<style>
  .contact-method {
    --cm-ink: var(--color-king-text);
    --cm-muted: var(--color-king-muted);
    --cm-accent: var(--color-king-accent);
    --cm-line: var(--kb-stroke-hairline);
    --cm-icon-bg: color-mix(in srgb, var(--color-king-accent) 7%, transparent);
    --cm-icon-border: color-mix(in srgb, var(--color-king-accent) 18%, var(--kb-stroke-hairline));

    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    min-width: 0;
    min-height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.5rem);
    overflow: hidden;
    text-decoration: none;
  }

  .contact-method--steel {
    --cm-ink: rgba(255, 255, 255, 0.94);
    --cm-muted: rgba(255, 255, 255, 0.58);
    --cm-accent: var(--color-king-accent-light);
    --cm-line: rgba(255, 255, 255, 0.1);
    --cm-icon-bg: rgba(255, 255, 255, 0.08);
    --cm-icon-border: rgba(255, 255, 255, 0.14);
  }

  .contact-method--linked {
    cursor: pointer;
    transition:
      border-color var(--kb-dur-med) var(--kb-ease-out),
      transform var(--kb-dur-med) var(--kb-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-method--linked:hover,
    .contact-method--linked:focus-visible {
      transform: translateY(-2px);
    }

    .contact-method--linked:hover .contact-method__icon,
    .contact-method--linked:focus-visible .contact-method__icon {
      border-color: color-mix(in srgb, var(--cm-accent) 35%, transparent);
      background-color: color-mix(in srgb, var(--cm-accent) 11%, transparent);
    }
  }

  .contact-method__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--kb-space-4);
    min-width: 0;
    padding-bottom: var(--kb-space-3);
    border-bottom: 1px solid var(--cm-line);
  }

  .contact-method__kicker {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-1);
    min-width: 0;
  }

  .contact-method__index {
    margin: 0;
    color: var(--cm-accent);
    opacity: 0.5;
  }

  .contact-method__label {
    margin: 0;
    color: var(--cm-accent);
  }

  .contact-method__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--cm-icon-border);
    border-radius: var(--kb-radius-xs);
    background: var(--cm-icon-bg);
    color: var(--cm-accent);
    transition:
      border-color var(--kb-dur-med) var(--kb-ease-out),
      background-color var(--kb-dur-med) var(--kb-ease-out);
  }

  .contact-method__icon :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .contact-method__body {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-2);
    min-width: 0;
    flex: 1 1 auto;
  }

  .contact-method__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    font-weight: var(--kb-w-medium);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--cm-ink);
    word-break: break-word;
  }

  .contact-method__description {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--cm-muted);
  }

  .contact-method__foot {
    margin-top: auto;
    padding-top: var(--kb-space-3);
    border-top: 1px solid var(--cm-line);
  }

  .contact-method__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    color: var(--cm-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-method__meta :global(svg) {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-method--linked {
      transition: none;
    }
  }
</style>
