---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icon-paths';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  label: string;
  value: string;
  description?: string;
  href?: string;
  icon?: IconName;
  index?: number | string;
  meta?: string;
  variant?: 'default' | 'steel';
  density?: 'default' | 'compact';
}

const {
  label,
  value,
  description,
  href,
  icon,
  index,
  meta,
  variant = 'default',
  density = 'default',
  class: className,
  ...rest
} = Astro.props;

const Element = href ? 'a' : 'article';
const isExternal = Boolean(href && /^https?:/.test(href));
const linkProps = href
  ? { href, target: isExternal ? '_blank' : undefined, rel: isExternal ? 'noopener noreferrer' : undefined }
  : {};

const formattedIndex =
  index !== undefined
    ? typeof index === 'number'
      ? String(index).padStart(2, '0')
      : index
    : undefined;

const cardClass = variant === 'steel' ? 'kb-card-steel' : 'kb-card-dry';
const ctaLabel =
  icon === 'phone'
    ? 'Llamar'
    : icon === 'mail'
      ? 'Enviar email'
      : icon === 'whatsapp'
        ? 'Abrir WhatsApp'
        : 'Contactar';
const footMeta = meta ?? (variant === 'steel' ? 'Canal principal' : 'Canal directo');
---

<Element
  class:list={[
    'contact-method',
    `contact-method--${variant}`,
    density === 'compact' && 'contact-method--compact',
    cardClass,
    href && 'contact-method--linked',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-king-accent/45 focus-visible:ring-offset-2 focus-visible:ring-offset-king-bg',
    className,
  ]}
  aria-label={href ? `${label}: ${value}` : undefined}
  {...linkProps}
  {...rest}
>
  <span class="contact-method__accent" aria-hidden="true"></span>

  <div class="contact-method__inner">
    <header class="contact-method__head">
      {formattedIndex && (
        <span class="contact-method__index" aria-hidden="true">{formattedIndex}</span>
      )}

      <p class="contact-method__eyebrow kb-eyebrow">
        {icon && (
          <span class="contact-method__mark" aria-hidden="true">
            <Icon name={icon} class="h-full w-full" strokeWidth={1.65} />
          </span>
        )}
        <span class="contact-method__label">{label}</span>
      </p>
    </header>

    <div class="contact-method__main">
      <p class="contact-method__value">{value}</p>
      {description && <p class="contact-method__description">{description}</p>}
    </div>

    <footer class="contact-method__foot">
      <span class="contact-method__meta">{footMeta}</span>

      {href && (
        <span class="contact-method__cta kb-action-label">
          {ctaLabel}
          <span class="contact-method__cta-icon" aria-hidden="true">
            <Icon name={isExternal ? 'external-link' : 'arrow-right'} class="h-full w-full" />
          </span>
        </span>
      )}
    </footer>
  </div>
</Element>

<style>
  .contact-method {
    --cm-eyebrow: var(--color-king-accent);
    --cm-title: var(--color-king-text);
    --cm-body: var(--color-king-muted);
    --cm-index: var(--color-king-accent);
    --cm-mark: var(--color-king-accent);
    --cm-divider: rgba(138, 90, 43, 0.12);
    --cm-meta-fg: var(--color-king-accent);
    --cm-meta-bg: rgba(138, 90, 43, 0.05);
    --cm-meta-border: rgba(138, 90, 43, 0.16);
    --cm-accent: var(--color-king-accent);
    --cm-cta: var(--color-king-accent);

    position: relative;
    display: block;
    min-width: 0;
    min-height: 100%;
    padding: var(--kb-space-5);
    text-decoration: none;
  }

  .contact-method--steel {
    --cm-eyebrow: var(--color-king-accent-light);
    --cm-title: rgba(255, 255, 255, 0.94);
    --cm-body: rgba(255, 255, 255, 0.56);
    --cm-index: var(--color-king-accent-light);
    --cm-mark: var(--color-king-accent-light);
    --cm-divider: rgba(255, 255, 255, 0.1);
    --cm-meta-fg: var(--color-king-accent-light);
    --cm-meta-bg: rgba(183, 138, 79, 0.1);
    --cm-meta-border: rgba(183, 138, 79, 0.24);
    --cm-accent: var(--color-king-accent-light);
    --cm-cta: var(--color-king-accent-light);
  }

  .contact-method--compact {
    padding: var(--kb-space-3) var(--kb-space-4);
  }

  .contact-method--compact .contact-method__inner {
    gap: var(--kb-space-2);
  }

  .contact-method--compact .contact-method__head {
    gap: var(--kb-space-2);
  }

  .contact-method--compact .contact-method__index {
    font-size: 0.625rem;
  }

  .contact-method--compact .contact-method__mark {
    width: 0.8125rem;
    height: 0.8125rem;
  }

  .contact-method--compact .contact-method__main {
    gap: 0.25rem;
  }

  .contact-method--compact .contact-method__value {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.25;
  }

  .contact-method--compact .contact-method__description {
    font-size: var(--kb-text-xs);
    line-height: 1.5;
  }

  .contact-method--compact .contact-method__foot {
    padding-top: var(--kb-space-2);
  }

  .contact-method--compact .contact-method__meta {
    padding: 0.2rem 0.5rem;
    font-size: 0.625rem;
  }

  .contact-method--compact .contact-method__cta {
    font-size: 0.6875rem;
  }

  .contact-method__accent {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 3px;
    height: 100%;
    background: var(--cm-accent);
    opacity: 0.65;
    transform: scaleY(0.36);
    transform-origin: top;
    transition: transform var(--kb-dur-med) var(--kb-ease-out);
    pointer-events: none;
  }

  .contact-method__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    min-width: 0;
    min-height: 100%;
  }

  .contact-method__head {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--kb-space-3);
    min-width: 0;
  }

  .contact-method__index {
    flex-shrink: 0;
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    font-weight: var(--kb-w-medium);
    line-height: 1;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--cm-index);
    opacity: 0.45;
  }

  .contact-method__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-2);
    margin: 0;
    min-width: 0;
    color: var(--cm-eyebrow);
  }

  .contact-method__label {
    min-width: 0;
  }

  .contact-method__mark {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 0.9375rem;
    height: 0.9375rem;
    color: var(--cm-mark);
    opacity: 0.88;
  }

  .contact-method__mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .contact-method__main {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-2);
    min-width: 0;
    flex: 1 1 auto;
  }

  .contact-method__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    font-weight: var(--kb-w-medium);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--cm-title);
    word-break: break-word;
  }

  .contact-method__description {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: 1.65;
    text-wrap: pretty;
    color: var(--cm-body);
  }

  .contact-method__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-3);
    margin-top: auto;
    padding-top: var(--kb-space-4);
    border-top: 1px solid var(--cm-divider);
  }

  .contact-method__meta {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.625rem;
    border: 1px solid var(--cm-meta-border);
    border-radius: var(--kb-radius-xs);
    background: var(--cm-meta-bg);
    color: var(--cm-meta-fg);
    font-size: var(--kb-text-2xs);
    font-weight: var(--kb-w-medium);
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .contact-method__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
    color: var(--cm-cta);
    font-size: var(--kb-text-xs);
    transition:
      opacity var(--kb-dur-med) var(--kb-ease-out),
      transform var(--kb-dur-med) var(--kb-ease-out);
  }

  .contact-method__cta-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 0.875rem;
    height: 0.875rem;
  }

  .contact-method__cta-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .contact-method--linked {
    cursor: pointer;
    transition:
      border-color var(--kb-dur-med) var(--kb-ease-out),
      transform var(--kb-dur-med) var(--kb-ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-method--linked:hover,
    .contact-method--linked:focus-visible {
      transform: translateY(-2px);
    }

    .contact-method--linked:hover .contact-method__accent,
    .contact-method--linked:focus-visible .contact-method__accent {
      transform: scaleY(1);
    }

    .contact-method__cta {
      opacity: 0.72;
      transform: translateX(-0.15rem);
    }

    .contact-method--linked:hover .contact-method__cta,
    .contact-method--linked:focus-visible .contact-method__cta {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-method__accent,
    .contact-method__cta,
    .contact-method--linked {
      transition: none;
    }

    .contact-method__accent {
      transform: scaleY(1);
    }
  }
</style>
