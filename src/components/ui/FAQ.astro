  @media (prefers-reduced-motion: reduce) {
    .faq-card,
    .faq-card::before,
    .faq-summary-toggle,
    .faq-summary-toggle-line,
    .faq-card-corner,
    .faq-answer-wrap,
    .faq-summary-icon {
      transition: none !important;
    }

    .faq-card::before {
      transform: scaleY(1);
    }

  }
</style>

<script>
  (function initFAQ() {
    const sections = document.querySelectorAll('[data-faq-section]');

    sections.forEach((section) => {
      const details = Array.from(section.querySelectorAll<HTMLDetailsElement>('.faq-card'));
      const accordionName = details[0]?.getAttribute('name') ?? 'faq-group';
      const summaries = section.querySelectorAll<HTMLElement>('.faq-summary');
      const filterButtons = section.querySelectorAll<HTMLButtonElement>('.faq-filter-btn');
      const searchInput = section.querySelector<HTMLInputElement>('.faq-search-input');
      const counterValue = section.querySelector<HTMLElement>('.faq-counter-value');
      const counterLabel = section.querySelector<HTMLElement>('.faq-counter-label');
      const expandBtn = section.querySelector<HTMLButtonElement>('[data-action="expand"]');
      const collapseBtn = section.querySelector<HTMLButtonElement>('[data-action="collapse"]');

      function updateCounter(visibleCount: number) {
        if (counterValue) counterValue.textContent = String(visibleCount);
        if (counterLabel) counterLabel.textContent = visibleCount === 1 ? 'pregunta' : 'preguntas';
      }

      function updateSummaryAria(detail: HTMLDetailsElement) {
        const summary = detail.querySelector<HTMLElement>('.faq-summary');
        summary?.setAttribute('aria-expanded', String(detail.open));
      }

      function applyFilters() {
        const activeBtn = section.querySelector<HTMLButtonElement>('.faq-filter-btn.is-active');
        const activeCategory = activeBtn?.dataset.category ?? 'all';
        const query = searchInput?.value.trim().toLowerCase() ?? '';

        let visibleCount = 0;

        details.forEach((detail) => {
          const category = detail.dataset.category ?? '';
          const question = detail.querySelector('.faq-summary-q')?.textContent ?? '';
          const answer = detail.querySelector('.faq-answer-text')?.textContent ?? '';

          const matchesCategory = activeCategory === 'all' || category === activeCategory;
          const matchesSearch =
            query === '' ||
            question.toLowerCase().includes(query) ||
            answer.toLowerCase().includes(query);

          if (matchesCategory && matchesSearch) {
            detail.classList.remove('is-hidden');
            detail.removeAttribute('aria-hidden');
            visibleCount += 1;
          } else {
            detail.classList.add('is-hidden');
            detail.setAttribute('aria-hidden', 'true');
            detail.open = false;
            updateSummaryAria(detail);
          }
        });

        updateCounter(visibleCount);
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterButtons.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');
          applyFilters();
        });
      });

      searchInput?.addEventListener('input', applyFilters);

      details.forEach((detail) => {
        detail.addEventListener('toggle', () => {
          updateSummaryAria(detail);
          if (detail.open) {
            details.forEach((other) => {
              if (other !== detail && other.open) {
                other.open = false;
                updateSummaryAria(other);
              }
            });
          }
        });
      });

      summaries.forEach((summary) => {
        summary.addEventListener('click', () => {
          // Restore accordion grouping when a summary is clicked manually.
          details.forEach((d) => d.setAttribute('name', accordionName));
        });
      });

      expandBtn?.addEventListener('click', () => {
        details.forEach((detail) => {
          if (!detail.classList.contains('is-hidden')) {
            detail.removeAttribute('name');
            detail.open = true;
            updateSummaryAria(detail);
          }
        });
      });

      collapseBtn?.addEventListener('click', () => {
        details.forEach((detail) => {
          detail.setAttribute('name', accordionName);
          detail.open = false;
          updateSummaryAria(detail);
        });
      });

      // Deep-link support: open and scroll to a specific FAQ.
      function openHashFAQ() {
        const hash = window.location.hash;
        if (!hash || !hash.startsWith('#faq-')) return;
        const target = section.querySelector<HTMLDetailsElement>(hash);
        if (!target || target.classList.contains('is-hidden')) return;
        target.open = true;
        updateSummaryAria(target);
        setTimeout(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }

      openHashFAQ();
      window.addEventListener('hashchange', openHashFAQ);
    });
  })();
</script>
