---
interface Props {
  columns?: 2 | 3 | 4;
  gap?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { columns = 3, gap = 'md', class: className } = Astro.props;

const gridCols = {
  2: 'sm:grid-cols-2',
  3: 'md:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];

const gapSize = {
  sm: 'gap-4 md:gap-5',
  md: 'gap-5 md:gap-6 lg:gap-7',
  lg: 'gap-6 md:gap-8 lg:gap-10',
}[gap];
---

<div class:list={['grid grid-cols-1', gridCols, gapSize, className]}>
  <slot />
</div>
