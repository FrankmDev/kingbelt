---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

interface Props extends HTMLAttributes<'div'> {
  label: string;
  for: string;
  help?: string;
  error?: string;
  required?: boolean;
  icon?: string;
}

const {
  label,
  for: forId,
  help,
  error,
  required = false,
  icon,
  class: className,
  ...rest
} = Astro.props;

const descriptionId = help ? `${forId}-help` : undefined;
const errorId = error ? `${forId}-error` : undefined;
---

<div class:list={['form-field group kb-rounded-sm', className]} {...rest}>
  <label class="kb-label" for={forId}>
    {icon && <Icon name={icon} class="w-3 h-3 text-king-accent" />}
    <span>{label}</span>
    {required && <span class="text-king-accent text-[var(--kb-text-eyebrow)] font-medium" aria-hidden="true">*</span>}
  </label>

  <div class="relative">
    <slot />
  </div>

  {help && !error && (
    <p id={descriptionId} class="form-field-message text-king-muted">
      <span class="w-1 h-1 rounded-full bg-king-accent/50" aria-hidden="true"></span>
      {help}
    </p>
  )}

  {error && (
    <p id={errorId} class="form-field-message form-field-error" role="alert" aria-live="polite">
      <Icon name="x" class="w-3 h-3 shrink-0" />
      {error}
    </p>
  )}
</div>

<style>
  .form-field {
    transition: background-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .form-field:focus-within .kb-label {
    color: var(--color-king-accent);
  }

  .form-field-message {
    display: flex;
    align-items: center;
    gap: var(--kb-space-2);
    margin-top: var(--kb-space-2);
    font-size: var(--kb-text-meta);
    font-weight: var(--kb-w-body);
    line-height: 1.6;
  }

  .form-field-error {
    color: var(--color-king-error);
    font-weight: var(--kb-w-medium);
  }
</style>
