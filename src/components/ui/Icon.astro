---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Instagram from '../icons/Instagram.astro';
import Mail from '../icons/Mail.astro';
import Phone from '../icons/Phone.astro';
import ShoppingBag from '../icons/ShoppingBag.astro';
import Whatsapp from '../icons/Whatsapp.astro';
import { iconPaths, type ComponentIconName, type IconName, type PathIconName } from './icon-paths';

interface Props {
  name: IconName;
  class?: string;
  title?: string;
  strokeWidth?: number;
}

const { name, class: className = 'w-5 h-5', title, strokeWidth = 1.8 } = Astro.props;

const iconComponents = {
  instagram: Instagram,
  mail: Mail,
  phone: Phone,
  'shopping-bag': ShoppingBag,
  whatsapp: Whatsapp,
} as const satisfies Record<ComponentIconName, AstroComponentFactory>;

const isComponentIcon = (iconName: IconName): iconName is ComponentIconName =>
  iconName in iconComponents;

const IconComponent = isComponentIcon(name) ? iconComponents[name] : undefined;
const pathName = isComponentIcon(name) ? undefined : (name as PathIconName);
const hasTitle = Boolean(title);
---

{IconComponent ? (
  <IconComponent class={className} title={title} strokeWidth={strokeWidth} />
) : (
  <svg
    class={className}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={hasTitle ? undefined : 'true'}
    role={hasTitle ? 'img' : undefined}
    set:html={pathName ? iconPaths[pathName] : ''}
  >
    {hasTitle && <title>{title}</title>}
  </svg>
)}
