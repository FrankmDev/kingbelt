  engine: '<path d="M3 10h4l2-3h5l2 3h3a2 2 0 0 1 2 2v5h-3l-2 3H8l-2-3H3v-7Z"/><path d="M9 7V4h6v3"/><path d="M3 14H1"/><path d="M21 14h2"/><path d="M10 13h4"/>',
