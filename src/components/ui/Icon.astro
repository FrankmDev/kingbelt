---
import { iconPaths, type IconName } from './icon-paths';

interface Props {
  name: IconName;
  class?: string;
  title?: string;
  strokeWidth?: number;
}

const { name, class: className = 'w-5 h-5', title, strokeWidth = 1.8 } = Astro.props;

const hasTitle = Boolean(title);
const isFilled = name === 'whatsapp' || name === 'instagram';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? undefined : strokeWidth}
  stroke-linecap={isFilled ? undefined : 'round'}
  stroke-linejoin={isFilled ? undefined : 'round'}
  aria-hidden={hasTitle ? undefined : 'true'}
  role={hasTitle ? 'img' : undefined}
  set:html={iconPaths[name]}
>
  {hasTitle && <title>{title}</title>}
</svg>
