---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'w-5 h-5' } = Astro.props;

const paths: Record<string, string> = {
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-left': '<path d="M19 12H5"/><path d="m11 18-6-6 6-6"/>',
  'caret-down': '<path d="m6 9 6 6 6-6"/>',
  star: '<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3z"/>',
  motorcycle: '<path d="M5.5 17.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M18.5 17.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M8.5 14.5h4l2-5h2l2 5"/><path d="M11 9.5H8l-2.5 5"/><path d="M13 7h3"/>',
  shield: '<path d="M12 3 5 6v5c0 4.5 2.9 8.4 7 10 4.1-1.6 7-5.5 7-10V6l-7-3Z"/>',
  'shield-check': '<path d="M12 3 5 6v5c0 4.5 2.9 8.4 7 10 4.1-1.6 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/>',
  lightning: '<path d="m13 2-8 12h7l-1 8 8-12h-7l1-8Z"/>',
  hammer: '<path d="m14 4 6 6"/><path d="m13 5 2-2 6 6-2 2"/><path d="m3 21 8-8"/><path d="m9 11 4 4"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.1 5.1l-6.3 6.3a2 2 0 0 0 2.8 2.8l6.3-6.3a4 4 0 0 0 5.1-5.1l-2.8 2.8-2.1-2.1 2.1-3.5Z"/>',
  engine: '<path d="M4 13h3l2-3h5l2 3h4"/><path d="M7 13v5h10v-5"/><path d="M9 10V7h6v3"/><path d="M10 7V4h4v3"/><path d="M20 11v5"/><path d="M4 11v5"/>',
  ruler: '<path d="M4 18 18 4l2 2L6 20 4 18Z"/><path d="m14 8 2 2"/><path d="m11 11 2 2"/><path d="m8 14 2 2"/>',
  clock: '<path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"/><path d="M12 7v5l3 2"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="4"/><path d="M16 11.4A4 4 0 1 1 12.6 8"/><path d="M17.5 6.5h.01"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  'paper-plane': '<path d="m21 3-6.5 18-3.7-7.8L3 9.5 21 3Z"/><path d="m10.8 13.2 4.5-4.5"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={name === 'star' ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name] ?? paths.engine}
/>
