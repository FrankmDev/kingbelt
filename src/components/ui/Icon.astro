  hammer: '<path d="m15 12-8.5 8.5a2.1 2.1 0 0 1-3-3L12 9"/><path d="m17.64 15 4.36-4.36-3.54-3.54-1.41 1.41-2.12-2.12 1.41-1.41L13.5 2.14 9.14 6.5l2.12 2.12L9.85 10.03l3.54 3.54 1.41-1.41L17.64 15Z"/>',
