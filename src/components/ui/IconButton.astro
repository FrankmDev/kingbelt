---
interface Props {
  id?: string;
  ariaLabel: string;
  class?: string;
}

const { id, ariaLabel, class: className = '' } = Astro.props;
---

<button
  id={id}
  class={`w-12 h-12 border border-king-text/10 flex items-center justify-center text-king-text hover:border-king-text hover:bg-king-text/5 transition-all duration-300 ${className}`}
  aria-label={ariaLabel}
>
  <slot />
</button>
