---
import type { HTMLAttributes } from 'astro/types';
import Breadcrumbs from './Breadcrumbs.astro';
import OptimizedImage from './OptimizedImage.astro';

interface ArticleMeta {
  date?: string;
  category?: string;
  readTime?: string;
  issue?: string;
}

interface Props extends HTMLAttributes<'section'> {
  eyebrow?: string;
  description?: string;
  image: string;
  imageAlt?: string;
  imagePosition?: string;
  meta?: string;
  titleId?: string;
  breadcrumbs?: { label: string; href?: string }[];
  articleMeta?: ArticleMeta;
}

const {
  eyebrow,
  description,
  image,
  imageAlt = '',
  imagePosition = 'center',
  meta,
  titleId = 'page-hero-title',
  breadcrumbs,
  articleMeta,
  class: className = '',
  ...rest
} = Astro.props;

const hasLedger = Boolean(eyebrow || meta);
const articleNotes = articleMeta
  ? [articleMeta.category, articleMeta.date, articleMeta.readTime, articleMeta.issue]
      .filter(Boolean)
      .join(' · ')
  : '';
const hasAside = Boolean(description || articleNotes);
const objectStyle = `object-position:${imagePosition}`;
---

<section class:list={['page-header', className]} {...rest}>
  <div class="page-header-media absolute inset-0">
    <OptimizedImage
      src={image}
      alt={imageAlt}
      preset="hero"
      loading="eager"
      fetchpriority="high"
      width={1920}
      height={1080}
      class="page-header-img h-full w-full object-cover"
      style={objectStyle}
    />
    <div class="page-header-overlay absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-readability absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-vignette absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-grain absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <span class="page-header-accent" aria-hidden="true"></span>
  </div>

  <div class="page-header-inner">
    <div class="page-header-shell kb-shell-wide">
      <div class="page-header-content">
        {breadcrumbs && breadcrumbs.length > 0 && (
          <div class="page-header-breadcrumbs">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        )}

        {hasLedger && (
          <div class="page-header-ledger">
            {eyebrow && (
              <p class="page-header-ledger-eyebrow kb-eyebrow kb-eyebrow-lined">{eyebrow}</p>
            )}
            {meta && <p class="page-header-ledger-meta kb-meta-label">{meta}</p>}
          </div>
        )}

        <div class="page-header-editorial">
          <div class="page-header-editorial__primary">
            <h1 id={titleId} class="page-header-title font-display">
              <slot name="title" />
            </h1>
          </div>

          {hasAside && (
            <div class="page-header-editorial__aside">
              <span class="page-header-aside-rule" aria-hidden="true"></span>
              <div class="page-header-aside-copy">
                {description && <p class="page-header-lede">{description}</p>}
                {articleNotes && (
                  <p class="page-header-notes kb-meta-label" aria-label="Metadatos del artículo">
                    {articleNotes}
                  </p>
                )}
              </div>
            </div>
          )}
        </div>

        <slot />
      </div>

      <span class="page-header-shell-rule" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .page-header {
    --ph-min-height: min(36rem, 78svh);
    --ph-ink: var(--color-king-bone);
    --ph-muted: rgba(255, 250, 241, 0.68);
    --ph-accent: var(--color-king-on-dark-em);

    position: relative;
    overflow: hidden;
    min-height: var(--ph-min-height);
    color: var(--ph-ink);
  }

  .page-header-inner {
    position: relative;
    z-index: 10;
    display: flex;
    min-height: inherit;
    width: 100%;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--kb-header-offset) + var(--kb-space-4));
    padding-bottom: var(--kb-space-7);
  }

  .page-header-shell {
    display: grid;
    gap: var(--kb-space-5);
    min-width: 0;
  }

  .page-header-content {
    display: grid;
    gap: var(--kb-space-5);
    width: 100%;
    min-width: 0;
  }

  .page-header :global(.page-header-img) {
    filter: saturate(0.82) contrast(1.05) brightness(0.78);
  }

  .page-header :global(.page-header-overlay) {
    background:
      linear-gradient(
        180deg,
        rgba(11, 10, 8, 0.38) 0%,
        rgba(11, 10, 8, 0.1) 32%,
        rgba(11, 10, 8, 0.24) 66%,
        rgba(11, 10, 8, 0.46) 100%
      ),
      linear-gradient(
        90deg,
        rgba(11, 10, 8, 0.5) 0%,
        rgba(11, 10, 8, 0.08) 48%,
        rgba(11, 10, 8, 0.3) 100%
      );
  }

  .page-header-readability {
    z-index: 1;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(11, 10, 8, 0.03) 30%,
      rgba(11, 10, 8, 0.38) 68%,
      rgba(11, 10, 8, 0.86) 100%
    );
  }

  .page-header :global(.page-header-vignette) {
    opacity: 0.4;
  }

  .page-header-breadcrumbs {
    --kb-breadcrumb-color: rgba(255, 250, 241, 0.58);
    --kb-breadcrumb-hover: rgba(255, 250, 241, 0.92);
    --kb-breadcrumb-active: var(--color-king-bone);
    margin-bottom: 0;
  }

  .page-header-ledger {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-3) var(--kb-space-5);
    width: 100%;
    min-width: 0;
  }

  .page-header-ledger-eyebrow {
    margin: 0;
    color: rgba(255, 250, 241, 0.82);
  }

  .page-header-ledger-eyebrow.kb-eyebrow-lined::before {
    background: var(--color-king-on-dark-line);
    opacity: 0.9;
  }

  .page-header-ledger-meta {
    margin: 0;
    margin-left: auto;
    color: var(--ph-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .page-header-editorial {
    display: grid;
    gap: var(--kb-space-5);
    width: 100%;
    min-width: 0;
  }

  .page-header-editorial__primary,
  .page-header-editorial__aside,
  .page-header-aside-copy {
    min-width: 0;
  }

  .page-header-editorial__aside {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--kb-space-4);
    align-items: start;
  }

  .page-header-aside-rule {
    display: none;
  }

  .page-header-title {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(2.5rem, 5.2vw, 3.875rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
    color: var(--color-king-bone);
  }

  .page-header-title :global(em) {
    color: var(--ph-accent);
    font-style: italic;
    font-weight: var(--kb-w-heading-strong);
  }

  .page-header-lede {
    margin: 0;
    max-width: 40ch;
    font-size: var(--kb-text-body-lg);
    line-height: 1.64;
    text-wrap: pretty;
    color: rgba(255, 250, 241, 0.82);
  }

  .page-header-aside-copy {
    display: grid;
    gap: var(--kb-space-3);
  }

  .page-header-notes {
    margin: 0;
    color: rgba(255, 250, 241, 0.58);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .page-header-shell-rule {
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(255, 250, 241, 0.36),
      rgba(255, 250, 241, 0.1) 58%,
      transparent
    );
  }

  .page-header-accent {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    height: 2px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--color-king-on-dark-line),
      color-mix(in srgb, var(--color-king-on-dark-line) 30%, transparent) 55%,
      transparent
    );
    opacity: 0.78;
  }

  @media (max-width: 47.99rem) {
    .page-header {
      --ph-min-height: min(34rem, 74svh);
    }

    .page-header-ledger-meta {
      width: 100%;
      margin-left: 0;
    }

    .page-header-title {
      max-width: none;
      font-size: clamp(2.125rem, 8.8vw, 2.75rem);
      line-height: 1.02;
    }

    .page-header-lede {
      max-width: none;
      font-size: var(--kb-text-body);
      line-height: 1.62;
    }
  }

  @media (min-width: 48rem) {
    .page-header {
      --ph-min-height: min(36rem, 62svh);
    }

    .page-header-inner {
      padding-top: calc(var(--kb-header-offset) + var(--kb-space-5));
      padding-bottom: var(--kb-space-8);
    }

    .page-header-content {
      gap: var(--kb-space-6);
    }
  }

  @media (min-width: 64rem) {
    .page-header {
      --ph-min-height: min(38rem, 62svh);
    }

    .page-header-editorial {
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      gap: var(--kb-space-10);
      align-items: end;
    }

    .page-header-editorial__aside {
      grid-template-columns: 1px minmax(0, 1fr);
      gap: var(--kb-space-6);
      justify-self: end;
      padding-bottom: 0.35rem;
    }

    .page-header-aside-rule {
      display: block;
      width: 1px;
      min-height: 100%;
      align-self: stretch;
      background: linear-gradient(
        180deg,
        transparent 0%,
        rgba(255, 250, 241, 0.22) 18%,
        rgba(255, 250, 241, 0.22) 82%,
        transparent 100%
      );
    }

    .page-header-lede {
      max-width: 38ch;
    }
  }

  @keyframes page-header-zoom-in {
    from {
      opacity: 0;
      transform: scale(1.12);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes page-header-rise {
    from {
      opacity: 0;
      transform: translate3d(0, var(--page-header-rise, 1rem), 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-header :global(.page-header-img) {
      animation: page-header-zoom-in 1.9s var(--kb-ease-out) both;
    }

    .page-header-breadcrumbs {
      --page-header-rise: -0.625rem;
      animation: page-header-rise 0.7s var(--kb-ease-out) 0.4s both;
    }

    .page-header-ledger {
      --page-header-rise: 0.75rem;
      animation: page-header-rise 0.7s var(--kb-ease-out) 0.55s both;
    }

    .page-header-title {
      --page-header-rise: 1.5rem;
      animation: page-header-rise 1s var(--kb-ease-out) 0.75s both;
    }

    .page-header-lede,
    .page-header-notes {
      --page-header-rise: 1rem;
      animation: page-header-rise 0.85s var(--kb-ease-out) 0.95s both;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-header :global(.page-header-img) {
      transform: none;
    }
  }
</style>
