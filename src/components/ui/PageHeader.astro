---
import type { HTMLAttributes } from 'astro/types';
import Badge from './Badge.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface ArticleMeta {
  date?: string;
  category?: string;
  readTime?: string;
  issue?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
}

interface Props extends HTMLAttributes<'section'> {
  variant?: 'default' | 'blog';
  eyebrow?: string;
  description?: string;
  image: string;
  imageAlt?: string;
  imagePosition?: string;
  meta?: string;
  breadcrumbs?: { label: string; href?: string }[];
  articleMeta?: ArticleMeta;
}

const {
  variant = 'default',
  eyebrow,
  description,
  image,
  imageAlt = '',
  imagePosition = 'center',
  meta,
  breadcrumbs,
  articleMeta,
  class: className = '',
  ...rest
} = Astro.props;

const isBlog = variant === 'blog';
const hasArticleMeta = Boolean(
  articleMeta &&
    (articleMeta.date ||
      articleMeta.category ||
      articleMeta.readTime ||
      articleMeta.issue)
);
const heroImage = isBlog && articleMeta?.image ? articleMeta.image : image;
const heroImageAlt = isBlog && articleMeta?.imageAlt ? articleMeta.imageAlt : imageAlt;
const heroImagePosition =
  isBlog && articleMeta?.imagePosition ? articleMeta.imagePosition : imagePosition;
const objectStyle = `object-position:${heroImagePosition}`;
---

<section
  class:list={['page-header', className]}
  data-page-header={variant}
  {...rest}
>
  <div class="page-header-media absolute inset-0">
    <img
      src={heroImage}
      alt={heroImageAlt}
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="page-header-img h-full w-full object-cover"
      style={objectStyle}
    />
    <div class="page-header-overlay absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-vignette absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-grain absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  </div>

  <div
    class:list={[
      'page-header-inner',
      isBlog ? 'page-header-inner--blog' : 'page-header-inner--default',
    ]}
  >
    <div
      class:list={[
        'page-header-content w-full',
        isBlog ? 'max-w-[var(--kb-shell-narrow)] mx-auto text-center' : 'max-w-[var(--kb-shell-copy)]',
      ]}
    >
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="page-header-breadcrumbs">
          <Breadcrumbs
            items={breadcrumbs}
            includeHome={!isBlog}
            class={isBlog ? 'justify-center' : undefined}
          />
        </div>
      )}

      {eyebrow && (
        <div class="page-header-kicker">
          <span class="page-header-kicker-mark" aria-hidden="true"></span>
          <span class="page-header-eyebrow kb-eyebrow">{eyebrow}</span>
        </div>
      )}

      <h1 class="page-header-title">
        <slot name="title" />
      </h1>

      {isBlog && hasArticleMeta && (
        <div class="page-header-article-meta" aria-label="Metadatos del artículo">
          {articleMeta?.category && (
            <Badge variant="accent">{articleMeta.category}</Badge>
          )}
          {articleMeta?.date && <Badge variant="dark">{articleMeta.date}</Badge>}
          {articleMeta?.readTime && <Badge variant="dark">{articleMeta.readTime}</Badge>}
          {articleMeta?.issue && <Badge variant="dark">{articleMeta.issue}</Badge>}
        </div>
      )}

      {description && (
        <p class:list={['page-header-lede', isBlog && 'page-header-lede--blog']}>{description}</p>
      )}

      <slot />

      {meta && (
        <p class="page-header-meta">
          <span class="page-header-meta__text kb-meta-label">{meta}</span>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    min-height: min(38rem, 78svh);
  }

  .page-header[data-page-header='blog'] {
    min-height: min(40rem, 82svh);
  }

  .page-header-inner {
    position: relative;
    z-index: 10;
    display: flex;
    min-height: inherit;
    width: 100%;
    flex-direction: column;
    margin-inline: auto;
    padding-inline: var(--kb-gutter);
    padding-top: calc(var(--kb-header-offset) + var(--kb-space-4));
  }

  .page-header-inner--default {
    justify-content: flex-end;
    padding-bottom: var(--kb-space-7);
  }

  .page-header-inner--blog {
    justify-content: center;
    padding-bottom: var(--kb-space-8);
  }

  .page-header-content {
    display: grid;
    gap: var(--kb-space-4);
  }

  @media (max-width: 47.99rem) {
    .page-header-content {
      gap: var(--kb-space-3);
    }
  }

  @media (min-width: 48rem) {
    .page-header {
      min-height: min(45rem, 86svh);
    }

    .page-header[data-page-header='blog'] {
      min-height: min(47rem, 88svh);
    }

    .page-header-inner {
      padding-inline: 2.5rem;
      padding-top: calc(var(--kb-header-offset) + var(--kb-space-5));
    }

    .page-header-inner--default {
      padding-bottom: var(--kb-space-8);
    }

    .page-header-inner--blog {
      padding-bottom: var(--kb-space-8);
    }

    .page-header-content {
      gap: var(--kb-space-5);
    }
  }

  @media (min-width: 64rem) {
    .page-header {
      min-height: min(52rem, 92vh);
    }

    .page-header-inner {
      padding-inline: 4rem;
      padding-top: calc(var(--kb-header-offset) + var(--kb-space-6));
    }

    .page-header-inner--default {
      padding-bottom: 9rem;
    }

    .page-header-inner--blog {
      padding-bottom: var(--kb-space-8);
    }
  }

  @keyframes page-header-zoom-in {
    from {
      opacity: 0;
      transform: scale(1.12);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes page-header-rise {
    from {
      opacity: 0;
      transform: translate3d(0, var(--page-header-rise, 1rem), 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-page-header] .page-header-img {
      animation: page-header-zoom-in 1.9s var(--kb-ease-out) both;
    }

    [data-page-header] .page-header-breadcrumbs {
      --page-header-rise: -0.625rem;
      animation: page-header-rise 0.7s var(--kb-ease-out) 0.4s both;
    }

    [data-page-header] .page-header-kicker {
      --page-header-rise: 0.875rem;
      animation: page-header-rise 0.7s var(--kb-ease-out) 0.6s both;
    }

    [data-page-header] .page-header-title {
      --page-header-rise: 2rem;
      animation: page-header-rise 1s var(--kb-ease-out) 0.8s both;
    }

    [data-page-header] .page-header-article-meta {
      --page-header-rise: 1.125rem;
      animation: page-header-rise 0.75s var(--kb-ease-out) 1s both;
    }

    [data-page-header] .page-header-lede {
      --page-header-rise: 1.125rem;
      animation: page-header-rise 0.85s var(--kb-ease-out) 1.05s both;
    }

    [data-page-header] .page-header-meta {
      --page-header-rise: 0.875rem;
      animation: page-header-rise 0.7s var(--kb-ease-out) 1.15s both;
    }
  }
</style>
