---
import type { HTMLAttributes } from 'astro/types';
import Badge from './Badge.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface ArticleMeta {
  date?: string;
  category?: string;
  readTime?: string;
  issue?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
}

interface Props extends HTMLAttributes<'section'> {
  variant?: 'default' | 'blog';
  eyebrow?: string;
  description?: string;
  image: string;
  imageAlt?: string;
  imagePosition?: string;
  meta?: string;
  breadcrumbs?: { label: string; href?: string }[];
  articleMeta?: ArticleMeta;
}

const {
  variant = 'default',
  eyebrow,
  description,
  image,
  imageAlt = '',
  imagePosition = 'center',
  meta,
  breadcrumbs,
  articleMeta,
  class: className = '',
  ...rest
} = Astro.props;

const isBlog = variant === 'blog';
const hasArticleMeta = Boolean(
  articleMeta &&
    (articleMeta.date ||
      articleMeta.category ||
      articleMeta.readTime ||
      articleMeta.issue)
);
const heroImage = isBlog && articleMeta?.image ? articleMeta.image : image;
const heroImageAlt = isBlog && articleMeta?.imageAlt ? articleMeta.imageAlt : imageAlt;
const heroImagePosition =
  isBlog && articleMeta?.imagePosition ? articleMeta.imagePosition : imagePosition;
const objectStyle = `object-position:${heroImagePosition}`;
---

<section
  class:list={[
    'page-header relative overflow-hidden',
    'min-h-[min(52rem,92vh)]',
    className,
  ]}
  data-page-header={variant}
  {...rest}
>
  <div class="page-header-media absolute inset-0">
    <img
      src={heroImage}
      alt={heroImageAlt}
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="page-header-img h-full w-full object-cover"
      style={objectStyle}
    />
    <div class="page-header-overlay absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-vignette absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-grain absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  </div>

  <div
    class:list={[
      'page-header-inner relative z-10 mx-auto flex min-h-[inherit] w-full flex-col',
      isBlog ? 'justify-center' : 'justify-end',
      'px-5 md:px-10 lg:px-16',
      isBlog ? 'py-28 md:py-32' : 'pb-24 md:pb-32 lg:pb-36 pt-28 md:pt-32',
    ]}
  >
    <div
      class:list={[
        'page-header-content w-full',
        isBlog ? 'max-w-[var(--kb-shell-narrow)] mx-auto text-center' : 'max-w-[var(--kb-shell-copy)]',
      ]}
    >
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="page-header-breadcrumbs">
          <Breadcrumbs
            items={breadcrumbs}
            includeHome={!isBlog}
            class={isBlog ? 'justify-center' : undefined}
          />
        </div>
      )}

      {eyebrow && (
        <div class="page-header-kicker">
          <span class="page-header-kicker-mark" aria-hidden="true"></span>
          <span class="page-header-eyebrow kb-eyebrow">{eyebrow}</span>
        </div>
      )}

      <h1 class="page-header-title">
        <slot name="title" />
      </h1>

      {isBlog && hasArticleMeta && (
        <div class="page-header-article-meta" aria-label="Metadatos del artículo">
          {articleMeta?.category && (
            <Badge variant="accent">{articleMeta.category}</Badge>
          )}
          {articleMeta?.date && <Badge variant="dark">{articleMeta.date}</Badge>}
          {articleMeta?.readTime && <Badge variant="dark">{articleMeta.readTime}</Badge>}
          {articleMeta?.issue && <Badge variant="dark">{articleMeta.issue}</Badge>}
        </div>
      )}

      {description && (
        <p class:list={['page-header-lede', isBlog && 'page-header-lede--blog']}>{description}</p>
      )}

      <slot />
    </div>
  </div>

  {meta && (
    <div class="page-header-bar absolute bottom-0 left-0 right-0 z-[3]">
      <div class="page-header-bar-inner mx-auto px-5 md:px-10">
        <div class="flex items-center justify-center py-3.5 md:py-4">
          <span class="page-header-bar-meta">{meta}</span>
        </div>
      </div>
    </div>
  )}
</section>

<script>
  import gsap from 'gsap';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const headers = document.querySelectorAll('[data-page-header]');

  headers.forEach((header) => {
    const scope = header as HTMLElement;
    const img = scope.querySelector<HTMLElement>('.page-header-img');
    const eyebrow = scope.querySelector<HTMLElement>('.page-header-kicker');
    const title = scope.querySelector<HTMLElement>('.page-header-title');
    const meta = scope.querySelector<HTMLElement>('.page-header-article-meta');
    const lede = scope.querySelector<HTMLElement>('.page-header-lede');
    const bar = scope.querySelector<HTMLElement>('.page-header-bar');
    const breadcrumbs = scope.querySelector<HTMLElement>('.page-header-breadcrumbs');

    if (reduceMotion) return;

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    if (img) tl.from(img, { scale: 1.12, opacity: 0, duration: 1.9 }, 0);
    if (breadcrumbs) tl.from(breadcrumbs, { y: -10, opacity: 0, duration: 0.7 }, 0.4);
    if (eyebrow) tl.from(eyebrow, { y: 14, opacity: 0, duration: 0.7 }, 0.6);
    if (title) tl.from(title, { y: 32, opacity: 0, duration: 1.0 }, 0.8);
    if (meta) tl.from(meta, { y: 18, opacity: 0, duration: 0.75 }, 1.0);
    if (lede) tl.from(lede, { y: 18, opacity: 0, duration: 0.85 }, 1.05);
    if (bar) tl.from(bar, { y: 14, opacity: 0, duration: 0.7 }, 1.2);
  });
</script>
