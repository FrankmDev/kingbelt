---
import type { HTMLAttributes } from 'astro/types';
import Breadcrumbs from './Breadcrumbs.astro';

interface ArticleMeta {
  date?: string;
  category?: string;
  readTime?: string;
}

interface Props extends HTMLAttributes<'section'> {
  variant?: 'default' | 'blog';
  eyebrow?: string;
  description?: string;
  image: string;
  imageAlt?: string;
  imagePosition?: string;
  meta?: string;
  breadcrumbs?: { label: string; href?: string }[];
  articleMeta?: ArticleMeta;
}

const {
  variant = 'default',
  eyebrow,
  description,
  image,
  imageAlt = '',
  imagePosition = 'center',
  meta,
  breadcrumbs,
  articleMeta,
  class: className = '',
  ...rest
} = Astro.props;

const isBlog = variant === 'blog';
const hasBreadcrumbs = Boolean(breadcrumbs && breadcrumbs.length);
const hasArticleMeta = Boolean(
  articleMeta && (articleMeta.date || articleMeta.category || articleMeta.readTime)
);
const objectStyle = `object-position:${imagePosition}`;
---

<section
  class:list={[
    'page-header relative overflow-hidden',
    'min-h-[min(52rem,92vh)]',
    className,
  ]}
  data-page-header={variant}
  {...rest}
>
  <div class="page-header-media absolute inset-0">
    <img
      src={image}
      alt={imageAlt}
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="page-header-img h-full w-full object-cover"
      style={objectStyle}
    />
    <div class="page-header-overlay absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-vignette absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="page-header-grain absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  </div>

  <div
    class:list={[
      'page-header-inner relative z-10 mx-auto flex min-h-[inherit] w-full flex-col',
      isBlog ? 'justify-center' : 'justify-end',
      'px-5 md:px-10 lg:px-16',
      isBlog ? 'py-28 md:py-32' : 'pb-24 md:pb-32 lg:pb-36 pt-28 md:pt-32',
    ]}
  >
    <div
      class:list={[
        'page-header-content w-full',
        isBlog ? 'max-w-[var(--kb-shell-narrow)] mx-auto text-center' : 'max-w-[var(--kb-shell-copy)]',
      ]}
    >
      {isBlog && hasBreadcrumbs && (
        <div class="page-header-breadcrumbs">
          <Breadcrumbs
            items={breadcrumbs as { label: string; href?: string }[]}
            includeHome={false}
            class="justify-center"
          />
        </div>
      )}

      {eyebrow && (
        <div class="page-header-eyebrow-wrap">
          <span class="page-header-eyebrow">{eyebrow}</span>
        </div>
      )}

      <h1 class:list={['page-header-title', isBlog && 'text-balance']}>
        <slot name="title" />
      </h1>

      {isBlog && hasArticleMeta && (
        <div class="page-header-article-meta" aria-label="Metadatos del artículo">
          {articleMeta?.category && (
            <span class="page-header-meta-item page-header-meta-item--category">
              {articleMeta.category}
            </span>
          )}
          {articleMeta?.date && (
            <span class="page-header-meta-item">{articleMeta.date}</span>
          )}
          {articleMeta?.readTime && (
            <span class="page-header-meta-item">{articleMeta.readTime}</span>
          )}
        </div>
      )}

      {description && (
        <p class:list={['page-header-lede', isBlog && 'page-header-lede--blog']}>{description}</p>
      )}

      <slot />
    </div>
  </div>

  {meta && (
    <div class="page-header-bar absolute bottom-0 left-0 right-0 z-[3]">
      <div class="page-header-bar-inner mx-auto px-5 md:px-10">
        <div class="flex items-center justify-center py-3.5 md:py-4">
          <span class="page-header-bar-meta">{meta}</span>
        </div>
      </div>
    </div>
  )}
</section>

<style>
  .page-header-media {
    background: var(--color-king-oil);
  }

  .page-header-img {
    filter: saturate(0.72) contrast(1.08) brightness(0.74);
    transform: scale(1.04);
  }

  .page-header-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(13, 13, 12, 0.55) 0%,
        rgba(13, 13, 12, 0.18) 28%,
        rgba(13, 13, 12, 0.42) 62%,
        rgba(13, 13, 12, 0.82) 100%
      ),
      linear-gradient(
        90deg,
        rgba(13, 13, 12, 0.45) 0%,
        rgba(13, 13, 12, 0.12) 50%,
        rgba(13, 13, 12, 0.32) 100%
      );
  }

  .page-header-vignette {
    background: radial-gradient(
      ellipse 72% 56% at 50% 46%,
      transparent 42%,
      rgba(13, 13, 12, 0.55) 100%
    );
    mix-blend-mode: multiply;
  }

  .page-header-grain {
    opacity: 0.055;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.78' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px 200px;
  }

  .page-header-breadcrumbs {
    --kb-breadcrumb-color: rgba(255, 255, 255, 0.58);
    --kb-breadcrumb-hover: var(--color-king-accent-light);
    --kb-breadcrumb-active: var(--color-king-bone);
    margin-bottom: var(--kb-space-8);
  }

  .page-header-breadcrumbs :global(.kb-meta-label) {
    color: var(--kb-breadcrumb-color);
  }

  .page-header-breadcrumbs :global(a.kb-meta-label:hover) {
    color: var(--kb-breadcrumb-hover);
  }

  .page-header-breadcrumbs :global(span[aria-current='page'].kb-meta-label) {
    color: var(--kb-breadcrumb-active);
  }

  .page-header-breadcrumbs :global(svg) {
    color: rgba(255, 255, 255, 0.28);
  }

  .page-header-eyebrow-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-3);
    margin-bottom: var(--kb-space-5);
  }

  .page-header-eyebrow-wrap::before {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: var(--color-king-brass);
  }

  [data-page-header='blog'] .page-header-eyebrow-wrap {
    justify-content: center;
  }

  [data-page-header='blog'] .page-header-eyebrow-wrap::before {
    background: linear-gradient(90deg, transparent, var(--color-king-brass));
  }

  [data-page-header='blog'] .page-header-eyebrow-wrap::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    background: linear-gradient(90deg, var(--color-king-brass), transparent);
  }

  .page-header-eyebrow {
    display: inline-flex;
    font-size: var(--kb-text-eyebrow);
    font-weight: var(--kb-label-weight);
    letter-spacing: var(--kb-label-tracking);
    text-transform: uppercase;
    line-height: 1;
    color: rgba(255, 255, 255, 0.65);
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--kb-radius-xs);
    backdrop-filter: blur(6px);
    background: rgba(255, 255, 255, 0.04);
  }

  [data-page-header='blog'] .page-header-eyebrow {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.055);
    color: var(--color-king-accent-light);
  }

  .page-header-title {
    line-height: 0.96;
    letter-spacing: -0.015em;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: var(--kb-w-heading-hero);
    max-width: 16ch;
    color: var(--color-king-bone);
  }

  [data-page-header='blog'] .page-header-title {
    max-width: 18ch;
    margin-left: auto;
    margin-right: auto;
  }

  .page-header-title :global(em) {
    color: var(--color-king-accent-light);
    font-style: italic;
    font-weight: 400;
  }

  .page-header-article-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--kb-space-2) var(--kb-space-4);
    margin-top: var(--kb-space-6);
    margin-bottom: 0;
    padding: var(--kb-space-3) var(--kb-space-5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--kb-radius-pill);
    background: rgba(13, 13, 12, 0.28);
    backdrop-filter: blur(8px);
  }

  .page-header-meta-item {
    font-size: var(--kb-text-meta);
    font-weight: var(--kb-w-medium);
    line-height: 1;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.65);
  }

  .page-header-meta-item--category {
    color: var(--color-king-accent-light);
  }

  .page-header-meta-item:not(:last-child)::after {
    content: '·';
    margin-left: var(--kb-space-4);
    color: rgba(255, 255, 255, 0.25);
  }

  .page-header-lede {
    font-size: clamp(1rem, 0.94rem + 0.28vw, 1.1875rem);
    line-height: 1.75;
    max-width: 44rem;
    margin-top: var(--kb-space-6);
    color: rgba(255, 255, 255, 0.68);
  }

  .page-header-lede--blog {
    margin-left: auto;
    margin-right: auto;
  }

  .page-header-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(13, 13, 12, 0.28);
    backdrop-filter: blur(10px);
  }

  .page-header-bar-inner {
    max-width: var(--kb-shell-narrow);
  }

  .page-header-bar-meta {
    font-size: var(--kb-text-eyebrow);
    font-weight: var(--kb-w-medium);
    line-height: 1.3;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.52);
  }

  @media (max-width: 768px) {
    .page-header-title {
      font-size: clamp(2.5rem, 10vw, 3.75rem);
    }

    .page-header-article-meta {
      gap: var(--kb-space-2) var(--kb-space-3);
      padding: var(--kb-space-2) var(--kb-space-4);
    }

    .page-header-meta-item {
      font-size: var(--kb-text-meta);
    }

    [data-page-header='blog'] .page-header-title {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-header-img {
      transform: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const headers = document.querySelectorAll('[data-page-header]');

  headers.forEach((header) => {
    const scope = header as HTMLElement;
    const img = scope.querySelector<HTMLElement>('.page-header-img');
    const eyebrow = scope.querySelector<HTMLElement>('.page-header-eyebrow-wrap');
    const title = scope.querySelector<HTMLElement>('.page-header-title');
    const meta = scope.querySelector<HTMLElement>('.page-header-article-meta');
    const lede = scope.querySelector<HTMLElement>('.page-header-lede');
    const bar = scope.querySelector<HTMLElement>('.page-header-bar');
    const breadcrumbs = scope.querySelector<HTMLElement>('.page-header-breadcrumbs');

    if (reduceMotion) return;

    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    if (img) tl.from(img, { scale: 1.12, opacity: 0, duration: 1.9 }, 0);
    if (breadcrumbs) tl.from(breadcrumbs, { y: -10, opacity: 0, duration: 0.7 }, 0.4);
    if (eyebrow) tl.from(eyebrow, { y: 14, opacity: 0, duration: 0.7 }, 0.6);
    if (title) tl.from(title, { y: 32, opacity: 0, duration: 1.0 }, 0.8);
    if (meta) tl.from(meta, { y: 18, opacity: 0, duration: 0.75 }, 1.0);
    if (lede) tl.from(lede, { y: 18, opacity: 0, duration: 0.85 }, 1.05);
    if (bar) tl.from(bar, { y: 14, opacity: 0, duration: 0.7 }, 1.2);
  });
</script>
