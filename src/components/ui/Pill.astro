---
interface Props {
  accent?: boolean;
  class?: string;
}

const { accent = false, class: className } = Astro.props;
---

<span
  class:list={[
    'kb-pill border px-4 py-1.5 text-[9px] font-medium uppercase tracking-[0.15em]',
    accent
      ? 'border-king-accent/30 text-king-accent/70'
      : 'border-king-border/40 text-king-muted/60',
    className,
  ]}
>
  <slot />
</span>
