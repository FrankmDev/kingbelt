---
interface Props {
  class?: string;
  boxed?: boolean;
}

const { class: className, boxed = false } = Astro.props;
---

<div class:list={[
  'kb-prose',
  boxed && 'kb-prose--boxed kb-panel p-6 md:p-8',
  className,
]}>
  <slot />
</div>

<style>
  .kb-prose {
    max-width: var(--kb-shell-copy);
    margin-inline: auto;
    font-size: clamp(0.9375rem, 0.92rem + 0.2vw, 1.0625rem);
    line-height: 1.78;
    color: var(--color-king-muted);
    overflow-wrap: break-word;
    text-rendering: optimizeLegibility;
  }

  .kb-prose > * + * {
    margin-top: 1.4em;
  }

  .kb-prose h2,
  .kb-prose h3,
  .kb-prose h4 {
    font-family: var(--font-display);
    color: var(--color-king-text);
    letter-spacing: var(--kb-title-tracking);
    text-wrap: balance;
    scroll-margin-top: 7rem;
  }

  .kb-prose h2 {
    font-size: var(--kb-text-h3);
    font-weight: var(--kb-w-heading-strong);
    line-height: 1.15;
    margin-top: 2.4em;
    margin-bottom: 0.5em;
  }

  .kb-prose h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: var(--kb-w-medium);
    line-height: 1.2;
    margin-top: 2em;
    margin-bottom: 0.4em;
  }

  .kb-prose h4 {
    font-size: var(--kb-text-h5);
    font-weight: var(--kb-w-medium);
    line-height: 1.3;
    margin-top: 1.75em;
    margin-bottom: 0.4em;
  }

  .kb-prose h2 + *,
  .kb-prose h3 + *,
  .kb-prose h4 + *,
  .kb-prose blockquote + *,
  .kb-prose pre + *,
  .kb-prose figure + *,
  .kb-prose hr + * {
    margin-top: 0;
  }

  .kb-prose h2 + p::first-letter {
    font-family: "Bitter", Georgia, serif;
    font-weight: 600;
    font-size: 3.4em;
    line-height: 0.85;
    float: left;
    padding-right: 0.1em;
    padding-top: 0.02em;
    color: var(--color-king-accent);
  }

  .kb-prose p {
    margin: 0;
    color: var(--color-king-muted);
    text-wrap: pretty;
    line-height: 1.78;
  }

  .kb-prose a {
    color: var(--color-king-accent);
    text-decoration: none;
    font-weight: 500;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    padding-bottom: 1px;
    transition: background-size var(--kb-dur-med) var(--kb-ease-out);
  }

  .kb-prose a:hover {
    background-size: 100% 1px;
  }

  .kb-prose ul,
  .kb-prose ol {
    padding-inline-start: 0;
    margin: 0;
  }

  .kb-prose ul {
    list-style: none;
  }

  .kb-prose ul li {
    position: relative;
    padding-left: 1.5em;
    line-height: 1.75;
    color: var(--color-king-muted);
  }

  .kb-prose ul li::before {
    content: "";
    position: absolute;
    left: 0.2em;
    top: 0.72em;
    width: 0.32em;
    height: 0.32em;
    border-radius: var(--kb-radius-pill);
    background: var(--color-king-accent);
    opacity: 0.55;
  }

  .kb-prose ol {
    list-style-position: outside;
    padding-inline-start: 1.5em;
  }

  .kb-prose ol li {
    line-height: 1.75;
    color: var(--color-king-muted);
    padding-left: 0.25em;
  }

  .kb-prose ol li::marker {
    color: var(--color-king-accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-sans);
  }

  .kb-prose li + li {
    margin-top: 0.5em;
  }

  .kb-prose blockquote {
    font-family: "Bitter", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.45;
    color: var(--color-king-text);
    border-left: 2px solid var(--color-king-accent);
    padding-left: clamp(1.25rem, 2.5vw, 2rem);
    margin: clamp(2rem, 4vw, 3rem) 0;
    max-width: 42ch;
  }

  .kb-prose blockquote p {
    margin: 0;
    color: inherit;
    line-height: inherit;
  }

  .kb-prose blockquote cite,
  .kb-prose blockquote footer {
    display: block;
    margin-top: 0.75em;
    font-family: var(--font-sans);
    font-size: var(--kb-text-meta);
    font-weight: 500;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-king-muted);
  }

  .kb-prose code {
    font-family: "SF Mono", Monaco, "Cascadia Code", monospace;
    font-size: 0.875em;
    background: var(--kb-surface-light);
    padding: 0.18em 0.45em;
    border-radius: var(--kb-radius-xs);
    border: 1px solid var(--kb-stroke-hairline);
    color: var(--color-king-text);
    overflow-wrap: anywhere;
  }

  .kb-prose pre {
    background: var(--color-king-graphite);
    color: rgba(255, 255, 255, 0.92);
    padding: 1.5em;
    border-radius: var(--kb-radius-md);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    margin: 2em 0;
    font-size: 0.8125rem;
    line-height: 1.65;
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: var(--kb-shadow-md);
  }

  .kb-prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
    white-space: pre;
    font-size: inherit;
  }

  .kb-prose strong {
    font-weight: 600;
    color: var(--color-king-text);
  }

  .kb-prose em {
    font-style: italic;
  }

  .kb-prose mark {
    background: rgba(138, 90, 43, 0.12);
    color: inherit;
    padding: 0.1em 0.25em;
    border-radius: var(--kb-radius-xs);
  }

  .kb-prose small {
    font-size: 0.85em;
    color: var(--color-king-muted);
  }

  .kb-prose img {
    width: 100%;
    height: auto;
    border-radius: var(--kb-radius-md);
    border: 1px solid var(--kb-stroke-hairline);
    margin: 2em 0;
    box-shadow: var(--kb-shadow-sm);
  }

  .kb-prose figure {
    margin: 2em 0;
  }

  .kb-prose figcaption {
    margin-top: 0.75em;
    font-size: var(--kb-text-meta);
    color: var(--color-king-muted);
    text-align: center;
    letter-spacing: 0.04em;
  }

  .kb-prose hr {
    border: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--kb-stroke-dark) 15%,
      var(--kb-stroke-dark) 85%,
      transparent
    );
    margin: 3em 0;
    position: relative;
  }

  .kb-prose hr::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    width: 0.4rem;
    height: 0.4rem;
    background: var(--color-king-accent);
    opacity: 0.3;
    border-radius: 1px;
  }

  .kb-prose--boxed {
    max-width: none;
  }

  @media (max-width: 640px) {
    .kb-prose blockquote {
      font-size: var(--kb-text-body);
    }

    .kb-prose pre {
      padding: 1.15em;
    }

    .kb-prose h2 {
      margin-top: 2em;
    }

    .kb-prose h3 {
      margin-top: 1.6em;
    }
  }
</style>
