---
interface Props {
  eyebrow?: string;
  title?: string;
  titleId?: string;
  body?: string;
  meta?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  density?: 'default' | 'compact';
  class?: string;
}

const {
  eyebrow,
  title,
  titleId,
  body,
  meta,
  align = 'center',
  tone = 'light',
  density = 'default',
  class: className = '',
} = Astro.props;

const hasTitle = Boolean(title || Astro.slots.has('title'));
const hasCopy = Boolean(body || Astro.slots.has('body'));
const hasKicker = Boolean(eyebrow || meta);
const isCentered = align === 'center';
---

<header
  class:list={['section-header', className]}
  data-align={align}
  data-tone={tone}
  data-density={density}
>
  <div class="sh-head">
    {hasKicker && (
      <div class="sh-kicker">
        {isCentered && <span class="sh-kicker-wing" aria-hidden="true"></span>}

        <div class="sh-kicker-inner">
          {eyebrow && (
            <p class="sh-eyebrow kb-eyebrow">
              <span class="sh-eyebrow-mark" aria-hidden="true"></span>
              <span class="sh-eyebrow-text">{eyebrow}</span>
            </p>
          )}

          {eyebrow && meta && <span class="sh-kicker-sep" aria-hidden="true"></span>}

          {meta && <p class="sh-meta kb-meta-label">{meta}</p>}
        </div>

        {isCentered && <span class="sh-kicker-wing" aria-hidden="true"></span>}
      </div>
    )}

    {hasTitle && (
      <h2 id={titleId} class="sh-title">
        {Astro.slots.has('title') ? <slot name="title" /> : title}
      </h2>
    )}
  </div>

  {hasCopy && (
    <div class="sh-lede">
      <div class="sh-lede-rule" aria-hidden="true"></div>
      <div class="sh-copy">
        {Astro.slots.has('body') ? <slot name="body" /> : <p>{body}</p>}
      </div>
    </div>
  )}
</header>
