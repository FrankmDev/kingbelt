---
interface Props {
  count: number;
  label: string;
  class?: string;
  activeIndex?: number;
  target?: string;
}

const {
  count,
  label,
  class: className = '',
  activeIndex = 0,
  target = 'slider',
} = Astro.props;
---

<div class={`flex gap-2 ${className}`}>
  {Array.from({ length: count }).map((_, index) => (
    <button
      class={`h-[2px] transition-all duration-500 ${index === activeIndex ? 'w-10 bg-king-accent' : 'w-4 bg-king-border'}`}
      aria-label={`${label} ${index + 1}`}
      data-slider-dot={target}
      data-index={index}
      type="button"
    />
  ))}
</div>
