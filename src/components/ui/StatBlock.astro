---
interface StatItem {
  value: string;
  label: string;
  description?: string;
  unit?: string;
}

interface Props {
  items?: StatItem[];
  value?: string;
  label?: string;
  description?: string;
  unit?: string;
  variant?: 'default' | 'steel';
  class?: string;
}

const {
  items,
  value,
  label,
  description,
  unit,
  variant = 'default',
  class: className,
} = Astro.props;

const stats: StatItem[] =
  items && items.length > 0
    ? items.slice(0, 3)
    : value && label
      ? [{ value, label, description, unit }]
      : [];

const isSteel = variant === 'steel';
const groupLabel = stats
  .map((s) => `${s.value}${s.unit ? ' ' + s.unit : ''} — ${s.label}`)
  .join('; ');
---

{
  stats.length > 0 && (
    <div
      class:list={[
        'stat-grid',
        isSteel ? 'stat-grid--steel kb-panel-steel kb-texture-metal' : 'stat-grid--default kb-panel',
        className,
      ]}
      role="group"
      aria-label={groupLabel}
    >
      <span class="stat-grid__accent" aria-hidden="true" />

      {stats.map((stat, index) => (
        <div class="stat-grid__item">
          <span class="stat-grid__index" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>

          <div class="stat-grid__value-row">
            <span class="kb-stat-value stat-grid__value">{stat.value}</span>
            {stat.unit && <span class="stat-grid__unit">{stat.unit}</span>}
          </div>

          <span class="kb-stat-label stat-grid__label">{stat.label}</span>

          {stat.description && (
            <p class="stat-grid__desc">{stat.description}</p>
          )}
        </div>
      ))}
    </div>
  )
}

<style>
  .stat-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
  }

  .stat-grid__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-king-accent) 20%,
      var(--color-king-accent) 80%,
      transparent 100%
    );
    opacity: 0.65;
    z-index: 3;
    pointer-events: none;
  }

  .stat-grid--steel .stat-grid__accent {
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-king-brass) 20%,
      var(--color-king-brass) 80%,
      transparent 100%
    );
    opacity: 0.55;
  }

  .stat-grid__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--kb-space-6) var(--kb-space-5);
    transition: background-color var(--kb-dur-med) var(--kb-ease-out);
  }

  .stat-grid__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: var(--kb-space-5);
    right: var(--kb-space-5);
    bottom: 0;
    height: 1px;
    background: var(--kb-stroke-steel);
    opacity: 0.55;
  }

  .stat-grid__index {
    font-family: var(--font-sans);
    font-size: var(--kb-micro-size);
    font-weight: var(--kb-w-semibold);
    letter-spacing: var(--kb-micro-tracking);
    text-transform: uppercase;
    color: var(--color-king-accent);
    margin-bottom: var(--kb-space-2);
    opacity: 0.7;
  }

  .stat-grid__value-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--kb-space-2);
    margin-bottom: var(--kb-space-1);
  }

  .stat-grid__value {
    transition: color var(--kb-dur-med) var(--kb-ease-out);
  }

  .stat-grid__unit {
    font-family: var(--font-sans);
    font-size: var(--kb-text-meta);
    font-weight: var(--kb-w-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    flex-shrink: 0;
  }

  .stat-grid__label {
    margin-top: 0.25rem;
  }

  .stat-grid__desc {
    font-size: var(--kb-text-meta);
    line-height: 1.55;
    max-width: 28ch;
    margin: var(--kb-space-2) 0 0;
    text-wrap: pretty;
  }

  /* Default variant colors */
  .stat-grid--default .stat-grid__unit,
  .stat-grid--default .stat-grid__desc {
    color: var(--color-king-muted);
  }

  /* Steel variant colors */
  .stat-grid--steel .stat-grid__value {
    color: rgba(255, 255, 255, 0.96);
  }

  .stat-grid--steel .stat-grid__index {
    color: var(--color-king-brass);
  }

  .stat-grid--steel .stat-grid__unit,
  .stat-grid--steel .stat-grid__label {
    color: rgba(255, 255, 255, 0.55);
  }

  .stat-grid--steel .stat-grid__desc {
    color: rgba(255, 255, 255, 0.5);
  }

  .stat-grid--steel .stat-grid__item:not(:last-child)::after {
    background: rgba(255, 255, 255, 0.12);
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .stat-grid__item:hover {
      background-color: rgba(138, 90, 43, 0.03);
    }

    .stat-grid__item:hover .stat-grid__value {
      color: var(--color-king-accent);
    }

    .stat-grid--steel .stat-grid__item:hover {
      background-color: rgba(255, 255, 255, 0.04);
    }

    .stat-grid--steel .stat-grid__item:hover .stat-grid__value {
      color: var(--color-king-brass);
    }
  }

  @media (min-width: 768px) {
    .stat-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .stat-grid__item {
      padding: var(--kb-space-7) var(--kb-space-6);
    }

    .stat-grid__item:not(:last-child)::after {
      left: auto;
      right: 0;
      top: var(--kb-space-6);
      bottom: var(--kb-space-6);
      width: 1px;
      height: auto;
    }
  }
</style>
