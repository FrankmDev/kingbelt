---
import '../styles/global.css';
import { site } from '@config/site';
import { serializeJsonForHtml } from '@shared/security/serialize-json-for-html';
import type { PageSeo } from '@shared/seo/page-seo';

interface Props {
  seo?: PageSeo;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonicalURL?: string;
  schema?: object;
  ogType?: 'website' | 'article' | 'product';
  robots?: string;
  publishedAt?: string;
  updatedAt?: string;
}

const {
  seo,
  title: titleProp,
  description: descriptionProp,
  image: imageProp,
  imageAlt: imageAltProp,
  imageWidth: imageWidthProp,
  imageHeight: imageHeightProp,
  canonicalURL: canonicalURLProp,
  schema,
  ogType: ogTypeProp,
  robots: robotsProp,
  publishedAt,
  updatedAt,
} = Astro.props;

const title = seo?.title ?? titleProp ?? `${site.name} — ${site.tagline}`;
const description = seo?.description ?? descriptionProp ?? site.description;
const canonicalURL = seo?.canonicalUrl ?? canonicalURLProp ??
  new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const robots = seo?.robots ?? robotsProp;
const ogType = seo?.ogType ?? ogTypeProp ?? 'website';
const image = seo?.image?.url ?? imageProp ?? '/favicon.svg';
const imageAlt = seo?.image?.altText ?? imageAltProp ?? site.name;
const imageWidth = seo?.image?.width ?? imageWidthProp;
const imageHeight = seo?.image?.height ?? imageHeightProp;

const schemaScript = schema ? serializeJsonForHtml(schema) : null;
const ogImageUrl = new URL(image, Astro.site || Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#EDE8E0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0908" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    {/* Fonts: Satoshi (sans) + Bitter (slab serif) */}
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    {/* SEO */}
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="sitemap" href="/sitemap-commerce.xml" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="KingBelt" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {/* Schema.org */}
    {schemaScript && (
      <script is:inline type="application/ld+json" set:html={schemaScript} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-king-bg">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-full focus:bg-king-text focus:px-4 focus:py-2 focus:text-[var(--kb-text-2xs)] focus:font-medium focus:uppercase focus:tracking-[0.2em] focus:text-king-bg"
    >
      Saltar al contenido
    </a>
    <slot name="header" />
    <main
      id="main"
      class="relative z-[var(--kb-z-content)] flex-1 w-full max-w-full overflow-x-clip bg-king-bg"
    >
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
