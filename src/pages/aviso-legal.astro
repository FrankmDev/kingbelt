---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import LegalPageLayout from '../components/legal/LegalPageLayout.astro';
import LegalDocumentView from '../components/legal/LegalDocumentView.astro';
import LegalBlocks from '../components/legal/LegalBlocks.astro';
import Prose from '../components/ui/Prose.astro';
import { legalDocuments, legalPages } from '@content/legal';
import { avisoLegalBody } from '@content/legal-bodies';
import { createLegalPageHead } from '@shared/seo/legal-page';

const doc = legalDocuments.avisoLegal;
const page = legalPages.avisoLegal;
const { seo, schema } = createLegalPageHead(doc, page);
---

<BaseLayout seo={seo} schema={schema}>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    eyebrow="Legal"
    description={page.lede}
    image={page.image}
    imageAlt={page.imageAlt}
    imagePosition={page.imagePosition}
    meta={page.meta}
    breadcrumbs={[{ label: page.heading }]}
  >
    <Fragment slot="title">
      <span set:html={page.titleHtml} />
    </Fragment>
  </PageHeader>

  <LegalPageLayout document={doc} section={page.section}>
    {avisoLegalBody.intro && (
      <Prose slot="intro" variant="document">
        <LegalBlocks blocks={avisoLegalBody.intro} />
      </Prose>
    )}
    <LegalDocumentView documentKey="avisoLegal" />
  </LegalPageLayout>

  <Footer slot="footer" connected />
</BaseLayout>
