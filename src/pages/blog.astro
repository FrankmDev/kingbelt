---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import BlogBrandCta from '../components/blog/BlogBrandCta.astro';
import BlogTopicNavigation from '../components/blog/BlogTopicNavigation.astro';
import EditorialSelectionSection from '../components/blog/EditorialSelectionSection.astro';
import BlogFeedSection from '../components/sections/blog/BlogFeedSection.astro';
import { blogCategories, blogPage, blogPosts, getBlogPostPath } from '@content/blog';
import { createPageSeo, toSeoImage } from '@shared/seo/page-head';
import { createWebPageSchema } from '@shared/seo/structured-data';

const seo = createPageSeo({
  title: blogPage.meta.title,
  description: blogPage.meta.description,
  pathname: '/blog',
  image: toSeoImage(blogPage.hero.image, blogPage.hero.imageAlt),
});
const featured = blogPosts.find((post) => post.status === 'featured') ?? blogPosts[0];
const journalPosts = [
  featured,
  ...blogPosts.filter((post) => post.slug !== featured.slug),
];
const selection = [blogPosts[7], blogPosts[6], blogPosts[4]].filter(Boolean);
const { sections: blogSections } = blogPage;
const blogSchema = {
  ...createWebPageSchema({
    type: 'Blog',
    name: blogPage.meta.title,
    description: blogPage.meta.description,
    url: seo.canonicalUrl,
  }),
  blogPost: blogPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    datePublished: post.date,
    url: new URL(getBlogPostPath(post), seo.canonicalUrl).href,
    image: new URL(post.image, seo.canonicalUrl).href,
  })),
};
---

<BaseLayout seo={seo} schema={blogSchema}>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    eyebrow={blogPage.hero.eyebrow}
    description={blogPage.hero.lede}
    image={blogPage.hero.image}
    imageAlt={blogPage.hero.imageAlt}
    imagePosition={blogPage.hero.imagePosition}
    meta={blogPage.hero.issue}
    breadcrumbs={[{ label: 'Revista' }]}
  >
    <Fragment slot="title">
      <span set:html={blogPage.hero.title} />
    </Fragment>
  </PageHeader>

  <div class="blog-page">
    <BlogTopicNavigation categories={blogCategories} />

    <BlogFeedSection
      id="publicaciones"
      posts={journalPosts}
      section={blogSections.publications}
      titleId="blog-publications-title"
      afterNav
    />

    <EditorialSelectionSection posts={selection} section={blogSections.selection} />

    <BlogBrandCta
      image={featured.image}
      imagePosition={featured.imagePosition}
      section={blogSections.brandCta}
    />
  </div>

  <Footer slot="footer" connected />
</BaseLayout>
