---
import type { GetStaticPaths } from 'astro';
import ArticleReadingSection from '../../components/blog/ArticleReadingSection.astro';
import ArticleRelatedSection from '../../components/blog/ArticleRelatedSection.astro';
import BlogBrandCta from '../../components/blog/BlogBrandCta.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { blogPage, blogPosts, getBlogPostPath, type BlogPost } from '@content/blog';
import { siteUrl } from '@config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createPageSeo, toSeoImage } from '@shared/seo/page-head';
import {
  createBreadcrumbListSchema,
  createWebPageSchema,
  SITE_ORGANIZATION_ID,
} from '@shared/seo/structured-data';

export const prerender = true;

export const getStaticPaths = (() =>
  blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { sections: blogSections } = blogPage;
const seo = createPageSeo({
  title: `${post.title} — Revista KingBelt`,
  description: post.excerpt,
  pathname: getBlogPostPath(post),
  ogType: 'article',
  image: toSeoImage(post.image, post.imageAlt),
});
const sameCategory = blogPosts.filter(
  (candidate) => candidate.slug !== post.slug && candidate.category === post.category
);
const otherPosts = blogPosts.filter(
  (candidate) => candidate.slug !== post.slug && candidate.category !== post.category
);
const relatedPosts = [...sameCategory, ...otherPosts].slice(0, 3);
const articleSchema = {
  ...createWebPageSchema({
    type: 'BlogPosting',
    name: post.title,
    description: post.excerpt,
    url: seo.canonicalUrl,
    datePublished: post.date,
    dateModified: post.date,
  }),
  headline: post.title,
  image: new URL(post.image, siteUrl).href,
  mainEntityOfPage: seo.canonicalUrl,
  articleSection: post.category,
  author: { '@id': SITE_ORGANIZATION_ID },
};
const breadcrumbSchema = createBreadcrumbListSchema([
  { name: 'Revista', path: '/blog' },
  { name: post.title, path: getBlogPostPath(post) },
]);
---

<BaseLayout
  seo={seo}
  schema={[articleSchema, breadcrumbSchema]}
  publishedAt={post.date}
  updatedAt={post.date}
>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    titleId="article-hero-title"
    eyebrow="Revista KingBelt"
    description={post.excerpt}
    image={post.image}
    imageAlt={post.imageAlt}
    imagePosition={post.imagePosition}
    meta={blogPage.hero.issue}
    articleMeta={{
      category: post.category,
      date: post.dateLabel,
      readTime: post.readingTime,
    }}
    breadcrumbs={[{ label: 'Revista', href: '/blog' }, { label: post.category }]}
  >
    <Fragment slot="title">{post.title}</Fragment>
  </PageHeader>

  <div class="blog-article-page">
    <ArticleReadingSection post={post} section={blogSections.reading} />

    {relatedPosts.length > 0 && (
      <ArticleRelatedSection posts={relatedPosts} section={blogSections.related} />
    )}

    <BlogBrandCta
      image={post.image}
      imagePosition={post.imagePosition}
      section={blogSections.brandCta}
      article
    />
  </div>

  <Footer slot="footer" connected />
</BaseLayout>
