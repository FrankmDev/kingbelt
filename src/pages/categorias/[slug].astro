---
import CollectionCatalog from '../../components/collection/CollectionCatalog.astro';
import CollectionCategoryNav from '../../components/collection/CollectionCategoryNav.astro';
import CollectionPageHead from '../../components/collection/CollectionPageHead.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import { site, siteUrl } from '@config/site';
import { getCatalogProvider } from '@commerce/catalog';
import { CATALOG_INDEX_PATH } from '@commerce/application/paths';
import { resolveCollectionPageHead, type CommercePageHead } from '@commerce/application/seo';
import BaseLayout from '../../layouts/BaseLayout.astro';

const handle = Astro.params.slug;
if (!handle) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const catalogProvider = await getCatalogProvider(Astro.clientAddress);
const collectionPage = await catalogProvider.getCollectionByHandle(handle);
if (!collectionPage) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
// HTML anónimo y derivado del catálogo: caché CDN breve con revalidación.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');
const pageHead: CommercePageHead = resolveCollectionPageHead(collectionPage, site, siteUrl);
const { collection: category, products, facets } = collectionPage;
const categories = await catalogProvider.getCollections();
---

<BaseLayout seo={pageHead.seo} schema={pageHead.schema}>
  <Header slot="header" initialTheme="light" scrolledTheme="light" compactThreshold={32} />

  <CollectionPageHead
    eyebrow="Colección KingBelt"
    title={category.title}
    description={category.description}
    breadcrumbs={[{ label: 'Productos', href: CATALOG_INDEX_PATH }, { label: category.title }]}
  >
    <CollectionCategoryNav categories={categories} currentHandle={category.handle} />
  </CollectionPageHead>

  <CollectionCatalog category={category} products={products} facets={facets} />

  <Footer slot="footer" connected />
</BaseLayout>
