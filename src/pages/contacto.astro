---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ContactEmailBanner from '../components/sections/contact/ContactEmailBanner.astro';
import ContactFaqSection from '../components/sections/contact/ContactFaqSection.astro';
import ContactFormSection from '../components/sections/contact/ContactFormSection.astro';
import PurchaseInfo from '../components/sections/contact/PurchaseInfo.astro';
import { contactData } from '@content/contact';
import { confirmed, businessFacts } from '@config/business';
import { site } from '@config/site';
import { createPageSeo, toSeoImage } from '@shared/seo/page-head';
import {
  createBreadcrumbListSchema,
  createFaqPageSchema,
  createWebPageSchema,
} from '@shared/seo/structured-data';

const contactTitle = 'Contacto — KingBelt';
const contactDescription =
  'Contacta con KingBelt para consultas sobre producto, pedidos, colaboraciones y atención general.';
const seo = createPageSeo({
  title: contactTitle,
  description: contactDescription,
  pathname: '/contacto',
  image: toSeoImage(contactData.hero.image, contactData.hero.imageAlt),
});
const emailChannel = contactData.channels[0];
const legalName = confirmed(businessFacts.legalName);

const contactSchema = [
  {
    ...createWebPageSchema({
      type: 'ContactPage',
      name: contactTitle,
      description: contactDescription,
      url: seo.canonicalUrl,
    }),
    mainEntity: {
      '@type': 'Organization',
      name: site.name,
      ...(legalName ? { legalName } : {}),
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: emailChannel.value,
        ...(confirmed(businessFacts.phone)
          ? { telephone: confirmed(businessFacts.phone) }
          : {}),
        url: seo.canonicalUrl,
        availableLanguage: 'Spanish',
      },
    },
  },
  createFaqPageSchema(contactData.faqs, seo.canonicalUrl),
  createBreadcrumbListSchema([{ name: 'Contacto', path: '/contacto' }]),
];
---

<BaseLayout seo={seo} schema={contactSchema}>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    titleId="contact-hero-title"
    eyebrow={contactData.hero.eyebrow}
    description={contactData.hero.description}
    image={contactData.hero.image}
    imageAlt={contactData.hero.imageAlt}
    imagePosition={contactData.hero.imagePosition}
    meta={contactData.hero.meta}
    breadcrumbs={[{ label: 'Contacto' }]}
  >
    <Fragment slot="title">Hablemos de lo que <em>necesitas</em>.</Fragment>
  </PageHeader>

  <div class="contact-page">
    <ContactFormSection channels={contactData.channels} inquiryTypes={contactData.inquiryTypes} />

    <PurchaseInfo
      index="02"
      eyebrow={contactData.purchaseInfo.eyebrow}
      title={contactData.purchaseInfo.title}
      description={contactData.purchaseInfo.description}
      items={contactData.purchaseInfo.items}
      badge={contactData.purchaseInfo.badge}
      cta={contactData.purchaseInfo.cta}
      image={contactData.purchaseInfo.image}
    />

    <ContactFaqSection items={contactData.faqs} sidebar={contactData.faqSidebar} />

    <ContactEmailBanner
      eyebrow={contactData.emailBanner.eyebrow}
      title={contactData.emailBanner.title}
      description={contactData.emailBanner.description}
      email={emailChannel.value}
      ctaLabel={contactData.emailBanner.ctaLabel}
    />
  </div>

  <Footer slot="footer" connected />
</BaseLayout>

<style>
  .contact-page {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
</style>
