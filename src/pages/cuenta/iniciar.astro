---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountAccessPanel from '../../components/account/AccountAccessPanel.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getAccountAccessResponse } from '@commerce/commerce-navigation';
import { accountAccessPage } from '@content/account';
import { createPageSeo } from '@shared/seo/page-head';

const shopifyAccountResponse = getAccountAccessResponse();
if (shopifyAccountResponse) return shopifyAccountResponse;

const seo = createPageSeo({
  title: accountAccessPage.title,
  description: accountAccessPage.description,
  pathname: '/cuenta/iniciar',
  robots: 'noindex,nofollow',
});
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
---

<BaseLayout seo={seo}>
  <Header slot="header" initialTheme="light" scrolledTheme="light" compactThreshold={32} />

  <div class="account-page">
    <div class="account-page__frame">
      <Breadcrumbs items={[{ label: 'Acceder' }]} />
      <AccountAccessPanel />
    </div>
  </div>

  <Footer slot="footer" connected />
</BaseLayout>

<style>
  .account-page {
    display: flex;
    justify-content: center;
    padding:
      var(--kb-page-offset-top)
      var(--kb-gutter)
      var(--kb-space-12);
  }

  .account-page__frame {
    display: grid;
    gap: var(--kb-space-5);
    width: min(100%, 26.5rem);
    min-width: 0;
  }
</style>
