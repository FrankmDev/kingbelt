---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EditorialCtaSection from '../components/sections/EditorialCtaSection.astro';
import CareIntroSection from '../components/sections/help/CareIntroSection.astro';
import CareTopicsSection from '../components/sections/help/CareTopicsSection.astro';
import { carePage, careSections, helpHub, helpMeta } from '@content/help';
import { createPageSeo, toSeoImage } from '@shared/seo/page-head';
import { createBreadcrumbListSchema, createWebPageSchema } from '@shared/seo/structured-data';

const { title, description } = helpMeta.care;
const { hero, intro, chapters } = carePage;
const seo = createPageSeo({
  title,
  description,
  pathname: '/cuidados',
  image: toSeoImage(hero.image, hero.imageAlt),
});

const chapterItems = chapters.map((chapter) => ({
  chapter,
  items: chapter.itemIds.map((id) => {
    const item = careSections.find((section) => section.id === id);
    if (!item) {
      throw new Error(`Care topic not found: ${id}`);
    }
    return item;
  }),
}));

const careSchema = [
  createWebPageSchema({
    name: title,
    description,
    url: seo.canonicalUrl,
  }),
  createBreadcrumbListSchema([
    { name: 'Ayuda', path: '/ayuda' },
    { name: 'Cuidados', path: '/cuidados' },
  ]),
];
---

<BaseLayout seo={seo} schema={careSchema}>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    eyebrow={hero.eyebrow}
    description={hero.description}
    image={hero.image}
    imageAlt={hero.imageAlt}
    imagePosition={hero.imagePosition}
    meta={hero.meta}
    breadcrumbs={[{ label: 'Ayuda', href: '/ayuda' }, { label: 'Cuidados' }]}
  >
    <Fragment slot="title">
      <span set:html={hero.title} />
    </Fragment>
  </PageHeader>

  <CareIntroSection section={intro} />

  {chapterItems.map(({ chapter, items }) => (
    <CareTopicsSection chapter={chapter} items={items} />
  ))}

  <EditorialCtaSection cta={helpHub.cta} index="04" titleId="care-cta-title" />

  <Footer slot="footer" connected />
</BaseLayout>
