---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import FooterSection from '../components/layout/FooterSection.astro';
import LegalPageLayout from '../components/legal/LegalPageLayout.astro';
import LegalSection from '../components/legal/LegalSection.astro';
import WithdrawalForm from '../components/legal/WithdrawalForm.astro';
import Prose from '../components/ui/Prose.astro';
import { getLegalRobots, legalDocuments } from '../data/legal';

const doc = legalDocuments.desistimiento;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<BaseLayout
  title={doc.title}
  description={doc.description}
  canonicalURL={canonicalURL}
  robots={getLegalRobots(doc)}
>
  <Header slot="header" initialTheme="light" scrolledTheme="light" compactThreshold={32} />

  <LegalPageLayout
    document={doc}
    title="Formulario de desistimiento"
    description="Vista interna de revisión. El mecanismo electrónico no está activo."
    breadcrumbs={[{ label: 'Desistimiento' }]}
    showLegalNav={false}
    showContactCta={false}
  >
    <Prose variant="document">
      <LegalSection id="proceso" title="Proceso de desistimiento">
        <p>
          El consumidor dispone de un plazo para ejercer el derecho de desistimiento conforme a la normativa de consumo aplicable.
          Este formulario permitirá comunicar la decisión de desistir de forma inequívoca cuando el ecommerce esté operativo.
        </p>
        <p>
          <strong>Estado actual:</strong> mecanismo inactivo. No utilices esta ruta para solicitudes reales.
        </p>
      </LegalSection>

      <LegalSection id="datos-pedido" title="Datos del pedido">
        <p>Se solicitará: número de pedido, fecha de compra y productos afectados.</p>
      </LegalSection>

      <LegalSection id="identificacion" title="Identificación del cliente">
        <p>Se solicitará: nombre completo y email de contacto asociado al pedido.</p>
      </LegalSection>

      <LegalSection id="declaracion" title="Declaración inequívoca">
        <p>
          El formulario incluirá una declaración explícita de la voluntad de desistir del contrato,
          conforme al modelo previsto en la normativa de consumo.
        </p>
      </LegalSection>

      <LegalSection id="confirmacion" title="Confirmación">
        <p>
          Tras el envío, se mostrará un acuse de recibo y se enviará confirmación por el canal configurado.
          Actualmente no existe endpoint ni envío de email.
        </p>
      </LegalSection>
    </Prose>

    <div class="withdrawal-preview">
      <WithdrawalForm />
    </div>
  </LegalPageLayout>

  <FooterSection slot="footer" />
</BaseLayout>

<style>
  .withdrawal-preview {
    margin-top: 2rem;
  }
</style>
