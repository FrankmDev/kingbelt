---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import LegalPageLayout from '../components/legal/LegalPageLayout.astro';
import LegalSection from '../components/legal/LegalSection.astro';
import WithdrawalForm from '../components/legal/WithdrawalForm.astro';
import Prose from '../components/ui/Prose.astro';
import { legalDocuments, legalPages } from '@content/legal';
import { createLegalPageHead } from '@shared/seo/legal-page';

const doc = legalDocuments.desistimiento;
const page = legalPages.desistimiento;
const { seo, schema } = createLegalPageHead(doc, page);
---

<BaseLayout seo={seo} schema={schema}>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    eyebrow="Legal"
    description={page.lede}
    image={page.image}
    imageAlt={page.imageAlt}
    imagePosition={page.imagePosition}
    meta={page.meta}
    breadcrumbs={[{ label: page.heading }]}
  >
    <Fragment slot="title">
      <span set:html={page.titleHtml} />
    </Fragment>
  </PageHeader>

  <LegalPageLayout
    document={doc}
    section={page.section}
    relatedNav="none"
    showContactCta={false}
  >
    <Prose variant="document">
      <LegalSection id="proceso" title="Proceso de desistimiento" documentStatus={doc.status}>
        <p>
          El consumidor dispone de un plazo para ejercer el derecho de desistimiento conforme a la normativa de consumo aplicable.
          Este formulario permitirá comunicar la decisión de desistir de forma inequívoca cuando el ecommerce esté operativo.
        </p>
        <p>
          <strong>Estado actual:</strong> mecanismo inactivo. No utilices esta ruta para solicitudes reales.
        </p>
      </LegalSection>

      <LegalSection id="datos-pedido" title="Datos del pedido" documentStatus={doc.status}>
        <p>Se solicitará: número de pedido, fecha de compra y productos afectados.</p>
      </LegalSection>

      <LegalSection id="identificacion" title="Identificación del cliente" documentStatus={doc.status}>
        <p>Se solicitará: nombre completo y email de contacto asociado al pedido.</p>
      </LegalSection>

      <LegalSection id="declaracion" title="Declaración inequívoca" documentStatus={doc.status}>
        <p>
          El formulario incluirá una declaración explícita de la voluntad de desistir del contrato,
          conforme al modelo previsto en la normativa de consumo.
        </p>
      </LegalSection>

      <LegalSection id="confirmacion" title="Confirmación" documentStatus={doc.status}>
        <p>
          Tras el envío, se mostrará un acuse de recibo y se enviará confirmación por el canal configurado.
          Actualmente no existe endpoint ni envío de email.
        </p>
      </LegalSection>
    </Prose>

    <div class="withdrawal-preview">
      <WithdrawalForm />
    </div>
  </LegalPageLayout>

  <Footer slot="footer" connected />
</BaseLayout>

<style>
  .withdrawal-preview {
    margin-top: var(--kb-space-gap);
  }
</style>
