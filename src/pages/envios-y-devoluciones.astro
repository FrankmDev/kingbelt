---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import LegalPageLayout from '../components/legal/LegalPageLayout.astro';
import LegalSection from '../components/legal/LegalSection.astro';
import Prose from '../components/ui/Prose.astro';
import { getLegalRobots, legalDocuments } from '@content/legal';
import { shippingPage } from '@content/help';
import { confirmed, businessFacts } from '@config/business';
import { site } from '@config/site';

const doc = legalDocuments.envios;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const email = confirmed(businessFacts.email) ?? site.contact.email;
const { hero, section } = shippingPage;
---

<BaseLayout
  title={doc.title}
  description={doc.description}
  canonicalURL={canonicalURL}
  robots={getLegalRobots(doc)}
>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    eyebrow={hero.eyebrow}
    description={hero.description}
    image={hero.image}
    imageAlt={hero.imageAlt}
    imagePosition={hero.imagePosition}
    meta={hero.meta}
    breadcrumbs={[{ label: 'Ayuda', href: '/ayuda' }, { label: 'Envíos y devoluciones' }]}
  >
    <Fragment slot="title">
      <span set:html={hero.title} />
    </Fragment>
  </PageHeader>

  <LegalPageLayout document={doc} section={section} relatedNav="help" ctaIndex="02">
    <Prose variant="document">
      {doc.sections.map((item) => (
        <LegalSection
          id={item.id}
          title={item.title}
          pending={item.id !== 'contacto'}
        >
          {item.id === 'contacto' && (
            <p>
              Para consultas sobre envíos o devoluciones, escríbenos a{' '}
              <a href={`mailto:${email}`}>{email}</a> o visita la página de{' '}
              <a href="/contacto">contacto</a>.
            </p>
          )}
        </LegalSection>
      ))}
    </Prose>
  </LegalPageLayout>

  <Footer slot="footer" connected />
</BaseLayout>
