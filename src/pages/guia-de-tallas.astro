---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import EditorialCtaSection from '../components/sections/EditorialCtaSection.astro';
import SizeGuideIntroSection from '../components/sections/help/SizeGuideIntroSection.astro';
import SizeGuideMethodsSection from '../components/sections/help/SizeGuideMethodsSection.astro';
import SizeGuideDiagramSection from '../components/sections/help/SizeGuideDiagramSection.astro';
import SizeGuideTableSection from '../components/sections/help/SizeGuideTableSection.astro';
import SizeGuideMistakesSection from '../components/sections/help/SizeGuideMistakesSection.astro';
import SizeGuideFaqSection from '../components/sections/help/SizeGuideFaqSection.astro';
import {
  helpHub,
  helpMeta,
  sizeGuidePage,
  sizeGuideMethods,
  sizeGuideMistakes,
  sizeGuideFaqs,
  getHelpRobots,
} from '@content/help';

const { title, description } = helpMeta.sizeGuide;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const { hero, intro, methods, diagram, table, mistakes, faq } = sizeGuidePage;
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  robots={getHelpRobots(helpMeta.sizeGuide)}
>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    eyebrow={hero.eyebrow}
    description={hero.description}
    image={hero.image}
    imageAlt={hero.imageAlt}
    imagePosition={hero.imagePosition}
    meta={hero.meta}
    breadcrumbs={[{ label: 'Ayuda', href: '/ayuda' }, { label: 'Guía de tallas' }]}
  >
    <Fragment slot="title">
      <span set:html={hero.title} />
    </Fragment>
  </PageHeader>

  <SizeGuideIntroSection section={intro} />
  <SizeGuideMethodsSection section={methods} methods={sizeGuideMethods} />
  <SizeGuideDiagramSection section={diagram} />
  <SizeGuideTableSection section={table} />
  <SizeGuideMistakesSection section={mistakes} items={sizeGuideMistakes} />
  <SizeGuideFaqSection section={faq} items={sizeGuideFaqs} />

  <EditorialCtaSection cta={helpHub.cta} index="07" titleId="size-guide-cta-title" />

  <Footer slot="footer" connected />
</BaseLayout>
