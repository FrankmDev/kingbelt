---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroHome from '../components/sections/home/HeroHome.astro';
import HomeBrandStatement from '../components/sections/home/HomeBrandStatement.astro';
import HomeCategoriesSection from '../components/sections/home/HomeCategoriesSection.astro';
import HomeFeaturedProducts from '../components/sections/home/HomeFeaturedProducts.astro';
import HomeProductStandards from '../components/sections/home/HomeProductStandards.astro';
import HomeStyleBanner from '../components/sections/home/HomeStyleBanner.astro';
import HomeJournalSection from '../components/sections/home/HomeJournalSection.astro';
import HomeTrustSection from '../components/sections/home/HomeTrustSection.astro';
import HomeClosingCta from '../components/sections/home/HomeClosingCta.astro';
import { blogPosts } from '@content/blog';
import { categoriesSection } from '@content/home';
import { site } from '@config/site';
import { getCatalogProvider } from '@commerce/catalog';
import { createPageSeo, toSeoImage } from '@shared/seo/page-head';
import { createWebPageSchema } from '@shared/seo/structured-data';

const homeTitle = `${site.name} — Cinturones de cuero con criterio`;
const homeDescription =
  'KingBelt selecciona cinturones masculinos con criterio: cuero, herrajes y proporción pensados para el día a día. Explora categorías, selección y revista.';
const seo = createPageSeo({
  title: homeTitle,
  description: homeDescription,
  pathname: '/',
  image: toSeoImage(
    '/images/imagen-cinturon-kingbelt-9.avif',
    'Cinturones de cuero negro y marrón KingBelt con costura en contraste'
  ),
});
const homeSchema = createWebPageSchema({
  name: homeTitle,
  description: homeDescription,
  url: seo.canonicalUrl,
});
const featuredPost = blogPosts.find((post) => post.status === 'featured') ?? blogPosts[0];
const secondaryPosts = blogPosts
  .filter((post) => post.slug !== featuredPost.slug)
  .slice(0, 4);
const journalPosts = [featuredPost, ...secondaryPosts];
const catalogProvider = await getCatalogProvider(Astro.clientAddress);
const featuredProducts = await catalogProvider.getFeaturedProducts(4);
const productCategories = categoriesSection.enabled
  ? await catalogProvider.getCollections()
  : [];
// HTML anónimo derivado del catálogo: caché CDN breve; un redeploy purga.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');
---

<BaseLayout seo={seo} schema={homeSchema}>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={48} />

  <HeroHome />
  <HomeFeaturedProducts products={featuredProducts} />
  {categoriesSection.enabled && <HomeCategoriesSection categories={productCategories} />}
  <HomeBrandStatement />
  <HomeProductStandards />
  <HomeStyleBanner />
  <HomeJournalSection posts={journalPosts} />
  <HomeTrustSection />
  <HomeClosingCta />

  <Footer slot="footer" connected />
</BaseLayout>
