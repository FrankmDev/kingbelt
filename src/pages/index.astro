---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroHome from '../components/sections/home/HeroHome.astro';
import HomeBrandStatement from '../components/sections/home/HomeBrandStatement.astro';
import HomeCategoriesSection from '../components/sections/home/HomeCategoriesSection.astro';
import HomeFeaturedProducts from '../components/sections/home/HomeFeaturedProducts.astro';
import HomeProductStandards from '../components/sections/home/HomeProductStandards.astro';
import HomeStyleBanner from '../components/sections/home/HomeStyleBanner.astro';
import HomeJournalSection from '../components/sections/home/HomeJournalSection.astro';
import HomeTrustSection from '../components/sections/home/HomeTrustSection.astro';
import HomeClosingCta from '../components/sections/home/HomeClosingCta.astro';
import { blogPosts } from '@content/blog';
import { site } from '@config/site';
import { catalogProvider } from '@commerce/catalog';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const featuredPost = blogPosts.find((post) => post.status === 'featured') ?? blogPosts[0];
const journalPosts = [featuredPost, blogPosts[1], blogPosts[2]].filter(Boolean);
const featuredProducts = await catalogProvider.getFeaturedProducts(4);
const productCategories = await catalogProvider.getCollections();

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  description: site.description,
  url: canonicalURL,
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: Astro.site ?? Astro.url.origin,
  },
};
---

<BaseLayout
  title={`${site.name} — Cinturones de cuero con criterio`}
  description="KingBelt selecciona cinturones masculinos con criterio: cuero, herrajes y proporción pensados para el día a día. Explora categorías, selección y revista."
  image="/images/brand/cinturones-en-taller.jpg"
  imageAlt="Cinturón de cuero KingBelt"
  canonicalURL={canonicalURL}
  schema={homeSchema}
>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={48} />

  <HeroHome />
  <HomeFeaturedProducts products={featuredProducts} />
  <HomeCategoriesSection categories={productCategories} />
  <HomeBrandStatement />
  <HomeProductStandards />
  <HomeStyleBanner />
  <HomeJournalSection posts={journalPosts} />
  <HomeTrustSection />
  <HomeClosingCta />

  <Footer slot="footer" connected />
</BaseLayout>
