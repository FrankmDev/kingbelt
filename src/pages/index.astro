import HeroSection from "../sections/HeroSection.astro";
import ProductGrid from "../sections/ProductGrid.astro";
import BrandSection from "../sections/BrandSection.astro";
import BuyingSection from "../sections/BuyingSection.astro";
import MarqueeSection from "../sections/MarqueeSection.astro";
import FooterSection from "../components/layout/FooterSection.astro";
---

<BaseLayout>
    <Header slot="header" />
    <HeroSection />
    <ProductGrid />
    <BrandSection />
    <BuyingSection />
    <MarqueeSection />
    <FooterSection slot="footer" />
</BaseLayout>
