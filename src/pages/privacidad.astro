---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import LegalPageLayout from '../components/legal/LegalPageLayout.astro';
import LegalDocumentView from '../components/legal/LegalDocumentView.astro';
import LegalBlocks from '../components/legal/LegalBlocks.astro';
import PrivacySummary from '../components/legal/PrivacySummary.astro';
import Prose from '../components/ui/Prose.astro';
import { getLegalRobots, legalDocuments, legalPages } from '@content/legal';
import { privacidadBody } from '@content/legal-bodies';

const doc = legalDocuments.privacidad;
const page = legalPages.privacidad;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<BaseLayout
  title={doc.title}
  description={doc.description}
  canonicalURL={canonicalURL}
  robots={getLegalRobots(doc)}
>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    eyebrow="Legal"
    description={page.lede}
    image={page.image}
    imageAlt={page.imageAlt}
    imagePosition={page.imagePosition}
    meta={page.meta}
    breadcrumbs={[{ label: page.heading }]}
  >
    <Fragment slot="title">
      <span set:html={page.titleHtml} />
    </Fragment>
  </PageHeader>

  <LegalPageLayout document={doc} section={page.section}>
    <Fragment slot="intro">
      <div class="legal-privacy-intro">
        <PrivacySummary />
        {privacidadBody.intro && (
          <Prose variant="document">
            <LegalBlocks blocks={privacidadBody.intro} />
          </Prose>
        )}
      </div>
    </Fragment>
    <LegalDocumentView documentKey="privacidad" />
  </LegalPageLayout>

  <Footer slot="footer" connected />
</BaseLayout>

<style>
  .legal-privacy-intro {
    display: grid;
    gap: var(--kb-space-5);
  }
</style>
