---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import FooterSection from '../../components/layout/FooterSection.astro';
import ProductVisualImage from '../../components/product/ProductVisualImage.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import SectionHeader from '../../components/common/SectionHeader.astro';
import { products, getProductBySlug, getRelatedProducts, type ProductImage } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug || '');

if (!product) {
  return Astro.redirect('/404');
}

const related = getRelatedProducts(product.slug, 3);
const pageTitle = `${product.name} — KingBelt`;
const pageDescription = product.shortDescription;

const defaultColorName = product.colors[0]?.name || '';
const defaultColorHex = product.colors[0]?.hex || '#8A6A3D';
const whatsappUrl = `https://wa.me/1234567890?text=${encodeURIComponent(product.whatsappMessage)}`;

const isLocalImage = (image: ProductImage): image is ImageMetadata => typeof image !== 'string';
const rawImageSrc = (image: ProductImage) => (isLocalImage(image) ? image.src : image);
const perspectiveLabel = (index: number) => (index === 0 ? 'Portada' : `Perspectiva ${index}`);

const resolveMainImage = async (image: ProductImage) => {
  if (!isLocalImage(image)) return rawImageSrc(image);

  const optimized = await getImage({
    src: image,
    width: 1400,
    format: 'webp',
    quality: 86,
  });

  return optimized.src;
};

const galleryColors = (
  await Promise.all(
    product.colors.map(async (color) => {
      const assets = product.colorImages[color.name]?.length
        ? product.colorImages[color.name]
        : product.images;

      const images = await Promise.all(
        assets.map(async (asset, index) => ({
          asset,
          src: await resolveMainImage(asset),
          width: isLocalImage(asset) ? asset.width : 800,
          height: isLocalImage(asset) ? asset.height : 1000,
          alt: `${product.name} — ${perspectiveLabel(index).toLowerCase()}, acabado ${color.name}`,
          view: perspectiveLabel(index),
        })),
      );

      return {
        name: color.name,
        hex: color.hex,
        images,
      };
    }),
  )
).filter((color) => color.images.length > 0);

const fallbackImage = product.images[0];
const defaultGalleryColor = galleryColors[0];
const defaultGalleryImage = defaultGalleryColor?.images[0];
const defaultMainAsset = defaultGalleryImage?.asset ?? fallbackImage;
const defaultMainSrc = defaultGalleryImage?.src ?? rawImageSrc(fallbackImage);
const defaultMainAlt = defaultGalleryImage?.alt ?? `${product.name} — cinturón de cuero`;

const galleryPayload = galleryColors.map((color) => ({
  name: color.name,
  hex: color.hex,
  images: color.images.map(({ src, width, height, alt, view }) => ({
    src,
    width,
    height,
    alt,
    view,
  })),
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.shortDescription,
  image: defaultMainSrc,
  brand: {
    '@type': 'Brand',
    name: 'KingBelt',
  },
  offers: {
    '@type': 'Offer',
    url: product.amazonUrl,
    availability: 'https://schema.org/InStock',
    priceCurrency: 'EUR',
  },
};
---

<BaseLayout title={pageTitle} description={pageDescription} schema={schema}>
  <Header slot="header" initialTheme="light" scrolledTheme="light" compactThreshold={36} />

  <main class="relative overflow-hidden bg-king-bg" data-gsap-product-page>
    {/* Ambient background grid */}
    <div class="product-bg pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute right-[-10rem] top-24 h-[32rem] w-[32rem] rounded-full bg-king-accent/[0.06] blur-[145px]"></div>

    <div class="kb-shell-wide relative flex min-h-[100dvh] flex-col pb-16 pt-24 md:pb-24 md:pt-28">
      {/* ===== Breadcrumb ===== */}
      <nav class="product-breadcrumb mb-4 md:mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-[10px] uppercase tracking-[0.25em] text-king-muted/50">
          <li>
            <a href="/" class="inline-flex items-center gap-1.5 transition-colors duration-300 hover:text-king-accent">
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              Inicio
            </a>
          </li>
          <li class="text-king-border/60">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          <li><a href="/#coleccion" class="transition-colors duration-300 hover:text-king-accent">Colección</a></li>
          <li class="text-king-border/60">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          <li class="font-medium text-king-text">{product.name}</li>
        </ol>
      </nav>

      {/* ===== Main product grid ===== */}
      <div class="product-main-grid grid flex-1 grid-cols-1 items-stretch gap-8 lg:grid-cols-12 lg:gap-10">
        {/* LEFT: Sticky gallery */}
        <div
          class="lg:col-span-7"
          data-product-gallery
          data-gallery-colors={JSON.stringify(galleryPayload)}
          data-default-color-index="0"
          data-default-image-index="0"
        >
          <div
            class="product-gallery-frame relative aspect-[4/3] overflow-hidden lg:max-h-[65vh] lg:min-h-0"
            style={`--product-gallery-accent: ${defaultColorHex};`}
          >
            {/* Dark base + cinematic gradients */}
            <div class="absolute inset-0 bg-[#14110d]"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/72 via-black/22 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-black/48 via-transparent to-transparent"></div>
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(138,106,61,0.08),transparent_40%)]"></div>

            {/* Inner frame border */}
            <div class="pointer-events-none absolute inset-4 rounded-[calc(var(--kb-radius-lg)-0.5rem)] border border-white/[0.07] md:inset-5"></div>

            {/* Stitch line effect */}
            <div class="pointer-events-none absolute inset-5 rounded-[calc(var(--kb-radius-lg)-0.75rem)] border border-dashed border-white/[0.04] md:inset-6"></div>

            {/* Corner frames */}
            <div class="absolute inset-5 z-10 pointer-events-none md:inset-6">
              <span class="kb-corner-frame absolute left-0 top-0 opacity-60"></span>
              <span class="kb-corner-frame absolute right-0 top-0 opacity-60" style="transform: scaleX(-1);"></span>
              <span class="kb-corner-frame absolute bottom-0 left-0 opacity-60" style="transform: scaleY(-1);"></span>
              <span class="kb-corner-frame absolute bottom-0 right-0 opacity-60" style="transform: scale(-1);"></span>
            </div>

            {/* Product ID */}
            <div class="absolute right-5 top-5 z-10 md:right-6 md:top-6">
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/25">{product.id}</span>
            </div>

            {/* Badge */}
            {product.badge && (
              <div class="absolute left-5 top-5 z-10 md:left-6 md:top-6">
                <Badge type={product.badge === 'new' ? 'new' : 'bestseller'} />
              </div>
            )}

            {/* Main image */}
            {
              isLocalImage(defaultMainAsset) ? (
                <Image
                  src={defaultMainAsset}
                  alt={defaultMainAlt}
                  class="product-main-image relative z-[1] h-full w-full object-cover object-center transition-opacity duration-300"
                  loading="eager"
                  sizes="(min-width: 1024px) 58vw, 100vw"
                  format="webp"
                  quality={86}
                />
              ) : (
                <img
                  src={defaultMainSrc}
                  width={defaultGalleryImage?.width ?? 800}
                  height={defaultGalleryImage?.height ?? 1000}
                  alt={defaultMainAlt}
                  class="product-main-image relative z-[1] h-full w-full object-cover object-center transition-opacity duration-300"
                  loading="eager"
                />
              )
            }

            {/* Bottom fade */}
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/55 to-transparent"></div>
          </div>

          {galleryColors.length > 0 && (
            <div class="mt-2.5" data-gallery-thumbnails>
              {galleryColors.map((color, colorIndex) => (
                <div
                  class:list={[
                    'gallery-thumb-set grid grid-cols-4 gap-1.5 md:grid-cols-5 md:gap-2',
                    colorIndex === 0 ? '' : 'hidden',
                  ]}
                  data-thumb-set
                  data-color-index={colorIndex}
                >
                  {color.images.map((image, imageIndex) => (
                    <button
                      class:list={[
                        'gallery-thumb group relative aspect-[3/2] overflow-hidden rounded-[var(--kb-radius-sm)] border bg-king-secondary transition-all duration-300',
                        colorIndex === 0 && imageIndex === 0
                          ? 'border-king-accent opacity-100'
                          : 'border-king-border/50 opacity-70 hover:border-king-accent/50 hover:opacity-100',
                      ]}
                      data-gallery-thumb
                      data-color-index={colorIndex}
                      data-image-index={imageIndex}
                      data-active={colorIndex === 0 && imageIndex === 0 ? 'true' : 'false'}
                      type="button"
                      aria-label={`${color.name}: ${image.view}`}
                    >
                      {
                        isLocalImage(image.asset) ? (
                          <Image
                            src={image.asset}
                            alt={image.alt}
                            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                            loading={colorIndex === 0 ? 'eager' : 'lazy'}
                            width={220}
                            height={220}
                            format="webp"
                            quality={72}
                          />
                        ) : (
                          <img
                            src={image.src}
                            alt={image.alt}
                            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                            loading={colorIndex === 0 ? 'eager' : 'lazy'}
                          />
                        )
                      }
                      <span class="pointer-events-none absolute bottom-1 left-1 rounded-full border border-white/12 bg-black/45 px-1.5 py-0.5 text-[8px] uppercase tracking-[0.16em] text-white/70 backdrop-blur-sm">
                        {image.view}
                      </span>
                    </button>
                  ))}
                </div>
              ))}
            </div>
          )}
        </div>

        {/* RIGHT: Product info */}
        <div class="product-info-col relative flex flex-col lg:col-span-5 lg:justify-between" data-product-info>
          {/* Decorative corner accents */}
          <div class="pointer-events-none absolute -top-2 -left-2 hidden h-6 w-6 border-t border-l border-king-accent/40 lg:block"></div>
          <div class="pointer-events-none absolute -bottom-2 -right-2 hidden h-6 w-6 border-b border-r border-king-accent/40 lg:block"></div>

          <span class="product-id eyebrow-text mb-2 text-king-muted/45">{product.id}</span>

          <h1 class="product-title font-display text-[2rem] leading-[1] tracking-[-0.02em] text-king-text sm:text-[2.25rem] md:text-[2.75rem] lg:text-[3rem]">
            {product.name}
          </h1>

          <div class="product-divider my-5 flex items-center gap-3">
            <span class="h-px flex-1 bg-king-border"></span>
            <span class="kb-divider-dot"></span>
            <span class="h-px flex-1 bg-king-border"></span>
          </div>

          {/* Color selector */}
          <div class="product-selector mb-6" data-color-selector>
            <div class="mb-4 flex items-center gap-3">
              <span class="kb-eyebrow text-king-text">Color</span>
              <span class="h-px w-6 bg-king-border"></span>
              <span class="color-name text-[13px] font-medium tracking-wide text-king-accent">{defaultColorName}</span>
            </div>
            <div class="flex items-center gap-3">
              {product.colors.map((color, i) => (
                <button
                  class:list={[
                    'color-swatch group relative h-8 w-8 rounded-full border-2 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]',
                    i === 0 ? 'border-king-accent scale-110 shadow-[0_0_0_4px_rgba(156,114,56,0.12)]' : 'border-king-border/50 hover:border-king-accent/70 hover:scale-105',
                  ]}
                  data-color-index={i}
                  data-active={i === 0 ? 'true' : 'false'}
                  type="button"
                  aria-label={`Color: ${color.name}`}
                  title={color.name}
                >
                  <span class="absolute inset-[3px] rounded-full shadow-[inset_0_1px_2px_rgba(0,0,0,0.15)]" style={`background-color: ${color.hex};`}></span>
                  {/* Active indicator ring */}
                  <span class:list={[
                    'absolute -inset-1 rounded-full border border-king-accent/20 transition-all duration-500',
                    i === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100'
                  ]}></span>
                </button>
              ))}
            </div>
          </div>

          {/* Description */}
          <div class="product-description mb-6">
            <p class="max-w-lg text-sm leading-relaxed text-king-text/80">
              {product.description}
            </p>
          </div>

          {/* Materials */}
          <div class="product-materials mb-6">
            <span class="kb-eyebrow mb-3 block text-king-text">Materiales</span>
            <ul class="space-y-2">
              {product.materials.map((mat) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-king-muted">
                  <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-king-accent/40"></span>
                  {mat}
                </li>
              ))}
            </ul>
          </div>

          {/* Sizes */}
          <div class="product-sizes mb-8">
            <div class="mb-4 flex items-center gap-3">
              <span class="kb-eyebrow text-king-text">Tallas disponibles</span>
              <span class="h-px w-6 bg-king-border"></span>
              <span class="size-name text-[13px] font-medium tracking-wide text-king-accent">{product.sizes[0]} cm</span>
            </div>
            <div class="flex flex-wrap gap-2" data-size-selector>
              {product.sizes.map((size, index) => (
                <button
                  class:list={[
                    'size-btn relative overflow-hidden rounded-full border px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]',
                    index === 0
                      ? 'border-king-accent bg-king-accent/5 text-king-accent'
                      : 'border-king-border/50 text-king-muted/80 hover:border-king-accent/50 hover:text-king-text',
                  ]}
                  data-size={size}
                  data-active={index === 0 ? 'true' : undefined}
                  type="button"
                >
                  <span class="relative z-10">{size} <span class="text-[9px] opacity-60">cm</span></span>
                  {/* Hover fill */}
                  <span class="absolute inset-0 origin-bottom scale-y-0 bg-king-accent/[0.06] transition-transform duration-500 group-hover:scale-y-100"></span>
                </button>
              ))}
            </div>
          </div>

          {/* Trust badge */}
          <div class="mb-6 flex items-center gap-3 rounded-[var(--kb-radius-sm)] border border-king-border/40 bg-king-surface/50 p-3 backdrop-blur-sm">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-king-accent/20 bg-king-accent/5">
              <svg class="h-3.5 w-3.5 text-king-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.15em] text-king-text">Garantía de artesanía</p>
              <p class="text-[11px] text-king-muted/70">Cuero 100% natural. Hecho a mano en España.</p>
            </div>
          </div>

          {/* Actions */}
          <div class="product-actions grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            <Button
              href={product.amazonUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="primary"
              size="sm"
              class="w-full"
            >
              Comprar en Amazon
              <svg class="h-3 w-3 transition-transform duration-500 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </Button>
            <Button
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              variant="outline"
              size="sm"
              class="w-full"
            >
              Pedir al fabricante
            </Button>
          </div>
        </div>
      </div>

      {/* Decorative section divider */}
      <div class="relative my-8 flex items-center justify-center md:my-12">
        <span class="h-px w-full max-w-[10rem] bg-gradient-to-r from-transparent via-king-border to-transparent"></span>
        <span class="mx-4 h-1.5 w-1.5 rounded-full border border-king-accent/30 bg-king-accent/10"></span>
        <span class="h-px w-full max-w-[10rem] bg-gradient-to-r from-transparent via-king-border to-transparent"></span>
      </div>

      {/* ===== Features ===== */}
      <div class="product-features section-spacing-lg relative">
        <div class="absolute left-1/2 top-0 h-px w-[120%] -translate-x-1/2 bg-gradient-to-r from-transparent via-king-accent/30 to-transparent"></div>

        <SectionHeader
          eyebrow="Ficha técnica"
          body="Cada modelo se construye sobre los mismos principios: materiales honestos, acabado manual y una estética que mejora con el uso."
          meta={product.id}
        >
          <Fragment slot="title">
            Detalles
            <span class="block italic text-king-accent">artesanales.</span>
          </Fragment>
        </SectionHeader>

        <div class="feature-grid mt-10 grid grid-cols-1 gap-5 md:mt-14 md:grid-cols-2 lg:grid-cols-4">
          {product.features.slice(0, 4).map((feature, index) => (
            <div class="feature-card group relative overflow-hidden rounded-[var(--kb-radius-lg)] border border-king-border/50 bg-king-surface/40 p-8 backdrop-blur-sm transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-king-accent/25 hover:bg-king-surface/70 hover:shadow-[0_28px_80px_rgba(18,15,12,0.06)] md:p-10">
              {/* Top gold accent line */}
              <div class="absolute left-0 right-0 top-0 h-px bg-[linear-gradient(90deg,transparent_0%,var(--color-king-accent)_50%,transparent_100%)] opacity-0 transition-opacity duration-700 group-hover:opacity-40"></div>

              {/* Corner frames on hover */}
              <div class="absolute inset-5 pointer-events-none opacity-0 transition-opacity duration-700 group-hover:opacity-100 md:inset-6">
                <span class="kb-corner-frame absolute left-0 top-0" style="opacity:0.5;"></span>
                <span class="kb-corner-frame absolute right-0 top-0" style="transform: scaleX(-1); opacity:0.5;"></span>
                <span class="kb-corner-frame absolute bottom-0 left-0" style="transform: scaleY(-1); opacity:0.5;"></span>
                <span class="kb-corner-frame absolute bottom-0 right-0" style="transform: scale(-1); opacity:0.5;"></span>
              </div>

              {/* Icon */}
              <div class="relative mb-6 flex h-12 w-12 items-center justify-center rounded-full border border-king-accent/20 bg-king-accent/5 text-king-accent transition-all duration-500 group-hover:scale-110 group-hover:border-king-accent/30 group-hover:bg-king-accent/10">
                {index === 0 && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                  </svg>
                )}
                {index === 1 && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M12 2v4m0 12v4" />
                    <path d="M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4" />
                    <path d="M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83" />
                  </svg>
                )}
                {index === 2 && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 3l4 4-4 4" />
                    <path d="M21 7H9a4 4 0 00-4 4v1" />
                    <path d="M13 17l-4 4-4-4" />
                    <path d="M9 21V10" />
                  </svg>
                )}
                {index === 3 && (
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="M9 12l2 2 4-4" />
                  </svg>
                )}
              </div>

              {/* Number label */}
              <div class="mb-4 flex items-center gap-3">
                <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-king-accent/60">0{index + 1}</span>
                <span class="h-px w-6 bg-king-accent/20 transition-all duration-500 group-hover:w-10"></span>
              </div>

              {/* Feature text */}
              <p class="relative text-[14px] leading-[1.7] text-king-text/85">
                {feature}
              </p>
            </div>
          ))}
        </div>
      </div>

      {/* ===== Related products ===== */}
      {related.length > 0 && (
        <div class="product-related section-spacing-lg relative">
          <div class="absolute left-0 right-0 top-0 flex items-center justify-center">
            <span class="h-px w-full max-w-[6rem] bg-gradient-to-r from-transparent via-king-accent/40 to-transparent"></span>
          </div>

          <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
            <SectionHeader
              eyebrow="Colección"
              body="Descubre otros cinturones construidos con la misma filosofía."
              meta={`${related.length} modelos`}
              class="flex-1"
            >
              <Fragment slot="title">
                Más modelos,
                <span class="block italic text-king-accent">misma actitud.</span>
              </Fragment>
            </SectionHeader>
            <a
              href="/#coleccion"
              class="group relative inline-flex shrink-0 items-center gap-3 overflow-hidden rounded-full border border-king-border/60 bg-king-surface/60 px-5 py-2.5 text-[10px] font-semibold uppercase tracking-[0.22em] text-king-muted/60 backdrop-blur-sm transition-all duration-500 hover:border-king-accent/40 hover:text-king-accent"
            >
              <span class="relative z-10">Ver todo</span>
              <span class="relative z-10 inline-block h-px w-4 bg-current transition-all duration-500 group-hover:w-7"></span>
              <span class="absolute inset-0 origin-bottom scale-y-0 bg-king-accent/5 transition-transform duration-500 group-hover:scale-y-100"></span>
            </a>
          </div>

          <div class="mt-10 grid grid-cols-1 gap-5 md:mt-14 md:grid-cols-3 md:gap-6">
            {related.map((p) => {
              const pPrimary = p.images[0];
              const pHover = p.images[1] ?? pPrimary;
              const badgeType = (badge?: string) => {
                if (badge === 'bestseller') return 'bestseller';
                if (badge === 'new') return 'new';
                return 'default';
              };
              return (
                <a
                  href={`/product/${p.slug}`}
                  class="pg-card group relative block overflow-hidden rounded-[var(--kb-radius-lg)]"
                  data-related-card
                >
                  <div class="relative aspect-[5/5.8] overflow-hidden">
                    {/* Primary image */}
                    <ProductVisualImage
                      src={pPrimary}
                      alt={`${p.name} — cinturón de cuero`}
                      class="pg-card-img absolute inset-0 h-full w-full object-cover"
                      loading="lazy"
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      format="webp"
                      quality={84}
                    />
                    {/* Hover image */}
                    <ProductVisualImage
                      src={pHover}
                      alt={`${p.name} detalle`}
                      class="pg-card-hover-img absolute inset-0 h-full w-full scale-[1.06] object-cover opacity-0"
                      loading="lazy"
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      format="webp"
                      quality={82}
                    />

                    {/* Cinematic overlays */}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>
                    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-transparent"></div>
                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(138,106,61,0.10),transparent_50%)] opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>

                    {/* Shimmer */}
                    <div class="pg-shimmer absolute inset-0 opacity-0"></div>

                    {/* Inner frame border */}
                    <div class="pointer-events-none absolute inset-3 rounded-[calc(var(--kb-radius-lg)-0.5rem)] border border-white/[0.06] transition-colors duration-700 group-hover:border-white/[0.14] md:inset-5"></div>

                    {/* Corner accents */}
                    <div class="pointer-events-none absolute inset-4 z-10 md:inset-6">
                      <span class="kb-corner-frame absolute left-0 top-0"></span>
                      <span class="kb-corner-frame absolute right-0 top-0" style="transform: scaleX(-1);"></span>
                      <span class="kb-corner-frame absolute bottom-0 left-0" style="transform: scaleY(-1);"></span>
                      <span class="kb-corner-frame absolute bottom-0 right-0" style="transform: scale(-1);"></span>
                    </div>

                    {/* Top bar: badge + ID */}
                    <div class="absolute left-4 right-4 top-4 z-10 flex items-start justify-between md:left-6 md:right-6 md:top-6">
                      <Badge type={badgeType(p.badge)} />
                      <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40">
                        {p.id}
                      </span>
                    </div>

                    {/* Top accent line */}
                    <div class="absolute left-0 right-0 top-0 h-px bg-[linear-gradient(90deg,transparent_0%,var(--color-king-accent)_50%,transparent_100%)] opacity-0 transition-opacity duration-500 group-hover:opacity-50"></div>

                    {/* Bottom info */}
                    <div class="absolute bottom-0 left-0 right-0 z-10 p-4 md:p-6">
                      <div class="pg-card-line mb-3 h-px w-8 bg-king-accent/80"></div>

                      <h3 class="font-display text-[1.5rem] font-light leading-[0.95] tracking-[-0.01em] md:text-[1.75rem]">
                        {p.name}
                      </h3>

                      <p class="pg-card-desc mt-2 text-[13px] leading-[1.6] text-white/60 md:max-w-[28ch]">
                        {p.shortDescription}
                      </p>

                      <div class="pg-card-meta mt-4 flex flex-wrap items-center gap-3">
                        <div class="flex items-center gap-2">
                          {p.colors.slice(0, 3).map((color) => (
                            <span
                              class="inline-block h-3.5 w-3.5 rounded-full border border-white/30 shadow-sm transition-transform duration-300 group-hover:scale-110 md:h-4 md:w-4"
                              style={`background-color: ${color.hex}`}
                              title={color.name}
                            />
                          ))}
                          {p.colors.length > 3 && (
                            <span class="ml-1 text-[9px] uppercase tracking-wider text-white/45">
                              +{p.colors.length - 3}
                            </span>
                          )}
                        </div>
                        <span class="ml-auto inline-flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.18em] text-white/70">
                          Ver detalle
                          <span class="inline-block h-px w-5 bg-king-accent transition-all duration-500 group-hover:w-8"></span>
                        </span>
                      </div>
                    </div>

                    {/* Bottom gold accent bar */}
                    <div class="absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-king-accent transition-transform duration-700 ease-out group-hover:scale-x-100"></div>

                    {/* Outer border glow on hover */}
                    <div class="pointer-events-none absolute inset-0 rounded-[var(--kb-radius-lg)] border border-white/0 transition-colors duration-700 group-hover:border-white/[0.08]"></div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </main>

  <FooterSection slot="footer" />
</BaseLayout>

<style>
  .product-bg {
    opacity: 0.35;
    background-image:
      linear-gradient(90deg, rgba(138, 106, 61, 0.065) 0, rgba(138, 106, 61, 0.065) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.02) 1px, transparent 1px);
    background-size: 11rem 100%, 100% 5rem;
    mask-image: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.8) 10%, transparent 92%);
  }

  /* Subtle noise texture overlay */
  [data-gsap-product-page]::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.018;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px;
    z-index: 1;
  }

  .product-gallery-frame {
    border-radius: var(--kb-radius-lg);
    box-shadow:
      0 32px 80px rgba(18, 15, 12, 0.14),
      0 12px 24px rgba(18, 15, 12, 0.08);
  }

  /* Subtle gold shimmer on gallery hover */
  .product-gallery-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(156, 114, 56, 0.03) 45%,
      rgba(156, 114, 56, 0.06) 50%,
      rgba(156, 114, 56, 0.03) 55%,
      transparent 60%
    );
    transition: opacity 1s ease;
    pointer-events: none;
  }
  .product-gallery-frame:hover::after {
    opacity: 1;
  }

  .color-swatch[data-active="true"]::after {
    content: "";
    position: absolute;
    bottom: -0.5rem;
    left: 50%;
    width: 0.625rem;
    height: 2px;
    border-radius: 999px;
    background: var(--color-king-accent);
    transform: translateX(-50%);
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gallery-thumb[data-active="true"] {
    border-color: var(--color-king-accent);
    opacity: 1;
    box-shadow: 0 0 0 3px rgba(156, 114, 56, 0.08);
  }

  /* Size button active state enhancement */
  .size-btn[data-active="true"] {
    box-shadow: 0 0 0 3px rgba(156, 114, 56, 0.08);
  }

  /* ===== Product Grid cards (related products) ===== */
  .pg-card {
    box-shadow:
      0 20px 50px rgba(18, 15, 12, 0.12),
      0 8px 18px rgba(18, 15, 12, 0.05);
    transition:
      transform 800ms var(--kb-ease-out),
      box-shadow 800ms var(--kb-ease-out);
  }

  .pg-card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 32px 72px rgba(18, 15, 12, 0.18),
      0 12px 28px rgba(18, 15, 12, 0.08);
  }

  .pg-card h3 {
    color: #ffffff;
  }

  .pg-card-img {
    filter: saturate(0.85) contrast(1.04);
    transition:
      transform 1400ms var(--kb-ease-out),
      filter 900ms var(--kb-ease-out);
  }

  .pg-card:hover .pg-card-img {
    filter: saturate(0.94) contrast(1.06);
  }

  .pg-card-hover-img {
    filter: saturate(0.92) contrast(1.05);
    transition:
      opacity 1000ms var(--kb-ease-out),
      transform 1000ms var(--kb-ease-out);
  }

  .pg-card:hover .pg-card-hover-img {
    opacity: 1;
    transform: scale(1);
  }

  .pg-shimmer {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.03) 45%,
      rgba(255, 255, 255, 0.06) 50%,
      rgba(255, 255, 255, 0.03) 55%,
      transparent 60%
    );
    background-size: 200% 200%;
    animation: none;
    transition: opacity 700ms;
  }

  .pg-card:hover .pg-shimmer {
    animation: shimmer-sweep 1.4s ease-out forwards;
    opacity: 1;
  }

  .pg-card-line {
    transition: width 500ms var(--kb-ease-out);
  }

  .pg-card:hover .pg-card-line {
    width: 3rem;
  }

  @keyframes shimmer-sweep {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @media (max-width: 767px) {
    .product-gallery-frame {
      border-radius: var(--kb-radius-md);
    }
    .pg-card {
      border-radius: var(--kb-radius-md);
    }
    .pg-card .pointer-events-none.absolute.inset-3,
    .pg-card .pointer-events-none.absolute.inset-4 {
      border-radius: calc(var(--kb-radius-md) - 0.5rem);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const scope = document.querySelector('[data-gsap-product-page]');
  if (scope) {
    /* ── Main product reveal ── */
    const mainGrid = scope.querySelector('.product-main-grid');
    if (mainGrid) {
      const tl = gsap.timeline({
        defaults: { ease: 'power3.out' },
        scrollTrigger: {
          trigger: mainGrid,
          start: 'top 82%',
          once: true,
        },
      });

      tl.from(scope.querySelector('.product-breadcrumb'), {
        y: 10,
        opacity: 0,
        duration: 0.6,
      })
        .from(scope.querySelector('.product-gallery-frame'), {
          y: 40,
          opacity: 0,
          duration: 1.0,
        }, 0.1)
        .from(scope.querySelector('.product-info-col'), {
          x: 30,
          opacity: 0,
          duration: 0.9,
        }, 0.25);
    }

    /* ── Features reveal ── */
    const features = scope.querySelector('.product-features');
    if (features) {
      gsap.timeline({
        defaults: { ease: 'power3.out' },
        scrollTrigger: {
          trigger: features,
          start: 'top 85%',
          once: true,
        },
      })
        .from(features.querySelector('.section-header'), {
          y: 20,
          opacity: 0,
          duration: 0.75,
        })
        .from(features.querySelectorAll('.feature-card'), {
          y: 24,
          opacity: 0,
          duration: 0.65,
          stagger: 0.07,
        }, 0.2);
    }

    /* ── Related products reveal ── */
    const related = scope.querySelector('.product-related');
    if (related) {
      gsap.timeline({
        defaults: { ease: 'power3.out' },
        scrollTrigger: {
          trigger: related,
          start: 'top 85%',
          once: true,
        },
      })
        .from(related.querySelector('.section-header'), {
          y: 20,
          opacity: 0,
          duration: 0.75,
        })
        .from(related.querySelectorAll('[data-related-card]'), {
          y: 28,
          opacity: 0,
          duration: 0.68,
          stagger: 0.07,
        }, 0.2);
    }
  }

  type GalleryPayload = Array<{
    name: string;
    hex: string;
    images: Array<{
      src: string;
      width: number;
      height: number;
      alt: string;
      view: string;
    }>;
  }>;

  const readGalleryPayload = (gallery: HTMLElement): GalleryPayload => {
    const raw = gallery.getAttribute('data-gallery-colors');
    if (!raw) return [];

    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  /* ── Gallery color + perspective logic ── */
  document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>('.product-main-image');
    const frame = gallery.querySelector<HTMLElement>('.product-gallery-frame');
    const thumbSets = gallery.querySelectorAll<HTMLElement>('[data-thumb-set]');
    const thumbBtns = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');
    const galleryColors = readGalleryPayload(gallery);
    let transitionId = 0;

    const setActiveThumbs = (colorIndex: number, imageIndex: number) => {
      thumbSets.forEach((set) => {
        const isActiveSet = Number(set.dataset.colorIndex) === colorIndex;
        set.classList.toggle('hidden', !isActiveSet);
      });

      thumbBtns.forEach((btn) => {
        const isActive =
          Number(btn.dataset.colorIndex) === colorIndex &&
          Number(btn.dataset.imageIndex) === imageIndex;
        btn.dataset.active = String(isActive);
        btn.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };

    const updateGallery = (colorIndex: number, imageIndex = 0) => {
      const safeColorIndex = Number.isInteger(colorIndex) && galleryColors[colorIndex] ? colorIndex : 0;
      const color = galleryColors[safeColorIndex];
      if (!color || !mainImage) return;

      const safeImageIndex = Number.isInteger(imageIndex) && color.images[imageIndex] ? imageIndex : 0;
      const item = color.images[safeImageIndex];
      if (!item) return;

      const nextTransition = ++transitionId;
      setActiveThumbs(safeColorIndex, safeImageIndex);
      frame?.style.setProperty('--product-gallery-accent', color.hex);
      gallery.dataset.activeColorIndex = String(safeColorIndex);
      gallery.dataset.activeImageIndex = String(safeImageIndex);

      mainImage.style.opacity = '0';
      window.setTimeout(() => {
        if (nextTransition !== transitionId) return;

        mainImage.src = item.src;
        mainImage.alt = item.alt;
        mainImage.width = item.width;
        mainImage.height = item.height;
        mainImage.removeAttribute('srcset');
        mainImage.removeAttribute('sizes');
        mainImage.style.opacity = '1';
      }, 160);
    };

    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const colorIndex = Number(btn.dataset.colorIndex ?? 0);
        const imageIndex = Number(btn.dataset.imageIndex ?? 0);
        updateGallery(colorIndex, imageIndex);
      });
    });

    (gallery as HTMLElement & { __updateGallery?: (colorIndex: number, imageIndex?: number) => void }).__updateGallery = updateGallery;

    const defaultColorIndex = Number(gallery.dataset.defaultColorIndex ?? 0);
    const defaultImageIndex = Number(gallery.dataset.defaultImageIndex ?? 0);
    updateGallery(defaultColorIndex, defaultImageIndex);
  });

  /* ── Color & size selectors ── */
  document.querySelectorAll<HTMLElement>('[data-product-info]').forEach((info) => {
    const colorBtns = info.querySelectorAll<HTMLElement>('[data-color-selector] [data-color-index]');
    const colorNameEl = info.querySelector<HTMLElement>('.color-name');
    const sizeBtns = info.querySelectorAll<HTMLElement>('[data-size]');
    const sizeNameEl = info.querySelector<HTMLElement>('.size-name');
    const gallery = document.querySelector<HTMLElement>('[data-product-gallery]');
    const updateGallery = (gallery as any)?.__updateGallery;
    const galleryColors = gallery ? readGalleryPayload(gallery) : [];

    const setActiveColor = (activeIndex: number) => {
      colorBtns.forEach((btn) => {
        const isActive = Number(btn.dataset.colorIndex) === activeIndex;
        btn.dataset.active = String(isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        btn.classList.toggle('border-king-accent', isActive);
        btn.classList.toggle('scale-110', isActive);
        btn.classList.toggle('border-king-border/40', !isActive);
      });
    };

    colorBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-color-index') || '0', 10);
        const color = galleryColors[idx];

        if (colorNameEl && color) colorNameEl.textContent = color.name;
        setActiveColor(idx);
        if (updateGallery && color) updateGallery(idx, 0);
      });
    });

    setActiveColor(0);

    const setActiveSize = (activeBtn: HTMLElement) => {
      sizeBtns.forEach((b) => {
        b.classList.remove('border-king-accent', 'text-king-accent', 'bg-king-accent/5');
        b.classList.add('border-king-border/60', 'text-king-muted');
        b.removeAttribute('data-active');
      });
      activeBtn.classList.remove('border-king-border/60', 'text-king-muted');
      activeBtn.classList.add('border-king-accent', 'text-king-accent', 'bg-king-accent/5');
      activeBtn.setAttribute('data-active', 'true');
    };

    sizeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const size = btn.getAttribute('data-size') || '';
        setActiveSize(btn);
        if (sizeNameEl) sizeNameEl.textContent = `${size} cm`;
      });
    });

    /* Initialize first size button */
    if (sizeBtns.length > 0) {
      setActiveSize(sizeBtns[0] as HTMLElement);
    }
  });
</script>
