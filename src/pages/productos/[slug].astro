---
import ProductCard from '../../components/collection/ProductCard.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import ProductAddToCart from '../../components/product/ProductAddToCart.astro';
import ProductGallery from '../../components/product/ProductGallery.astro';
import Badge from '../../components/ui/Badge.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { site, siteUrl } from '@config/site';
import { getCatalogProvider } from '@commerce/catalog';
import { getRedirectedProductHandles } from '@commerce/application/product-redirects';
import { CATALOG_INDEX_PATH } from '@commerce/application/paths';
import { resolveProductPageHead, type CommercePageHead } from '@commerce/application/seo';
import { getFirstAvailableVariant } from '@commerce/domain/variants';
import BaseLayout from '../../layouts/BaseLayout.astro';

const handle = Astro.params.slug;
const redirectedHandles = getRedirectedProductHandles();
if (!handle || redirectedHandles.has(handle)) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const catalogProvider = await getCatalogProvider(Astro.clientAddress);
const product = await catalogProvider.getProductByHandle(handle);
if (!product) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
// HTML anónimo: el estado del carrito llega solo por cliente. Caché CDN breve
// alineada con la del catálogo; un redeploy purga la CDN de Vercel.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=600');
const pageHead: CommercePageHead = resolveProductPageHead(product, site, siteUrl);
const [collections, related] = await Promise.all([
  catalogProvider.getCollections(),
  catalogProvider.getRelatedProducts(product, 4),
]);
const category = collections.find((collection) => collection.id === product.primaryCollectionId);
if (!category) throw new Error(`Colección principal no encontrada: ${product.primaryCollectionId}`);
const initialVariant = getFirstAvailableVariant(product) ?? product.variants[0];
const specifications = product.specifications.filter((spec) => spec.label !== 'Referencia');

const breadcrumbs = [
  { label: 'Productos', href: CATALOG_INDEX_PATH },
  { label: category.title, href: `/categorias/${category.handle}` },
  { label: product.title },
];
---

<BaseLayout seo={pageHead.seo} schema={pageHead.schema}>
  <Header slot="header" initialTheme="light" scrolledTheme="light" compactThreshold={32} />

  <article class="pdp" data-product-page>
    <div class="pdp__head kb-shell-wide">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <div class="pdp__main kb-shell-wide">
      <div class="pdp__gallery">
        <ProductGallery
          images={product.images}
          mediaGroups={product.mediaGroups}
          options={product.options}
          initialVariant={initialVariant}
          idPrefix={product.handle}
        />
      </div>

      <div class="pdp__buy">
        <header class="pdp__title-block">
          <div class="pdp__meta">
            <Badge variant="steel" class="pdp__category">{category.title}</Badge>
            <p class="pdp__eyebrow kb-eyebrow text-king-accent">{product.productType}</p>
          </div>
          <h1 class="pdp__title font-display">{product.title}</h1>
          <p class="pdp__excerpt">{product.summary}</p>
        </header>

        <ProductAddToCart product={product}>
          {specifications.length > 0 && (
            <section class="pdp__specs" aria-label="Especificaciones">
              <h2 class="pdp__specs-title kb-meta-label">Detalles</h2>
              <dl class="pdp__specs-list">
                {specifications.map((spec) => (
                  <div class="pdp__spec">
                    <dt class="pdp__spec-label kb-meta-label text-king-muted">{spec.label}</dt>
                    <dd class="pdp__spec-value">{spec.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
        </ProductAddToCart>
      </div>
    </div>

    {related.length > 0 && (
      <section class="pdp__related" aria-labelledby="pdp-related-title">
        <div class="pdp__related-inner kb-shell-wide">
          <div class="pdp__related-head">
            <h2 id="pdp-related-title" class="pdp__section-title font-display">También en {category.title}</h2>
            <a href={`/categorias/${category.handle}`} class="pdp__related-link kb-meta-label text-king-accent">
              Ver categoría
            </a>
          </div>

          <div class="pdp__related-grid">
            {related.map((item, index) => (
              <ProductCard product={item} index={index} />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <Footer slot="footer" connected />
</BaseLayout>

<style>
  .pdp {
    padding-top: var(--kb-page-offset-top);
    padding-bottom: var(--kb-space-section);
  }

  .pdp__head {
    padding-bottom: var(--kb-space-5);
  }

  .pdp__title-block {
    display: grid;
    gap: var(--kb-space-3);
    min-width: 0;
    padding-bottom: var(--kb-space-5);
    border-bottom: 1px solid var(--kb-stroke-hairline);
  }

  .pdp__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-2) var(--kb-space-4);
  }

  .pdp__category {
    letter-spacing: 0.08em;
  }

  .pdp__eyebrow {
    margin: 0;
  }

  .pdp__title {
    margin: 0;
    font-size: clamp(1.875rem, 1.45rem + 1.6vw, 2.5rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--color-king-text);
  }

  .pdp__excerpt {
    margin: 0;
    max-width: 44ch;
    font-size: var(--kb-text-sm);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-king-text) 68%, var(--color-king-muted));
    text-wrap: pretty;
  }

  .pdp__main {
    display: grid;
    gap: var(--kb-space-7);
    align-items: start;
    padding-bottom: var(--kb-space-8);
  }

  .pdp__gallery,
  .pdp__buy {
    min-width: 0;
  }

  .pdp__gallery {
    width: 100%;
    max-width: 100%;
  }

  .pdp__buy {
    display: flex;
    flex-direction: column;
    gap: var(--kb-space-4);
    min-width: 0;
  }

  .pdp__specs {
    display: grid;
    gap: var(--kb-space-3);
    margin: 0;
    padding: var(--kb-space-4);
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-card-radius);
    background: color-mix(in srgb, var(--color-king-bone) 18%, var(--color-king-bg));
  }

  .pdp__specs-title {
    margin: 0;
    color: var(--color-king-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pdp__specs-list {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .pdp__spec {
    display: grid;
    grid-template-columns: minmax(0, 7.25rem) minmax(0, 1fr);
    gap: var(--kb-space-3);
    align-items: baseline;
    min-width: 0;
    padding-block: 0.625rem;
    border-top: 1px solid color-mix(in srgb, var(--kb-stroke-hairline) 85%, transparent);
  }

  .pdp__spec:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .pdp__spec:last-child {
    padding-bottom: 0;
  }

  .pdp__spec-label,
  .pdp__spec-value {
    margin: 0;
    min-width: 0;
  }

  .pdp__spec-value {
    font-size: var(--kb-text-sm);
    line-height: 1.45;
    color: var(--color-king-text);
  }

  .pdp__section-title {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .pdp__related {
    padding-top: var(--kb-space-7);
    padding-bottom: var(--kb-space-6);
    margin-top: var(--kb-space-1);
    border-top: 1px solid var(--kb-stroke-hairline);
    background: var(--color-king-bg);
  }

  .pdp__related-inner {
    display: grid;
    gap: var(--kb-space-5);
  }

  .pdp__related-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--kb-space-3) var(--kb-space-4);
  }

  .pdp__related-link {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-king-accent) 30%, transparent);
    text-underline-offset: 0.22em;
    transition:
      color var(--kb-dur-fast) var(--kb-ease-out),
      text-decoration-color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .pdp__related-link:hover {
    text-decoration-color: var(--color-king-accent);
  }

  .pdp__related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--kb-space-5) var(--kb-space-4);
  }

  @media (max-width: 47.99rem) {
    .pdp__main {
      gap: var(--kb-space-5);
      padding-bottom: var(--kb-space-6);
    }

    .pdp__head {
      padding-bottom: var(--kb-space-4);
    }

    .pdp__title-block {
      padding-bottom: var(--kb-space-4);
    }

    .pdp__excerpt {
      max-width: none;
    }

    .pdp__spec {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--kb-space-1);
      padding-block: 0.75rem;
    }

    .pdp__spec-label {
      margin-bottom: 0.125rem;
    }

    .pdp__related {
      padding-top: var(--kb-space-6);
    }

    .pdp__related-inner {
      gap: var(--kb-space-4);
    }

    .pdp__related-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .pdp__related-grid > li {
      padding-block: var(--kb-space-6);
      border-bottom: 1px solid var(--kb-stroke-hairline);
    }

    .pdp__related-grid > li:first-child {
      padding-top: 0;
    }

    .pdp__related-grid > li:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }
  }

  @media (min-width: 48rem) {
    .pdp {
      padding-top: calc(var(--kb-header-offset) + var(--kb-space-5));
    }

    .pdp__gallery {
      display: flex;
      align-items: start;
      margin-inline: 0;
      position: sticky;
      top: var(--kb-sticky-below-header);
    }

    .pdp__main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 3.25vw, 2.75rem);
      align-items: start;
    }

    .pdp__related-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--kb-space-6);
    }
  }

  @media (min-width: 64rem) {
    .pdp__main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 4vw, 3.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pdp__related-link {
      transition: none;
    }
  }
</style>
