---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AboutCtaSection from '../components/sections/about/AboutCtaSection.astro';
import AboutContextSection from '../components/sections/about/AboutContextSection.astro';
import AboutDirectionSection from '../components/sections/about/AboutDirectionSection.astro';
import AboutOriginSection from '../components/sections/about/AboutOriginSection.astro';
import AboutStandardsSection from '../components/sections/about/AboutStandardsSection.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { aboutPage } from '@content/about';
import { createPageSeo, toSeoImage } from '@shared/seo/page-head';
import { createBreadcrumbListSchema, createWebPageSchema } from '@shared/seo/structured-data';

const { meta, hero, origin, standards, direction, context, cta } = aboutPage;
const seo = createPageSeo({
  title: meta.title,
  description: meta.description,
  pathname: '/sobre',
  image: toSeoImage(hero.image, hero.imageAlt),
});
const aboutSchema = [
  createWebPageSchema({
    type: 'AboutPage',
    name: meta.title,
    description: meta.description,
    url: seo.canonicalUrl,
  }),
  createBreadcrumbListSchema([{ name: 'Sobre KingBelt', path: '/sobre' }]),
];
---

<BaseLayout seo={seo} schema={aboutSchema}>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={32} />

  <PageHeader
    eyebrow={hero.eyebrow}
    description={hero.lede}
    image={hero.image}
    imageAlt={hero.imageAlt}
    imagePosition={hero.imagePosition}
    meta={hero.meta}
    breadcrumbs={[{ label: 'Sobre KingBelt' }]}
  >
    <Fragment slot="title">
      <span set:html={hero.title} />
    </Fragment>
  </PageHeader>

  <div class="about-page">
    <AboutOriginSection data={origin} />
    <AboutStandardsSection data={standards} />
    <AboutDirectionSection data={direction} />
    <AboutContextSection data={context} />

    <AboutCtaSection cta={cta} backgroundImage={hero.image} />
  </div>

  <Footer slot="footer" connected />
</BaseLayout>
