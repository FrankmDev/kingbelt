---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import MuseumSection from '../components/museum/MuseumSection.astro';
import ButtonShowcase from '../components/museum/ButtonShowcase.astro';
import IconShowcase from '../components/museum/IconShowcase.astro';
import SectionHeaderShowcase from '../components/museum/SectionHeaderShowcase.astro';
import DecorativeShowcase from '../components/museum/DecorativeShowcase.astro';
import ComponentsRef from '../components/museum/ComponentsRef.astro';
import PageHeaderShowcase from '../components/museum/PageHeaderShowcase.astro';
import BreadcrumbsShowcase from '../components/museum/BreadcrumbsShowcase.astro';
import ProseShowcase from '../components/museum/ProseShowcase.astro';
import MediaFrameShowcase from '../components/museum/MediaFrameShowcase.astro';
import ContentSplitShowcase from '../components/museum/ContentSplitShowcase.astro';
import FeatureCardShowcase from '../components/museum/FeatureCardShowcase.astro';
import StatBlockShowcase from '../components/museum/StatBlockShowcase.astro';
import BlogCardShowcase from '../components/museum/BlogCardShowcase.astro';
import TagListShowcase from '../components/museum/TagListShowcase.astro';
import ContactMethodShowcase from '../components/museum/ContactMethodShowcase.astro';
import FormFieldShowcase from '../components/museum/FormFieldShowcase.astro';
import CTABoxShowcase from '../components/museum/CTABoxShowcase.astro';

const navItems = [
  { id: 'deco', label: 'Decorativos' },
  { id: 'button', label: 'Button' },
  { id: 'icons', label: 'Icons' },
  { id: 'pageheader', label: 'PageHeader' },
  { id: 'breadcrumbs', label: 'Breadcrumbs' },
  { id: 'prose', label: 'Prose' },
  { id: 'mediaframe', label: 'MediaFrame' },
  { id: 'contentsplit', label: 'ContentSplit' },
  { id: 'featurecard', label: 'FeatureCard' },
  { id: 'statblock', label: 'StatBlock' },
  { id: 'blogcard', label: 'BlogCard' },
  { id: 'taglist', label: 'TagList' },
  { id: 'contactmethod', label: 'ContactMethod' },
  { id: 'formfield', label: 'FormField' },
  { id: 'ctabox', label: 'CTABox' },
  { id: 'common', label: 'Common' },
  { id: 'layout', label: 'Layout' },
  { id: 'sections', label: 'Sections' },
];
---

<BaseLayout
  title="Style Museum — KingBelt"
  description="Sistema de diseño KingBelt — componentes y utilidades decorativas."
  robots="noindex,nofollow"
>
  <Header slot="header" initialTheme="dark" scrolledTheme="light" compactThreshold={24} />

  {/* ====================== HERO ====================== */}
  <section class="museum-hero relative overflow-hidden bg-king-asphalt pt-32 pb-18 md:pt-40 md:pb-24 lg:pt-48 lg:pb-28">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(156,114,56,0.1),transparent_45%)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/20"></div>

    <div class="kb-shell-wide relative z-10">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-5">
          <span class="h-[1.5px] w-10 bg-gradient-to-r from-king-accent to-transparent"></span>
          <span class="kb-action-label text-king-accent">Design Archive</span>
        </div>

        <h1 class="text-white mb-5">
          Style <span class="italic text-king-brass">Museum</span>
        </h1>

        <p class="max-w-[38rem] text-[var(--kb-text-body)] leading-[1.72] text-white/60 font-light">
          Componentes, utilidades decorativas y tokens del sistema KingBelt. Una armería visual para construir interfaces con carácter de asfalto, cuero y latón.
        </p>
      </div>
    </div>

    {/* Bottom rule */}
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-king-accent/30 to-transparent"></div>
  </section>

  {/* ====================== STICKY NAV ====================== */}
  <nav class="sticky top-0 z-40 border-b border-king-border/20 bg-king-bg/85 backdrop-blur-xl kb-noise-overlay">
    <div class="kb-shell-wide flex items-center gap-1 overflow-x-auto py-3 scrollbar-none">
      {navItems.map((s) => (
        <a
          href={`#${s.id}`}
          class="museum-nav-link kb-action-label group shrink-0 relative px-3.5 py-1.5 text-king-muted/75 rounded-full transition-[background-color,color] duration-[var(--kb-dur-fast)] hover:text-king-accent hover:bg-king-accent/[0.05]"
          data-section={s.id}
        >
          <span class="relative z-10">{s.label}</span>
          <span class="nav-link-dot absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-king-accent opacity-0 transition-opacity duration-[var(--kb-dur-fast)]"></span>
        </a>
      ))}
    </div>
  </nav>

  {/* ====================== SECTIONS ====================== */}
  <MuseumSection id="deco" title="Decorative Utilities" subtitle="Utilidades visuales" tone="alt">
    <DecorativeShowcase />
  </MuseumSection>

  <MuseumSection id="button" title="Button.astro" subtitle="6 variantes × 3 tamaños">
    <ButtonShowcase />
  </MuseumSection>

  <MuseumSection id="icons" title="Icon.astro" subtitle="Catálogo SVG del sistema" tone="alt">
    <IconShowcase />
  </MuseumSection>

  <MuseumSection id="common" title="Common Components">
    <SectionHeaderShowcase />
  </MuseumSection>

  <MuseumSection id="pageheader" title="PageHeader.astro" subtitle="Editorial header para páginas internas" tone="alt">
    <PageHeaderShowcase />
  </MuseumSection>

  <MuseumSection id="breadcrumbs" title="Breadcrumbs.astro" subtitle="Navegación secundaria">
    <BreadcrumbsShowcase />
  </MuseumSection>

  <MuseumSection id="prose" title="Prose.astro" subtitle="Contenedor de texto editorial" tone="alt">
    <ProseShowcase />
  </MuseumSection>

  <MuseumSection id="mediaframe" title="MediaFrame.astro" subtitle="Marco de imagen con ratio, caption y label">
    <MediaFrameShowcase />
  </MuseumSection>

  <MuseumSection id="contentsplit" title="ContentSplit.astro" subtitle="Bloque editorial con cabecera e imagen horizontal" tone="alt">
    <ContentSplitShowcase />
  </MuseumSection>

  <MuseumSection id="featurecard" title="FeatureCard.astro" subtitle="Card de valor/feature con icon y grid">
    <FeatureCardShowcase />
  </MuseumSection>

  <MuseumSection id="statblock" title="StatBlock.astro" subtitle="Bloque de dato/impacto" tone="alt">
    <StatBlockShowcase />
  </MuseumSection>

  <MuseumSection id="blogcard" title="BlogCard.astro" subtitle="Card de artículo con metadatos">
    <BlogCardShowcase />
  </MuseumSection>

  <MuseumSection id="taglist" title="TagList.astro" subtitle="Lista de tags/chips" tone="alt">
    <TagListShowcase />
  </MuseumSection>

  <MuseumSection id="contactmethod" title="ContactMethod.astro" subtitle="Item de contacto con icon y href">
    <ContactMethodShowcase />
  </MuseumSection>

  <MuseumSection id="formfield" title="FormField.astro" subtitle="Wrapper de campo de formulario" tone="alt">
    <FormFieldShowcase />
  </MuseumSection>

  <MuseumSection id="ctabox" title="CTABox.astro" subtitle="Bloque CTA con textura y acción">
    <CTABoxShowcase />
  </MuseumSection>

  <MuseumSection id="layout" title="Layout Components" subtitle="Estructura de página" tone="alt">
    <ComponentsRef type="layout" />
  </MuseumSection>

  <MuseumSection id="sections" title="Sections Reference" subtitle="Secciones de alto nivel">
    <ComponentsRef type="sections" />
  </MuseumSection>

  {/* ====================== MUSEUM FOOTER ====================== */}
  <footer class="relative bg-king-asphalt py-16 md:py-20 overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-king-accent/25 to-transparent"></div>

    <div class="kb-shell-wide relative z-10 text-center">
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class="h-[1.5px] w-10 bg-gradient-to-r from-transparent to-king-accent/50"></span>
        <span class="kb-action-label text-king-accent/60">Fin del archivo</span>
        <span class="h-[1.5px] w-10 bg-gradient-to-l from-transparent to-king-accent/50"></span>
      </div>
      <p class="kb-meta-label text-white/55 font-light">
        KingBelt Design System · 2026
      </p>
    </div>
  </footer>

  {/* Fixed back button */}
  <div class="fixed bottom-6 right-6 z-50">
    <Button href="/" variant="primary" size="md">
      <Icon name="arrow-left" class="h-3.5 w-3.5" />
      Volver al home
    </Button>
  </div>
</BaseLayout>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .museum-nav-link.active {
    color: var(--color-king-accent);
    background: rgba(138, 90, 43, 0.08);
  }

  .museum-nav-link.active .nav-link-dot {
    opacity: 1;
  }
</style>

<script>
  // Highlight active nav link on scroll
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.museum-nav-link');

  function updateActiveNav() {
    const scrollPos = window.scrollY + 120;
    let activeId = '';

    sections.forEach((section) => {
      const el = section as HTMLElement;
      if (el.offsetTop <= scrollPos) {
        activeId = el.id;
      }
    });

    navLinks.forEach((link) => {
      const sectionId = link.getAttribute('data-section');
      if (sectionId === activeId) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
  }

  window.addEventListener('scroll', updateActiveNav, { passive: true });
  updateActiveNav();
</script>
