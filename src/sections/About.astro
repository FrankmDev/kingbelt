---
import SectionHeader from '../components/common/SectionHeader.astro';
import FeatureItem from '../components/common/FeatureItem.astro';

const features = [
  { title: 'Materiales', body: 'Pieles seleccionadas. Acero y latón macizo.' },
  { title: 'Durabilidad', body: 'Construidos para durar décadas, no temporadas.' },
  { title: 'Diseño', body: 'Estética biker contemporánea sin concesiones.' },
  { title: 'Artesanía', body: 'Acabados manuales en cada pieza.' },
];
---

<section id="marca" class="relative py-24 md:py-32 bg-king-secondary overflow-hidden">
  <div class="mx-auto px-6 md:px-10 lg:px-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      {/* Image Column */}
      <div class="lg:col-span-6 relative animate-on-scroll">
        <div class="relative aspect-[4/5] overflow-hidden bg-king-surface">
          <img
            src="https://images.unsplash.com/photo-1605518216938-7c31b7b14ad0?auto=format&fit=crop&w=800&q=80"
            alt="Artesanía en cuero KingBelt"
            class="h-full w-full object-cover"
            loading="lazy"
          />
          {/* Decorative frame */}
          <div class="absolute inset-4 border border-king-text/10 pointer-events-none"></div>
        </div>
        {/* Industrial detail */}
        <div class="absolute -bottom-4 -right-4 w-24 h-24 border-r-2 border-b-2 border-king-accent/30 hidden lg:block"></div>
      </div>

      {/* Text Column */}
      <div class="lg:col-span-5 lg:col-start-8 animate-on-scroll animate-delay-1">
        <SectionHeader
          eyebrow="La Marca"
          title="BUILT FOR MEN WHO CARRY CHARACTER"
          size="md"
          class="mb-8"
          titleClass="mb-0 tracking-wide leading-[0.95]"
        />
        <div class="space-y-6 text-king-muted leading-relaxed">
          <p>
            KingBelt nace de la tradición del cuero y la identidad masculina. Diseñado para hombres que valoran el detalle, la resistencia y el carácter en cada pieza.
          </p>
          <p>
            No seguimos tendencias pasajeras. Creamos objetos que mejoran con el uso, que desarrollan pátina y personalidad. Cada cinturón es una declaración de intenciones.
          </p>
        </div>

        {/* Features List */}
        <div class="mt-10 grid grid-cols-2 gap-6">
          {features.map((feature) => <FeatureItem {...feature} />)}
        </div>
      </div>
    </div>
  </div>
</section>
