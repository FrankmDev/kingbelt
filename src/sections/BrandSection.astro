---
import SectionHeader from '../components/common/SectionHeader.astro';

const values = [
  {
    num: '01',
    title: 'Cuero para la ruta',
    text: 'Piel seleccionada con grosor y cuerpo. Diseñada para moverse contigo, no para quedarse en el armario.',
  },
  {
    num: '02',
    title: 'Hebilla con peso real',
    text: 'Herrajes sólidos que se notan al abrochar. Sin plástico, sin imitaciones, sin concesiones.',
  },
  {
    num: '03',
    title: 'Hecho en España',
    text: 'Producción próxima, controlada y revisada pieza a pieza. Sin atajos, sin stock ciego.',
  },
] as const;

const specs = [
  { label: 'Origen', value: 'ES' },
  { label: 'Revisión', value: '01' },
  { label: 'Material', value: 'Cuero' },
] as const;

const brandImage =
  'https://images.unsplash.com/photo-1605518216938-7c31b7b14ad0?auto=format&fit=crop&w=1400&q=82';
---

<section id="marca" class="brand-about relative overflow-hidden bg-king-bg py-24 md:py-32 lg:py-36" data-gsap-brand>
  <div class="brand-field pointer-events-none absolute inset-0"></div>
  <div class="brand-soft-glow pointer-events-none absolute right-[-12rem] top-24 h-[34rem] w-[34rem] rounded-full bg-king-accent/[0.065] blur-[150px]"></div>

  <div class="kb-shell-wide relative">
    <div class="brand-hero mb-16 md:mb-20 lg:mb-24">
      <SectionHeader
        eyebrow="La marca"
        body="KingBelt nace para hacer accesorios de cuero pensados para la ruta: piezas con peso, carácter y un acabado que no se rinde."
        meta="España"
      >
        <Fragment slot="title">
          Hecho para la ruta, <em>pensado para durar</em>.
        </Fragment>
      </SectionHeader>
    </div>

    {/* Premium dual-card editorial layout */}
    <div class="brand-layout relative grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10 xl:gap-12">
      {/* Left card: cinematic image panel */}
      <div class="brand-image-col">
        <div class="brand-image-card group relative overflow-hidden rounded-[var(--kb-radius-lg)] border border-king-text/[0.08] bg-king-oil shadow-[var(--kb-shadow-float-dark)]">
          <img
            src={brandImage}
            alt="Cuero y hebilla KingBelt — accesorio de ruta"
            class="brand-main-image aspect-[3/2] w-full object-cover md:aspect-[16/10] lg:aspect-[3/2]"
            loading="lazy"
            sizes="(min-width: 1024px) 50vw, 100vw"
          />

          {/* Bottom fade gradient — more dramatic */}
          <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(9,8,7,0.02)_0%,rgba(9,8,7,0.12)_35%,rgba(9,8,7,0.65)_75%,rgba(9,8,7,0.85)_100%)]"></div>

          {/* Floating top-left badge — refined */}
          <div class="absolute left-6 top-6 z-10">
            <span class="inline-flex items-center gap-2.5 rounded-[var(--kb-radius-xs)] border border-white/12 bg-black/30 px-3.5 py-1.5 backdrop-blur-sm">
              <span class="h-1.5 w-1.5 rounded-full bg-king-accent shadow-[0_0_6px_rgba(138,90,43,0.6)]"></span>
              <span class="eyebrow-text text-white/95">Hecho a mano</span>
            </span>
          </div>

          {/* Bottom caption — more dramatic */}
          <div class="brand-image-caption absolute bottom-0 left-0 right-0 p-6 md:p-8 lg:p-10">
            <div class="mb-4 h-px w-14 bg-gradient-to-r from-king-accent/80 to-transparent"></div>
            <p class="max-w-md font-serif text-[1.5rem] italic leading-[1.1] text-white/95 md:text-[2rem] lg:text-[2.25rem]">
              Te pones algo y se nota que va en serio.
            </p>
          </div>
        </div>
      </div>

      {/* Right card: editorial content panel */}
      <div class="brand-content-col">
        <div class="brand-content-card relative flex h-full flex-col justify-center kb-rounded-lg border border-king-border/60 bg-king-surface p-8 shadow-[var(--kb-shadow-md),var(--kb-shadow-inset-soft)] md:p-10 lg:p-10 lg:py-9">
          {/* Eyebrow */}
          <div class="mb-6 flex items-center gap-3">
            <span class="inline-block h-px w-5 bg-king-accent/60"></span>
            <span class="eyebrow-text text-king-accent">MADE TO RIDE</span>
          </div>

          {/* Headline */}
          <h3 class="brand-content-headline mb-5 font-display text-[1.875rem] leading-[1.08] tracking-[var(--kb-title-tracking)] text-king-text md:text-[2.25rem] lg:text-[2.5rem]">
            Cuero que se nota al cogerlo.
            <span class="brand-content-accent block mt-1 text-king-accent italic">Hebilla que no se anda con rodeos.</span>
          </h3>

          {/* Body */}
          <div class="space-y-3">
            <p class="text-[var(--kb-text-xs)] leading-[1.7] text-king-muted md:text-[15px]">
              Cada pieza está pensada para el movimiento real: cuero que gana carácter con el uso, hebilla con el peso justo, costuras que no ceden cuando aprietas.
            </p>
            <p class="text-[var(--kb-text-xs)] leading-[1.7] text-king-muted md:text-[15px]">
              Hecho en España, revisado pieza a pieza. Sin producción en masa.
            </p>
          </div>

          {/* Gear detail strip — dry technical labels */}
          <div class="brand-craft-strip mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
            {[
              { label: 'Cuero de primera', mark: '01' },
              { label: 'Hebilla maciza', mark: '02' },
              { label: 'Costura reforzada', mark: '03' },
            ].map((item) => (
              <div class="brand-craft-item group flex items-center gap-2">
                <span class="eyebrow-text text-king-accent/70 font-mono tabular-nums">
                  {item.mark}
                </span>
                <span class="h-px w-3 bg-king-border/60"></span>
                <span class="meta-text text-king-muted transition-colors duration-[var(--kb-dur-fast)] group-hover:text-king-text">
                  {item.label}
                </span>
              </div>
            ))}
          </div>

          {/* Spec strip */}
          <div class="brand-specs mt-6 border-t border-king-border/50 pt-5">
            <div class="grid grid-cols-3 gap-4">
              {specs.map((spec, i) => (
                <div class:list={['brand-spec-item relative text-center', i === 0 && 'text-left', i === 2 && 'text-right']}>
                  {i > 0 && (
                    <span class="pointer-events-none absolute left-0 top-1/2 hidden h-8 w-px -translate-y-1/2 bg-king-border/40 lg:block"></span>
                  )}
                  <span class="block font-display text-[2rem] leading-none text-king-text md:text-[2.5rem]">
                    {spec.value}
                  </span>
                  <span class="block mt-3 text-[var(--kb-text-eyebrow)] font-medium uppercase tracking-[0.2em] text-king-muted/55">
                    {spec.label}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Values: gear blocks */}
    <div class="brand-values mt-12 grid gap-5 md:mt-16 md:grid-cols-3">
      {values.map((value, i) => (
        <article
          class:list={[
            'brand-value group relative overflow-hidden kb-rounded-lg p-8 transition-all duration-[var(--kb-dur-med)] md:p-10',
            i === 1
              ? 'border border-white/10 bg-king-graphite shadow-[var(--kb-shadow-steel-soft)] text-white/92'
              : 'border border-king-border/60 bg-king-surface shadow-[var(--kb-shadow-sm),var(--kb-shadow-inset-soft)] text-king-text hover:border-king-accent/30',
          ]}
        >
          <div class="mb-8 flex items-center gap-4">
            <span class="brand-value-marker eyebrow-text"
              class:list={[i === 1 ? 'text-white/60' : 'text-king-accent/70']}>
              {value.num}
            </span>
          </div>
          <h3 class="mb-4 text-[1.5rem] leading-[0.95] tracking-[var(--kb-title-tracking)] md:text-[1.75rem]"
            class:list={[i === 1 ? 'text-white/90' : 'text-king-text']}>
            {value.title}
          </h3>
          <p class="max-w-[25rem] text-[var(--kb-text-sm)] leading-[1.7]"
            class:list={[i === 1 ? 'text-white/60' : 'text-king-muted']}>
            {value.text}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .brand-about {
    isolation: isolate;
  }

  .brand-field {
    opacity: 0.42;
    background-image:
      linear-gradient(90deg, rgba(138, 90, 43, 0.07) 0, rgba(138, 90, 43, 0.07) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.026) 1px, transparent 1px);
    background-size: 10rem 100%, 100% 5.5rem;
    mask-image: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.82) 14%, transparent 92%);
  }

  .brand-image-panel {
    box-shadow: 0 28px 80px rgba(18, 15, 12, 0.12);
  }

  .brand-main-image {
    filter: saturate(0.75) contrast(1.08) brightness(0.95);
    transform: scale(1.01);
    transition:
      transform 1300ms var(--kb-ease-out),
      filter 900ms var(--kb-ease-out);
  }

  .brand-image-panel:hover .brand-main-image,
  .brand-image-card:hover .brand-main-image {
    filter: saturate(0.9) contrast(1.1) brightness(1);
    transform: scale(1.04);
  }

  @media (max-width: 767px) {
    .brand-value + .brand-value {
      border-top: 1px solid rgba(229, 224, 219, 0.82);
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const section = document.querySelector('[data-gsap-brand]');
  if (section) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from(section.querySelector('.brand-hero'), {
      y: 18,
      opacity: 0,
      duration: 0.75,
    })
      .from(section.querySelector('.brand-image-col'), {
        y: 30,
        opacity: 0,
        duration: 0.85,
      }, 0.18)
      .from(section.querySelector('.brand-content-col'), {
        x: 28,
        opacity: 0,
        duration: 0.8,
      }, 0.32)
      .from(section.querySelectorAll('.brand-spec-item'), {
        y: 12,
        opacity: 0,
        duration: 0.5,
        stagger: 0.08,
      }, 0.52)
      .from(section.querySelectorAll('.brand-value'), {
        y: 16,
        opacity: 0,
        duration: 0.52,
        stagger: 0.07,
      }, 0.6);
  }
</script>
