---
import SectionHeader from '../components/common/SectionHeader.astro';

const steps = [
  {
    num: '01',
    title: 'Elige tu modelo',
    desc: 'Recorre la colección y decide qué cinturón encaja mejor por estilo, hebilla y carácter.',
  },
  {
    num: '02',
    title: 'Revisa color y talla',
    desc: 'Dentro de cada ficha comprueba variantes y talla antes de cerrar la compra.',
  },
  {
    num: '03',
    title: 'Compra o consulta',
    desc: 'Finaliza en Amazon o escríbenos si necesitas ayuda con talla, color o disponibilidad.',
  },
] as const;

const channels = [
  { label: 'Comprar en Amazon', href: 'https://amazon.com/kingbelt' },
  { label: 'Consultar por WhatsApp', href: 'https://wa.me/1234567890' },
] as const;
---

<section id="como-comprar" class="buying-shell relative overflow-hidden bg-king-bg py-24 md:py-32 lg:py-40" data-gsap-buying>
  <div class="buying-bg pointer-events-none absolute inset-0"></div>
  <div class="buying-glow pointer-events-none absolute left-[-10rem] top-24 h-[32rem] w-[32rem] rounded-full bg-king-accent/[0.06] blur-[145px]"></div>
  <div class="kb-shell-wide relative">
    <div class="buying-heading mb-14 md:mb-20">
      <SectionHeader
        eyebrow="Cómo comprar"
        body="Compra en Amazon o contáctanos por WhatsApp si quieres ayuda con talla, color o disponibilidad."
        meta="Compra disponible"
      >
        <Fragment slot="title">
          Compra directa.
        </Fragment>
      </SectionHeader>
    </div>

    <div class="buying-steps relative grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-0" data-buying-steps>
      {steps.map((step, i) => (
        <article
          class:list={[
            'buying-step group relative',
            i < 2 && 'md:border-r md:border-king-border/60',
            i === 0 && 'md:pr-10 lg:pr-14',
            i === 1 && 'md:px-10 lg:px-14',
            i === 2 && 'md:pl-10 lg:pl-14',
          ]}
          data-buying-step
        >
          <div class="relative">
            <span class="buying-step-num mb-6 inline-flex h-10 w-10 items-center justify-center rounded-full border border-king-accent/25 bg-king-bg font-mono text-[11px] font-medium text-king-accent">
              {step.num}
            </span>
            <h3 class="mb-3 text-[1.5rem] font-light leading-[0.98] tracking-[var(--kb-title-tracking)] text-king-text md:text-[1.75rem]">
              {step.title}
            </h3>
            <p class="text-[14px] leading-[1.75] text-king-muted md:text-[15px]">
              {step.desc}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="buying-cta-wrap mt-14 flex flex-col items-center justify-center gap-4 sm:flex-row md:mt-20" data-buying-cta>
      {channels.map((ch, index) => (
        <a
          href={ch.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'group inline-flex items-center gap-3 rounded-full border px-7 py-2.5 text-[10px] font-medium uppercase tracking-[0.2em] transition-all duration-500',
            index === 0
              ? 'border-king-text bg-king-text text-king-bg hover:border-king-accent hover:bg-king-accent'
              : 'border-king-border/80 bg-white/40 text-king-text backdrop-blur-sm hover:border-king-accent/40 hover:bg-white/60 hover:text-king-accent',
          ]}
        >
          <span>{ch.label}</span>
          <span class="h-px w-5 bg-current transition-all duration-500 group-hover:w-8"></span>
          <svg class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .buying-shell {
    isolation: isolate;
  }

  .buying-bg {
    opacity: 0.35;
    background-image:
      linear-gradient(90deg, rgba(138, 106, 61, 0.065) 0, rgba(138, 106, 61, 0.065) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.02) 1px, transparent 1px);
    background-size: 11rem 100%, 100% 5rem;
    mask-image: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.8) 16%, transparent 92%);
  }

  .buying-step-num {
    box-shadow: 0 8px 24px rgba(18, 15, 12, 0.06);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const scope = document.querySelector('[data-gsap-buying]');
  if (scope) {
    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      scrollTrigger: {
        trigger: scope,
        start: 'top 84%',
        once: true,
      },
    });

    tl.from(scope.querySelector('.buying-heading'), {
      y: 22,
      opacity: 0,
      duration: 0.75,
    })
      .from(scope.querySelectorAll('[data-buying-step]'), {
        y: 24,
        opacity: 0,
        duration: 0.68,
        stagger: 0.09,
      }, 0.18)
      .from(scope.querySelector('.buying-cta-wrap'), {
        y: 14,
        opacity: 0,
        duration: 0.62,
      }, 0.62);
  }
</script>
