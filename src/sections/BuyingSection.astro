---
import SectionHeader from '../components/common/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { contactChannels } from '../data/navigation';

const steps = [
  {
    num: '01',
    title: 'Material con criterio.',
    desc: 'Cuero seleccionado por grosor y cuerpo. Herrajes que aguantan el ritmo del día a día.',
  },
  {
    num: '02',
    title: 'Acabado pensado.',
    desc: 'Cada pieza se revisa antes de salir. Costura, remate y ajuste. Nada se delega al azar.',
  },
  {
    num: '03',
    title: 'Atención directa.',
    desc: 'Consulta por WhatsApp o Instagram. Respondemos preguntas y te asesoramos sobre la mejor pieza para ti.',
  },
] as const;

const channels = contactChannels;
---

<section id="proceso" class="buying-shell relative overflow-hidden bg-king-bg py-24 md:py-32 lg:py-36" data-gsap-buying>
  <div class="buying-bg pointer-events-none absolute inset-0"></div>
  <div class="buying-glow pointer-events-none absolute left-[-10rem] top-24 h-[32rem] w-[32rem] rounded-full bg-king-accent/[0.06] blur-[145px]"></div>
  <div class="kb-shell-wide relative">
    <div class="buying-heading mb-14 md:mb-16">
      <SectionHeader
        eyebrow="Proceso"
        number="02" numberTotal="03"
        body="Cada pieza tiene un recorrido: desde la selección del material hasta que llega a tus manos."
        meta="3 pasos"
      >
        <Fragment slot="title">
          Pensado para moverse contigo.
        </Fragment>
      </SectionHeader>
    </div>

    <div class="buying-steps relative grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-0" data-buying-steps>
      {/* Animated connector line — desktop only */}
      <div class="buying-connector pointer-events-none absolute left-0 right-0 top-5 hidden md:block" aria-hidden="true">
        <span class="buying-connector-line"></span>
        <span class="buying-connector-trail"></span>
      </div>
      {steps.map((step, i) => (
        <article
          class:list={[
            'buying-step group relative rounded-[var(--kb-radius-md)] p-6 transition-all duration-500 hover:bg-king-surface/60 md:rounded-none md:bg-transparent md:p-0',
            i < 2 && 'md:border-r md:border-king-border/60',
            i === 0 && 'md:pr-10 lg:pr-14',
            i === 1 && 'md:px-10 lg:px-14',
            i === 2 && 'md:pl-10 lg:pl-14',
          ]}
          data-buying-step
        >
          <div class="relative">
            <span class="buying-step-num mb-6 inline-flex items-center justify-center rounded-[var(--kb-radius-xs)] border border-king-accent/30 bg-king-surface px-3 py-1.5 font-mono text-[11px] font-semibold text-king-accent shadow-[0_2px_6px_-2px_rgba(138,90,43,0.2),inset_0_1px_0_rgba(255,255,255,0.5)] transition-all duration-300 group-hover:border-king-accent/50 group-hover:shadow-[0_4px_12px_-3px_rgba(138,90,43,0.3),inset_0_1px_0_rgba(255,255,255,0.6)]">
              {step.num}
            </span>
            <h3 class="mb-3 text-[1.4rem] font-normal leading-[1.05] tracking-[var(--kb-title-tracking)] text-king-text md:text-[1.65rem]">
              {step.title}
            </h3>
            <p class="text-[14px] leading-[1.75] text-king-muted md:text-[15px]">
              {step.desc}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="buying-cta-wrap mt-14 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap md:mt-16" data-buying-cta>
      {channels.map((ch) => (
        <Button
          href={ch.href}
          target={ch.external ? '_blank' : undefined}
          rel={ch.external ? 'noopener noreferrer' : undefined}
          variant="outline"
          size="md"
        >
          {ch.label}
          <Icon name="arrow-right" class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5" />
        </Button>
      ))}
    </div>
  </div>
</section>

<style>
  .buying-shell {
    isolation: isolate;
  }

  .buying-bg {
    opacity: 0.35;
    background-image:
      linear-gradient(90deg, rgba(138, 90, 43, 0.06) 0, rgba(138, 90, 43, 0.06) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.02) 1px, transparent 1px);
    background-size: 11rem 100%, 100% 5rem;
    mask-image: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.8) 16%, transparent 92%);
  }

  /* Connector line between steps */
  .buying-connector {
    height: 1px;
    z-index: 0;
  }

  .buying-connector-line {
    position: absolute;
    inset: 0;
    background: rgba(123, 125, 120, 0.25);
  }

  .buying-connector-trail {
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 0;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-king-accent) 50%,
      transparent
    );
    box-shadow: 0 0 8px rgba(138, 90, 43, 0.4);
    transition: width 1.4s var(--kb-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .buying-connector-trail.is-drawn {
    width: 100%;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const scope = document.querySelector('[data-gsap-buying]');
  if (scope) {
    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      scrollTrigger: {
        trigger: scope,
        start: 'top 84%',
        once: true,
      },
    });

    tl.from(scope.querySelector('.buying-heading'), {
      y: 22,
      opacity: 0,
      duration: 0.75,
    })
      .from(scope.querySelectorAll('[data-buying-step]'), {
        y: 24,
        opacity: 0,
        duration: 0.68,
        stagger: 0.09,
      }, 0.18)
      .add(() => {
        const trail = scope.querySelector<HTMLElement>('.buying-connector-trail');
        if (trail) trail.classList.add('is-drawn');
      }, 0.5)
      .from(scope.querySelector('.buying-cta-wrap'), {
        y: 14,
        opacity: 0,
        duration: 0.62,
      }, 0.62);
  }
</script>
