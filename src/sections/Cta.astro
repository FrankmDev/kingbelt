---
import Button from '../components/ui/Button.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
---

<section id="contacto" class="relative py-32 md:py-48 bg-king-bg overflow-hidden">
  {/* Background texture */}
  <div class="absolute inset-0 opacity-30">
    <div class="absolute inset-0 bg-gradient-to-b from-king-bg via-king-secondary to-king-bg"></div>
  </div>

  {/* Decorative elements */}
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-king-accent/5 blur-[120px] pointer-events-none"></div>

  <div class="relative mx-auto px-6 md:px-10 lg:px-16 text-center animate-on-scroll">
    <SectionHeader
      eyebrow="Empieza Ahora"
      body="Explora la colección completa en Amazon o contáctanos directamente por WhatsApp para pedidos personalizados."
      align="center"
      class="max-w-4xl"
    >
      <Fragment slot="title">
        FIND YOUR BELT.<br />
        OWN YOUR STYLE.
      </Fragment>
    </SectionHeader>
    <div class="mt-12 flex flex-wrap justify-center gap-4">
      <Button
        href="https://amazon.com/kingbelt"
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="md"
      >
        Comprar en Amazon
      </Button>
      <Button
        href="https://wa.me/1234567890"
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
        size="md"
      >
        Hablar por WhatsApp
      </Button>
    </div>
  </div>
</section>
