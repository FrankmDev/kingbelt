---
import { hero } from '../data/home';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
---

<section
  id="inicio"
  class="hero-shell grain-overlay relative overflow-hidden"
  data-gsap-hero
>
  <div class="hero-bg absolute inset-0">
    <video
      src="/heroVideo.mp4"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
      poster="https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=1920&q=80"
      class="h-full w-full object-cover"
      style="filter: saturate(0.50) contrast(1.14) brightness(0.74);"
    />
  </div>

  <div class="hero-overlay absolute inset-0"></div>

  <div class="hero-inner relative z-10 mx-auto flex flex-col justify-center px-5 pb-14 pt-20 text-center md:px-10 md:pb-32 md:pt-36 lg:px-16">
    <div class="hero-copy mx-auto">
      <div class="hero-badge mx-auto mb-4 inline-flex items-center md:mb-8">
        <div class="hero-badge-inner relative flex items-center gap-3 overflow-hidden px-5 py-2 md:px-7 md:py-3">
          <span class="kb-pulse-dot h-1.5 w-1.5 rounded-full bg-king-accent/70"></span>
          <span class="eyebrow-text text-white/58">
            {hero.eyebrow}
          </span>
          <span class="h-1.5 w-1.5 rounded-full bg-king-accent/35"></span>
        </div>
      </div>

      <h1 class="font-display-hero leading-[0.95] tracking-[-0.01em] mb-4 md:mb-8">
        <span class="hero-title-1 block text-white">
          {hero.title}
        </span>
      </h1>

      <p class="hero-sub mx-auto mb-6 max-w-[36rem] text-[var(--kb-text-xs)] leading-[1.75] text-white/80 md:mb-12 md:text-[17px]">
        {hero.body}
      </p>

      <div class="hero-cta-wrap flex flex-col items-center justify-center gap-2.5 sm:flex-row sm:flex-wrap md:gap-3">
        <Button
          href={hero.primaryCta.href}
          variant="secondary"
          size="md"
        >
          {hero.primaryCta.label}
          <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1" />
        </Button>
        <Button
          href={hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          variant="surfaceOutline"
          size="md"
        >
          {hero.secondaryCta.label}
        </Button>
      </div>
    </div>

    {/* Scroll indicator */}
    <a href="#marca" class="hero-scroll-indicator group" aria-label="Descubrir la marca">
      <span class="hero-scroll-text">Descubrir</span>
      <span class="hero-scroll-line">
        <span class="hero-scroll-dot"></span>
      </span>
    </a>

    <div class="hero-bottom absolute bottom-0 left-0 right-0 z-10 border-t border-white/[0.08] bg-black/20 backdrop-blur-sm">
      <div class="hero-bottom-inner mx-auto px-5 md:px-10">
        <div class="flex items-center justify-center gap-6 py-3.5 md:gap-8 md:py-5">
          <div class="hero-info-item">
            <span class="hero-info-label">KingBelt · Est. 2026</span>
          </div>
          <span class="hidden h-3 w-px bg-white/[0.12] md:block"></span>
          <div class="hero-info-item">
            <span class="hero-info-label">Hecho en España</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    background:
      radial-gradient(circle at top, rgba(138, 90, 43, 0.1), transparent 34%),
      var(--color-king-oil);
  }

  .hero-overlay {
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.06) 30%, rgba(0, 0, 0, 0.55) 85%, rgba(0, 0, 0, 0.72) 100%),
      linear-gradient(100deg, rgba(7, 7, 7, 0.5) 10%, rgba(7, 7, 7, 0.08) 50%, rgba(7, 7, 7, 0.4) 100%);
  }

  .hero-shell {
    min-height: 100dvh;
  }

  .hero-inner {
    min-height: 100dvh;
    max-width: var(--kb-shell-max);
  }

  .hero-copy {
    max-width: var(--kb-shell-copy);
  }

  .hero-bottom-inner {
    max-width: var(--kb-shell-narrow);
  }

  .hero-badge-inner {
  border-radius: var(--kb-radius-xs);
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(12px) saturate(1.2);
  -webkit-backdrop-filter: blur(12px) saturate(1.2);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

  .hero-info-label {
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.52);
  }

  /* Scroll indicator */
  .hero-scroll-indicator {
    position: absolute;
    right: clamp(1.5rem, 3vw, 2.5rem);
    bottom: 6.5rem;
    z-index: 12;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .hero-scroll-indicator {
      display: flex;
    }
  }

  .hero-scroll-text {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .hero-scroll-line {
    position: relative;
    display: block;
    width: 1px;
    height: 3.5rem;
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }

  .hero-scroll-dot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 1rem;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.85));
    animation: hero-scroll-dot 2.4s var(--kb-ease-out, cubic-bezier(0.22, 1, 0.36, 1)) infinite;
  }

  @keyframes hero-scroll-dot {
    0% { transform: translate(-50%, -100%); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translate(-50%, 250%); opacity: 0; }
  }

  @media (max-width: 767px) {
    .hero-shell {
      height: 100dvh;
      min-height: 100dvh;
      overflow: hidden;
    }
    .hero-inner {
      height: 100dvh;
      min-height: 100dvh;
      display: grid;
      grid-template-rows: 1fr auto 1fr;
      align-items: center;
      padding-top: 0;
      padding-bottom: 0;
    }
    .hero-copy {
      grid-row: 2;
      align-self: center;
    }
    .hero-bottom {
      grid-row: 3;
      position: relative;
      align-self: end;
    }

  }
</style>

<script>
  import gsap from 'gsap';

  const scope = document.querySelector('[data-gsap-hero]');
  if (scope) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from(scope.querySelector('.hero-bg'), { scale: 1.08, opacity: 0, duration: 2.1 })
      .from(scope.querySelector('.hero-overlay'), { opacity: 0, duration: 1.3 }, 0)
      .from(scope.querySelector('.hero-badge'), { y: 16, opacity: 0, duration: 0.85 }, 0.7)
      .from(scope.querySelector('.hero-title-1'), { y: 40, opacity: 0, duration: 1.2 }, 0.95)
      .from(scope.querySelector('.hero-sub'), { y: 18, opacity: 0, duration: 0.9 }, 1.18)
      .from(scope.querySelector('.hero-cta-wrap'), { y: 14, opacity: 0, duration: 0.85 }, 1.3)
      .from(scope.querySelector('.hero-bottom'), { y: 18, opacity: 0, duration: 0.75 }, 1.44);
  }
</script>
