---
import { hero } from '../data/home';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
---

<section
  id="inicio"
  class="home-hero"
  data-home-hero
  aria-labelledby="home-hero-title"
>
  <div class="home-hero__main">
    <div class="home-hero__copy">
      <span class="home-hero__seam" aria-hidden="true"></span>

      <div class="home-hero__copy-inner">
        <header class="home-hero__head">
          <span class="kb-eyebrow kb-eyebrow-lined text-king-accent">{hero.badge}</span>
          <span class="kb-code-label home-hero__code" aria-hidden="true">KB.{hero.index}</span>
        </header>

        <h1 id="home-hero-title" class="home-hero__title font-display font-display-hero">
          {hero.titleLines.map((line) => (
            <span
              class:list={[
                'home-hero__title-line',
                line.variant === 'em' && 'home-hero__title-line--accent',
              ]}
            >
              <span class="home-hero__title-inner">
                {line.variant === 'em' ? <em>{line.text}</em> : line.text}
              </span>
            </span>
          ))}
        </h1>

        <p class="home-hero__lede body-copy text-pretty">{hero.description}</p>

        <div class="home-hero__actions">
          <Button href={hero.primaryCta.href} variant="primary" size="lg">
            {hero.primaryCta.label}
            <Icon name="arrow-right" class="h-4 w-4" />
          </Button>

          <a
            class="home-hero__secondary kb-action-label kb-underline-slide"
            href={hero.secondaryCta.href}
          >
            {hero.secondaryCta.label}
            <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
    </div>

    <div class="home-hero__visual">
      <div class="home-hero__frame grain-overlay">
        <div class="home-hero__media page-header-media" aria-hidden="true">
          <video
            src="/heroVideo.mp4"
            autoplay
            muted
            loop
            playsinline
            poster="/image.jpg"
            tabindex="-1"
            class="home-hero__video page-header-img"
          ></video>
          <div class="home-hero__grade"></div>
          <div class="page-header-vignette"></div>
          <div class="page-header-grain"></div>
        </div>

        <span class="home-hero__frame-folio kb-folio" aria-hidden="true">{hero.index}</span>
        <span
          class="home-hero__frame-mark kb-corner-bracket kb-corner-bracket-br"
          aria-hidden="true"
        ></span>
      </div>
    </div>
  </div>

  <footer class="home-hero__rail">
    <span class="home-hero__rail-accent" aria-hidden="true"></span>
    <div class="home-hero__rail-inner">
      <span class="kb-meta-label home-hero__rail-meta">{hero.meta}</span>
      <a href="#marca" class="home-hero__discover kb-action-label" aria-label="Descubrir KingBelt">
        <span>Descubrir</span>
        <span class="home-hero__discover-icon" aria-hidden="true">
          <Icon name="caret-down" class="h-3.5 w-3.5" />
        </span>
      </a>
    </div>
  </footer>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: max(42rem, 100svh);
    background: var(--color-king-oil);
    color: var(--color-king-bone);
  }

  .home-hero__main {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    min-height: 0;
  }

  .home-hero__copy {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    min-width: 0;
    background: var(--color-king-oil);
  }

  .home-hero__seam {
    position: absolute;
    top: clamp(5.25rem, 11vh, 7rem);
    right: 0;
    bottom: clamp(1.25rem, 2.5vh, 1.75rem);
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--color-king-bone), transparent 82%) 14%,
      color-mix(in srgb, var(--color-king-accent), transparent 48%) 50%,
      color-mix(in srgb, var(--color-king-bone), transparent 82%) 86%,
      transparent 100%
    );
    pointer-events: none;
  }

  .home-hero__copy-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(100%, 41rem);
    margin-inline: auto 0;
    margin-left: max(var(--kb-gutter), calc((100vw - var(--kb-shell-wide)) / 2 + var(--kb-gutter)));
    padding-block: clamp(7rem, 13vh, 9rem) clamp(2rem, 4vh, 2.75rem);
    padding-right: clamp(0.75rem, 2vw, 1.5rem);
  }

  .home-hero__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    margin-bottom: clamp(1.5rem, 3vh, 2.25rem);
  }

  .home-hero__code {
    color: color-mix(in srgb, var(--color-king-bone), transparent 50%);
    letter-spacing: 0.16em;
  }

  .home-hero__title {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.08em;
    margin: 0;
    width: calc(100% + clamp(1.5rem, 5vw, 4rem));
    max-width: 14ch;
    font-size: clamp(2.75rem, 5.8vw, 5.5rem);
    line-height: 0.93;
    letter-spacing: -0.04em;
    text-wrap: pretty;
  }

  .home-hero__title-line {
    display: block;
    overflow: hidden;
  }

  .home-hero__title-inner {
    display: block;
  }

  .home-hero__title-line--accent {
    position: relative;
    padding-bottom: 0.12em;
  }

  .home-hero__title-line--accent::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(4rem, 36%, 7.5rem);
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-accent) 22%, transparent)
    );
  }

  .home-hero__title :global(em) {
    color: color-mix(in srgb, var(--color-king-accent-light), white 10%);
    font-style: italic;
    font-weight: var(--kb-w-heading);
    letter-spacing: -0.03em;
  }

  .home-hero__lede {
    margin: clamp(1.5rem, 3vh, 2.1rem) 0 0;
    max-width: 34ch;
    line-height: 1.64;
    color: color-mix(in srgb, var(--color-king-bone), transparent 20%);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-5);
    margin-top: clamp(1.75rem, 3.4vh, 2.5rem);
  }

  .home-hero__secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-2);
    min-height: 2.75rem;
    padding-block: var(--kb-space-2);
    color: color-mix(in srgb, var(--color-king-bone), transparent 14%);
    transition:
      color var(--kb-dur-fast) var(--kb-ease-out),
      background-size var(--kb-dur-med) var(--kb-ease-out);
  }

  .home-hero__secondary:hover,
  .home-hero__secondary:focus-visible {
    color: var(--color-king-accent-light);
  }

  .home-hero__secondary :global(svg) {
    transition: transform var(--kb-dur-fast) var(--kb-ease-out);
  }

  .home-hero__secondary:hover :global(svg),
  .home-hero__secondary:focus-visible :global(svg) {
    transform: translate(0.15rem, -0.15rem);
  }

  .home-hero__visual {
    position: relative;
    z-index: 2;
    min-width: 0;
    padding: clamp(5.5rem, 11.5vh, 7rem) 0 clamp(1.25rem, 2.5vh, 1.75rem)
      clamp(1.25rem, 2.6vw, 2rem);
    background: var(--color-king-oil);
  }

  .home-hero__frame {
    position: relative;
    height: 100%;
    min-height: clamp(20rem, 58vh, 34rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-king-bone), transparent 84%);
    border-right: 0;
    border-radius: var(--kb-radius-2xl) 0 0 var(--kb-radius-xl);
    box-shadow: var(--kb-shadow-float-dark);
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .home-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 56% 42%;
  }

  .home-hero__grade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(13, 13, 12, 0.38) 0%, transparent 30%),
      linear-gradient(180deg, rgba(13, 13, 12, 0.1) 0%, transparent 40%, rgba(13, 13, 12, 0.28) 100%);
    pointer-events: none;
  }

  .home-hero__frame-folio {
    position: absolute;
    z-index: 3;
    right: clamp(1rem, 2.2vw, 1.35rem);
    bottom: clamp(0.75rem, 1.8vh, 1rem);
    font-size: clamp(3rem, 5.5vw, 5rem);
    color: color-mix(in srgb, var(--color-king-bone), transparent 80%);
    pointer-events: none;
    user-select: none;
  }

  .home-hero__frame-mark {
    z-index: 4;
    right: var(--kb-space-4);
    bottom: var(--kb-space-4);
    border-color: color-mix(in srgb, var(--color-king-bone), transparent 66%);
  }

  .home-hero__rail {
    position: relative;
    z-index: 4;
    border-top: 1px solid color-mix(in srgb, var(--color-king-bone), transparent 88%);
    background: color-mix(in srgb, var(--color-king-graphite), var(--color-king-oil) 24%);
  }

  .home-hero__rail-accent {
    position: absolute;
    top: 0;
    left: max(var(--kb-gutter), calc((100vw - var(--kb-shell-wide)) / 2 + var(--kb-gutter)));
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-brass) 50%, transparent) 40%,
      transparent
    );
    opacity: 0.85;
    pointer-events: none;
  }

  .home-hero__rail-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-4);
    width: min(calc(100% - (var(--kb-gutter) * 2)), var(--kb-shell-wide));
    margin-inline: auto;
    min-height: 3.25rem;
    padding-block: var(--kb-space-3);
  }

  .home-hero__rail-meta {
    color: color-mix(in srgb, var(--color-king-bone), transparent 36%);
    letter-spacing: 0.14em;
  }

  .home-hero__discover {
    display: inline-flex;
    align-items: center;
    gap: var(--kb-space-2);
    min-height: 2.75rem;
    padding-inline: var(--kb-space-2);
    color: color-mix(in srgb, var(--color-king-bone), transparent 28%);
    text-decoration: none;
    transition: color var(--kb-dur-fast) var(--kb-ease-out);
  }

  .home-hero__discover:hover,
  .home-hero__discover:focus-visible {
    color: var(--color-king-bone);
  }

  .home-hero__discover-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1px solid color-mix(in srgb, var(--color-king-bone), transparent 78%);
    border-radius: var(--kb-radius-pill);
    transition:
      border-color var(--kb-dur-fast) var(--kb-ease-out),
      transform var(--kb-dur-fast) var(--kb-ease-out);
  }

  .home-hero__discover:hover .home-hero__discover-icon,
  .home-hero__discover:focus-visible .home-hero__discover-icon {
    border-color: color-mix(in srgb, var(--color-king-accent-light), transparent 35%);
    transform: translateY(0.1rem);
  }

  @media (min-width: 80rem) {
    .home-hero__title {
      font-size: clamp(3.5rem, 5vw, 5.65rem);
      width: calc(100% + clamp(2rem, 6vw, 5.5rem));
      max-width: 15ch;
    }

    .home-hero__copy-inner {
      width: min(100%, 43rem);
    }
  }

  @media (max-width: 63.99rem) {
    .home-hero {
      min-height: auto;
    }

    .home-hero__main {
      grid-template-columns: 1fr;
    }

    .home-hero__seam {
      display: none;
    }

    .home-hero__copy-inner {
      width: 100%;
      margin-inline: auto;
      padding-inline: var(--kb-gutter);
      padding-top: 7rem;
      padding-bottom: var(--kb-space-6);
    }

    .home-hero__title {
      font-size: clamp(2.35rem, 11.5vw, 3.65rem);
      max-width: 13ch;
    }

    .home-hero__visual {
      padding: 0 var(--kb-gutter) var(--kb-space-4);
    }

    .home-hero__frame {
      min-height: 0;
      aspect-ratio: 5 / 3;
      height: auto;
      border-right: 1px solid color-mix(in srgb, var(--color-king-bone), transparent 84%);
      border-radius: var(--kb-radius-lg);
    }

    .home-hero__grade {
      background:
        linear-gradient(180deg, rgba(13, 13, 12, 0.12) 0%, transparent 38%),
        linear-gradient(0deg, rgba(13, 13, 12, 0.35) 0%, transparent 36%);
    }

    .home-hero__frame-folio {
      font-size: clamp(2.25rem, 10vw, 3.25rem);
    }

    .home-hero__rail-accent {
      left: var(--kb-gutter);
    }
  }

  @media (max-width: 29.99rem) {
    .home-hero__copy-inner {
      padding-top: 6.75rem;
    }

    .home-hero__head {
      margin-bottom: var(--kb-space-5);
    }

    .home-hero__title {
      font-size: clamp(2.1rem, 12.5vw, 2.85rem);
    }

    .home-hero__actions {
      align-items: flex-start;
      gap: var(--kb-space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__discover-icon {
      transition: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const scope = document.querySelector<HTMLElement>('[data-home-hero]');

  if (scope && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const video = scope.querySelector<HTMLElement>('.home-hero__video');
    const frame = scope.querySelector<HTMLElement>('.home-hero__frame');
    const copy = scope.querySelector<HTMLElement>('.home-hero__copy-inner');
    const titleLines = scope.querySelectorAll<HTMLElement>('.home-hero__title-inner');
    const frameMark = scope.querySelector<HTMLElement>('.home-hero__frame-mark');

    gsap.set(frame, { clipPath: 'inset(0 100% 0 0)' });
    gsap.set(titleLines, { yPercent: 108, opacity: 0 });
    if (frameMark) gsap.set(frameMark, { opacity: 0 });

    const intro = gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.04 });

    intro
      .to(frame, { clipPath: 'inset(0 0% 0 0)', duration: 1.08, ease: 'power3.inOut' }, 0)
      .from(video, { scale: 1.07, duration: 1.18, ease: 'power2.out' }, 0.04)
      .from(copy, { x: -24, opacity: 0, duration: 0.86 }, 0.26)
      .to(titleLines, { yPercent: 0, opacity: 1, duration: 0.76, stagger: 0.1 }, 0.52)
      .from(scope.querySelector('.home-hero__head'), { y: 8, opacity: 0, duration: 0.5 }, 0.68)
      .from(scope.querySelector('.home-hero__lede'), { y: 10, opacity: 0, duration: 0.55 }, 0.8)
      .from(scope.querySelector('.home-hero__actions'), { y: 12, opacity: 0, duration: 0.58 }, 0.9)
      .to(frameMark, { opacity: 1, duration: 0.45 }, 0.98)
      .from(scope.querySelector('.home-hero__frame-folio'), { opacity: 0, y: 8, duration: 0.5 }, 1)
      .from(scope.querySelector('.home-hero__rail'), { y: 10, opacity: 0, duration: 0.55 }, 1.06);

    if (video) {
      gsap.to(video, {
        scale: 1.05,
        ease: 'none',
        scrollTrigger: {
          trigger: scope,
          start: 'top top',
          end: 'bottom top',
          scrub: 1,
        },
      });
    }
  }
</script>
