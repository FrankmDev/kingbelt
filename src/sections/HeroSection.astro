---
import { hero } from '../data/home';
import Button from '../components/ui/Button.astro';
---

<section
  id="inicio"
  class="hero-shell grain-overlay relative overflow-hidden bg-[#0c0b0a]"
  data-gsap-hero
>
  <div class="hero-bg absolute inset-0">
    <video
      src="/heroVideo.mp4"
      autoplay
      muted
      loop
      playsinline
      poster="https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=1920&q=80"
      class="h-full w-full object-cover"
      style="filter: saturate(0.50) contrast(1.14) brightness(0.74);"
    />
  </div>

  <div class="hero-overlay absolute inset-0"></div>
  <div class="hero-grid absolute inset-0 pointer-events-none"></div>
  <div class="hero-vignette absolute inset-0 pointer-events-none"></div>
  <div class="hero-spotlight absolute inset-0 pointer-events-none"></div>

  <div class="absolute inset-8 z-[2] pointer-events-none md:inset-12 lg:inset-16">
    <div class="hero-frame hero-frame-tl kb-corner-frame"></div>
    <div class="hero-frame hero-frame-tr kb-corner-frame"></div>
    <div class="hero-frame hero-frame-bl kb-corner-frame"></div>
    <div class="hero-frame hero-frame-br kb-corner-frame"></div>
  </div>

  <div class="hero-inner relative z-10 mx-auto flex flex-col justify-center px-5 pb-14 pt-20 text-center md:px-10 md:pb-32 md:pt-36 lg:px-16">
    <div class="hero-copy mx-auto">
      <div class="hero-badge mx-auto mb-4 inline-flex items-center md:mb-8">
        <div class="hero-badge-inner relative flex items-center gap-3 overflow-hidden px-5 py-2 md:px-7 md:py-3">
          <span class="absolute inset-0 rounded-full border border-white/[0.08]"></span>
          <span class="absolute inset-[5px] rounded-full border border-white/[0.04]"></span>
          <span class="kb-pulse-dot h-1.5 w-1.5 rounded-full bg-king-accent/70"></span>
          <span class="eyebrow-text text-white/58">
            {hero.eyebrow}
          </span>
          <span class="h-1.5 w-1.5 rounded-full bg-king-accent/35"></span>
        </div>
      </div>

      <h1 class="font-serif leading-[0.9] tracking-[-0.03em] mb-4 md:mb-8">
        <span class="hero-title-1 block text-white text-[2.1rem] sm:text-[3.25rem] md:text-[4rem] lg:text-[5rem] xl:text-[5.8rem]">
          Cinturones con carácter.
        </span>
        <span class="hero-title-2 block text-white/94 text-[2.1rem] sm:text-[3.25rem] md:text-[4rem] lg:text-[5rem] xl:text-[5.8rem] italic mt-1 md:mt-2.5">
          Hechos para <span class="not-italic font-medium text-king-accent">durar</span>.
        </span>
      </h1>

      <p class="hero-sub mx-auto mb-5 max-w-[34rem] text-[13px] leading-[1.75] text-white/85 md:mb-14 md:text-[17px]">
        {hero.body}
      </p>

      <div class="hero-cta-wrap flex flex-col items-center justify-center gap-2.5 sm:flex-row md:gap-4">
        <Button
          href={hero.primaryCta.href}
          variant="secondary"
          size="md"
          class="rounded-full shadow-[0_16px_40px_rgba(138,106,61,0.24)]"
        >
          {hero.primaryCta.label}
          <svg class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </Button>
        <Button
          href={hero.secondaryCta.href}
          target="_blank"
          rel="noopener noreferrer"
          variant="surfaceOutline"
          size="md"
          class="rounded-full border-white/18 text-white/68 hover:border-white/40 hover:bg-white/[0.04] hover:text-white"
        >
          {hero.secondaryCta.label}
        </Button>
      </div>
    </div>

    {/* Vertical side labels — editorial detail */}
    <div class="hero-side-label hero-side-label-left pointer-events-none absolute left-0 top-1/2 z-10 hidden -translate-y-1/2 lg:block">
      <span class="hero-side-rule"></span>
      <span class="hero-side-text">Colección · 2025</span>
    </div>
    <div class="hero-side-label hero-side-label-right pointer-events-none absolute right-0 top-1/2 z-10 hidden -translate-y-1/2 lg:block">
      <span class="hero-side-text">Est. España</span>
      <span class="hero-side-rule"></span>
    </div>

    {/* Scroll indicator */}
    <a href="#coleccion" class="hero-scroll-indicator group" aria-label="Descubrir colección">
      <span class="hero-scroll-text">Descubrir</span>
      <span class="hero-scroll-line">
        <span class="hero-scroll-dot"></span>
      </span>
    </a>

    <div class="hero-bottom absolute bottom-0 left-0 right-0 z-10 border-t border-white/[0.06]">
      <div class="hero-bottom-inner mx-auto px-5 md:px-10">
        <div class="flex items-center justify-center gap-4 py-3.5 md:gap-10 md:py-6">
          <div class="hero-info-item">
            <span class="hero-info-label">Cuero seleccionado</span>
          </div>
          <span class="hidden h-3 w-px bg-white/[0.08] md:block"></span>
          <div class="hero-info-item">
            <span class="hero-info-label">Herrajes sólidos</span>
          </div>
          <span class="hidden h-3 w-px bg-white/[0.08] md:block"></span>
          <div class="hero-info-item hidden md:flex">
            <span class="hero-info-label">Hecho en España</span>
          </div>
          <span class="hidden h-3 w-px bg-white/[0.08] lg:block"></span>
          <div class="hero-info-item hidden lg:flex">
            <span class="hero-info-label">Uso diario</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    background:
      radial-gradient(circle at top, rgba(138, 106, 61, 0.1), transparent 34%),
      #0c0b0a;
  }

  .hero-overlay {
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.22), rgba(0, 0, 0, 0.08) 32%, rgba(0, 0, 0, 0.62) 100%),
      linear-gradient(100deg, rgba(7, 7, 7, 0.55) 10%, rgba(7, 7, 7, 0.12) 50%, rgba(7, 7, 7, 0.42) 100%);
  }

  .hero-grid {
    opacity: 0.28;
    background-image:
      linear-gradient(90deg, rgba(138, 106, 61, 0.08) 0, rgba(138, 106, 61, 0.08) 1px, transparent 1px, transparent 24%),
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 150px 100%, 100% 100%;
  }

  .hero-vignette {
    background: radial-gradient(ellipse 60% 56% at 50% 40%, transparent 0%, rgba(0, 0, 0, 0.10) 58%, rgba(0, 0, 0, 0.46) 100%);
  }

  .hero-spotlight {
    background:
      radial-gradient(circle at 50% 34%, rgba(255, 255, 255, 0.11), transparent 26%),
      radial-gradient(circle at 50% 62%, rgba(138, 106, 61, 0.12), transparent 30%);
    mix-blend-mode: screen;
  }

  .hero-shell {
    min-height: 100dvh;
  }

  .hero-inner {
    min-height: 100dvh;
    max-width: var(--kb-shell-max);
  }

  .hero-copy {
    max-width: var(--kb-shell-copy);
  }

  .hero-bottom-inner {
    max-width: var(--kb-shell-narrow);
  }

  .hero-frame {
    position: absolute;
  }

  .hero-frame-tl { top: 0; left: 0; }
  .hero-frame-tr { top: 0; right: 0; transform: scaleX(-1); }
  .hero-frame-bl { bottom: 0; left: 0; transform: scaleY(-1); }
  .hero-frame-br { right: 0; bottom: 0; transform: scale(-1); }

  .hero-badge-inner {
    border-radius: var(--kb-radius-pill);
    background: var(--kb-surface-dark);
    backdrop-filter: blur(var(--kb-blur-sm));
    -webkit-backdrop-filter: blur(var(--kb-blur-sm));
  }

  .hero-info-label {
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.52);
  }

  /* Vertical side labels */
  .hero-side-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: 1.5rem;
  }

  .hero-side-label-left {
    flex-direction: row;
  }

  .hero-side-label-right {
    flex-direction: row;
  }

  .hero-side-rule {
    display: block;
    width: 1px;
    height: 3.5rem;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.22), transparent);
  }

  .hero-side-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    font-feature-settings: 'tnum' on;
  }

  .hero-side-label-left .hero-side-text {
    transform: rotate(180deg);
  }

  .hero-side-label-right .hero-side-text {
    transform: rotate(0deg);
  }

  /* Scroll indicator */
  .hero-scroll-indicator {
    position: absolute;
    right: clamp(1.5rem, 3vw, 2.5rem);
    bottom: 6.5rem;
    z-index: 12;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .hero-scroll-indicator {
      display: flex;
    }
  }

  .hero-scroll-text {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .hero-scroll-line {
    position: relative;
    display: block;
    width: 1px;
    height: 3.5rem;
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }

  .hero-scroll-dot {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 1rem;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.85));
    animation: hero-scroll-dot 2.4s var(--kb-ease-out, cubic-bezier(0.22, 1, 0.36, 1)) infinite;
  }

  @keyframes hero-scroll-dot {
    0% { transform: translate(-50%, -100%); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translate(-50%, 250%); opacity: 0; }
  }

  @media (max-width: 767px) {
    .hero-shell {
      height: 100dvh;
      min-height: 100dvh;
      overflow: hidden;
    }
    .hero-inner {
      height: 100dvh;
      min-height: 100dvh;
      display: grid;
      grid-template-rows: 1fr auto 1fr;
      align-items: center;
      padding-top: 0;
      padding-bottom: 0;
    }
    .hero-copy {
      grid-row: 2;
      align-self: center;
    }
    .hero-bottom {
      grid-row: 3;
      position: relative;
      align-self: end;
    }
    .hero-grid {
      background-size: 96px 100%, 100% 100%;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const scope = document.querySelector('[data-gsap-hero]');
  if (scope) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from(scope.querySelector('.hero-bg'), { scale: 1.08, opacity: 0, duration: 2.1 })
      .from(scope.querySelector('.hero-overlay'), { opacity: 0, duration: 1.3 }, 0)
      .from(scope.querySelectorAll('.hero-frame'), {
        opacity: 0,
        scale: 0.55,
        duration: 0.9,
        stagger: 0.06,
      }, 0.35)
      .from(scope.querySelector('.hero-badge'), { y: 16, opacity: 0, duration: 0.85 }, 0.7)
      .from(scope.querySelector('.hero-title-1'), { y: 40, opacity: 0, duration: 1.2 }, 0.95)
      .from(scope.querySelector('.hero-title-2'), { y: 40, opacity: 0, duration: 1.2 }, 1.06)
      .from(scope.querySelector('.hero-sub'), { y: 18, opacity: 0, duration: 0.9 }, 1.3)
      .from(scope.querySelector('.hero-cta-wrap'), { y: 14, opacity: 0, duration: 0.85 }, 1.42)
      .from(scope.querySelector('.hero-bottom'), { y: 18, opacity: 0, duration: 0.75 }, 1.56);
  }
</script>
