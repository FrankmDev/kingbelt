---
import SectionHeaderHome from '../components/common/SectionHeaderHome.astro';
import Badge from '../components/ui/Badge.astro';
import { productCategories } from '../data/catalog';
import { categoriesSection } from '../data/home';

const featured = productCategories.find((category) => category.featured) ?? productCategories[0];
const secondary = productCategories.filter((category) => category.id !== featured.id);

const cards = [
  { category: featured, index: 1, placement: 'hero' as const },
  ...secondary.map((category, index) => ({
    category,
    index: index + 2,
    placement: index === 0 ? ('top' as const) : ('bottom' as const),
  })),
];
---

<section
  id="coleccion"
  class="home-categories section-spacing section-spacing-chapter"
  aria-labelledby="home-categories-title"
>
  <div class="kb-shell-wide section-stack-lg">
    <SectionHeaderHome
      index={categoriesSection.index}
      eyebrow={categoriesSection.eyebrow}
      body={categoriesSection.body}
      meta={categoriesSection.meta}
      titleId="home-categories-title"
      class="home-categories__header"
    >
      <Fragment slot="title">
        <span set:html={categoriesSection.title} />
      </Fragment>
    </SectionHeaderHome>

    <div class="home-categories__grid">
      {cards.map(({ category, index, placement }) => (
        <a
          href={category.href}
          class:list={[
            'home-categories__card',
            placement === 'hero' && 'home-categories__card--hero',
            placement === 'top' && 'home-categories__card--top',
            placement === 'bottom' && 'home-categories__card--bottom',
          ]}
          aria-label={`Explorar categoría ${category.name}`}
        >
          <div class="home-categories__media-wrap">
            <img
              src={category.image}
              alt={category.imageAlt}
              width={placement === 'hero' ? 1200 : 960}
              height={placement === 'hero' ? 1600 : 720}
              loading="lazy"
              decoding="async"
              class="home-categories__media"
              style={`object-position: ${category.imagePosition ?? 'center'}`}
            />
          </div>

          <div
            class:list={[
              'home-categories__shade',
              placement === 'hero' && 'home-categories__shade--hero',
            ]}
            aria-hidden="true"
          ></div>
          <div class="home-categories__grain kb-texture-asphalt" aria-hidden="true"></div>

          <div
            class:list={[
              'home-categories__top',
              placement === 'hero' && 'home-categories__top--hero',
            ]}
          >
            <div class="home-categories__badges">
              <Badge variant="dark" class="home-categories__badge">
                {String(index).padStart(2, '0')}
              </Badge>
              {category.badge && (
                <Badge variant="accent" class="home-categories__badge">
                  {category.badge}
                </Badge>
              )}
            </div>
          </div>

          <div
            class:list={[
              'home-categories__caption',
              placement === 'hero' && 'home-categories__caption--hero',
            ]}
          >
            <span
              class:list={[
                'home-categories__folio',
                placement !== 'hero' && 'home-categories__folio--compact',
              ]}
              aria-hidden="true"
            >
              {String(index).padStart(2, '0')}
            </span>

            <div class="home-categories__copy">
              <h3
                class:list={[
                  'home-categories__title',
                  placement !== 'hero' && 'home-categories__title--compact',
                ]}
              >
                {category.name}
              </h3>

              {category.tagline && (
                <p
                  class:list={[
                    'home-categories__tagline',
                    placement !== 'hero' && 'home-categories__tagline--compact',
                  ]}
                >
                  {category.tagline}
                </p>
              )}

              <span class="home-categories__action kb-meta-label">Explorar</span>
            </div>
          </div>

          <span class="home-categories__accent" aria-hidden="true"></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .home-categories {
    background: var(--color-king-surface);
  }

  .home-categories__header:global(.section-header-home) .shh-body {
    max-width: 42ch;
  }

  .home-categories__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-2);
    min-width: 0;
  }

  .home-categories__card {
    --cat-accent: var(--color-king-accent-light);

    position: relative;
    display: block;
    min-width: 0;
    min-height: clamp(18rem, 56vw, 24rem);
    overflow: hidden;
    color: var(--color-king-bone);
    text-decoration: none;
    border: 1px solid var(--kb-stroke-dark);
    border-radius: var(--kb-card-radius);
    background: var(--color-king-oil);
    box-shadow: var(--kb-shadow-sm);
    isolation: isolate;
  }

  .home-categories__card--hero {
    min-height: clamp(24rem, 76vw, 34rem);
  }

  .home-categories__media-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .home-categories__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    filter: saturate(0.86) contrast(1.06) brightness(0.9);
    transition:
      transform 0.85s var(--kb-ease-soft),
      filter 0.85s var(--kb-ease-soft);
  }

  .home-categories__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(11, 10, 8, 0.55) 0%, rgba(11, 10, 8, 0.2) 24%, transparent 42%),
      linear-gradient(
        to top,
        rgba(11, 10, 8, 0.8) 0%,
        rgba(11, 10, 8, 0.28) 40%,
        transparent 68%
      );
    transition: opacity 0.65s var(--kb-ease-out);
  }

  .home-categories__shade--hero {
    background:
      linear-gradient(180deg, rgba(11, 10, 8, 0.58) 0%, rgba(11, 10, 8, 0.22) 26%, transparent 44%),
      linear-gradient(
        to top,
        rgba(11, 10, 8, 0.84) 0%,
        rgba(11, 10, 8, 0.32) 44%,
        transparent 72%
      );
  }

  .home-categories__grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0.14;
    pointer-events: none;
    mix-blend-mode: soft-light;
    transition: opacity 0.65s var(--kb-ease-out);
  }

  .home-categories__grain::before {
    opacity: 0.55;
  }

  .home-categories__top {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--kb-space-4);
    pointer-events: none;
  }

  .home-categories__top--hero {
    padding: var(--kb-space-5);
  }

  .home-categories__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 3;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: var(--kb-space-3);
    padding: var(--kb-space-4) var(--kb-space-5);
    pointer-events: none;
  }

  .home-categories__caption--hero {
    gap: var(--kb-space-4);
    padding: var(--kb-space-5) var(--kb-space-6);
  }

  .home-categories__folio {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 5.5rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: rgba(255, 250, 241, 0.44);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
    transition:
      color 0.65s var(--kb-ease-out),
      transform 0.65s var(--kb-ease-out);
  }

  .home-categories__folio--compact {
    font-size: clamp(2.5rem, 6vw, 3.25rem);
  }

  .home-categories__copy {
    display: grid;
    gap: var(--kb-space-2);
    min-width: 0;
    padding-bottom: 0.15rem;
  }

  .home-categories__caption--hero .home-categories__copy {
    gap: var(--kb-space-3);
  }

  .home-categories__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kb-space-2);
  }

  .home-categories__badge:global(.kb-badge) {
    padding: 0.34rem 0.62rem;
    font-size: var(--kb-text-meta);
    letter-spacing: 0.12em;
    backdrop-filter: blur(12px);
    box-shadow: var(--kb-shadow-xs);
  }

  .home-categories__badge:global(.kb-badge-dark) {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(11, 10, 8, 0.58);
    color: var(--color-king-bone);
  }

  .home-categories__badge:global(.kb-badge-accent) {
    border-color: rgba(201, 168, 124, 0.42);
    background: rgba(11, 10, 8, 0.52);
    color: var(--color-king-accent-light);
  }

  .home-categories__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 6.5vw, 4.25rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 0.9;
    letter-spacing: -0.038em;
    text-wrap: balance;
    color: var(--color-king-bone);
    text-shadow:
      0 2px 24px rgba(0, 0, 0, 0.55),
      0 1px 3px rgba(0, 0, 0, 0.35);
    transition:
      transform 0.65s var(--kb-ease-out),
      letter-spacing 0.65s var(--kb-ease-out),
      color 0.65s var(--kb-ease-out);
  }

  .home-categories__title--compact {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    line-height: 0.92;
    letter-spacing: -0.032em;
  }

  .home-categories__tagline {
    margin: 0;
    max-width: 28ch;
    font-family: var(--font-sans);
    font-size: var(--kb-text-sm);
    font-weight: var(--kb-w-body);
    letter-spacing: 0.02em;
    line-height: 1.45;
    color: rgba(255, 250, 241, 0.84);
    transition:
      opacity 0.65s var(--kb-ease-out),
      transform 0.65s var(--kb-ease-out),
      color 0.65s var(--kb-ease-out);
  }

  .home-categories__tagline--compact {
    display: none;
  }

  .home-categories__action {
    position: relative;
    display: inline-block;
    width: fit-content;
    margin-top: var(--kb-space-1);
    padding-top: var(--kb-space-2);
    color: rgba(255, 250, 241, 0.72);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.65s var(--kb-ease-out);
  }

  .home-categories__action::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1.75rem;
    height: 1px;
    background: var(--cat-accent);
    transform: scaleX(0.35);
    transform-origin: left center;
    transition: transform 0.7s var(--kb-ease-out);
  }

  .home-categories__accent {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 4;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-brass) 70%, transparent) 55%,
      transparent
    );
    transform: scaleX(0.22);
    transform-origin: left center;
    pointer-events: none;
    transition: transform 0.75s var(--kb-ease-out);
  }

  .home-categories__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    pointer-events: none;
    opacity: 0.55;
    transition: opacity 0.65s var(--kb-ease-out);
  }

  .home-categories__card:focus-visible {
    outline: 2px solid var(--color-king-accent);
    outline-offset: 2px;
  }

  @media (min-width: 40rem) {
    .home-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--kb-space-3);
    }

    .home-categories__card--hero {
      grid-column: 1 / -1;
      min-height: clamp(22rem, 48vw, 30rem);
    }

    .home-categories__card:not(.home-categories__card--hero) {
      min-height: clamp(15rem, 32vw, 19rem);
    }

    .home-categories__tagline--compact {
      display: block;
      max-width: 22ch;
      font-size: var(--kb-text-xs);
      line-height: 1.4;
    }
  }

  @media (min-width: 64rem) {
    .home-categories__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: var(--kb-space-3);
      min-height: clamp(34rem, 42vw, 40rem);
    }

    .home-categories__card--hero {
      grid-column: 1;
      grid-row: 1 / -1;
      min-height: 0;
    }

    .home-categories__card--top {
      grid-column: 2;
      grid-row: 1;
      min-height: 0;
    }

    .home-categories__card--bottom {
      grid-column: 2;
      grid-row: 2;
      min-height: 0;
    }

    .home-categories__card:not(.home-categories__card--hero) {
      min-height: 0;
    }

    .home-categories__title {
      font-size: clamp(3rem, 3.4vw, 4.5rem);
    }

    .home-categories__title--compact {
      font-size: clamp(1.85rem, 1.7vw, 2.35rem);
    }

    .home-categories__folio {
      font-size: clamp(4rem, 5vw, 6rem);
    }

    .home-categories__folio--compact {
      font-size: clamp(2.75rem, 3vw, 3.5rem);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-categories__card:hover .home-categories__media {
      transform: scale(1.12) translateY(-2.5%);
      filter: saturate(0.94) contrast(1.08) brightness(0.97);
    }

    .home-categories__card:hover .home-categories__shade {
      opacity: 0.92;
    }

    .home-categories__card:hover .home-categories__grain {
      opacity: 0.22;
    }

    .home-categories__card:hover .home-categories__folio {
      color: rgba(201, 168, 124, 0.78);
      transform: translateY(-4px);
    }

    .home-categories__card:hover .home-categories__title {
      transform: translateY(-5px);
      letter-spacing: -0.03em;
      color: rgba(255, 250, 241, 1);
    }

    .home-categories__card:hover .home-categories__tagline {
      transform: translateY(-3px);
      color: rgba(255, 250, 241, 0.88);
    }

    .home-categories__card:hover .home-categories__action {
      color: var(--color-king-accent-light);
    }

    .home-categories__card:hover .home-categories__action::before {
      transform: scaleX(1);
    }

    .home-categories__card:hover .home-categories__accent {
      transform: scaleX(1);
    }

    .home-categories__card:hover::after {
      opacity: 1;
      box-shadow:
        inset 0 0 0 1px rgba(166, 124, 78, 0.18),
        inset 0 -24px 48px rgba(11, 10, 8, 0.22);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-categories__media,
    .home-categories__shade,
    .home-categories__grain,
    .home-categories__folio,
    .home-categories__title,
    .home-categories__tagline,
    .home-categories__action,
    .home-categories__action::before,
    .home-categories__accent,
    .home-categories__card::after {
      transition: none;
    }
  }
</style>
