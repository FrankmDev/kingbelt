---
import SectionHeaderHome from '../components/common/SectionHeaderHome.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { featuredProducts, formatPrice } from '../data/catalog';
import { featuredSection } from '../data/home';
---

<section
  id="seleccion"
  class="home-featured section-spacing section-spacing-chapter"
  aria-labelledby="home-featured-title"
>
  <div class="kb-shell-wide section-stack-lg">
    <div class="home-featured__head">
      <SectionHeaderHome
        index={featuredSection.index}
        eyebrow={featuredSection.eyebrow}
        body={featuredSection.body}
        meta={featuredSection.meta}
        titleId="home-featured-title"
        class="home-featured__header"
      >
        <Fragment slot="title">
          <span set:html={featuredSection.title} />
        </Fragment>
      </SectionHeaderHome>

      <div class="home-featured__cta">
        <Button href={featuredSection.cta.href} variant="outline" size="md">
          {featuredSection.cta.label}
          <Icon
            name="arrow-right"
            class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
          />
        </Button>
      </div>
    </div>

    <ul class="home-featured__grid">
      {featuredProducts.map((product, index) => {
        const priceLabel = formatPrice(product.price, product.currency);
        const ref = product.id.toUpperCase();

        return (
          <li class="home-featured__item">
            <article class="home-featured__card kb-rise-sm">
              <div class="home-featured__media">
                <img
                  src={product.image}
                  alt={product.imageAlt}
                  width="480"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  style={`object-position: ${product.imagePosition ?? 'center'}`}
                />

                <div class="home-featured__tags">
                  {product.badge ? (
                    <Badge variant="steel">{product.badge}</Badge>
                  ) : (
                    <span aria-hidden="true" />
                  )}
                  <span class="home-featured__folio kb-meta-label" aria-hidden="true">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                <span class="home-featured__media-line" aria-hidden="true" />
              </div>

              <div class="home-featured__info">
                <p class="home-featured__meta kb-meta-label text-king-muted">
                  {product.category} · {product.color}
                </p>
                <h3 class="home-featured__name font-display">{product.name}</h3>
                <p class="home-featured__excerpt text-king-muted">{product.excerpt}</p>

                <div class="home-featured__stitch kb-stitch-line" aria-hidden="true" />

                <div class="home-featured__foot">
                  <span class="home-featured__price">{priceLabel}</span>
                  <span class="home-featured__ref kb-code-label text-king-muted">{ref}</span>
                </div>

                <Button
                  href={product.href}
                  variant="outline"
                  size="sm"
                  class="home-featured__action"
                  aria-label={`Ver producto: ${product.name}`}
                >
                  Ver
                  <Icon
                    name="arrow-right"
                    class="h-3 w-3 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1"
                  />
                </Button>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .home-featured__head {
    display: grid;
    gap: var(--kb-space-6);
    align-items: end;
  }

  .home-featured__header:global(.section-header-home) .shh-body {
    max-width: 44ch;
  }

  /* ---------- Grid de destacados ---------- */

  .home-featured__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--kb-space-8) var(--kb-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-featured__item {
    min-width: 0;
  }

  .home-featured__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
  }

  /* ---------- Media ---------- */

  .home-featured__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--kb-stroke-hairline);
    border-radius: var(--kb-radius-sm);
    background: var(--color-king-bone);
    box-shadow: var(--kb-shadow-xs);
    transition:
      border-color var(--kb-dur-med) var(--kb-ease-out),
      box-shadow var(--kb-dur-med) var(--kb-ease-out);
  }

  .home-featured__media::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 32%;
    background: linear-gradient(
      to bottom,
      rgba(13, 13, 12, 0.32),
      rgba(13, 13, 12, 0.08) 55%,
      transparent
    );
    pointer-events: none;
  }

  .home-featured__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.03);
    transform: translateZ(0);
    transition: transform var(--kb-dur-slow) var(--kb-ease-soft);
    will-change: transform;
  }

  .home-featured__tags {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--kb-space-2);
    padding: var(--kb-space-3);
    pointer-events: none;
  }

  .home-featured__folio {
    color: var(--color-king-bone);
    text-shadow: 0 1px 8px rgba(13, 13, 12, 0.55);
    font-variant-numeric: tabular-nums;
  }

  .home-featured__media-line {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 1;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-king-accent),
      color-mix(in srgb, var(--color-king-brass) 70%, transparent) 60%,
      transparent
    );
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
    transition: transform var(--kb-dur-med) var(--kb-ease-out);
  }

  /* ---------- Información ---------- */

  .home-featured__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding-top: var(--kb-space-4);
  }

  .home-featured__meta {
    margin: 0 0 var(--kb-space-2);
  }

  .home-featured__name {
    margin: 0 0 var(--kb-space-2);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: var(--kb-w-heading-light);
    line-height: 1.06;
    letter-spacing: -0.018em;
    text-wrap: balance;
    color: var(--color-king-text);
    transition: color var(--kb-dur-med) var(--kb-ease-out);
  }

  .home-featured__excerpt {
    margin: 0 0 var(--kb-space-4);
    font-size: var(--kb-text-sm);
    line-height: 1.55;
  }

  .home-featured__stitch {
    width: 100%;
    height: 1px;
    margin: auto 0 var(--kb-space-3);
  }

  .home-featured__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--kb-space-3);
    margin-bottom: var(--kb-space-4);
  }

  .home-featured__price {
    font-family: var(--font-sans);
    font-size: var(--kb-text-body-lg);
    font-weight: var(--kb-w-semibold);
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--color-king-text);
  }

  .home-featured__info :global(.home-featured__action) {
    justify-content: center;
    width: 100%;
  }

  /* ---------- Responsive ---------- */

  @media (min-width: 40rem) {
    .home-featured__grid {
      gap: var(--kb-space-8) var(--kb-space-5);
    }

    .home-featured__info {
      padding-top: var(--kb-space-5);
    }
  }

  @media (min-width: 48rem) {
    .home-featured__head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--kb-space-8);
    }

    .home-featured__cta {
      justify-self: end;
      padding-bottom: 0.35rem;
    }
  }

  @media (min-width: 64rem) {
    .home-featured__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--kb-space-8) var(--kb-space-6);
    }
  }

  /* ---------- Hover ---------- */

  @media (hover: hover) and (pointer: fine) {
    .home-featured__card:hover .home-featured__media {
      border-color: var(--kb-stroke-accent);
      box-shadow: var(--kb-shadow-md);
    }

    .home-featured__card:hover .home-featured__media img {
      transform: scale(1.06);
    }

    .home-featured__card:hover .home-featured__media-line {
      transform: scaleX(1);
    }

    .home-featured__card:hover .home-featured__name {
      color: var(--color-king-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-featured__card,
    .home-featured__media,
    .home-featured__media img,
    .home-featured__media-line,
    .home-featured__name {
      transition: none;
    }
  }
</style>
