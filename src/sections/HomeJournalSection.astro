---
import SectionHeader from '../components/common/SectionHeader.astro';
import BlogCard from '../components/ui/BlogCard.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import type { BlogPost } from '../data/blog';
import { journalSection } from '../data/home';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const [lead, ...secondary] = posts;
---

<section
  id="revista"
  class="home-journal section-spacing section-spacing-chapter"
  aria-labelledby="home-journal-title"
>
  <div class="kb-shell-wide section-stack-lg">
    <div class="home-journal__head">
      <SectionHeader
        eyebrow={journalSection.eyebrow}
        body={journalSection.body}
        titleId="home-journal-title"
        align="left"
        class="home-journal__header"
      >
        <Fragment slot="title">
          <span set:html={journalSection.title} />
        </Fragment>
      </SectionHeader>

      <div class="home-journal__cta">
        <Button href={journalSection.cta.href} variant="outline" size="md">
          {journalSection.cta.label}
          <Icon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-[var(--kb-dur-fast)] group-hover:translate-x-1" />
        </Button>
      </div>
    </div>

    {lead && (
      <div class="home-journal__stage">
        <div class="home-journal__stage-texture" aria-hidden="true"></div>

        <span class="home-journal__corner kb-corner-bracket kb-corner-bracket-tl" aria-hidden="true"></span>
        <span class="home-journal__corner kb-corner-bracket kb-corner-bracket-tr" aria-hidden="true"></span>
        <span class="home-journal__corner kb-corner-bracket kb-corner-bracket-bl" aria-hidden="true"></span>
        <span class="home-journal__corner kb-corner-bracket kb-corner-bracket-br" aria-hidden="true"></span>

        <div class="home-journal__grid">
          <BlogCard
            variant="bento"
            folio="01"
            title={lead.title}
            excerpt={lead.excerpt}
            slug={lead.slug}
            image={lead.image}
            imageAlt={lead.imageAlt}
            imageWidth={960}
            imageHeight={720}
            imagePosition={lead.imagePosition}
            category={lead.category}
            date={lead.dateLabel}
            readingTime={lead.readingTime}
            class="home-journal__lead"
          />

          <ul class="home-journal__secondary" aria-label="Artículos secundarios">
            {secondary.map((post, index) => (
              <li>
                <BlogCard
                  variant="strip"
                  title={post.title}
                  excerpt={post.excerpt}
                  slug={post.slug}
                  image={post.image}
                  imageAlt={post.imageAlt}
                  imageWidth={480}
                  imageHeight={360}
                  imagePosition={post.imagePosition}
                  category={post.category}
                  date={post.dateLabel}
                  readingTime={post.readingTime}
                  folio={String(index + 2).padStart(2, '0')}
                />
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .home-journal {
    background: var(--color-king-bg);
  }

  .home-journal__head {
    display: grid;
    gap: var(--kb-space-6);
    align-items: end;
  }

  .home-journal__header:global(.section-header) {
    --sh-max-copy: 40ch;
  }

  .home-journal__stage {
    position: relative;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--kb-stroke-dark);
    border-radius: var(--kb-panel-radius);
    background: var(--color-king-surface);
    box-shadow: var(--kb-shadow-sm);
  }

  .home-journal__stage-texture {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0.35;
    background-image:
      linear-gradient(90deg, rgba(138, 90, 43, 0.04) 0, rgba(138, 90, 43, 0.04) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.02) 1px, transparent 1px);
    background-size: 10rem 100%, 100% 5rem;
    pointer-events: none;
  }

  .home-journal__corner {
    position: absolute;
    z-index: 1;
    opacity: 0.55;
  }

  .home-journal__corner.kb-corner-bracket-tl { top: 0.65rem; left: 0.65rem; }
  .home-journal__corner.kb-corner-bracket-tr { top: 0.65rem; right: 0.65rem; }
  .home-journal__corner.kb-corner-bracket-bl { bottom: 0.65rem; left: 0.65rem; }
  .home-journal__corner.kb-corner-bracket-br { bottom: 0.65rem; right: 0.65rem; }

  .home-journal__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap);
    min-width: 0;
  }

  .home-journal__secondary {
    display: grid;
    gap: var(--kb-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .home-journal__lead:global(.kb-blog-card[data-variant='bento']) {
    min-height: clamp(20rem, 52vw, 26rem);
  }

  @media (min-width: 48rem) {
    .home-journal__head {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--kb-space-8);
    }

    .home-journal__cta {
      padding-bottom: 0.35rem;
    }

    .home-journal__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      align-items: stretch;
    }

    .home-journal__secondary {
      align-content: start;
    }
  }
</style>
