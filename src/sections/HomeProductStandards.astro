---
import SectionHeaderHome from '../components/common/SectionHeaderHome.astro';
import MediaFrame from '../components/ui/MediaFrame.astro';
import { standardsSection } from '../data/home';

const { panel, principles } = standardsSection;
const layerCount = principles.length;
---

<section
  id="criterio"
  class="home-standards section-spacing section-spacing-chapter"
  aria-labelledby="home-standards-title"
>
  <div class="kb-shell-wide section-stack-lg">
    <SectionHeaderHome
      index={standardsSection.index}
      eyebrow={standardsSection.eyebrow}
      body={standardsSection.lede}
      meta={standardsSection.meta}
      class="home-standards__header"
    >
      <Fragment slot="title">
        <span id="home-standards-title" set:html={standardsSection.title} />
      </Fragment>
    </SectionHeaderHome>

    <div class="home-standards__layout">
      <MediaFrame
        src={standardsSection.image}
        alt={standardsSection.imageAlt}
        ratio="4/3"
        label={standardsSection.imageLabel}
        caption={standardsSection.imageCaption}
        captionNumber="01"
        imagePosition="center 58%"
        width={1600}
        height={1200}
        loading="lazy"
        class="home-standards__media"
      />

      <aside class="kb-reading-panel" aria-labelledby="home-standards-panel-title">
        <header class="kb-reading-panel__head">
          <div class="kb-reading-panel__head-bar">
            <p class="kb-eyebrow kb-eyebrow-lined kb-reading-panel__eyebrow">
              {panel.eyebrow}
            </p>
            <span class="kb-reading-panel__folio kb-meta-label" aria-hidden="true">
              {String(layerCount).padStart(2, '0')}
            </span>
          </div>

          <p id="home-standards-panel-title" class="kb-reading-panel__statement">
            {panel.statement}
          </p>
        </header>

        <ol class="kb-reading-panel__layers">
          {principles.map((layer, index) => (
            <li class="kb-reading-panel__layer">
              <div class="kb-reading-panel__rail" aria-hidden="true">
                <span class="kb-reading-panel__num">{layer.number}</span>
                {index < layerCount - 1 && (
                  <span class="kb-reading-panel__rail-line"></span>
                )}
              </div>

              <div class="kb-reading-panel__body">
                <div class="kb-reading-panel__layer-head">
                  <h3 class="kb-reading-panel__label">{layer.label}</h3>
                  <span class="kb-reading-panel__tag">{layer.meta}</span>
                </div>
                <p class="kb-reading-panel__text">{layer.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="kb-reading-panel__foot" aria-hidden="true">
          <span class="kb-reading-panel__track"></span>
          <span class="kb-reading-panel__track"></span>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .home-standards {
    background: var(--color-king-surface);
  }

  .home-standards__header:global(.section-header-home) .shh-body {
    max-width: 42ch;
  }

  .home-standards__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--kb-space-gap-lg);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .home-standards__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: stretch;
    }

    .kb-reading-panel {
      height: 100%;
    }

    .home-standards__media:global(.media-frame) {
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
    }
  }
</style>
