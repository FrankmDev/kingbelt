---
import { marqueeLine } from '../data/home';

const repeat = [marqueeLine, marqueeLine].join('   ·   ');
---

<section class="overflow-hidden bg-king-bg py-6 md:py-8" aria-label="Detalles de marca">
  <div class="relative border-y border-white/[0.08] bg-king-graphite py-4 shadow-[var(--kb-shadow-inset-steel)]">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-king-graphite to-transparent md:w-40"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-king-graphite to-transparent md:w-40"></div>

    <div class="flex animate-marquee-left whitespace-nowrap">
      <span class="mx-8 inline-block eyebrow-text text-white/50 md:mx-10">
        {repeat}
      </span>
    </div>
  </div>
</section>
