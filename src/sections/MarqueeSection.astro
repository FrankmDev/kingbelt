---
import { marqueeLine } from '../data/home';

const repeat = [marqueeLine, marqueeLine].join('   ·   ');
---

<section class="overflow-hidden bg-king-bg py-6 md:py-8" aria-label="Detalles de marca">
  <div class="relative border-y border-king-border/40 bg-king-surface/50 py-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.4),inset_0_-1px_0_rgba(0,0,0,0.03)]">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-king-bg to-transparent md:w-40"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-king-bg to-transparent md:w-40"></div>

    <div class="flex animate-marquee-left whitespace-nowrap">
      <span class="mx-8 inline-block text-[12px] font-medium uppercase tracking-[0.28em] text-king-text/50 md:mx-10 md:text-[13px]">
        {repeat}
      </span>
    </div>
  </div>
</section>
