---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeader from '../components/common/SectionHeader.astro';
import { products } from '../data/products';
import Badge from '../components/ui/Badge.astro';

const allImages = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/products/*.avif', {
    eager: true,
  })
)
  .map((entry) => entry.default)
  .sort((a, b) => a.src.localeCompare(b.src));

const featuredProduct = products.find((p) => p.slug === 'highway-king') ?? products[0];
const gridProducts = products.filter((p) => p.slug !== featuredProduct.slug);

const getImageForProduct = (productIndex: number, variant: 'primary' | 'hover') => {
  const offset = variant === 'hover' ? 3 : 0;
  return allImages[(productIndex + offset) % allImages.length];
};

const featuredIndex = products.indexOf(featuredProduct);

const badgeType = (badge?: string) => {
  if (badge === 'bestseller') return 'bestseller';
  if (badge === 'new') return 'new';
  return 'default';
};
---

<section
  id="coleccion"
  class="product-grid-shell relative overflow-hidden bg-king-bg py-24 md:py-32 lg:py-40"
  data-gsap-product-grid
>
  <div class="pg-bg pointer-events-none absolute inset-0"></div>
  <div class="kb-shell-wide relative">
    <div class="pg-heading mb-10 lg:mb-14">
      <SectionHeader
        eyebrow="Colección"
        body="Materiales reales, herrajes con peso y una estética pensada para envejecer bien con el uso."
        ref="7 modelos"
        size="md"
      >
        <Fragment slot="title">
          Siete modelos,
          <span class="block italic text-king-text/78">una filosofía.</span>
        </Fragment>
      </SectionHeader>
    </div>

    {/* Featured — cinematic magazine cover */}
    <a
      href={`/product/${featuredProduct.slug}`}
      class="pg-featured group relative mb-8 block overflow-hidden rounded-[var(--kb-radius-lg)] lg:mb-12"
      data-pg-card
    >
      <div class="relative aspect-[16/10] overflow-hidden md:aspect-[21/9] lg:aspect-[2.8/1]">
        <Image
          src={getImageForProduct(featuredIndex, 'primary')}
          alt={`${featuredProduct.name} — cinturón de cuero`}
          class="h-full w-full object-cover transition-transform duration-[1400ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]"
          loading="eager"
          sizes="100vw"
        />

        {/* Layered cinematic gradients */}
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/15 to-transparent"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(138,106,61,0.12),transparent_40%)]"></div>

        {/* Inner frame */}
        <div class="pointer-events-none absolute inset-5 rounded-[calc(var(--kb-radius-lg)-0.5rem)] border border-white/[0.06] transition-colors duration-700 group-hover:border-white/[0.12]"></div>

        {/* Corner accents */}
        <div class="pointer-events-none absolute inset-6 z-10 md:inset-7">
          <span class="kb-corner-frame absolute left-0 top-0"></span>
          <span class="kb-corner-frame absolute right-0 top-0" style="transform: scaleX(-1);"></span>
          <span class="kb-corner-frame absolute bottom-0 left-0" style="transform: scaleY(-1);"></span>
          <span class="kb-corner-frame absolute bottom-0 right-0" style="transform: scale(-1);"></span>
        </div>

        {/* Bottom accent line */}
        <div class="absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-king-accent transition-transform duration-700 ease-out group-hover:scale-x-100"></div>

        <div class="absolute bottom-0 left-0 p-6 md:p-10 lg:p-14">
          <div class="mb-4">
            <Badge type="featured" />
          </div>
          <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-king-accent/80">
            {featuredProduct.id}
          </span>
          <h3 class="mt-2 font-display text-[2.2rem] font-light leading-[0.92] tracking-[-0.02em] md:text-[3.2rem] lg:text-[4rem]">
            {featuredProduct.name}
          </h3>
          <p class="mt-3 max-w-lg text-[14px] leading-[1.7] text-white/70 md:text-[15px] lg:mt-4">
            {featuredProduct.shortDescription}
          </p>
          <div class="mt-5 flex items-center gap-4">
            {featuredProduct.colors.slice(0, 4).map((color) => (
              <span
                class="h-5 w-5 rounded-full border-2 border-white/40 shadow-sm transition-transform duration-300 group-hover:scale-110"
                style={`background-color: ${color.hex}`}
                title={color.name}
              />
            ))}
            <span class="ml-3 inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.18em] text-white/80 transition-all duration-500 group-hover:gap-3">
              Ver detalle
              <span class="pg-arrow h-px w-6 bg-king-accent transition-all duration-500 group-hover:w-10"></span>
            </span>
          </div>
        </div>
      </div>
    </a>

    {/* Grid — editorial lookbook */}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {gridProducts.map((product) => {
        const originalIndex = products.indexOf(product);

        return (
          <a
            href={`/product/${product.slug}`}
            class="pg-card group relative block overflow-hidden rounded-[var(--kb-radius-lg)]"
            data-pg-card
          >
            <div class="relative aspect-[3/4] overflow-hidden">
              {/* Primary image */}
              <Image
                src={getImageForProduct(originalIndex, 'primary')}
                alt={`${product.name} — cinturón de cuero`}
                class="pg-card-img absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
                loading="lazy"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
              {/* Hover image */}
              <Image
                src={getImageForProduct(originalIndex, 'hover')}
                alt={`${product.name} detalle`}
                class="pg-card-hover-img absolute inset-0 h-full w-full scale-[1.06] object-cover opacity-0 transition-[opacity,transform] duration-[1000ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-100 group-hover:opacity-100"
                loading="lazy"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />

              {/* Cinematic overlay layers */}
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>
              <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-transparent"></div>
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(138,106,61,0.10),transparent_50%)] opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>

              {/* Shimmer on hover */}
              <div class="pg-shimmer absolute inset-0 opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>

              {/* Inner frame border */}
              <div class="pointer-events-none absolute inset-4 rounded-[calc(var(--kb-radius-lg)-0.5rem)] border border-white/[0.06] transition-colors duration-700 group-hover:border-white/[0.14] md:inset-5"></div>

              {/* Corner accents */}
              <div class="pointer-events-none absolute inset-5 z-10 md:inset-6">
                <span class="kb-corner-frame absolute left-0 top-0"></span>
                <span class="kb-corner-frame absolute right-0 top-0" style="transform: scaleX(-1);"></span>
                <span class="kb-corner-frame absolute bottom-0 left-0" style="transform: scaleY(-1);"></span>
                <span class="kb-corner-frame absolute bottom-0 right-0" style="transform: scale(-1);"></span>
              </div>

              {/* Top bar: badge + ID */}
              <div class="absolute left-5 right-5 top-5 z-10 flex items-start justify-between md:left-6 md:right-6 md:top-6">
                <Badge type={badgeType(product.badge)} />
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40">
                  {product.id}
                </span>
              </div>

              {/* Accent line top */}
              <div class="absolute left-0 right-0 top-0 h-px bg-[linear-gradient(90deg,transparent_0%,var(--color-king-accent)_50%,transparent_100%)] opacity-0 transition-opacity duration-500 group-hover:opacity-50"></div>

              {/* Bottom info */}
              <div class="absolute bottom-0 left-0 right-0 z-10 p-5 md:p-6">
                {/* Accent line */}
                <div class="pg-card-line mb-3 h-px w-8 bg-king-accent/80"></div>

                <h3 class="font-display text-[1.5rem] font-light leading-[0.95] tracking-[-0.01em] md:text-[1.75rem]">
                  {product.name}
                </h3>

                {/* Description */}
                <p class="pg-card-desc mt-2 max-w-[28ch] text-[13px] leading-[1.6] text-white/60">
                  {product.shortDescription}
                </p>

                {/* Color swatches + CTA */}
                <div class="pg-card-meta mt-4 flex items-center gap-3">
                  <div class="flex items-center gap-2">
                    {product.colors.slice(0, 3).map((color) => (
                      <span
                        class="inline-block h-4 w-4 rounded-full border border-white/30 shadow-sm transition-transform duration-300 group-hover:scale-110"
                        style={`background-color: ${color.hex}`}
                        title={color.name}
                      />
                    ))}
                    {product.colors.length > 3 && (
                      <span class="ml-1 text-[9px] uppercase tracking-wider text-white/45">
                        +{product.colors.length - 3}
                      </span>
                    )}
                  </div>
                  <span class="ml-auto inline-flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.18em] text-white/70">
                    Ver detalle
                    <span class="inline-block h-px w-5 bg-king-accent transition-all duration-500 group-hover:w-8"></span>
                  </span>
                </div>
              </div>

              {/* Bottom accent line */}
              <div class="absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-king-accent transition-transform duration-700 ease-out group-hover:scale-x-100"></div>

              {/* Outer border glow on hover */}
              <div class="pointer-events-none absolute inset-0 rounded-[var(--kb-radius-lg)] border border-white/0 transition-colors duration-700 group-hover:border-white/[0.08]"></div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .product-grid-shell {
    isolation: isolate;
  }

  .pg-bg {
    opacity: 0.42;
    background-image:
      linear-gradient(90deg, rgba(138, 106, 61, 0.07) 0, rgba(138, 106, 61, 0.07) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.024) 1px, transparent 1px);
    background-size: 11rem 100%, 100% 5.5rem;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent 88%);
  }

  .pg-featured {
    box-shadow:
      0 32px 80px rgba(18, 15, 12, 0.14),
      0 12px 24px rgba(18, 15, 12, 0.08);
  }

  .pg-featured h3 {
    color: #ffffff;
  }

  .pg-card {
    box-shadow:
      0 20px 50px rgba(18, 15, 12, 0.12),
      0 8px 18px rgba(18, 15, 12, 0.05);
    transition:
      transform 800ms var(--kb-ease-out),
      box-shadow 800ms var(--kb-ease-out);
  }

  .pg-card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 32px 72px rgba(18, 15, 12, 0.18),
      0 12px 28px rgba(18, 15, 12, 0.08);
  }

  .pg-card h3 {
    color: #ffffff;
  }

  .pg-card-img {
    filter: saturate(0.85) contrast(1.04);
    transition:
      transform 1400ms var(--kb-ease-out),
      filter 900ms var(--kb-ease-out);
  }

  .pg-card:hover .pg-card-img {
    filter: saturate(0.94) contrast(1.06);
  }

  .pg-card-hover-img {
    filter: saturate(0.92) contrast(1.05);
  }

  .pg-shimmer {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.03) 45%,
      rgba(255, 255, 255, 0.06) 50%,
      rgba(255, 255, 255, 0.03) 55%,
      transparent 60%
    );
    background-size: 200% 200%;
    animation: none;
  }

  .pg-card:hover .pg-shimmer {
    animation: shimmer-sweep 1.4s ease-out forwards;
  }

  @keyframes shimmer-sweep {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .pg-arrow {
    transform-origin: left center;
  }

  .pg-featured:hover .pg-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 767px) {
    .pg-card {
      border-radius: var(--kb-radius-md);
    }
    .pg-card .pointer-events-none.absolute.inset-4,
    .pg-card .pointer-events-none.absolute.inset-5 {
      border-radius: calc(var(--kb-radius-md) - 0.5rem);
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const scope = document.querySelector('[data-gsap-product-grid]');
  if (scope) {
    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      scrollTrigger: {
        trigger: scope,
        start: 'top 85%',
        once: true,
      },
    });

    tl.from(scope.querySelector('.pg-heading'), {
      y: 24,
      opacity: 0,
      duration: 0.8,
    })
      .from(scope.querySelector('.pg-featured'), {
        y: 40,
        opacity: 0,
        duration: 1.0,
      }, 0.22)
      .from(scope.querySelectorAll('[data-pg-card]:not(.pg-featured)'), {
        y: 28,
        opacity: 0,
        duration: 0.78,
        stagger: 0.07,
      }, 0.5);
  }
</script>
