---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeader from '../components/common/SectionHeader.astro';
import { products } from '../data/products';

const allImages = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/products/*.avif', {
    eager: true,
  })
)
  .map((entry) => entry.default)
  .sort((a, b) => a.src.localeCompare(b.src));

const featuredProduct = products.find((p) => p.slug === 'highway-king') ?? products[0];
const gridProducts = products.filter((p) => p.slug !== featuredProduct.slug);

const getImageForProduct = (productIndex: number, variant: 'primary' | 'hover') => {
  const offset = variant === 'hover' ? 3 : 0;
  return allImages[(productIndex + offset) % allImages.length];
};

const featuredIndex = products.indexOf(featuredProduct);
---

<section
  id="coleccion"
  class="product-grid-shell relative overflow-hidden bg-king-bg py-24 md:py-32 lg:py-36"
  data-gsap-product-grid
>
  <div class="pg-bg pointer-events-none absolute inset-0"></div>
  <div class="pg-inner kb-shell-wide relative">
    <div class="pg-heading mb-10 lg:mb-12">
      <SectionHeader
        eyebrow="Colección"
        body="Materiales reales, herrajes con peso y una estética pensada para envejecer bien con el uso."
        ref="Road gear, not fashion"
        size="md"
      >
        <Fragment slot="title">
          Siete modelos,
          <span class="block italic text-king-text/78">una filosofía.</span>
        </Fragment>
      </SectionHeader>
    </div>

    <a
      href={`/product/${featuredProduct.slug}`}
      class="pg-featured pg-card group mb-9 grid overflow-hidden lg:mb-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]"
      data-pg-card
    >
      <div class="pg-featured-copy relative flex min-h-[24rem] flex-col justify-between overflow-hidden p-6 md:p-8 lg:p-10">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(138,106,61,0.14),transparent_34%)]"></div>

        <div class="relative flex items-start justify-between gap-6">
          <div>
            <span class="mb-4 inline-flex rounded-full border border-king-text/10 bg-white/40 px-3.5 py-1.5 text-[10px] font-medium uppercase tracking-[0.22em] text-king-text/62">
              Destacado
            </span>
            <h3 class="font-serif text-[2.4rem] font-light leading-[0.9] tracking-[var(--kb-title-tracking)] text-king-text md:text-[3.5rem]">
              {featuredProduct.name}
            </h3>
          </div>
          <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-king-accent/68">
            {featuredProduct.id}
          </span>
        </div>

        <div class="relative mt-10">
          <p class="mb-7 max-w-md text-[15px] leading-[1.85] text-king-muted md:text-[16px]">
            {featuredProduct.shortDescription}
          </p>
          <div class="mb-7 flex flex-wrap gap-2.5">
            {featuredProduct.colors.slice(0, 5).map((color) => (
              <span
                class="h-6 w-6 rounded-full border-2 border-white shadow-[0_0_0_1px_rgba(26,26,26,0.14)]"
                style={`background-color: ${color.hex}`}
                title={color.name}
              />
            ))}
          </div>
          <div class="flex items-center justify-between gap-5 border-t border-king-border/70 pt-5">
            <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-king-muted/70">
              {featuredProduct.materials[0]}
            </span>
            <span class="inline-flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.2em] text-king-text">
              Ver producto
              <span class="pg-arrow h-px w-9 bg-king-accent transition-all duration-500 group-hover:w-12"></span>
            </span>
          </div>
        </div>
      </div>

      <div class="relative min-h-[22rem] overflow-hidden md:min-h-[25rem] lg:min-h-[29rem]">
        <Image
          src={getImageForProduct(featuredIndex, 'primary')}
          alt={featuredProduct.name}
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1100ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.045]"
          loading="eager"
          sizes="(min-width: 1024px) 52vw, 100vw"
        />
        <Image
          src={getImageForProduct(featuredIndex, 'hover')}
          alt={`${featuredProduct.name} detalle`}
          class="absolute inset-0 h-full w-full scale-[1.06] object-cover opacity-0 transition-[opacity,transform] duration-[1100ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-100 group-hover:opacity-100"
          loading="eager"
          sizes="(min-width: 1024px) 52vw, 100vw"
        />
        <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.02),rgba(12,11,10,0.28))]"></div>
        <div class="absolute right-5 top-5 rounded-full border border-white/14 bg-black/18 px-3.5 py-1.5 text-[9px] font-medium uppercase tracking-[0.26em] text-white/76 backdrop-blur-md">
          {featuredProduct.badge === 'bestseller' ? 'Más vendido' : featuredProduct.badge === 'new' ? 'Nuevo' : 'Edición'}
        </div>
      </div>
    </a>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {gridProducts.map((product) => {
        const originalIndex = products.indexOf(product);

        return (
          <a
            href={`/product/${product.slug}`}
            class="pg-card group relative block overflow-hidden"
            data-pg-card
          >
            <div class="relative aspect-[4/4.35] overflow-hidden">
              <Image
                src={getImageForProduct(originalIndex, 'primary')}
                alt={product.name}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1000ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.045]"
                loading="lazy"
                sizes="(min-width: 1280px) 30vw, (min-width: 640px) 50vw, 100vw"
              />
              <Image
                src={getImageForProduct(originalIndex, 'hover')}
                alt={`${product.name} detalle`}
                class="absolute inset-0 h-full w-full scale-[1.06] object-cover opacity-0 transition-[opacity,transform] duration-[1000ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-100 group-hover:opacity-100"
                loading="lazy"
                sizes="(min-width: 1280px) 30vw, (min-width: 640px) 50vw, 100vw"
              />
              <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.04)_0%,rgba(12,11,10,0.12)_48%,rgba(12,11,10,0.52)_100%)]"></div>

              <div class="absolute left-4 right-4 top-4 flex items-start justify-between gap-4">
                <span class="rounded-full border border-white/14 bg-black/16 px-3 py-1.5 text-[10px] font-medium uppercase tracking-[0.2em] text-white/74 backdrop-blur-md">
                  {product.badge === 'bestseller' ? 'Más vendido' : product.badge === 'new' ? 'Nuevo' : 'Selección'}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/48">
                  {product.id}
                </span>
              </div>
            </div>

            <div class="relative bg-white/46 p-5 backdrop-blur-[var(--kb-blur-sm)] md:p-6">
              <div class="mb-4 flex items-center gap-2.5">
                {product.colors.slice(0, 5).map((color) => (
                  <span
                    class="h-5 w-5 rounded-full border-2 border-white shadow-[0_0_0_1px_rgba(26,26,26,0.13)]"
                    style={`background-color: ${color.hex}`}
                    title={color.name}
                  />
                ))}
              </div>

              <h3 class="mb-3 font-serif text-[1.65rem] font-light leading-[0.95] tracking-[var(--kb-title-tracking)] text-king-text md:text-[1.9rem]">
                {product.name}
              </h3>
              <p class="mb-5 max-w-[30ch] text-[14px] leading-[1.7] text-king-muted">
                {product.shortDescription}
              </p>

              <div class="flex items-center justify-between gap-5 border-t border-king-border/70 pt-4">
                <span class="text-[10px] font-medium uppercase tracking-[0.18em] text-king-muted/68">
                  {product.materials[0]}
                </span>
                <span class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.18em] text-king-text">
                  Ver
                  <span class="pg-arrow h-px w-6 bg-king-accent transition-all duration-500 group-hover:w-9"></span>
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .product-grid-shell {
    isolation: isolate;
  }

  .pg-bg {
    opacity: 0.48;
    background-image:
      linear-gradient(90deg, rgba(138, 106, 61, 0.08) 0, rgba(138, 106, 61, 0.08) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.028) 1px, transparent 1px);
    background-size: 11rem 100%, 100% 5.5rem;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent 88%);
  }

  .pg-card {
    box-shadow:
      0 20px 54px rgba(18, 15, 12, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }

  .pg-card {
    border: 1px solid var(--kb-stroke-dark);
    border-radius: var(--kb-radius-lg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0.28)),
      rgba(247, 243, 238, 0.78);
    transition:
      transform 700ms var(--kb-ease-out),
      border-color 500ms var(--kb-ease-out),
      box-shadow 700ms var(--kb-ease-out);
  }

  .pg-card:hover {
    transform: translateY(-4px);
    border-color: rgba(138, 106, 61, 0.22);
    box-shadow:
      0 30px 70px rgba(18, 15, 12, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.74);
  }

  .pg-featured-copy {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.28)),
      rgba(247, 243, 238, 0.84);
  }

  .pg-card img {
    transition:
      transform 1100ms var(--kb-ease-out),
      opacity 900ms var(--kb-ease-out);
  }

  .pg-arrow {
    transform-origin: left center;
  }

  .pg-card:hover .pg-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 767px) {
    .pg-card {
      border-radius: var(--kb-radius-md);
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const scope = document.querySelector('[data-gsap-product-grid]');
  if (scope) {
    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      scrollTrigger: {
        trigger: scope,
        start: 'top 85%',
        once: true,
      },
    });

    tl.from(scope.querySelector('.pg-heading'), {
      y: 24,
      opacity: 0,
      duration: 0.8,
    })
      .from(scope.querySelector('.pg-featured'), {
        y: 34,
        opacity: 0,
        duration: 0.95,
      }, 0.22)
      .from(scope.querySelector('.pg-divider'), {
        scaleX: 0,
        opacity: 0,
        duration: 0.7,
        transformOrigin: 'center',
      }, 0.52)
      .from(scope.querySelectorAll('[data-pg-card]:not(.pg-featured)'), {
        y: 26,
        opacity: 0,
        duration: 0.72,
        stagger: 0.06,
      }, 0.66);
  }
</script>
