---
import type { ImageMetadata } from 'astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import ProductVisualImage from '../components/product/ProductVisualImage.astro';
import { products, type ProductImage } from '../data/products';
import Badge from '../components/ui/Badge.astro';

const allImages = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/products/*.avif', {
    eager: true,
  })
)
  .map((entry) => entry.default)
  .sort((a, b) => a.src.localeCompare(b.src));

const gridProducts = products;

const getImageForProduct = (productIndex: number, variant: 'primary' | 'hover') => {
  const offset = variant === 'hover' ? 3 : 0;
  return allImages[(productIndex + offset) % allImages.length];
};

const getDisplayImageForProduct = (product: (typeof products)[number], productIndex: number, variant: 'primary' | 'hover'): ProductImage => {
  const productImageIndex = variant === 'hover' ? 1 : 0;
  return product.images[productImageIndex] ?? getImageForProduct(productIndex, variant);
};

const badgeType = (badge?: string) => {
  if (badge === 'bestseller') return 'bestseller';
  if (badge === 'new') return 'new';
  return undefined;
};
---

<section
  id="coleccion"
  class="product-grid-shell relative overflow-hidden bg-king-bg py-24 md:py-32 lg:py-40"
  data-gsap-product-grid
>
  <div class="pg-bg pointer-events-none absolute inset-0"></div>
  <div class="kb-shell-wide relative">
    <div class="pg-heading mb-10 lg:mb-14">
      <SectionHeader
        eyebrow="Colección"
        number="02" numberTotal="04"
        body="Materiales reales, herrajes con peso y una estética pensada para envejecer bien con el uso."
        meta={`${products.length} modelos`}
      >
        <Fragment slot="title">
          Hechos para durar,
          <span class="block italic text-king-text/78">una filosofía.</span>
        </Fragment>
      </SectionHeader>
    </div>

    {/* Position counter — editorial detail */}
    <div class="pg-counter mb-5 flex items-center justify-end gap-3 lg:mb-7" aria-live="polite">
      <span class="pg-counter-line h-px w-8 bg-king-accent/30"></span>
      <span class="pg-counter-current font-mono text-[11px] font-semibold tabular-nums tracking-[0.18em] text-king-text">01</span>
      <span class="pg-counter-sep font-mono text-[10px] text-king-muted/40">/</span>
      <span class="pg-counter-total font-mono text-[10px] tabular-nums tracking-[0.18em] text-king-muted/50">
        {String(products.length).padStart(2, '0')}
      </span>
      <span class="pg-counter-label text-[9px] font-semibold uppercase tracking-[0.28em] text-king-muted/40">
        En catálogo
      </span>
    </div>

    {/* Horizontal scroll — editorial lookbook */}
    <div class="relative">
      {/* Left fade */}
      <div class="pointer-events-none absolute inset-y-0 left-0 z-20 w-8 bg-gradient-to-r from-king-bg to-transparent sm:w-12 lg:w-16"></div>
      {/* Right fade */}
      <div class="pointer-events-none absolute inset-y-0 right-0 z-20 w-8 bg-gradient-to-l from-king-bg to-transparent sm:w-12 lg:w-16"></div>

      <div
        class="pg-scroll-track flex cursor-grab select-none gap-4 overflow-x-auto pb-6 snap-x snap-mandatory active:cursor-grabbing sm:gap-5 lg:gap-6 lg:pb-8"
        data-pg-scroll
        aria-label="Galería de productos"
      >
        {gridProducts.map((product) => {
          const originalIndex = products.indexOf(product);
          const primaryImage = getDisplayImageForProduct(product, originalIndex, 'primary');
          const hoverImage = originalIndex === 0 ? primaryImage : getDisplayImageForProduct(product, originalIndex, 'hover');

          return (
            <a
              href={`/product/${product.slug}`}
              class="pg-card group relative block w-[78vw] flex-shrink-0 snap-start overflow-hidden rounded-[var(--kb-radius-lg)] sm:w-[45vw] lg:w-[32vw] xl:w-[28vw]"
              data-pg-card
            >
              <div class="relative aspect-[5/5.8] overflow-hidden">
                {/* Primary image */}
                <ProductVisualImage
                  src={primaryImage}
                  alt={`${product.name} — cinturón de cuero`}
                  class="pg-card-img absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
                  loading="lazy"
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  format="webp"
                  quality={84}
                />
                {/* Hover image */}
                <ProductVisualImage
                  src={hoverImage}
                  alt={`${product.name} — vista alternativa`}
                  class="pg-card-hover-img absolute inset-0 h-full w-full scale-[1.06] object-cover opacity-0 transition-[opacity,transform] duration-[1000ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-100 group-hover:opacity-100"
                  loading="lazy"
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  format="webp"
                  quality={82}
                />

                {/* Cinematic overlay layers */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/10"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-transparent"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(138,106,61,0.10),transparent_50%)] opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>

                {/* Shimmer on hover */}
                <div class="pg-shimmer absolute inset-0 opacity-0 transition-opacity duration-700 group-hover:opacity-100"></div>

                {/* Inner frame border */}
                <div class="pointer-events-none absolute inset-3 rounded-[calc(var(--kb-radius-lg)-0.5rem)] border border-white/[0.06] transition-colors duration-700 group-hover:border-white/[0.14] md:inset-5"></div>

                {/* Corner accents */}
                <div class="pointer-events-none absolute inset-4 z-10 md:inset-6">
                  <span class="kb-corner-frame absolute left-0 top-0"></span>
                  <span class="kb-corner-frame absolute right-0 top-0" style="transform: scaleX(-1);"></span>
                  <span class="kb-corner-frame absolute bottom-0 left-0" style="transform: scaleY(-1);"></span>
                  <span class="kb-corner-frame absolute bottom-0 right-0" style="transform: scale(-1);"></span>
                </div>

                {/* Top bar: badge + ID */}
                <div class="absolute left-4 right-4 top-4 z-10 flex items-start justify-between md:left-6 md:right-6 md:top-6">
                  <Badge type={badgeType(product.badge)} />
                  <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40">
                    {product.id}
                  </span>
                </div>

                {/* Accent line top */}
                <div class="absolute left-0 right-0 top-0 h-px bg-[linear-gradient(90deg,transparent_0%,var(--color-king-accent)_50%,transparent_100%)] opacity-0 transition-opacity duration-500 group-hover:opacity-50"></div>

                {/* Bottom info */}
                <div class="absolute bottom-0 left-0 right-0 z-10 p-4 md:p-6">
                  {/* Accent line */}
                  <div class="pg-card-line mb-3 h-px w-8 bg-king-accent/80"></div>

                  <h3 class="font-display text-[1.5rem] font-light leading-[0.95] tracking-[-0.01em] md:text-[1.75rem]">
                    {product.name}
                  </h3>

                  {/* Description */}
                  <p class="pg-card-desc mt-2 text-[13px] leading-[1.6] text-white/60 md:max-w-[28ch]">
                    {product.shortDescription}
                  </p>

                  {/* Material attribute + CTA */}
                  <div class="pg-card-meta mt-4 flex flex-wrap items-center gap-3">
                    <span class="text-[11px] uppercase tracking-[0.12em] text-white/50">
                      {product.materials[0] || 'Cuero seleccionado'}
                    </span>
                    <span class="ml-auto inline-flex items-center gap-2 text-[10px] font-medium uppercase tracking-[0.18em] text-white/70">
                      Ver detalle
                      <span class="inline-block h-px w-5 bg-king-accent transition-all duration-500 group-hover:w-8"></span>
                    </span>
                  </div>
                </div>

                {/* Bottom accent line */}
                <div class="absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-king-accent transition-transform duration-700 ease-out group-hover:scale-x-100"></div>

                {/* Outer border glow on hover */}
                <div class="pointer-events-none absolute inset-0 rounded-[var(--kb-radius-lg)] border border-white/0 transition-colors duration-700 group-hover:border-white/[0.08]"></div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .product-grid-shell {
    isolation: isolate;
  }

  .pg-bg {
    opacity: 0.42;
    background-image:
      linear-gradient(90deg, rgba(138, 106, 61, 0.07) 0, rgba(138, 106, 61, 0.07) 1px, transparent 1px),
      linear-gradient(rgba(26, 26, 26, 0.024) 1px, transparent 1px);
    background-size: 11rem 100%, 100% 5.5rem;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent 88%);
  }

  .pg-card {
    box-shadow:
      0 20px 50px rgba(18, 15, 12, 0.12),
      0 8px 18px rgba(18, 15, 12, 0.05);
    transition:
      transform 800ms var(--kb-ease-out),
      box-shadow 800ms var(--kb-ease-out);
  }

  .pg-card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 32px 72px rgba(18, 15, 12, 0.18),
      0 12px 28px rgba(18, 15, 12, 0.08);
  }

  .pg-card h3 {
    color: #ffffff;
  }

  .pg-card-img {
    filter: saturate(0.85) contrast(1.04);
    transition:
      transform 1400ms var(--kb-ease-out),
      filter 900ms var(--kb-ease-out);
  }

  .pg-card:hover .pg-card-img {
    filter: saturate(0.94) contrast(1.06);
  }

  .pg-card-hover-img {
    filter: saturate(0.92) contrast(1.05);
  }

  .pg-shimmer {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.03) 45%,
      rgba(255, 255, 255, 0.06) 50%,
      rgba(255, 255, 255, 0.03) 55%,
      transparent 60%
    );
    background-size: 200% 200%;
    animation: none;
  }

  .pg-card:hover .pg-shimmer {
    animation: shimmer-sweep 1.4s ease-out forwards;
  }

  @keyframes shimmer-sweep {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .pg-scroll-track {
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-padding-inline: 1rem;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .pg-scroll-track::-webkit-scrollbar {
    display: none;
  }

  .pg-scroll-track.is-dragging {
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .pg-scroll-track.is-dragging .pg-card {
    pointer-events: none;
  }

  .pg-scroll-track img,
  .pg-scroll-track a {
    -webkit-user-drag: none;
    user-drag: none;
  }

  @media (max-width: 767px) {
    .pg-card {
      border-radius: var(--kb-radius-md);
    }
    .pg-card .pointer-events-none.absolute.inset-3,
    .pg-card .pointer-events-none.absolute.inset-4 {
      border-radius: calc(var(--kb-radius-md) - 0.5rem);
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const scope = document.querySelector('[data-gsap-product-grid]');
  if (scope) {
    const tl = gsap.timeline({
      defaults: { ease: 'power3.out' },
      scrollTrigger: {
        trigger: scope,
        start: 'top 85%',
        once: true,
      },
    });

    tl.from(scope.querySelector('.pg-heading'), {
      y: 24,
      opacity: 0,
      duration: 0.8,
    })
      .from(scope.querySelectorAll('[data-pg-card]'), {
        x: 30,
        opacity: 0,
        duration: 0.78,
        stagger: 0.08,
      }, 0.22);
  }

  document.querySelectorAll<HTMLElement>('[data-pg-scroll]').forEach((track) => {
    let isDraggingIntent = false;
    let isMouseDown = false;
    let didDrag = false;
    let startX = 0;
    let startScrollLeft = 0;
    let suppressClick = false;

    const stopDrag = () => {
      if (!isMouseDown) return;

      isMouseDown = false;
      isDraggingIntent = false;
      track.classList.remove('is-dragging');

      window.setTimeout(() => {
        didDrag = false;
        suppressClick = false;
      }, 120);
    };

    const startDrag = (clientX: number) => {
      isMouseDown = true;
      isDraggingIntent = false;
      didDrag = false;
      suppressClick = false;
      startX = clientX;
      startScrollLeft = track.scrollLeft;
    };

    const moveDrag = (clientX: number) => {
      if (!isMouseDown) return;

      const deltaX = clientX - startX;
      if (Math.abs(deltaX) > 4) {
        isDraggingIntent = true;
        didDrag = true;
        suppressClick = true;
        track.classList.add('is-dragging');
      }

      if (isDraggingIntent) {
        track.scrollLeft = startScrollLeft - deltaX;
      }
    };

    track.addEventListener('dragstart', (event) => {
      event.preventDefault();
    });

    track.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0) return;

      startDrag(event.clientX);
    });

    window.addEventListener('pointermove', (event) => {
      if (!isMouseDown) return;
      if (event.pointerType !== 'mouse') return;

      moveDrag(event.clientX);

      if (didDrag) {
        event.preventDefault();
      }
    });

    window.addEventListener('pointerup', stopDrag);
    window.addEventListener('pointercancel', stopDrag);

    track.addEventListener('mousedown', (event) => {
      if (event.button !== 0) return;

      startDrag(event.clientX);
    });

    window.addEventListener('mousemove', (event) => {
      if (!isMouseDown) return;

      moveDrag(event.clientX);

      if (didDrag) {
        event.preventDefault();
      }
    });

    window.addEventListener('mouseup', stopDrag);

    track.addEventListener(
      'click',
      (event) => {
        if (!suppressClick && !didDrag) return;

        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );
  });

  /* ── Position counter (01 / N) ── */
  document.querySelectorAll<HTMLElement>('[data-pg-scroll]').forEach((track) => {
    const scope = track.closest('[data-gsap-product-grid]') as HTMLElement | null;
    const counter = scope?.querySelector<HTMLElement>('.pg-counter-current');
    if (!counter) return;

    const cards = track.querySelectorAll<HTMLElement>('[data-pg-card]');
    if (cards.length === 0) return;

    let ticking = false;

    const updateCounter = () => {
      ticking = false;
      const trackRect = track.getBoundingClientRect();
      const trackCenter = trackRect.left + trackRect.width / 2;

      let closestIndex = 0;
      let closestDist = Infinity;

      cards.forEach((card, i) => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const dist = Math.abs(cardCenter - trackCenter);
        if (dist < closestDist) {
          closestDist = dist;
          closestIndex = i;
        }
      });

      counter.textContent = String(closestIndex + 1).padStart(2, '0');
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateCounter);
        ticking = true;
      }
    };

    track.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    updateCounter();
  });
</script>
