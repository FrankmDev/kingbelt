---
import ProductAddToCart from '../../../../../src/components/product/ProductAddToCart.astro';
import ProductGallery from '../../../../../src/components/product/ProductGallery.astro';
import '../../../../../src/styles/global.css';
import { scaleProduct } from '../../../scale-product';
import { getFirstAvailableVariant } from '../../../../../src/commerce/domain/variants';

const initialVariant = getFirstAvailableVariant(scaleProduct) ?? scaleProduct.variants[0];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Fixture de 76 variantes</title>
  </head>
  <body>
    <main data-product-page>
      <ProductGallery
        images={scaleProduct.images}
        mediaGroups={scaleProduct.mediaGroups}
        options={scaleProduct.options}
        initialVariant={initialVariant}
        idPrefix={scaleProduct.handle}
      />
      <ProductAddToCart product={scaleProduct} />
    </main>
  </body>
</html>
